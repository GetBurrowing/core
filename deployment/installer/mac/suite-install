#!/bin/bash
# suite-install: run the Burrow install CLI with a Python that has tomllib.
#
#   suite-install setup status --json
#   suite-install setup run preflight
#   suite-install validate <manifest>
#
# Stock macOS python3 is 3.9 (no tomllib). This uses the first python3 >= 3.11
# on PATH (Homebrew, python.org, pyenv), else runs the CLI under
# `uv run --python 3.12`, installing uv into ~/.local/bin first if needed (no
# sudo). Everything but the CLI's JSON goes to stderr, so stdout stays one
# JSON document.
#
# Named suite-install, not suite: `suite` is the separate suite-cli (TypeScript
# on bun, repo Startup-Suite/suite-cli) that wires a Claude Code runtime to
# Burrow. See deployment/installer/mac/README.md.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
installer=$(dirname "$here")
export PYTHONPATH="$installer${PYTHONPATH:+:$PYTHONPATH}"

pick_python() {
  local c path
  for c in python3.14 python3.13 python3.12 python3.11 /opt/homebrew/bin/python3 /usr/local/bin/python3 python3; do
    path=$(command -v "$c" 2>/dev/null) || continue
    # /usr/bin/python3 without the Command Line Tools is a stub that opens an
    # install dialog; never run it just to ask its version.
    if [ "$path" = /usr/bin/python3 ] && ! xcode-select -p >/dev/null 2>&1; then
      continue
    fi
    if "$path" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
      printf '%s\n' "$path"
      return 0
    fi
  done
  return 1
}

if py=$(pick_python); then
  exec "$py" -m suite_install "$@"
fi

uv=$(command -v uv 2>/dev/null || true)
if [ -z "$uv" ] && [ -x "$HOME/.local/bin/uv" ]; then
  uv="$HOME/.local/bin/uv"
fi
if [ -z "$uv" ]; then
  echo "suite-install: no python3 >= 3.11; installing uv into ~/.local/bin (no sudo)" >&2
  curl -LsSf https://astral.sh/uv/install.sh |
    env UV_INSTALL_DIR="$HOME/.local/bin" INSTALLER_NO_MODIFY_PATH=1 sh >&2
  uv="$HOME/.local/bin/uv"
fi
exec "$uv" run --quiet --no-project --python 3.12 python -m suite_install "$@"
