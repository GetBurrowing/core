package_update: true
packages:
  - "docker.io"
  - "docker-compose-v2"
write_files:
  - path: "/etc/systemd/system/suite-stack.service"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Generated by suite_install (ADR 0053) for install 'suite-01a0d69d'. Do not edit; re-render.
      [Unit]
      Description=Suite stack (suite-01a0d69d)
      Requires=docker.service
      After=docker.service network-online.target
      Wants=network-online.target
      ConditionPathExists=/opt/suite/.images-loaded

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=/opt/suite
      ExecStartPre=/usr/bin/test -s /opt/suite/models/Qwen3-Embedding-0.6B-f16.gguf
      ExecStartPre=/opt/suite/bin/suite-ca-bundle
      ExecStart=/usr/bin/docker compose up -d --remove-orphans
      ExecStop=/usr/bin/docker compose down

      [Install]
      WantedBy=multi-user.target
  - path: "/opt/suite/Caddyfile"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Generated by suite_install (ADR 0053) for install 'suite-01a0d69d'. Do not edit; re-render.
      {
      	# tls = internal: the root is generated on the host at first boot
      	# (bin/suite-root-ca) and never leaves it.
      	skip_install_trust
      	pki {
      		ca local {
      			name "suite-01a0d69d internal CA"
      			root {
      				cert /etc/caddy/pki/root.crt
      				key /etc/caddy/pki/root.key
      			}
      		}
      	}
      }

      auth.suite-01a0d69d.test {
      	tls internal
      	reverse_proxy pocket-id:1411
      }

      suite-01a0d69d.test {
      	tls internal
      	reverse_proxy core-platform:4000
      }
  - path: "/opt/suite/bin/suite-ca-bundle"
    owner: "root:root"
    permissions: "0755"
    content: |
      #!/bin/sh
      # Generated by suite_install (ADR 0053) for install 'suite-01a0d69d'. Do not edit; re-render.
      # core-platform's trust store is CAStore's bundle (apps/platform/config/runtime.exs:3-10;
      # Platform.OIDC.http_adapter/1 for sign-in), so it cannot verify this install's own
      # root. Build CAStore's bundle from the
      # core image + the install root, mounted read-only over the CAStore file.
      # Retired by ADR 0053 follow-up 10 (a core env var for extra CA certs).
      set -eu
      image='docker.io/example/suite-core:latest'
      castore='/app/lib/castore-1.0.17/priv/cacerts.pem'
      out=/opt/suite/tls/ca-bundle.pem
      if ! docker run --rm --pull never --entrypoint cat "$image" "$castore" > "$out.tmp"; then
        echo "suite-ca-bundle: cannot read $castore in $image; CAStore moved? see ADR 0053" >&2
        rm -f "$out.tmp"
        exit 1
      fi
      if ! grep -q 'BEGIN CERTIFICATE' "$out.tmp"; then
        echo "suite-ca-bundle: $castore in $image holds no certificate" >&2
        rm -f "$out.tmp"
        exit 1
      fi
      printf '\n' >> "$out.tmp"
      cat /opt/suite/tls/root.crt >> "$out.tmp"
      chmod 0644 "$out.tmp"
      mv "$out.tmp" "$out"
  - path: "/opt/suite/bin/suite-root-ca"
    owner: "root:root"
    permissions: "0755"
    content: |
      #!/bin/sh
      # Generated by suite_install (ADR 0053) for install 'suite-01a0d69d'. Do not edit; re-render.
      # Creates this install's private root CA ON THIS HOST, once. The key never
      # exists anywhere else. Caddy signs site certificates with it (Caddyfile pki).
      set -eu
      d=/opt/suite/tls
      [ -s "$d/root.crt" ] && exit 0
      umask 077
      mkdir -p "$d"
      cat > "$d/root.cnf" <<'EOF'
      [req]
      distinguished_name = dn
      x509_extensions = v3
      prompt = no
      [dn]
      CN = suite-01a0d69d internal root
      [v3]
      basicConstraints = critical,CA:TRUE
      keyUsage = critical,keyCertSign,cRLSign
      subjectKeyIdentifier = hash
      EOF
      openssl req -x509 -new -config "$d/root.cnf" -newkey ec -pkeyopt ec_paramgen_curve:P-256 \
        -nodes -sha256 -days 3650 -keyout "$d/root.key" -out "$d/root.crt"
      chmod 0600 "$d/root.key"
      chmod 0644 "$d/root.crt"
  - path: "/opt/suite/compose.yaml"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Generated by suite_install (ADR 0053) for install 'suite-01a0d69d'. Do not edit; re-render.
      name: "suite-01a0d69d"
      services:
        caddy:
          container_name: "caddy"
          image: "docker.io/library/caddy:2"
          pull_policy: "never"
          restart: "unless-stopped"
          volumes:
            - "caddy-config:/config"
            - "caddy-data:/data"
            - "./Caddyfile:/etc/caddy/Caddyfile:ro"
            - "./tls/root.crt:/etc/caddy/pki/root.crt:ro"
            - "./tls/root.key:/etc/caddy/pki/root.key:ro"
          ports:
            - "80:80"
            - "443:443"
          networks:
            default:
              aliases:
                - "auth.suite-01a0d69d.test"
                - "suite-01a0d69d.test"
        core-platform:
          container_name: "core-platform"
          image: "docker.io/example/suite-core:latest"
          pull_policy: "never"
          restart: "unless-stopped"
          env_file:
            - "secrets.env"
          environment:
            APP_URL: "https://suite-01a0d69d.test"
            FILES_SERVICE_URL: "http://files-service:8200"
            OIDC_CLIENT_ID: "suite-core"
            OIDC_ISSUER: "https://auth.suite-01a0d69d.test"
            OIDC_PKCE_ENABLED: "true"
            PHX_HOST: "suite-01a0d69d.test"
            PHX_SERVER: "true"
            PORT: "4000"
          volumes:
            - "core-data:/data/platform"
            - "./tls/ca-bundle.pem:/app/lib/castore-1.0.17/priv/cacerts.pem:ro"
          depends_on:
            core-postgres:
              condition: "service_healthy"
            files-service:
              condition: "service_started"
          healthcheck:
            test:
              - "CMD"
              - "wget"
              - "--no-verbose"
              - "--tries=1"
              - "--spider"
              - "http://localhost:4000/health"
            interval: "30s"
            timeout: "10s"
            retries: 3
            start_period: "30s"
        core-postgres:
          container_name: "core-postgres"
          image: "docker.io/pgvector/pgvector:pg16"
          pull_policy: "never"
          restart: "unless-stopped"
          env_file:
            - "secrets.env"
          environment:
            POSTGRES_DB: "core_platform"
            POSTGRES_USER: "core_platform"
          volumes:
            - "core-postgres-data:/var/lib/postgresql/data"
            - "./postgres-init:/docker-entrypoint-initdb.d:ro"
          healthcheck:
            test:
              - "CMD"
              - "pg_isready"
              - "-U"
              - "core_platform"
            interval: "10s"
            timeout: "5s"
            retries: 5
        embeddings:
          container_name: "embeddings"
          image: "ghcr.io/ggml-org/llama.cpp:server"
          pull_policy: "never"
          restart: "unless-stopped"
          command:
            - "-m"
            - "/models/Qwen3-Embedding-0.6B-f16.gguf"
            - "--embedding"
            - "--pooling"
            - "last"
            - "--host"
            - "0.0.0.0"
            - "--port"
            - "8188"
            - "-c"
            - "32768"
            - "-np"
            - "4"
            - "--no-kv-unified"
            - "-b"
            - "8192"
            - "-ub"
            - "8192"
            - "-t"
            - "6"
          volumes:
            - "./models:/models:ro"
          healthcheck:
            test:
              - "CMD"
              - "curl"
              - "-f"
              - "http://localhost:8188/health"
            interval: "30s"
            timeout: "10s"
            retries: 3
            start_period: "30s"
        files-service:
          container_name: "files-service"
          image: "docker.io/example/suite-files-service:latest"
          pull_policy: "never"
          restart: "unless-stopped"
          env_file:
            - "secrets.env"
          environment:
            PORT: "8200"
        pocket-id:
          container_name: "pocket-id"
          image: "ghcr.io/pocket-id/pocket-id:v2"
          pull_policy: "never"
          restart: "unless-stopped"
          env_file:
            - "secrets.env"
          environment:
            ANALYTICS_DISABLED: "true"
            APP_URL: "https://auth.suite-01a0d69d.test"
            TRUST_PROXY: "true"
          volumes:
            - "pocket-id-data:/app/data"
