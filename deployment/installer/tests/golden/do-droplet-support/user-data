      # The per-agent drop-in in burrow-agent@<id>.service.d/ sets User, Group and paths.
      [Unit]
      Description=Burrow native agent %i
      After=network-online.target
      Wants=network-online.target
      StartLimitIntervalSec=300
      StartLimitBurst=5

      [Service]
      Type=simple
