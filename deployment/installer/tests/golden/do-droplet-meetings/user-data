    owner: "root:root"
    permissions: "0644"
    content: |
      # LiveKit for install 'burrow-01a0d69d' (media_reach = public).
      # Generated by burrow_install; do not edit, re-render. Holds no secret: the
      # key pair arrives as LIVEKIT_KEYS from secrets.env.
      port: 7880
      rtc:
        tcp_port: 7881
        udp_port: 7882
        use_external_ip: true
      # TURN is off on purpose: this host's public IP takes media directly on
      # UDP 7882, with ICE-TCP on 7881 as the fallback. TURN on UDP adds
      # no reach. Only 443-only networks need TURN, as TURN/TLS on 443 shared
      # with Caddy by SNI: a named follow-up, not built here.
      turn:
        enabled: false
      webhook:
        api_key: "suite"
        urls:
