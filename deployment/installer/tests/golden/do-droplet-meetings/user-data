      #!/bin/sh
      # Generated by burrow_install (ADR 0053) for install 'burrow-01a0d69d'. Do not edit; re-render.
      # The local embeddings model, from a pinned source (Hugging Face revision
      # 370f27d7550e0def9b39c1f16d3fbaa13aa67728), checked against its sha256 before it is used.
      set -eu
      dest=/opt/burrow/models/Qwen3-Embedding-0.6B-Q8_0.gguf
      url=https://huggingface.co/Qwen/Qwen3-Embedding-0.6B-GGUF/resolve/370f27d7550e0def9b39c1f16d3fbaa13aa67728/Qwen3-Embedding-0.6B-Q8_0.gguf
      sha=06507c7b42688469c4e7298b0a1e16deff06caf291cf0a5b278c308249c3e439
      if [ -s "$dest" ] && echo "$sha  $dest" | sha256sum -c --status; then
        exit 0
      fi
      mkdir -p "$(dirname "$dest")"
      part="$dest.part"
      attempt=1
      while [ "$attempt" -le 5 ]; do
        rm -f "$part"
        if curl -fsSL --retry 3 --retry-delay 5 --connect-timeout 30 -o "$part" "$url" \
          && echo "$sha  $part" | sha256sum -c --status; then
          chmod 0644 "$part"
          mv -f "$part" "$dest"
          echo "burrow-fetch-model: Qwen3-Embedding-0.6B-Q8_0.gguf downloaded and verified"
          exit 0
        fi
        echo "burrow-fetch-model: attempt $attempt failed (download or sha256 mismatch)" >&2
        sleep $((attempt * 15))
        attempt=$((attempt + 1))
      done
      rm -f "$part"
      echo "burrow-fetch-model: giving up; the stack will not start without the model" >&2
      exit 1
