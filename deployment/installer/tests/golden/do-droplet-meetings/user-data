      #!/bin/sh
      # Generated by burrow_install (ADR 0053) for install 'burrow-01a0d69d'. Do not edit; re-render.
      # Installs Burrow's agent host on THIS host (full_machine, task 01a10322).
      # Idempotent; run by burrow-agent-host-setup.service before burrow-agent-host.service.
      set -eu
      image='ghcr.io/example/burrow-agent-host:latest'
      dest=/opt/burrow/agent-host
      getent group burrow-agents >/dev/null || groupadd --system burrow-agents
      # Agents reach core at its public URL, through Caddy on this host.
      grep -q ' burrow-01a0d69d.test$' /etc/hosts || printf '127.0.0.1 burrow-01a0d69d.test\n' >> /etc/hosts
      # The daemon ships in the agent-host image, the artefact `contained` runs.
      ctr="$(docker create --pull missing "$image")"
      trap 'docker rm -f "$ctr" >/dev/null 2>&1 || true' EXIT
      rm -rf "$dest.incoming"
      docker cp "$ctr:/opt/burrow/agent-host" "$dest.incoming"
      chown -R root:root "$dest.incoming"
      chmod -R go-w,a+rX "$dest.incoming"
      rm -rf "$dest"
      mv "$dest.incoming" "$dest"
      if command -v snap >/dev/null 2>&1 && ! snap list chromium >/dev/null 2>&1; then
        snap install chromium
      fi
      sh "$dest/packaging/install-tools.sh" /etc/burrow-agent-host/versions.env
