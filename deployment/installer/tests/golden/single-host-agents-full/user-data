    owner: "root:root"
    permissions: "0644"
    content: |
      # Generated by suite_install (ADR 0053) for install 'suite-01a0d69d'. Do not edit; re-render.
      {
      	# tls = internal: the root is generated on the host at first boot
      	# (bin/suite-root-ca) and never leaves it.
      	skip_install_trust
      	pki {
      		ca local {
      			name "suite-01a0d69d internal CA"
      			root {
      				cert /etc/caddy/pki/root.crt
      				key /etc/caddy/pki/root.key
      			}
      		}
      	}
      }

      auth.suite-01a0d69d.test {
      	tls internal
      	reverse_proxy pocket-id:1411
      }

      suite-01a0d69d.test {
      	tls internal
      	reverse_proxy core-platform:4000
      }
  - path: "/opt/suite/bin/suite-agent-host-setup"
    owner: "root:root"
    permissions: "0755"
    content: |
      #!/bin/sh
      # Generated by suite_install (ADR 0053) for install 'suite-01a0d69d'. Do not edit; re-render.
      # Installs Burrow's agent host on THIS host (full_machine, task 01a10322).
      # Idempotent; run by suite-agent-host-setup.service before suite-agent-host.service.
      set -eu
      image='docker.io/example/suite-agent-host:latest'
      dest=/opt/suite/agent-host
      getent group suite-agents >/dev/null || groupadd --system suite-agents
      # tls = internal: agents (node, bun, git, curl) must trust this install's root.
      install -m 0644 /opt/suite/tls/root.crt /usr/local/share/ca-certificates/suite-suite-01a0d69d-root.crt
      update-ca-certificates >/dev/null
      # Agents reach core at its public URL, through Caddy on this host.
      grep -q ' suite-01a0d69d.test$' /etc/hosts || printf '127.0.0.1 suite-01a0d69d.test\n' >> /etc/hosts
      # The daemon ships in the agent-host image, the artefact `contained` runs.
      ctr="$(docker create --pull never "$image")"
      trap 'docker rm -f "$ctr" >/dev/null 2>&1 || true' EXIT
      rm -rf "$dest.incoming"
      docker cp "$ctr:/opt/suite/agent-host" "$dest.incoming"
      chown -R root:root "$dest.incoming"
      chmod -R go-w,a+rX "$dest.incoming"
      rm -rf "$dest"
      mv "$dest.incoming" "$dest"
      if command -v snap >/dev/null 2>&1 && ! snap list chromium >/dev/null 2>&1; then
        snap install chromium
      fi
      sh "$dest/packaging/install-tools.sh" /etc/suite-agent-host/versions.env
  - path: "/opt/suite/bin/suite-ca-bundle"
    owner: "root:root"
    permissions: "0755"
    content: |
      #!/bin/sh
      # Generated by suite_install (ADR 0053) for install 'suite-01a0d69d'. Do not edit; re-render.
      # core-platform's trust store is CAStore's bundle (apps/platform/config/runtime.exs:3-10;
      # Platform.OIDC.http_adapter/1 for sign-in), so it cannot verify this install's own
      # root. Build CAStore's bundle from the
      # core image + the install root, mounted read-only over the CAStore file.
      # Retired by ADR 0053 follow-up 10 (a core env var for extra CA certs).
      set -eu
      image='docker.io/example/suite-core:core'
      castore='/app/lib/castore-1.0.17/priv/cacerts.pem'
      out=/opt/suite/tls/ca-bundle.pem
      if ! docker run --rm --pull never --entrypoint cat "$image" "$castore" > "$out.tmp"; then
        echo "suite-ca-bundle: cannot read $castore in $image; CAStore moved? see ADR 0053" >&2
        rm -f "$out.tmp"
        exit 1
      fi
      if ! grep -q 'BEGIN CERTIFICATE' "$out.tmp"; then
        echo "suite-ca-bundle: $castore in $image holds no certificate" >&2
        rm -f "$out.tmp"
        exit 1
      fi
      printf '\n' >> "$out.tmp"
      cat /opt/suite/tls/root.crt >> "$out.tmp"
      chmod 0644 "$out.tmp"
      mv "$out.tmp" "$out"
  - path: "/opt/suite/bin/suite-root-ca"
    owner: "root:root"
    permissions: "0755"
    content: |
      #!/bin/sh
      # Generated by suite_install (ADR 0053) for install 'suite-01a0d69d'. Do not edit; re-render.
      # Creates this install's private root CA ON THIS HOST, once. The key never
      # exists anywhere else. Caddy signs site certificates with it (Caddyfile pki).
      set -eu
      d=/opt/suite/tls
      [ -s "$d/root.crt" ] && exit 0
      umask 077
      mkdir -p "$d"
      cat > "$d/root.cnf" <<'EOF'
      [req]
      distinguished_name = dn
      x509_extensions = v3
      prompt = no
      [dn]
      CN = suite-01a0d69d internal root
      [v3]
      basicConstraints = critical,CA:TRUE
      keyUsage = critical,keyCertSign,cRLSign
      subjectKeyIdentifier = hash
      EOF
      openssl req -x509 -new -config "$d/root.cnf" -newkey ec -pkeyopt ec_paramgen_curve:P-256 \
        -nodes -sha256 -days 3650 -keyout "$d/root.key" -out "$d/root.crt"
      chmod 0600 "$d/root.key"
      chmod 0644 "$d/root.crt"
