# Generated by suite_install (ADR 0053) for install 'suite-01a0d69d'. Do not edit; re-render.
# Carries secrets.env: keep this file mode 0600 and out of any repository.
# Target: Ubuntu 24.04 (noble) cloud image.
package_update: true
packages:
  - "docker.io"
  - "docker-compose-v2"
  - "tmux"
  - "git"
  - "curl"
  - "ca-certificates"
  - "xz-utils"
  - "unzip"
  - "cron"
write_files:
  - path: "/etc/sudoers.d/suite-agents"
    owner: "root:root"
    permissions: "0440"
    content: |
      # Installed by Burrow's agent host packaging (core task 01a10322 stage 3).
      # Native agents do anything that needs root themselves, with this grant.
      # An install is ONE trust group: an agent with this grant can read every other
      # agent's home, env file and tokens. Per-agent users are not a security boundary.
      %suite-agents ALL=(ALL) NOPASSWD:ALL
  - path: "/etc/suite-agent-host.env"
    owner: "root:root"
    permissions: "0600"
    content: |
      # Generated by suite_install (ADR 0053) for install 'suite-01a0d69d'. Do not edit; re-render.
      # SECRET. Mode 0600, root. Read by suite-agent-host.service only.
      AGENT_HOST_PROFILE=full_machine
      AGENT_HOST_TOKEN=<secret:AGENT_HOST_TOKEN>
      BURROW_CORE_URL=https://suite-01a0d69d.test
      SUITE_CORE_URL=https://suite-01a0d69d.test
  - path: "/etc/suite-agent-host/versions.env"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Tool versions the agent host installs, in BOTH capability profiles
      # (core task 01a10322 stage 3). One value per line, NAME=value, no quotes.
      #
      #   contained     Dockerfile runs packaging/install-tools.sh against this file.
      #   full_machine  suite_install renders this file verbatim into cloud-init
      #                 user-data (/etc/suite-agent-host/versions.env), and the host's
      #                 setup unit runs the same install-tools.sh against it.
      #
      # deployment/installer/tests/test_agents_render.py fails if the installer's
      # copy (suite_install/agents.py VERSIONS_ENV) differs from this file by a byte.
      #
      # Claude Code 2.x needs node >= 22 (npm view @anthropic-ai/claude-code engines),
      # which neither Debian bookworm nor Ubuntu noble ship, so node is pinned here
      # and installed from nodejs.org, not apt.
      NODE_VERSION=22.23.3
      BUN_VERSION=1.4.2
      CLAUDE_CODE_VERSION=2.1.295
      CODEX_VERSION=0.162.0
      # suite-cli has no release tags; this is PR #33 at 0.8.0 (Startup-Suite/suite-cli 3f80728): re-pin to its merge commit.
      BURROW_CLI_REF=3f8072830bea22f45584d00a5b6611bee05a05f8
      SUITE_CLI_REF=3f8072830bea22f45584d00a5b6611bee05a05f8
  - path: "/etc/systemd/system/suite-agent-host-setup.service"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Generated by suite_install (ADR 0053) for install 'suite-01a0d69d'. Do not edit; re-render.
      [Unit]
      Description=Install Burrow's agent host and its pinned tools
      Requires=docker.service
      After=docker.service network-online.target
      Wants=network-online.target
      ConditionPathExists=/opt/suite/.images-loaded

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/opt/suite/bin/suite-agent-host-setup
      TimeoutStartSec=30min

      [Install]
      WantedBy=multi-user.target
  - path: "/etc/systemd/system/suite-agent-host.service"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Burrow's agent host (core task 01a10322). The same unit in both capability
      # profiles: on full_machine it is a host service, on contained it runs under
      # the agent-host container's systemd.
      #
      # Configuration comes from /etc/suite-agent-host.env (full_machine: written by
      # suite_install, 0600 root) or, on contained, from the container's environment,
      # which PassEnvironment hands through from systemd. The image sets
      # AGENT_HOST_PROFILE=contained; Environment/EnvironmentFile win over it.
      [Unit]
      Description=Burrow agent host
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      PassEnvironment=BURROW_CORE_URL SUITE_CORE_URL AGENT_HOST_TOKEN AGENT_HOST_PROFILE
      EnvironmentFile=-/etc/suite-agent-host.env
      # Node and bun read only their bundled roots without this; the system bundle
      # carries an install's internal root CA once update-ca-certificates has run.
      Environment=NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
      ExecStart=/usr/local/bin/bun run /opt/suite/agent-host/src/main.ts
      Restart=always
      RestartSec=5

      [Install]
      WantedBy=multi-user.target
  - path: "/etc/systemd/system/suite-agent-host.service.d/10-full-machine.conf"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Generated by suite_install (ADR 0053) for install 'suite-01a0d69d'. Do not edit; re-render.
      # full_machine: the daemon and its tools are installed at first boot.
      [Unit]
      Requires=suite-agent-host-setup.service
      After=suite-agent-host-setup.service suite-stack.service
  - path: "/etc/systemd/system/suite-agent@.service"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Managed by Burrow's agent host. One instance per native agent; %i is the agent id.
      # The per-agent drop-in in suite-agent@<id>.service.d/ sets User, Group and paths.
      [Unit]
      Description=Burrow native agent %i
      After=network-online.target
      Wants=network-online.target
      StartLimitIntervalSec=300
      StartLimitBurst=5

      [Service]
      Type=simple
      EnvironmentFile=/etc/suite-agents/%i.env
      Environment=BURROW_AGENT_ID=%i
      Environment=SUITE_AGENT_ID=%i
      Environment=BURROW_AGENT_SESSION=suite-agent
      Environment=SUITE_AGENT_SESSION=suite-agent
      Environment=BURROW_UNATTENDED=1
      Environment=SUITE_UNATTENDED=1
      Environment=DISABLE_AUTOUPDATER=1
      Environment=NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
      ExecStart=/usr/local/bin/bun run /opt/suite/agent-host/src/runner.ts
      Restart=on-failure
      RestartSec=5
      KillMode=control-group
      TimeoutStopSec=30

      [Install]
      WantedBy=multi-user.target
  - path: "/etc/systemd/system/suite-stack.service"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Generated by suite_install (ADR 0053) for install 'suite-01a0d69d'. Do not edit; re-render.
      [Unit]
      Description=Burrow stack (suite-01a0d69d)
      Requires=docker.service
      After=docker.service network-online.target
      Wants=network-online.target
      Wants=suite-agent-host.service
      ConditionPathExists=/opt/suite/.images-loaded

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=/opt/suite
      ExecStartPre=/usr/bin/test -s /opt/suite/models/Qwen3-Embedding-0.6B-f16.gguf
      ExecStartPre=/opt/suite/bin/suite-ca-bundle
      ExecStart=/usr/bin/docker compose up -d --remove-orphans
      ExecStop=/usr/bin/docker compose down

      [Install]
      WantedBy=multi-user.target
