      MEMORY_DB_PASSWORD=<secret:MEMORY_DB_PASSWORD>
      MEMORY_SERVICE_API_KEY=<secret:MEMORY_SERVICE_API_KEY>
      OIDC_CLIENT_SECRET=<secret:OIDC_CLIENT_SECRET>
