#cloud-config
# Generated by burrow_install (ADR 0053) for install 'burrow-01a0d69d'. Do not edit; re-render.
# Carries secrets.env: keep this file mode 0600 and out of any repository.
# Target: Ubuntu 24.04 (noble) cloud image.
package_update: true
packages:
  - "docker.io"
  - "docker-compose-v2"
write_files:
  - path: "/etc/burrow-updater/updater.env"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Generated by burrow_install (ADR 0053) for install 'burrow-01a0d69d'. Do not edit; re-render.
      # Read by /opt/burrow/bin/burrow-update only. Core cannot write it; no secrets.
      # CHANNEL = day2.upgrade_channel. The update target is always
      # <CORE_REPO>:<FLAVOUR>-<CHANNEL>; a request from core can never name an image.
      # CHANNEL is pinned: images.source = "preloaded": nothing is pulled.
      CHANNEL=pinned
      CORE_REPO=ghcr.io/example/core
      ROLLBACK_REPOS=
      FLAVOUR=core
      HEALTH_TIMEOUT_S=600
      MEETING_STALE_HOURS=12
      AUTO_UPDATE_DEFAULT=true
  - path: "/etc/systemd/system/burrow-stack.service"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Generated by burrow_install (ADR 0053) for install 'burrow-01a0d69d'. Do not edit; re-render.
      [Unit]
      Description=Burrow stack (burrow-01a0d69d)
      Requires=docker.service
      After=docker.service network-online.target
      Wants=network-online.target
      ConditionPathExists=/opt/burrow/.images-loaded

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=/opt/burrow
      ExecStartPre=/usr/bin/test -s /opt/burrow/models/Qwen3-Embedding-0.6B-Q8_0.gguf
      ExecStartPre=/opt/burrow/bin/burrow-ca-bundle
      ExecStart=/usr/bin/docker compose up -d --remove-orphans
      ExecStop=/usr/bin/docker compose down

      [Install]
      WantedBy=multi-user.target
  - path: "/etc/systemd/system/burrow-updater.path"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Generated by burrow_install (ADR 0053) for install 'burrow-01a0d69d'. Do not edit; re-render.
      [Unit]
      Description=Burrow updater inbox (burrow-01a0d69d)

      [Path]
      DirectoryNotEmpty=/var/lib/burrow-updater/core/inbox
      # Past the limit the unit fails; every timer run resets and restarts it.
      TriggerLimitIntervalSec=10s
      TriggerLimitBurst=20
      Unit=burrow-updater.service

      [Install]
      WantedBy=paths.target
  - path: "/etc/systemd/system/burrow-updater.service"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Generated by burrow_install (ADR 0053) for install 'burrow-01a0d69d'. Do not edit; re-render.
      [Unit]
      Description=Burrow host updater (burrow-01a0d69d)
      Requires=docker.service
      After=docker.service burrow-stack.service
      # Started by the path unit on every inbox write: never start-limited.
      StartLimitIntervalSec=0

      [Service]
      Type=oneshot
      User=root
      # Mode comes from $TRIGGER_UNIT (path or timer). The updater takes
      # flock(2) on /run/burrow-updater.lock itself: one run at a time.
      ExecStart=/opt/burrow/bin/burrow-update
      TimeoutStartSec=3600
  - path: "/etc/systemd/system/burrow-updater.timer"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Generated by burrow_install (ADR 0053) for install 'burrow-01a0d69d'. Do not edit; re-render.
      [Unit]
      Description=Hourly Burrow core update check (burrow-01a0d69d)

      [Timer]
      OnBootSec=5min
      OnCalendar=hourly
      RandomizedDelaySec=30min
      Persistent=true
      Unit=burrow-updater.service

      [Install]
      WantedBy=timers.target
  - path: "/opt/burrow/Caddyfile"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Generated by burrow_install (ADR 0053) for install 'burrow-01a0d69d'. Do not edit; re-render.
      {
      	# tls = internal: the root is generated on the host at first boot
      	# (bin/burrow-root-ca) and never leaves it.
      	skip_install_trust
      	pki {
      		ca local {
      			name "burrow-01a0d69d internal CA"
      			root {
      				cert /etc/caddy/pki/root.crt
      				key /etc/caddy/pki/root.key
      			}
      		}
      	}
      }

      auth.burrow-01a0d69d.test {
      	tls internal
      	reverse_proxy pocket-id:1411
      }

      burrow-01a0d69d.test {
      	tls internal
      	reverse_proxy core-platform:4000
      }
  - path: "/opt/burrow/agent-host.env"
    owner: "root:root"
    permissions: "0600"
    content: |
      # Generated by burrow_install (ADR 0053) for install 'burrow-01a0d69d'. Do not edit; re-render.
      # SECRET. Mode 0600. Never commit, never print. Feed back with --reuse-secrets.
      AGENT_HOST_TOKEN=<secret:AGENT_HOST_TOKEN>
  - path: "/opt/burrow/bin/burrow-ca-bundle"
    owner: "root:root"
    permissions: "0755"
    content: |
      #!/bin/sh
      # Generated by burrow_install (ADR 0053) for install 'burrow-01a0d69d'. Do not edit; re-render.
      # core-platform's trust store is CAStore's bundle (apps/platform/config/runtime.exs:3-10;
      # Platform.OIDC.http_adapter/1 for sign-in), so it cannot verify this install's own
      # root. Build CAStore's bundle from the
      # core image + the install root, mounted read-only over the CAStore file.
      # Retired by ADR 0053 follow-up 10 (a core env var for extra CA certs).
      set -eu
      image='ghcr.io/example/core:core'
      castore='/app/lib/castore-1.0.17/priv/cacerts.pem'
      out=/opt/burrow/tls/ca-bundle.pem
      if ! docker run --rm --pull never --entrypoint cat "$image" "$castore" > "$out.tmp"; then
        echo "burrow-ca-bundle: cannot read $castore in $image; CAStore moved? see ADR 0053" >&2
        rm -f "$out.tmp"
        exit 1
      fi
      if ! grep -q 'BEGIN CERTIFICATE' "$out.tmp"; then
        echo "burrow-ca-bundle: $castore in $image holds no certificate" >&2
        rm -f "$out.tmp"
        exit 1
      fi
      printf '\n' >> "$out.tmp"
      cat /opt/burrow/tls/root.crt >> "$out.tmp"
      chmod 0644 "$out.tmp"
      mv "$out.tmp" "$out"
  - path: "/opt/burrow/bin/burrow-migrate"
    owner: "root:root"
    permissions: "0755"
    encoding: "gz+b64"
    content: ""
  - path: "/opt/burrow/bin/burrow-root-ca"
    owner: "root:root"
    permissions: "0755"
    content: |
      #!/bin/sh
      # Generated by burrow_install (ADR 0053) for install 'burrow-01a0d69d'. Do not edit; re-render.
      # Creates this install's private root CA ON THIS HOST, once. The key never
      # exists anywhere else. Caddy signs site certificates with it (Caddyfile pki).
      set -eu
      d=/opt/burrow/tls
      [ -s "$d/root.crt" ] && exit 0
      umask 077
      mkdir -p "$d"
      cat > "$d/root.cnf" <<'EOF'
      [req]
      distinguished_name = dn
      x509_extensions = v3
      prompt = no
      [dn]
      CN = burrow-01a0d69d internal root
      [v3]
      basicConstraints = critical,CA:TRUE
      keyUsage = critical,keyCertSign,cRLSign
      subjectKeyIdentifier = hash
      EOF
      openssl req -x509 -new -config "$d/root.cnf" -newkey ec -pkeyopt ec_paramgen_curve:P-256 \
        -nodes -sha256 -days 3650 -keyout "$d/root.key" -out "$d/root.crt"
      chmod 0600 "$d/root.key"
      chmod 0644 "$d/root.crt"
  - path: "/opt/burrow/bin/burrow-update"
    owner: "root:root"
    permissions: "0755"
    encoding: "gz+b64"
    content: ""
  - path: "/opt/burrow/compose.override.yaml"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Owned by bin/burrow-update. Rewritten on every updater run, so a
      # re-render that replaces it loses nothing. core-platform only: its
      # inbox (rw) and the updater's status (ro), plus the pinned digest.
      services:
        core-platform:
          volumes:
            - "/var/lib/burrow-updater/core:/run/burrow/updater/core:rw"
            - "/var/lib/burrow-updater/outbox:/run/burrow/updater/status:ro"
  - path: "/opt/burrow/compose.yaml"
    owner: "root:root"
    permissions: "0644"
    content: |
      # Generated by burrow_install (ADR 0053) for install 'burrow-01a0d69d'. Do not edit; re-render.
      name: "burrow-01a0d69d"
      services:
        agent-host:
          container_name: "agent-host"
          image: "ghcr.io/example/burrow-agent-host:latest"
          pull_policy: "never"
          restart: "unless-stopped"
          env_file:
            - "agent-host.env"
          environment:
            AGENT_HOST_PROFILE: "contained"
            BURROW_CORE_URL: "http://core-platform:4000"
          volumes:
            - "agent-homes:/home"
            - "/sys/fs/cgroup:/sys/fs/cgroup:rw"
          networks:
            agents: {}
          cgroup: "host"
          tmpfs:
            - "/run"
            - "/run/lock"
            - "/tmp"
          stop_signal: "SIGRTMIN+3"
        caddy:
          container_name: "caddy"
          image: "docker.io/library/caddy:2"
          pull_policy: "never"
          restart: "unless-stopped"
          volumes:
            - "caddy-config:/config"
            - "caddy-data:/data"
            - "./Caddyfile:/etc/caddy/Caddyfile:ro"
            - "./tls/root.crt:/etc/caddy/pki/root.crt:ro"
            - "./tls/root.key:/etc/caddy/pki/root.key:ro"
          ports:
            - "80:80"
            - "443:443"
          networks:
            default:
              aliases:
                - "auth.burrow-01a0d69d.test"
                - "burrow-01a0d69d.test"
        core-platform:
          container_name: "core-platform"
          image: "ghcr.io/example/core:core"
          pull_policy: "never"
          restart: "unless-stopped"
          env_file:
            - "secrets.env"
          environment:
            AGENT_HOST_CORE_URL: "http://core-platform:4000"
            APP_URL: "https://burrow-01a0d69d.test"
            FILES_SERVICE_URL: "http://files-service:8200"
            MEMORY_SERVICE_INGEST_TIMEOUT_MS: "2700000"
            MEMORY_SERVICE_URL: "http://memory-service:8100"
            NATIVE_AGENT_LOGIN: "api_key"
            OIDC_CLIENT_ID: "suite-core"
            OIDC_ISSUER: "https://auth.burrow-01a0d69d.test"
            OIDC_PKCE_ENABLED: "true"
            PHX_HOST: "burrow-01a0d69d.test"
            PHX_SERVER: "true"
            POCKET_ID_ADMIN_ENABLED: "true"
            POCKET_ID_ADMIN_URL: "http://pocket-id:1411"
            PORT: "4000"
          volumes:
            - "core-data:/data/platform"
            - "./tls/ca-bundle.pem:/app/lib/castore-1.0.17/priv/cacerts.pem:ro"
          depends_on:
            core-postgres:
              condition: "service_healthy"
            files-service:
              condition: "service_started"
            memory-service:
              condition: "service_started"
          networks:
            default: {}
            agents: {}
          healthcheck:
            test:
              - "CMD"
              - "wget"
              - "--no-verbose"
              - "--tries=1"
              - "--spider"
              - "http://localhost:4000/health"
            interval: "30s"
            timeout: "10s"
            retries: 3
            start_period: "30s"
        core-postgres:
          container_name: "core-postgres"
          image: "docker.io/pgvector/pgvector:pg16"
          pull_policy: "never"
          restart: "unless-stopped"
          env_file:
            - "secrets.env"
          environment:
            POSTGRES_DB: "core_platform"
            POSTGRES_USER: "core_platform"
          volumes:
            - "core-postgres-data:/var/lib/postgresql/data"
            - "./postgres-init:/docker-entrypoint-initdb.d:ro"
          healthcheck:
            test:
              - "CMD"
              - "pg_isready"
              - "-U"
              - "core_platform"
            interval: "10s"
            timeout: "5s"
            retries: 5
        embeddings:
          container_name: "embeddings"
          image: "ghcr.io/ggml-org/llama.cpp:server@sha256:b32890309c1a33a534a01b0b461e953dc2c5a6bac20213abcf48e22847a19c85"
          pull_policy: "never"
          restart: "unless-stopped"
          command:
            - "-m"
            - "/models/Qwen3-Embedding-0.6B-Q8_0.gguf"
            - "--embedding"
            - "--pooling"
            - "last"
            - "--host"
            - "0.0.0.0"
            - "--port"
            - "8188"
            - "-c"
            - "8192"
            - "-np"
            - "1"
            - "--no-kv-unified"
            - "-b"
            - "1024"
            - "-ub"
            - "1024"
            - "-t"
            - "2"
          mem_limit: "1974m"
          volumes:
            - "./models:/models:ro"
          healthcheck:
            test:
              - "CMD"
              - "curl"
              - "-f"
              - "http://localhost:8188/health"
            interval: "30s"
            timeout: "10s"
            retries: 3
            start_period: "30s"
        files-service:
          container_name: "files-service"
          image: "ghcr.io/example/files-service:latest"
          pull_policy: "never"
          restart: "unless-stopped"
          env_file:
            - "secrets.env"
          environment:
            PORT: "8200"
        memory-service:
          container_name: "memory-service"
          image: "ghcr.io/example/memory-service:latest"
          pull_policy: "never"
          restart: "unless-stopped"
          env_file:
            - "secrets.env"
          environment:
            MEMORY_CHUNK_MAX_TOKENS: "200"
            MEMORY_CHUNK_OVERLAP_TOKENS: "25"
            MEMORY_EMBEDDING_BACKEND: "http"
            MEMORY_EMBEDDING_MAX_BATCH_TOKENS: "200"
            MEMORY_EMBEDDING_MAX_CONCURRENCY: "1"
            MEMORY_EMBEDDING_MAX_INPUT_TOKENS: "200"
            MEMORY_EMBEDDING_MODEL: "embeddings"
            MEMORY_EMBEDDING_URL: "http://embeddings:8188"
            MEMORY_HOST: "0.0.0.0"
            MEMORY_PORT: "8100"
          depends_on:
            core-postgres:
              condition: "service_healthy"
            embeddings:
              condition: "service_healthy"
        pocket-id:
          container_name: "pocket-id"
          image: "ghcr.io/pocket-id/pocket-id:v2.18.0"
          pull_policy: "never"
          restart: "unless-stopped"
          env_file:
            - "secrets.env"
          environment:
            ANALYTICS_DISABLED: "true"
            APP_URL: "https://auth.burrow-01a0d69d.test"
            LOG_LEVEL: "error"
            TRUST_PROXY: "true"
          volumes:
            - "pocket-id-data:/app/data"
      volumes:
        agent-homes: {}
        caddy-config: {}
        caddy-data: {}
        core-data: {}
        core-postgres-data: {}
        pocket-id-data: {}
      networks:
        agents: {}
  - path: "/opt/burrow/postgres-init/10-memory.sql"
    owner: "root:root"
    permissions: "0644"
    content: |
      -- memory-service database (registry service: memory-service).
      -- Runs once, on an EMPTY core-postgres data volume. A fresh postgres has none of
      -- this; the reference install's did because its data was restored from another host.
      \getenv memory_db_password MEMORY_DB_PASSWORD
      CREATE ROLE memory LOGIN PASSWORD :'memory_db_password';
      CREATE DATABASE memory OWNER memory;
      \connect memory
      CREATE EXTENSION IF NOT EXISTS vector;
  - path: "/opt/burrow/secrets.env"
    owner: "root:root"
    permissions: "0600"
    content: |
      # Generated by burrow_install (ADR 0053) for install 'burrow-01a0d69d'. Do not edit; re-render.
      # SECRET. Mode 0600. Never commit, never print. Feed back with --reuse-secrets.
      AGENT_HOST_TOKEN=<secret:AGENT_HOST_TOKEN>
      ATTACHMENT_SIGNING_KEY=<secret:ATTACHMENT_SIGNING_KEY>
      DATABASE_URL=ecto://core_platform:<secret:POSTGRES_PASSWORD>@core-postgres:5432/core_platform
