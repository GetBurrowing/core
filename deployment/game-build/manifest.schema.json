{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable native game manifest (engine neutral)",
  "type": "object",
  "required": ["schema_version", "id", "repository", "repo_url", "source_sha", "build_number", "engine", "protocol_version", "capacity", "server_image", "publisher_workflow", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "maxLength": 128},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "repo_url": {"type": "string", "pattern": "^https://github.com/"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "build_number": {"type": "integer", "minimum": 1},
    "engine": {"type": "string", "minLength": 1},
    "protocol_version": {"type": "integer", "minimum": 1},
    "capacity": {"type": "integer", "minimum": 1, "maximum": 8},
    "server_image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
    "publisher_workflow": {"type": "string"},
    "artifacts": {"type": "array", "minItems": 4, "items": {
      "type": "object", "required": ["os", "arch", "role", "filename", "size", "sha256", "executable", "asset_id"],
      "properties": {
        "os": {"enum": ["windows", "linux", "macos"]},
        "arch": {"type": "string"}, "role": {"enum": ["client", "server"]},
        "filename": {"type": "string"}, "size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "executable": {"type": "string"}, "asset_id": {"type": "integer", "minimum": 1}
      }
    }}
  }
}
