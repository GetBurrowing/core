# Example secret runtime values for a Platform target instance
# Do not commit real values.

SECRET_KEY_BASE=replace-me-with-mix-phx-gen-secret-output

# HMAC secret for POST /api/webhooks/github. Must equal the secret set on the
# GitHub repo hook (see docs/runbooks/github_webhook_secret.md). Deliveries
# fail closed with 401 when neither this nor the project's
# deploy_config["webhook_secret"] verifies the signature.
GITHUB_WEBHOOK_SECRET=replace-me-with-the-value-set-on-the-github-repo-hook
