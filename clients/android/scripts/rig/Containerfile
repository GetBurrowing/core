# Burrow Android build + emulator rig (task 01a10d8e). Runs on the rig host (Linux,
# KVM) under podman; see clients/android/README.md, "Rig".
#
# The image holds the JDK, node and the Android cmdline-tools only. The SDK
# packages in sdk-packages.txt are installed by `rig.sh build-image` into the
# named volume `burrow-android-sdk`, mounted at $ANDROID_HOME, so a rebuilt
# image keeps its multi-GB SDK and the AVDs.
FROM docker.io/library/eclipse-temurin:21-jdk

ARG CMDLINE_TOOLS=13114758
ARG NODE_MAJOR=22

ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_AVD_HOME=/opt/android-sdk/avd \
    ANDROID_ADB_SERVER_PORT=5137 \
    CMDLINE_TOOLS_HOME=/opt/android-cmdline-tools \
    GRADLE_USER_HOME=/root/.gradle \
    DEBIAN_FRONTEND=noninteractive

# Emulator runtime libraries (headless still loads Qt/X11/GL/pulse stubs).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl unzip git rsync xz-utils \
      libpulse0 libnss3 libxcomposite1 libxcursor1 libxi6 libxtst6 libxrandr2 \
      libxdamage1 libxkbfile1 libx11-xcb1 libxkbcommon0 libgl1 libegl1 libgbm1 \
      libdbus-1-3 libasound2t64 libbz2-1.0 libtinfo6 \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://nodejs.org/dist/latest-v${NODE_MAJOR}.x/SHASUMS256.txt" -o /tmp/node.sums \
 && file=$(grep -o "node-v${NODE_MAJOR}\.[0-9.]*-linux-x64\.tar\.xz" /tmp/node.sums | head -1) \
 && curl -fsSL "https://nodejs.org/dist/latest-v${NODE_MAJOR}.x/${file}" -o "/tmp/${file}" \
 && (cd /tmp && grep " ${file}\$" node.sums | sha256sum -c -) \
 && tar -xJf "/tmp/${file}" -C /usr/local --strip-components=1 \
 && rm -f /tmp/node.sums "/tmp/${file}" \
 && node --version

RUN curl -fsSL "https://dl.google.com/android/repository/commandlinetools-linux-${CMDLINE_TOOLS}_latest.zip" -o /tmp/clt.zip \
 && mkdir -p "${CMDLINE_TOOLS_HOME}" \
 && unzip -q /tmp/clt.zip -d /tmp/clt \
 && mv /tmp/clt/cmdline-tools "${CMDLINE_TOOLS_HOME}/latest" \
 && rm -rf /tmp/clt /tmp/clt.zip

ENV PATH=${CMDLINE_TOOLS_HOME}/latest/bin:${ANDROID_HOME}/platform-tools:${ANDROID_HOME}/emulator:${PATH}

COPY sdk-packages.txt /opt/sdk-packages.txt

WORKDIR /work
