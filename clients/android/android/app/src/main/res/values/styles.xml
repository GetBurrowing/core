<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/burrow_primary</item>
        <item name="colorPrimaryDark">@color/burrow_surface</item>
        <item name="colorAccent">@color/burrow_primary</item>
        <item name="android:windowBackground">@color/burrow_surface</item>
    </style>

    <!-- BridgeActivity applies this after the splash. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="colorPrimary">@color/burrow_primary</item>
        <item name="colorAccent">@color/burrow_primary</item>
        <item name="android:windowBackground">@color/burrow_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The share sheet: a translucent window over the sending app, dimmed. -->
    <style name="AppTheme.Share" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimary">@color/burrow_primary</item>
        <item name="colorAccent">@color/burrow_primary</item>
    </style>

    <!-- SplashScreen API: the base-100 field with the arch in its orange
         gradient, as on the iOS launch screen. No cyan. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/burrow_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_arch</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
