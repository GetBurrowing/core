<?xml version="1.0" encoding="utf-8"?>
<!-- Today's briefing on the home screen: 2x2 by default, resizable both ways
     between the layouts the widget snaps to (2x2, 4x2). No maxResizeWidth:
     it stopped the Pixel launcher at 3 columns. The Flip 5 cover screen has
     its own receiver and info (todays_briefing_cover_widget_info). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_briefing_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
