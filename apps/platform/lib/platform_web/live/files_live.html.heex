<div class="flex h-full min-h-0 w-full">
  <%!-- LEFT: org-grouped project picker (desktop only).
       Mirrors the Tasks sidebar — Fabrikam first, then tenant orgs in
       canonical priority order. Hidden on mobile; the mobile sheet
       trigger lives in the center header below. --%>
  <aside class="hidden md:flex w-64 shrink-0 flex-col border-r border-base-300 bg-base-100">
    <div class="flex items-center justify-between border-b border-base-300 px-3 py-3">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-base-content/60">
        Files
      </h2>
      <button
        :if={@selected_project_id}
        phx-click="clear_selection"
        class="btn btn-ghost btn-xs"
        title="Clear project filter"
        aria-label="Clear project filter"
      >
        <span class="hero-x-mark size-4"></span>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto" data-role="files-project-picker">
      <details
        :for={{org_slug, _org_name, org_projects} <- @project_sections}
        open
        class="group"
        data-role="files-project-group"
        data-org-slug={org_slug}
      >
        <summary class="flex items-center gap-2 px-3 py-2 text-xs font-semibold uppercase tracking-widest text-base-content/60 hover:bg-base-200 cursor-pointer select-none">
          <span class={"size-2 rounded-full bg-current #{Tenancy.scope_color(org_slug)}"}></span>
          <span>{Tenancy.scope_label(org_slug)}</span>
          <span class="ml-auto text-[10px] tracking-normal text-base-content/40">
            {length(org_projects)}
          </span>
        </summary>
        <button
          :for={project <- org_projects}
          phx-click="select_project"
          phx-value-id={project.id}
          class={"w-full text-left px-5 py-2 text-sm hover:bg-base-200 #{if @selected_project_id == project.id, do: "bg-base-200 font-medium"}"}
          data-role="files-project-button"
          data-project-id={project.id}
        >
          {project.name}
        </button>
      </details>

      <%!-- Every active org now renders a header, so the picker is never truly
           empty — show the hint only when no org has a project to select. --%>
      <div
        :if={Enum.all?(@project_sections, fn {_slug, _name, projects} -> projects == [] end)}
        class="px-3 py-6 text-center text-sm text-base-content/50"
      >
        No projects yet. Create one from the Tasks surface to start uploading files here.
      </div>
    </div>
  </aside>

  <%!-- CENTER: file list + drag-drop. --%>
  <div class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden">
    <%!-- Header --%>
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-base-300 px-4 py-3">
      <div class="flex items-center gap-3">
        <h1 class="text-sm font-semibold uppercase tracking-widest text-base-content/60">
          Files
        </h1>
        <span :if={@selected_project} class="badge badge-ghost badge-sm">
          {length(@files)}
        </span>
        <%!-- Breadcrumb: org · project --%>
        <div
          :if={@selected_project}
          class="flex items-center gap-1 text-xs text-base-content/60"
          data-role="files-breadcrumb"
        >
          <span class={"font-medium #{org_color_for(@selected_project)}"}>
            {org_label_for(@selected_project)}
          </span>
          <span :if={@selected_project.org} class="text-base-content/40">/</span>
          <span>{@selected_project.name}</span>
        </div>
      </div>

      <div :if={@selected_project} class="flex flex-wrap items-center gap-2">
        <input
          type="text"
          name="filter"
          value={@filter}
          phx-keyup="filter"
          phx-debounce="150"
          placeholder="Filter files…"
          class="input input-bordered input-sm w-44"
          data-role="files-filter-input"
        />
        <form phx-change="sort" class="flex items-center gap-1">
          <label for="files-sort" class="sr-only">Sort by</label>
          <select
            id="files-sort"
            name="sort"
            class="select select-bordered select-sm"
            data-role="files-sort-select"
          >
            <option value="date_desc" selected={@sort == "date_desc"}>Newest first</option>
            <option value="date_asc" selected={@sort == "date_asc"}>Oldest first</option>
            <option value="name_asc" selected={@sort == "name_asc"}>Name A→Z</option>
            <option value="name_desc" selected={@sort == "name_desc"}>Name Z→A</option>
            <option value="size_desc" selected={@sort == "size_desc"}>Largest first</option>
            <option value="size_asc" selected={@sort == "size_asc"}>Smallest first</option>
            <option value="type_asc" selected={@sort == "type_asc"}>Type</option>
          </select>
        </form>
        <%!-- Persistent desktop upload control. Renders whenever a project
             is selected — for BOTH empty and non-empty projects — so you can
             always add files (the table state previously had no upload
             affordance). A SIBLING of the sort form, never nested (HTML
             forbids nested <form>). Desktop-only: mobile uploads via the
             FAB + bottom sheet below. NOTE: this input and the sheet input
             share @uploads.files.ref — keep exactly one functionally-live
             live_file_input per viewport; never add a third. --%>
        <form
          id="files-upload-form"
          phx-change="validate_upload"
          phx-submit="validate_upload"
          class="hidden items-center md:flex"
          data-role="files-upload-form"
        >
          <.live_file_input
            upload={@uploads.files}
            class="file-input file-input-bordered file-input-sm"
          />
          <%!-- Audience choice at upload time. The hidden "false" pairs
               with the checkbox so phx-change always carries a value —
               an unchecked box sends no param of its own, and an absent
               key is indistinguishable from a form that never had the
               field. --%>
          <input type="hidden" name="include_for_agents" value="false" />
          <label class="ml-3 flex cursor-pointer items-center gap-2 text-sm text-base-content">
            <input
              type="checkbox"
              name="include_for_agents"
              value="true"
              checked={@upload_include_for_agents}
              class="checkbox checkbox-sm"
              data-role="files-upload-include-for-agents"
            />
            <span>Include for agents</span>
          </label>
        </form>
      </div>
    </div>

    <%!-- Semantic search row --%>
    <div
      :if={@selected_project}
      class="border-b border-base-300 px-4 py-3 bg-base-200/50"
    >
      <form
        phx-submit="semantic_search"
        class="flex items-center gap-2"
        data-role="files-semantic-search-form"
      >
        <label for="files-semantic-input" class="sr-only">Semantic search</label>
        <span class="hero-magnifying-glass size-4 text-base-content/60"></span>
        <input
          id="files-semantic-input"
          type="text"
          name="query"
          value={@semantic_query}
          placeholder="Semantic search across this project's documents…"
          class="input input-bordered input-sm flex-1"
          data-role="files-semantic-search-input"
        />
        <button type="submit" class="btn btn-primary btn-sm">Search</button>
        <button
          :if={@semantic_query != ""}
          type="button"
          phx-click="clear_semantic"
          class="btn btn-ghost btn-sm"
        >
          Clear
        </button>
      </form>

      <div
        :if={@semantic_search_state == :empty}
        class="mt-2 text-xs text-base-content/60"
        data-role="files-semantic-empty"
      >
        No semantic hits for "{@semantic_query}" in this project.
      </div>

      <ul
        :if={@semantic_results != []}
        class="mt-3 flex flex-col gap-2"
        data-role="files-semantic-results"
      >
        <li
          :for={result <- @semantic_results}
          class="rounded-lg border border-base-300 bg-base-100 p-3"
        >
          <button
            type="button"
            phx-click="select_semantic_hit"
            phx-value-id={result_file_id(result)}
            class="flex w-full flex-col text-left hover:opacity-80"
            data-role="files-semantic-hit"
          >
            <div class="flex items-center justify-between gap-2 text-xs text-base-content/60">
              <span class="font-medium text-base-content">
                {result_label(result)}
              </span>
              <span class="badge badge-ghost badge-sm">
                score {format_score(result_score(result))}
              </span>
            </div>
            <p class="mt-1 text-sm text-base-content/80 line-clamp-3">
              {result_snippet(result)}
            </p>
          </button>
        </li>
      </ul>
    </div>

    <%!-- Drag-drop dropzone + file list --%>
    <div
      class="flex-1 overflow-y-auto"
      phx-drop-target={@uploads.files.ref}
      data-role="file-dropzone"
    >
      <%!-- Empty / placeholder states --%>
      <div
        :if={!@selected_project_id}
        class="flex h-full min-h-[40vh] flex-col items-center justify-center px-6 text-center"
      >
        <span class="hero-document-text size-12 text-base-content/30"></span>
        <h2 class="mt-4 text-lg font-semibold text-base-content">Pick a project</h2>
        <p class="mt-2 max-w-md text-sm text-base-content/60">
          Files are scoped per project (ADR 0042). Choose one from the sidebar
          to view its documents or upload new ones.
        </p>
      </div>

      <div
        :if={@selected_project && @files == []}
        class="flex h-full min-h-[40vh] flex-col items-center justify-center px-6 text-center"
        data-role="files-empty-state"
      >
        <span class="hero-cloud-arrow-up size-12 text-base-content/30"></span>
        <h2 class="mt-4 text-lg font-semibold text-base-content">No files yet</h2>
        <p class="mt-2 max-w-md text-sm text-base-content/60">
          Drag and drop files here, or use the upload button above to add the first one.
        </p>
      </div>

      <%!-- Failed-ingest summary (task 01a0008b stage 4).

           Renders ONLY when the count is above zero — no zero state, no
           green all-clear, no persistent widget. The table starts at the
           top on a healthy project exactly as it did before, and the
           line's mere presence is the signal before anyone reads the
           number.

           An ordinary sentence, not a heading: it comes and goes, and a
           heading that vanishes leaves a hole. A bottom hairline, not a
           box or an alert — a recoverable condition should not be
           dressed as an incident. Only the count takes the error slot;
           the words around it stay body colour. --%>
      <div
        :if={@failed_summary}
        class="flex flex-wrap items-baseline gap-x-2 gap-y-1 border-b border-base-300 px-4 py-3 text-sm text-base-content"
        data-role="files-failed-summary"
        data-failed-count={@failed_summary.count}
      >
        <p>
          <span class="font-semibold text-error">{@failed_summary.count}</span>
          {failed_summary_sentence(@failed_summary)}
        </p>
        <%!-- Retry-all lives HERE, not on each row: eight failures would
             otherwise be eight clicks, and that is how a repair gets
             abandoned halfway. Withdrawn entirely once every remaining
             file has exhausted its attempts. --%>
        <button
          :if={@failed_summary.retryable > 0}
          type="button"
          phx-click="retry_failed_ingests"
          class="link font-medium text-base-content underline-offset-2 hover:opacity-70"
          data-role="files-retry-all"
          data-retryable-count={@failed_summary.retryable}
        >
          Try again
        </button>
        <span :if={failed_summary_note(@failed_summary)} class="text-base-content/60">
          {failed_summary_note(@failed_summary)}
        </span>
      </div>

      <%!-- File table --%>
      <table
        :if={@selected_project && @files != []}
        class="table table-zebra w-full text-sm"
        data-role="files-table"
      >
        <thead>
          <tr>
            <th class="text-left">Name</th>
            <th class="text-left">Type</th>
            <th class="text-right">Size</th>
            <th class="text-left">Status</th>
            <th class="text-left">Uploaded</th>
          </tr>
        </thead>
        <tbody>
          <%!-- A comprehension block rather than `:for` on the row,
               because a failed file renders TWO sibling rows: the row
               itself, unchanged, and the failure reason strip beneath
               it. A non-failed file still renders exactly one, so every
               healthy row is byte-identical to before. --%>
          <%= for file <- filtered_and_sorted(@files, @filter, @sort) do %>
            <tr
              phx-click="select_file"
              phx-value-id={file.id}
              class={"cursor-pointer hover:bg-base-200 #{if @selected_file && @selected_file.id == file.id, do: "bg-base-200"}"}
              data-role="files-row"
              data-file-id={file.id}
              data-ingest-status={file.ingest_status}
              data-ingest-intent={file.ingest_intent}
            >
              <td class="font-medium">
                <div>{file.name || file.original_filename}</div>
                <%!-- Ghost badge, on its own line under the name it
                     qualifies. In the NAME cell, not the Status cell: a
                     supersession claim is about the document's standing,
                     not about its ingest, and the Status column stays
                     single-axis. --%>
                <div :if={Map.has_key?(@supersession_claims, file.id)} class="mt-0.5">
                  <PlatformWeb.Components.SupersessionRuling.supersession_badge claim={
                    Map.get(@supersession_claims, file.id)
                  } />
                </div>
              </td>
              <td class="text-xs text-base-content/60">{file.content_type}</td>
              <td class="text-right tabular-nums">{humanize_bytes(file.byte_size)}</td>
              <td>
                <span
                  class={status_badge_class(file.ingest_status)}
                  data-role="files-status-badge"
                >
                  {status_label(file.ingest_status)}
                </span>
              </td>
              <td class="text-xs text-base-content/60">
                {Calendar.strftime(file.inserted_at, "%Y-%m-%d %H:%M")}
              </td>
            </tr>
            <%!-- The failure reason strip. Renders as TEXT on the row,
                 never as a tooltip, `title=` or any other hover
                 affordance: a hover is invisible on touch and
                 unreachable by keyboard, and this string is the whole
                 point of the ticket. It renders or it does not exist.

                 No button here, deliberately, and this reverses an
                 earlier direction. The row already carries a whole-row
                 `select_file` click, so a control inside it nests one
                 interactive element in another — the click would have to
                 be stopped from also selecting the file, and a keyboard
                 user would meet two tab stops in one visual object. The
                 unbounded manual retry is the detail pane's
                 `files-detail-retry`, which renders for any failed file.

                 The strip is a sibling `<tr>` rather than a line inside
                 the name cell so it spans the row, and so `files-row`
                 keeps the exact shape other surfaces key off. --%>
            <tr
              :if={file.ingest_status == "failed"}
              data-role="files-row-failure-reason"
              data-file-id={file.id}
            >
              <td colspan="5" class="!py-0">
                <%!-- `text-base-content`, NOT `text-neutral`, and this
                     is a deliberate departure from the stage brief.
                     `--color-neutral` is a SURFACE slot: its 4.7:1
                     audit (1B-A11Y-5, in app.css) tuned it against
                     `--color-neutral-content` as a fill, never as a
                     foreground on `--color-base-200`. In the dark theme
                     the pair is oklch(40%) text on an oklch(9%) band —
                     roughly 2.4:1, which fails AA and made the reason
                     genuinely hard to read in a captured render.
                     `--color-base-content` is the foreground partner of
                     the base surfaces and clears AA in BOTH themes,
                     which is what the brief actually asked for. --%>
                <div class="flex max-w-[calc(100vw-0.5rem)] flex-wrap items-baseline gap-x-2 gap-y-1 border-l-[3px] border-error bg-base-200 px-3 py-1.5 md:max-w-none md:flex-nowrap">
                  <%!-- The width cap is what makes `truncate` below
                       actually fire on a phone. This table scrolls
                       horizontally on a narrow viewport, so an
                       unconstrained cell is as wide as the OVERFLOWING
                       table, not as wide as the screen — the tail would
                       run off the side rather than truncate, and a
                       reader would have to scroll sideways to learn
                       what broke. Capping to the viewport puts the
                       ellipsis where the reader can see it.

                       It wraps below `md` rather than competing for one
                       line. Single-line + a `shrink-0` skip clause
                       starved the MIDDLE element, so a narrow viewport
                       showed "Embedding: · not retried automatically
                       after 3 att…" — the reason itself truncated to
                       nothing while the least important fragment
                       survived. That is the truncation-order rule
                       inverted. Wrapping keeps every fragment readable;
                       the desktop row is unchanged. --%>
                  <%!-- Truncation order is the design decision here. The
                       stage prefix is the meaningful fragment and never
                       truncates; the machine tail is expendable.
                       "Embedding: connect timed…" still tells the reader
                       what to do, "…out after 5000ms" does not. --%>
                  <span class="shrink-0 whitespace-nowrap text-xs font-medium text-base-content">
                    {failure_stage_label(file.ingest_failure_stage)}:
                  </span>
                  <span class="min-w-0 truncate font-mono text-xs text-base-content">
                    {failure_detail_text(file.ingest_failure_detail)}
                  </span>
                  <%!-- Fourth state: the sweep declined to touch this
                       row. Appended to the reason, not replacing it —
                       the reader needs both halves, what broke and why
                       nothing has happened since. --%>
                  <span
                    :if={sweep_skipped?(file)}
                    class="shrink-0 whitespace-nowrap font-mono text-xs text-base-content"
                    data-role="files-row-sweep-skipped"
                  >
                    · {sweep_skipped_clause()}
                  </span>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <%!-- Active uploads (visible while files are flying up) --%>
      <div
        :if={@uploads.files.entries != []}
        class="border-t border-base-300 bg-base-200/40 px-4 py-3"
        data-role="files-upload-progress"
      >
        <h3 class="text-xs font-semibold uppercase tracking-widest text-base-content/60">
          Uploading
        </h3>
        <ul class="mt-2 flex flex-col gap-1">
          <li
            :for={entry <- @uploads.files.entries}
            class="flex items-center justify-between gap-3 text-sm"
          >
            <span class="truncate">{entry.client_name}</span>
            <span class="text-xs text-base-content/60">{entry.progress}%</span>
            <button
              type="button"
              phx-click="cancel_upload"
              phx-value-ref={entry.ref}
              class="btn btn-ghost btn-xs"
              aria-label="Cancel upload"
            >
              <span class="hero-x-mark size-3"></span>
            </button>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <%!-- RIGHT: file detail (desktop) / full-screen drawer (mobile). --%>
  <aside
    :if={@selected_file}
    class="hidden lg:flex w-96 shrink-0 flex-col border-l border-base-300 bg-base-100"
    data-role="files-detail-panel"
  >
    <div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
      <h2 class="truncate text-sm font-semibold text-base-content">
        {@selected_file.name || @selected_file.original_filename}
      </h2>
      <button
        phx-click="close_detail"
        class="btn btn-ghost btn-xs btn-square"
        aria-label="Close file detail"
      >
        <span class="hero-x-mark size-4"></span>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto p-4">
      <%!-- Always-available actions: download original + copy a
           shareable URL. These sit ABOVE the metadata dl so the
           primary verbs are reachable without scrolling past the
           preview, even on a short viewport. --%>
      <%!-- Wraps: four verbs plus a right-aligned Delete overflow the
           detail pane at 1280px once the audience toggle is present
           (measured: the toggle's right edge landed past the viewport
           before this). Wrapping keeps every action reachable instead
           of pushing one off the edge. --%>
      <div class="mb-3 flex flex-wrap items-center gap-2" data-role="files-detail-actions">
        <a
          href={file_download_url(@selected_file)}
          class="btn btn-primary btn-sm"
          data-role="files-detail-download"
          download={@selected_file.original_filename || @selected_file.name || "file"}
        >
          <span class="hero-arrow-down-tray size-4"></span> Download
        </a>
        <%!-- The interactive-code flag, beside Download per the design
             direction: flipping it is a deliberate second act taken
             after looking at the file. HTML files only — the gate
             governs code execution, which only an HTML preview's
             iframe surface can exercise (task 01a06a20 stage 3). --%>
        <PlatformWeb.Components.FilePreview.interactive_toggle
          :if={preview_mode(@selected_file) == :html}
          file={@selected_file}
        />
        <button
          type="button"
          id={"files-detail-copy-link-" <> @selected_file.id}
          phx-hook="CopyToClipboard"
          data-clipboard-text={file_attachment_url(@selected_file)}
          class="btn btn-ghost btn-sm"
          data-role="files-detail-copy-link"
        >
          <span class="hero-link size-4"></span> Copy link
        </button>
        <%!-- Audience toggle. Renders STATE, not an explanation: the
             label says which audience the file is in right now. The
             confirm fires on the withdrawing direction only — that one
             deletes extracted text. --%>
        <button
          type="button"
          phx-click="toggle_agent_context"
          phx-value-id={@selected_file.id}
          data-confirm={agent_toggle_confirm(@selected_file.ingest_intent)}
          class="btn btn-ghost btn-sm"
          data-role="files-detail-agent-toggle"
          data-ingest-intent={@selected_file.ingest_intent}
        >
          <.icon name={agent_toggle_icon(@selected_file.ingest_intent)} class="size-4" />
          {agent_toggle_label(@selected_file.ingest_intent)}
        </button>
        <%!-- Per-file retry. Only for a file whose extraction actually
             broke and has attempts left — see can_retry_file?/1, which
             reads the shared threshold rather than re-spelling it. Sits
             beside the audience toggle because both answer "what should
             agents do with this file"; it stays on the constructive side
             of the spacer. --%>
        <button
          :if={can_retry_file?(@selected_file)}
          type="button"
          phx-click="retry_file"
          phx-value-id={@selected_file.id}
          class="btn btn-ghost btn-sm"
          data-role="files-detail-retry"
          data-ingest-failure-count={@selected_file.ingest_failure_count}
        >
          <.icon name="hero-arrow-path" class="size-4" /> Try again
        </button>
        <%!-- Flex spacer: destructive separation — Delete is right-
             aligned, never glued to the constructive verbs. --%>
        <span class="flex-1" aria-hidden="true"></span>
        <.delete_file_button
          file={@selected_file}
          can_delete={can_delete?(@current_user_id)}
          id={"files-detail-delete-" <> @selected_file.id}
        />
      </div>

      <dl class="grid grid-cols-3 gap-2 text-xs text-base-content/60">
        <dt>Type</dt>
        <dd class="col-span-2 text-base-content">{@selected_file.content_type}</dd>
        <dt>Size</dt>
        <dd class="col-span-2 text-base-content">{humanize_bytes(@selected_file.byte_size)}</dd>
        <dt>Status</dt>
        <dd class="col-span-2">
          <span class={status_badge_class(@selected_file.ingest_status)}>
            {status_label(@selected_file.ingest_status)}
          </span>
        </dd>
        <dt>Uploaded</dt>
        <dd class="col-span-2 text-base-content">
          {Calendar.strftime(@selected_file.inserted_at, "%Y-%m-%d %H:%M:%S UTC")}
        </dd>
      </dl>

      <%!-- Supersession ruling. Sits between the metadata and the
           preview: it IS metadata, but it is the only metadata here a
           person can act on. Renders nothing when the card records no
           claim. --%>
      <PlatformWeb.Components.SupersessionRuling.supersession_panel
        claim={Map.get(@supersession_claims, @selected_file.id)}
        file_id={@selected_file.id}
        can_rule={can_rule_supersession?(@current_user_id)}
      />

      <div class="mt-4" data-role="files-detail-preview">
        <PlatformWeb.Components.FilePreview.file_preview
          file={@selected_file}
          text={@selected_file_text}
          scope="files-detail"
          expandable
        />
      </div>
    </div>
  </aside>

  <%!-- Mobile detail drawer — full-screen overlay --%>
  <div
    :if={@selected_file}
    class="fixed inset-0 z-40 bg-base-100 lg:hidden flex flex-col"
    data-role="files-detail-mobile"
  >
    <div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
      <h2 class="truncate text-base font-semibold text-base-content">
        {@selected_file.name || @selected_file.original_filename}
      </h2>
      <button
        phx-click="close_detail"
        class="btn btn-ghost btn-sm btn-square"
        aria-label="Close file detail"
      >
        <span class="hero-x-mark size-5"></span>
      </button>
    </div>
    <div class="flex-1 overflow-y-auto p-4">
      <%!-- Wraps for the same reason as the desktop row, and it bites
           harder here: Download + Copy link + the toggle measure wider
           than a 375px viewport on their own. --%>
      <div class="mb-3 flex flex-wrap items-center gap-2">
        <a
          href={file_download_url(@selected_file)}
          class="btn btn-primary btn-sm"
          download={@selected_file.original_filename || @selected_file.name || "file"}
        >
          <span class="hero-arrow-down-tray size-4"></span> Download
        </a>
        <PlatformWeb.Components.FilePreview.interactive_toggle
          :if={preview_mode(@selected_file) == :html}
          file={@selected_file}
          id_suffix="-mobile"
        />
        <button
          type="button"
          id={"files-detail-copy-link-mobile-" <> @selected_file.id}
          phx-hook="CopyToClipboard"
          data-clipboard-text={file_attachment_url(@selected_file)}
          class="btn btn-ghost btn-sm"
        >
          <span class="hero-link size-4"></span> Copy link
        </button>
        <button
          type="button"
          phx-click="toggle_agent_context"
          phx-value-id={@selected_file.id}
          data-confirm={agent_toggle_confirm(@selected_file.ingest_intent)}
          class="btn btn-ghost btn-sm min-h-11"
          data-role="files-detail-agent-toggle-mobile"
          data-ingest-intent={@selected_file.ingest_intent}
        >
          <.icon name={agent_toggle_icon(@selected_file.ingest_intent)} class="size-4" />
          {agent_toggle_label(@selected_file.ingest_intent)}
        </button>
        <span class="flex-1" aria-hidden="true"></span>
        <.delete_file_button
          file={@selected_file}
          can_delete={can_delete?(@current_user_id)}
          id={"files-detail-delete-mobile-" <> @selected_file.id}
          data_role="files-detail-delete-mobile"
          class="min-h-11"
        />
      </div>

      <%!-- Same block as the desktop pane, distinct data-role suffix so
           a selector resolves to exactly one node (the page renders both
           viewports' markup). Mirrors files-detail-delete-mobile. --%>
      <PlatformWeb.Components.SupersessionRuling.supersession_panel
        claim={Map.get(@supersession_claims, @selected_file.id)}
        file_id={@selected_file.id}
        can_rule={can_rule_supersession?(@current_user_id)}
        suffix="-mobile"
      />

      <PlatformWeb.Components.FilePreview.file_preview
        file={@selected_file}
        text={@selected_file_text}
        scope="files-detail-mobile"
        expandable
      />
    </div>
  </div>

  <%!-- Full-screen preview overlay (task 019ff1ab stage 2). Mirrors the
       active_review_canvas modal on the Tasks panel. Guarded on
       @selected_file so it can never outlive the row it shows. --%>
  <PlatformWeb.Components.FilePreview.preview_fullscreen
    :if={@preview_fullscreen && @selected_file}
    file={@selected_file}
    text={@selected_file_text}
  />

  <%!-- Mobile FAB: open upload sheet.
       Position mirrors the canonical Tasks "+" button so the FAB always
       clears the safe-area inset + the bottom-nav height on every
       device. data-role="file-upload-fab" keeps e2e selectors unique
       from task-create-fab / epic-create-fab / project-create-fab. --%>
  <button
    phx-click="toggle_upload_sheet"
    class="btn btn-primary btn-circle fixed bottom-[calc(env(safe-area-inset-bottom)+1.5rem+var(--bottom-nav-height,0px))] right-6 z-30 shadow-lg md:hidden"
    aria-label="Upload file"
    data-role="file-upload-fab"
  >
    <span class="hero-plus size-6"></span>
  </button>

  <%!-- Mobile bottom sheet: file picker + drag-drop. --%>
  <div
    :if={@show_upload_sheet}
    class="fixed inset-0 z-40 flex items-end justify-center bg-black/40 md:hidden"
    phx-click="close_upload_sheet"
    data-role="files-upload-sheet-backdrop"
  >
    <div
      class="w-full max-w-lg rounded-t-2xl bg-base-100 pb-[env(safe-area-inset-bottom)] max-h-[75vh] overflow-y-auto shadow-2xl"
      phx-click-away="close_upload_sheet"
      data-role="files-upload-sheet"
    >
      <div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-base-content/60">
          Upload to {(@selected_project && @selected_project.name) || "—"}
        </h2>
        <button
          phx-click="close_upload_sheet"
          class="btn btn-ghost btn-xs btn-square"
          aria-label="Close upload sheet"
        >
          <span class="hero-x-mark size-4"></span>
        </button>
      </div>

      <div class="px-4 py-4">
        <p
          :if={!@selected_project_id}
          class="rounded border border-warning/40 bg-warning/10 p-3 text-xs text-warning-content"
        >
          Pick a project from the sidebar (or rotate to a larger screen) before uploading.
        </p>

        <form
          :if={@selected_project_id}
          id="files-upload-sheet-form"
          phx-change="validate_upload"
          phx-submit="validate_upload"
          class="flex flex-col gap-3"
        >
          <div
            class="rounded-lg border-2 border-dashed border-base-300 bg-base-200 p-6 text-center"
            phx-drop-target={@uploads.files.ref}
            data-role="file-dropzone-sheet"
          >
            <span class="hero-cloud-arrow-up size-8 text-base-content/40"></span>
            <p class="mt-2 text-sm text-base-content/70">
              Drag files here, or pick from your device:
            </p>
            <.live_file_input
              upload={@uploads.files}
              class="file-input file-input-bordered file-input-sm mt-3 w-full"
            />
            <p class="mt-2 text-[10px] text-base-content/40">
              Up to 50&nbsp;MB per file, {@uploads.files.max_entries} files per batch.
            </p>
          </div>
          <%!-- Same control as the desktop form, distinct data-role so a
               test selector resolves to exactly one node (the page renders
               both viewports' markup). Mirrors files-detail-delete-mobile. --%>
          <input type="hidden" name="include_for_agents" value="false" />
          <label class="flex min-h-11 cursor-pointer items-center gap-2 text-sm text-base-content">
            <input
              type="checkbox"
              name="include_for_agents"
              value="true"
              checked={@upload_include_for_agents}
              class="checkbox checkbox-sm"
              data-role="files-upload-include-for-agents-mobile"
            />
            <span>Include for agents</span>
          </label>
        </form>
      </div>
    </div>
  </div>

  <%!-- Undo toast for optimistic file deletes. TOP-LEVEL sibling —
       pinned chrome must never live inside an :if region that can
       toggle (it would remount and lose its announce). --%>
  <.file_undo_toast toast={@undo_toast} />
</div>
