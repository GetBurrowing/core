<Layouts.app flash={@flash} embedded={true}>
  <main id="access-panel" class="mx-auto max-w-5xl space-y-6 p-4">
    <h1 class="text-2xl font-semibold">Access</h1>
    <p class="rounded border border-warning p-3 text-sm">
      Break-glass view. Normally your agent does this, and changes made here are logged the same way.
    </p>
    <section class="overflow-hidden rounded-xl border border-edge bg-base-100 p-4 space-y-4">
      <.form
        for={@subject_form}
        id="access-subject-form"
        phx-change="select"
        class="flex flex-col gap-2"
      >
        <.input
          field={@subject_form[:subject]}
          id="access-subject"
          type="select"
          label="Effective access for"
          options={subject_options(@subjects)}
        />
      </.form>
      <label :if={@subject} for="access-view-as" class="flex items-center gap-2 text-sm">
        <input
          id="access-view-as"
          type="checkbox"
          class="checkbox checkbox-sm"
          checked={@viewing}
          phx-click="view-as"
        /> View as this person
      </label>
      <section :if={@viewing && @view}>
        <div class="rounded border border-info p-3 text-info">
          Viewing as {@subject.name} <button phx-click="view-as">Exit</button>
        </div>
        <div class="flex flex-wrap items-center gap-2 py-3" data-role="panel-rail-preview">
          <span
            :for={chip <- rail_chips(@view)}
            data-module={chip.key}
            data-active={to_string(chip.active)}
            class={[
              "rounded-lg border border-edge px-3 py-2 text-sm",
              !chip.active && "opacity-35 line-through"
            ]}
          >
            {chip.label}
          </span>
          <span class="text-xs text-base-content/60">
            ← the rail as {@subject.name} sees it ({subject_role(@view)})
          </span>
        </div>
        <PlatformWeb.Components.AccessViewAs.preview
          result={@view}
          rail_keys={PlatformWeb.AccessViewAs.rail_keys(@view)}
        />
      </section>
      <div class="overflow-x-auto">
        <table class="table min-w-[600px]" data-role="effective-access">
          <thead>
            <tr>
              <th>Can</th>
              <th>Where</th>
              <th>Because</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <tr
              :for={line <- @lines}
              data-source={line.source}
              data-allowed={to_string(line.allowed)}
              data-module={line.source == "Locked" && line.module}
            >
              <td :if={line.source == "Locked"} data-role="module-lock">
                <span
                  class="hero-lock-closed size-4 align-text-bottom text-error"
                  aria-hidden="true"
                >
                </span>
                Locked: {module_label(line.module)}
              </td>
              <td :if={line.source != "Locked"}>
                {if line.allowed, do: "✓", else: "×"} {line.permission}
              </td>
              <td>{line.where.name}</td>
              <td>
                <span class={[
                  "font-mono text-xs",
                  line.source == "grant" && "text-info",
                  line.source in ["deny", "restricted", "Locked"] && "text-error",
                  line.source == "capped" && "text-warning",
                  line.source in ["role", "inherited"] && "text-base-content/60"
                ]}>
                  {line.source}
                </span>
                {line.note}
              </td>
              <td>
                <button
                  :if={line.source in ["grant", "deny"]}
                  phx-click="remove"
                  phx-value-id={line.grant_id}
                  class="btn btn-outline btn-xs"
                >
                  Remove
                </button>
                <button
                  :if={line.source == "Locked"}
                  phx-click="remove"
                  phx-value-id={line.grant_id}
                  class="btn btn-outline btn-xs"
                >
                  Unlock
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <.form
        :if={@lock_form}
        for={@lock_form.form}
        id="access-lock-form"
        phx-submit="lock-module"
        class="flex flex-col gap-2 sm:flex-row sm:items-end"
      >
        <.input
          field={@lock_form.form[:module]}
          id="access-lock-module"
          type="select"
          label="Lock module"
          prompt="Choose a module"
          options={@lock_form.modules}
        />
        <.input
          field={@lock_form.form[:org]}
          id="access-lock-org"
          type="select"
          label="In org"
          options={@lock_form.orgs}
        />
        <button type="submit" class="btn btn-outline btn-error btn-sm min-h-11 sm:min-h-8">
          <span class="hero-lock-closed size-4" aria-hidden="true"></span> Lock module
        </button>
      </.form>
    </section>
    <section class="overflow-hidden rounded-xl border border-edge bg-base-100 p-4">
      <h2 class="text-lg font-semibold">Recent changes</h2>
      <div class="overflow-x-auto">
        <table class="table min-w-[600px]" data-role="access-changes">
          <thead>
            <tr>
              <th>When</th>
              <th>Change</th>
              <th>By</th>
              <th>Undo</th>
            </tr>
          </thead>
          <tbody>
            <tr
              :for={change <- @changes}
              data-change-id={change.id}
              class={MapSet.member?(@undone, change.id) && "line-through text-base-content/60"}
            >
              <td class="font-mono text-xs text-base-content/60">
                {Calendar.strftime(change.inserted_at, "%Y-%m-%d %H:%M")}
              </td>
              <td>{change_label(change)}</td>
              <td>By {actor_name(change.actor_id)}{via_name(change.via_agent_id)}</td>
              <td>
                <button phx-click="undo" phx-value-id={change.id} class="btn btn-outline btn-xs">
                  Undo
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
    <section
      :if={@subject}
      class="overflow-hidden rounded-xl border border-edge bg-base-100 p-4 space-y-3"
    >
      <h2 class="text-lg font-semibold">Last resort</h2>
      <button phx-click="reset" class="btn btn-outline btn-error">
        Reset selected person to role defaults
      </button>
      <p class="text-sm text-base-content/60">
        Removes every per-person grant and deny, keeps their role. One undo.
      </p>
      <div :if={@preview} id="reset-card">
        <Platform.Chat.Canvas.Renderer.render_node
          node={preview_document(@preview)["root"]}
          canvas_id="panel-reset"
          event_target={nil}
        />
      </div>
    </section>
  </main>
</Layouts.app>
