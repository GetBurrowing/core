<div
  id="tasks-last-project"
  phx-hook="LastProject"
  data-selected-project-id={@selected_project_id || "__all__"}
  class="flex h-full min-h-0"
>
  <%!-- Desktop sidebar --%>
  <aside
    :if={@sidebar_open}
    class="hidden w-56 shrink-0 flex-col border-r border-base-300 bg-base-100 md:flex"
  >
    <div class="flex items-center justify-between border-b border-base-300 px-3 py-3">
      <span class="text-xs font-semibold uppercase tracking-widest text-base-content/60">
        Projects
      </span>
      <div class="flex items-center gap-1">
        <.section_add_button
          phx-click="toggle_project_create_sheet"
          aria_label="New project"
          data-role="project-create-trigger"
        />
        <button
          phx-click="toggle_projects_section"
          class="btn btn-ghost btn-xs btn-square"
          title={if @projects_collapsed, do: "Expand projects", else: "Collapse projects"}
        >
          <span class={"size-4 transition-transform #{if @projects_collapsed, do: "hero-chevron-down", else: "hero-chevron-up"}"}>
          </span>
        </button>
        <button
          phx-click="toggle_sidebar"
          class="btn btn-ghost btn-xs btn-square"
          title="Close sidebar"
        >
          <span class="hero-chevron-left size-4"></span>
        </button>
      </div>
    </div>

    <%!-- Stage 5 of ADR-0042: project picker grouped by org via collapsible
         <details> sections. Fabrikam first (root), then tenant orgs alphabetically.
         Header carries the scope color dot (Tenancy.scope_color/1, pure +
         DB-free) so users see at a glance which org a section belongs to. --%>
    <div :if={!@projects_collapsed} class="flex-1 overflow-y-auto">
      <details
        :for={{org_slug, _org_name, org_projects} <- @project_sections}
        open
        class="group relative"
        data-role="project-group"
        data-org-slug={org_slug}
      >
        <summary class={[
          "flex items-center gap-2 px-3 py-2 text-xs font-semibold uppercase tracking-widest text-base-content/60 hover:bg-base-200 cursor-pointer select-none",
          (@fabrikam_admin? and org_slug not in ["fabrikam", "_unassigned"]) && "pr-9"
        ]}>
          <span class={"size-2 rounded-full bg-current #{Tenancy.scope_color(org_slug)}"}></span>
          <span>{Tenancy.scope_label(org_slug)}</span>
          <span class="ml-auto text-[10px] tracking-normal text-base-content/40">
            {length(org_projects)}
          </span>
        </summary>
        <%!-- Org kebab: a sibling of <summary> (NOT a descendant) positioned
             over the row's right edge, so clicking it opens the lifecycle
             menu without toggling the native <details>. Root org (Fabrikam) is
             never offered — the lifecycle refuses it. --%>
        <.lifecycle_menu
          :if={@fabrikam_admin? and org_slug not in ["fabrikam", "_unassigned"]}
          key={"org:#{org_slug}"}
          open={@lifecycle_menu_key == "org:#{org_slug}"}
          type="org"
          id={org_slug}
          name={Tenancy.scope_label(org_slug)}
          class="absolute right-1 top-1.5"
        />
        <div
          :for={project <- org_projects}
          class="group/proj relative flex items-center hover:bg-base-200"
        >
          <button
            phx-click="select_project"
            phx-value-id={project.id}
            class={"min-w-0 flex-1 text-left px-5 py-2 text-sm truncate #{if @selected_project_id == project.id, do: "bg-base-200 font-medium"}"}
          >
            {project.name}
          </button>
          <.lifecycle_menu
            :if={@fabrikam_admin?}
            key={"project:#{project.id}"}
            open={@lifecycle_menu_key == "project:#{project.id}"}
            type="project"
            id={project.id}
            name={project.name}
            class="relative pr-2 opacity-0 focus-within:opacity-100 group-hover/proj:opacity-100"
          />
        </div>
      </details>
    </div>

    <div class="border-t border-base-300 p-2">
      <button phx-click="clear_filters" class="btn btn-xs btn-ghost w-full">All Projects</button>
    </div>
  </aside>

  <%!-- Sidebar collapsed toggle (desktop) --%>
  <button
    :if={!@sidebar_open}
    phx-click="toggle_sidebar"
    class="hidden md:flex items-center justify-center w-6 shrink-0 border-r border-base-300 hover:bg-base-200"
    title="Expand sidebar"
  >
    <span class="hero-chevron-right size-4 text-base-content/50"></span>
  </button>

  <%!-- Main content area --%>
  <div class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden">
    <%!-- Board header (re-skin Phase 2 stage 2, task 019f51ca): page_header
         replaces the ad-hoc header row. The count badge stays the
         UNFILTERED total (search narrows the board, not the headline).
         The scope rail + breadcrumb live in the :filters slot — they keep
         their ids/data-roles; the rail drops its own border-b because the
         header supplies the bottom hairline. --%>
    <.page_header
      id="tasks-page-header"
      title="Tasks"
      count={@visible_task_count || length(@all_tasks)}
    >
      <:leading>
        <%!-- Mobile: project sheet trigger --%>
        <button
          phx-click="toggle_project_sheet"
          class="btn btn-ghost btn-xs btn-square md:hidden"
          title="Projects"
          aria-label="Open projects menu"
        >
          <span class="hero-bars-3 size-4"></span>
        </button>
      </:leading>
      <:badges>
        <span :if={@pending_plan_count > 0} class="badge badge-warning badge-sm gap-1">
          {@pending_plan_count} awaiting review
        </span>
      </:badges>
      <:search>
        <.search_input
          id="task-search"
          event="search_tasks"
          value={@task_search_query}
          placeholder="Search tasks — id, title, sponsor, agent…"
          aria_label="Search tasks"
          class="w-full md:w-80"
        />
      </:search>
      <:primary_action>
        <%!-- hidden below md: mobile creates via the single FAB menu. --%>
        <div class="relative hidden md:block">
          <div class="join">
            <button
              type="button"
              phx-click="toggle_task_sheet"
              class="btn btn-primary btn-sm join-item focus-visible-ring"
              data-role="header-new-task"
            >
              <span class="hero-plus size-4"></span> New Task
            </button>
            <button
              type="button"
              phx-click="toggle_create_menu"
              class="btn btn-primary btn-sm join-item px-2 focus-visible-ring"
              aria-label="More create options"
              aria-haspopup="menu"
              aria-controls="header-create-menu"
              aria-expanded={to_string(@create_menu_open)}
              data-role="header-create-menu-trigger"
            >
              <span class="hero-chevron-down size-4"></span>
            </button>
          </div>
          <%!-- Styled-div dropdown (not a browser popover): scrim closes on
               tap-out/Escape; card reads elevation from --shadow-dropdown. --%>
          <div
            :if={@create_menu_open}
            class="fixed inset-0 z-30"
            phx-click="toggle_create_menu"
            phx-window-keydown="toggle_create_menu"
            phx-key="escape"
            aria-hidden="true"
          >
          </div>
          <div
            :if={@create_menu_open}
            id="header-create-menu"
            role="menu"
            aria-label="Create"
            class="absolute right-0 top-full z-40 mt-2 flex min-w-44 flex-col gap-2 rounded-box border border-base-content/10 bg-base-100 p-2"
            style="box-shadow: var(--shadow-dropdown);"
          >
            <button
              type="button"
              role="menuitem"
              phx-click="toggle_epic_sheet"
              class="flex items-center gap-2 rounded-lg px-3 py-2 text-left text-sm hover:bg-base-200 focus-visible-ring"
            >
              <span class="hero-rectangle-stack size-4"></span> New Epic
            </button>
            <button
              type="button"
              role="menuitem"
              phx-click="toggle_project_create_sheet"
              class="flex items-center gap-2 rounded-lg px-3 py-2 text-left text-sm hover:bg-base-200 focus-visible-ring"
              data-role="header-new-project"
            >
              <span class="hero-folder-plus size-4"></span> New Project
            </button>
          </div>
        </div>
      </:primary_action>
      <:filters>
        <%!-- Active filter breadcrumb. Stage 5 of ADR-0042 prefixes the project
             with `<org_label> / ` (org name carries the scope color token, e.g.
             `text-soylent`) so users always know which tenant context they're
             inside. --%>
        <div
          :if={@selected_project_id}
          class="flex items-center gap-1 px-4 pb-2 text-xs text-base-content/60"
        >
          <span
            :for={p <- @projects}
            :if={p.id == @selected_project_id}
            class="flex items-center gap-1"
          >
            <span
              :if={match?(%Tenancy.Org{}, p.org)}
              class={"font-medium #{Tenancy.scope_color(p.org.slug)}"}
            >
              {Tenancy.scope_label(p.org.slug)}
            </span>
            <span :if={match?(%Tenancy.Org{}, p.org)} class="text-base-content/40">/</span>
            <span>{p.name}</span>
          </span>
          <span :if={@selected_epic_id}>
            / <span :for={e <- @epics} :if={e.id == @selected_epic_id}>{e.name}</span>
          </span>
          <button
            phx-click="clear_filters"
            class="btn btn-ghost btn-xs btn-square ml-1"
            aria-label="Clear filters"
          >
            <span class="hero-x-mark size-3"></span>
          </button>
        </div>

        <%!-- Scope-filter rail (desktop, Stage 3 of Tasks v2 — 2026-05-19).
             Five sub-org chips + an "All" reset. Moved into the page_header
             :filters slot by re-skin Phase 2 stage 2 — ids, data-scope-chip
             hooks and click semantics are unchanged; only its own border-b
             was dropped (the header hairline replaces it). Mobile keeps the
             5-pill status nav — the rail is `hidden lg:flex` only, per the
             responsive-scope contract.

             Each sub-org chip uses the foundation `<.scope_pill />`
             primitive (futureproof seam for the MT/RBAC stack
             019e3c49). Counts come from `@scope_counts` populated by
             `Platform.Tasks.count_by_scope/0` — today-state every task
             folds under :fabrikam, so the other four show 0 until
             `tasks.org_id` lands.

             Click semantics: the "All" chip dispatches `scope_filter`
             with `phx-value-scope="all"`; sub-org chips dispatch it with
             their scope atom serialized to a string (`"fabrikam"`,
             `"soylent"`, etc.). The server narrows the kanban render via
             `desktop_column_items_for_scope/4`. --%>
        <nav
          id="tasks-scope-rail"
          aria-label="Filter tasks by sub-org scope"
          class="hidden min-w-0 lg:flex items-center gap-2 overflow-x-auto"
        >
          <button
            type="button"
            phx-click="scope_filter"
            phx-value-scope="all"
            aria-pressed={@scope_filter == :all}
            data-scope-chip="all"
            data-active={to_string(@scope_filter == :all)}
            class={[
              "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-medium leading-none transition-colors focus-visible-ring",
              if(@scope_filter == :all,
                do:
                  "bg-base-content text-base-100 border-base-content shadow-[0_0_0_2px_oklch(70%_0_0/30%)]",
                else: "bg-base-200 text-base-content/70 border-base-content/15 hover:bg-base-300"
              )
            ]}
          >
            <span class="scope-pill-label">All</span>
            <span class={[
              "inline-flex items-center justify-center min-w-[18px] h-[18px] rounded-full text-[10px] font-bold tabular-nums",
              if(@scope_filter == :all,
                do: "bg-base-100/20 text-base-100",
                else: "bg-base-300 text-base-content/70"
              )
            ]}>
              {scope_count_total(@scope_counts)}
            </span>
          </button>
          <span
            :for={scope <- @active_scope_keys}
            data-scope-chip={Atom.to_string(scope)}
            data-active={to_string(@scope_filter == scope)}
            class="inline-flex items-center gap-1"
          >
            <.scope_pill scope={scope} active={@scope_filter == scope} />
            <span class={[
              "inline-flex items-center justify-center min-w-[18px] h-[18px] -ml-0.5 rounded-full text-[10px] font-bold tabular-nums",
              if(@scope_filter == scope,
                do: "bg-base-content/15 text-base-content",
                else: "bg-base-200 text-base-content/60"
              )
            ]}>
              {Map.get(@scope_counts, scope, 0)}
            </span>
          </span>

          <%!-- "Sponsored by me" toggle (Stage 2 of task 019f3f22 —
               ADR-0042 sponsor visibility). Sits right-anchored on the
               scope rail so it's discoverable next to the scope pills
               without stealing left-side reading order. Click flips
               between `:all` ↔ `:mine` and push_patches the URL so
               `?sponsor=mine` is authoritative (share-a-URL contract,
               matches `?project=` / `?scope=` semantics — no localStorage
               / session persistence per ADR non-goals). Mobile uses the
               same URL param via `handle_params/3`; no mobile-specific
               chip today (follow-up if Marlowe wants a mobile toggle). --%>
          <button
            type="button"
            phx-click="toggle_sponsor_filter"
            aria-pressed={if @sponsor_filter == :mine, do: "true", else: "false"}
            aria-label="Filter tasks and stacks to those I sponsor"
            data-role="sponsor-filter-toggle"
            data-active={to_string(@sponsor_filter == :mine)}
            class={[
              "ml-auto inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-medium leading-none transition-colors focus-visible-ring",
              if(@sponsor_filter == :mine,
                do:
                  "bg-primary text-primary-content border-primary shadow-[0_0_0_2px_oklch(70%_0.15_260/30%)]",
                else: "bg-base-200 text-base-content/70 border-base-content/15 hover:bg-base-300"
              )
            ]}
          >
            <span>My work</span>
          </button>
        </nav>
      </:filters>
    </.page_header>

    <%!-- Epics above board --%>
    <div :if={@selected_project_id && @epics != []} class="px-4 pt-3" id="epics-section">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold uppercase tracking-widest text-base-content/50">
          Epics
        </span>
        <button
          phx-click="toggle_epics_panel"
          class="btn btn-ghost btn-xs btn-square"
          aria-label={if @epics_collapsed, do: "Expand epics", else: "Collapse epics"}
          aria-expanded={if @epics_collapsed, do: "false", else: "true"}
        >
          <span class={"size-4 transition-transform #{if @epics_collapsed, do: "hero-chevron-down", else: "hero-chevron-up"}"}>
          </span>
        </button>
      </div>
      <div :if={!@epics_collapsed} class="flex gap-3 overflow-x-auto pb-2">
        <div
          :for={epic <- @epics}
          phx-click="select_epic"
          phx-value-id={epic.id}
          class={"card card-compact min-w-[180px] max-w-[220px] shrink-0 cursor-pointer border bg-base-100 shadow-sm transition-all hover:shadow-md #{if @selected_epic_id == epic.id, do: "border-primary ring-2 ring-primary", else: "border-base-300"}"}
        >
          <div class="card-body gap-1 p-3">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-sm font-bold truncate">{epic.name}</h3>
              <span class={epic_status_badge_class(epic.status)}>{epic.status}</span>
            </div>
            <p :if={epic.description} class="text-xs text-base-content/60 line-clamp-2">
              {epic.description}
            </p>
            <div class="flex items-center gap-2 mt-1 text-xs text-base-content/50">
              <span>{epic.task_count} tasks</span>
              <span class="text-success">{epic.done_count} done</span>
            </div>
            <div
              :if={Map.get(epic, :target_branch)}
              class="flex items-center gap-1 mt-1 text-xs text-info"
            >
              <span class="hero-code-bracket size-3"></span>
              <span class="truncate">{Map.get(epic, :target_branch)}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%!-- Mobile task list — section-grouped vertical layout (audit 1B-USE-2).
         Replaces the horizontal kanban below md:. The kanban below this block
         is hidden on mobile via the same breakpoint, so desktop stays
         unchanged.

         Status-filter pill bar (Marlowe + Rowan, 2026-05-12) reuses the chat
         channel-pill pattern. Default-active = "in_progress" so users land
         on actionable work; previously the section iteration began at
         "Backlog" which buried in-progress work below the scroll fold. The
         @mobile_columns order (in_progress first) controls both the pill
         order and the rendered-section order — desktop @kanban_columns is
         unchanged. --%>
    <%!-- The inner scroll container (`flex-1 overflow-y-auto pb-24`)
         provides comfortable scroll-end padding so the last task isn't
         flush with the bottom-nav. The outer wrapper used to also carry
         pb-24 (pre-PR #334, when the shell wasn't properly bounded);
         that's now redundant and shows up as ~96px of empty space below
         the scroller. --%>
    <div
      :if={!(@show_detail && @selected_task)}
      id="tasks-mobile-list"
      class="lg:hidden flex flex-1 flex-col overflow-hidden"
    >
      <%!-- T6 status-filter pill nav (PR #328). Counts are derived from
           `@board_items` so stack cards contribute to the per-pill
           total — `@columns` is task-only and would undercount. --%>
      <nav
        id="tasks-status-filter-pills"
        phx-hook="TasksStatusFilter"
        class="flex items-center gap-2 overflow-x-auto px-3 py-2 border-b border-base-content/10 shrink-0"
        style="scrollbar-width: none; -webkit-overflow-scrolling: touch;"
        aria-label="Filter tasks by status"
      >
        <button
          :for={{col_key, col_label} <- @mobile_columns}
          type="button"
          phx-click="filter_by_status"
          phx-value-status={col_key}
          aria-pressed={@active_status_filter == col_key}
          class={[
            "flex items-center gap-1.5 px-3 py-1.5 rounded-full whitespace-nowrap text-[13px] font-medium shrink-0 transition-all",
            "active:scale-[0.97] ease-[cubic-bezier(0.16,1,0.3,1)]",
            if @active_status_filter == col_key do
              "bg-primary text-primary-content shadow-[0_0_16px_oklch(0.78_0.14_207_/_0.18)]"
            else
              "bg-base-200 text-base-content/70 border border-base-content/10 hover:bg-base-300"
            end
          ]}
        >
          <span class={["size-1.5 rounded-full", status_dot_class(col_key)]} aria-hidden="true">
          </span>
          {col_label}
          <span
            :if={length(Map.get(@board_items, col_key, [])) > 0}
            class={[
              "inline-flex items-center justify-center min-w-[18px] h-[18px] rounded-full text-[10px] font-bold tabular-nums",
              if(@active_status_filter == col_key,
                do: "bg-primary-content/20 text-primary-content",
                else: "bg-base-300 text-base-content/70"
              )
            ]}
          >
            {length(Map.get(@board_items, col_key, []))}
          </span>
        </button>
      </nav>

      <%!-- T7 mobile section list, rebased on top of T6's pill filter.
           Iterates `@mobile_columns` for ordering + only renders the
           active-filter section. Items come from `@board_items` so
           stack cards interleave with standalone tasks (sorted by
           `updated_at`, ADR 0041). Stack cards include the stage-3
           expansion contract (`stack-member-mobile-#{id}` rows + dep
           annotations). Empty-state checks also use `@board_items`. --%>
      <div class="flex-1 overflow-y-auto px-3 pb-24">
        <div
          :for={{col_key, col_label} <- @mobile_columns}
          :if={@active_status_filter == col_key && Map.get(@board_items, col_key, []) != []}
          class="mt-4 first:mt-2"
        >
          <h2 class="text-xs font-semibold uppercase tracking-widest text-base-content/50 mb-2 px-1">
            {col_label} · {length(Map.get(@board_items, col_key, []))}
          </h2>
          <div class="flex flex-col gap-2">
            <% column_items = Map.get(@board_items, col_key, []) %>
            <%= for item <- column_items do %>
              <%= case item.__struct__ do %>
                <% Platform.Tasks.Stack -> %>
                  <% board_data =
                    Map.get(@stack_board_data, item.id, %{
                      member_count: 0,
                      dep_edge_count: 0,
                      ready_count: 0,
                      members: []
                    }) %>
                  <div
                    data-stack-card="true"
                    data-stack-id={item.id}
                    data-expanded={
                      if(MapSet.member?(@expanded_stacks, item.id), do: "true", else: "false")
                    }
                    class="flex flex-col rounded-box border-l-4 border-violet-500 border border-base-300 bg-base-100"
                  >
                    <%!-- T8 stage 1: header opens the stack detail
                         panel. Chevron is split into its own sibling
                         button so the inline-expansion toggle remains
                         reachable without bubbling through the panel
                         opener (Discord "click thread to enter" pattern,
                         Option A in the T8 dispatch). --%>
                    <div class="relative flex min-w-0 items-stretch">
                      <button
                        type="button"
                        phx-click="open_stack_detail"
                        phx-value-id={item.id}
                        data-role="stack-header"
                        class="flex min-w-0 flex-1 flex-col gap-1.5 p-3 text-left transition-colors hover:bg-base-200/60 focus-visible-ring min-h-[44px]"
                      >
                        <div class="flex min-w-0 items-center gap-2 pr-7">
                          <span
                            class="hero-rectangle-stack size-4 shrink-0 text-violet-300"
                            aria-hidden="true"
                          >
                          </span>
                          <span class="text-[9px] font-semibold uppercase tracking-wider text-violet-300 shrink-0">
                            Stack
                          </span>
                          <span class="ml-auto text-[10px] text-base-content/50 font-medium whitespace-nowrap shrink-0">
                            {board_data.ready_count}/{board_data.member_count} ready
                          </span>
                        </div>
                        <h3 class="text-sm font-medium leading-snug truncate min-w-0">
                          {item.name}
                        </h3>
                        <% mobile_stack_sponsor = sponsor_identity(item, @users_by_id) %>
                        <div class="flex min-w-0 items-center gap-1.5 text-[10px] text-base-content/60">
                          <span class="bg-base-200 px-1.5 py-0.5 rounded whitespace-nowrap shrink-0">
                            {board_data.member_count} tasks
                          </span>
                          <span class="bg-base-200 px-1.5 py-0.5 rounded whitespace-nowrap shrink-0">
                            {board_data.dep_edge_count} dep edges
                          </span>
                          <%!-- Stage 4 of task 019f487e (ADR-0042 Decision 8):
                               sponsor avatar mirrors desktop stack card. Absent
                               sponsor renders nothing. No own-sponsorship ring
                               affordance — Rowan rejected it as always wrong. --%>
                          <.human_avatar
                            :if={mobile_stack_sponsor}
                            name={mobile_stack_sponsor.name}
                            avatar_url={mobile_stack_sponsor.avatar_url}
                            seed={mobile_stack_sponsor.seed}
                            size="xs"
                            class="ml-auto size-4 shrink-0"
                            title={"Sponsored by " <> mobile_stack_sponsor.name}
                            data-role="stack-sponsor-avatar"
                          />
                        </div>
                      </button>
                      <button
                        type="button"
                        phx-click="toggle_stack_expand"
                        phx-value-id={item.id}
                        data-role="stack-chevron"
                        aria-label="Toggle stack expansion"
                        aria-expanded={
                          if(MapSet.member?(@expanded_stacks, item.id), do: "true", else: "false")
                        }
                        class="absolute right-0 top-0 flex h-11 w-9 items-center justify-center text-violet-300 transition-colors hover:bg-base-200/60 focus-visible-ring"
                      >
                        <span
                          class={[
                            "hero-chevron-down size-3 transition-transform",
                            MapSet.member?(@expanded_stacks, item.id) && "rotate-180"
                          ]}
                          aria-hidden="true"
                        >
                        </span>
                      </button>
                    </div>
                    <div
                      :if={MapSet.member?(@expanded_stacks, item.id)}
                      data-role="stack-members"
                      data-stack-id={item.id}
                      class="flex flex-col gap-1.5 px-3 pb-3 pl-4"
                    >
                      <%= for member <- Enum.sort_by(board_data.members, & &1.stack_position) do %>
                        <% {member_status_label, member_status_class} =
                          task_display_status(member) %>
                        <% member_dep_text = dep_annotation_text(member, board_data.members) %>
                        <%!-- Badges-for-tasks-that-need-feedback (task
                             019e2c25 stage 4): mobile stack-member rows
                             mirror the desktop stack-detail badge from
                             stage 2 / mobile solo card from stage 3.
                             Reuses `@review_counts` (the board-wide
                             review_request count map populated in
                             refresh_board/1, which already covers stack
                             members because list_all_tasks/1 returns
                             them) — same source as the mobile solo card.
                             `:plans` is preloaded on members via
                             list_stacks_with_members/1 so the
                             `:plan_pending_review` branch resolves. --%>
                        <% member_review_count = Map.get(@review_counts, member.id, 0) %>
                        <% member_action_reason =
                          Tasks.needs_human_action_reason(member, member_review_count) %>
                        <%!-- Post-rejection fix (stage 4): use
                             `mobile_action_label/1` instead of
                             `stack_member_action_label/1` so the
                             `:plan_pending_review` branch does NOT
                             render an action chip — the adjacent
                             `task_display_status/1` "Plan Ready" status
                             chip is the single signal. Other reasons
                             still render the action chip. --%>
                        <% {member_action_label, member_action_reason_attr} =
                          mobile_stack_member_action_label(member_action_reason) %>
                        <button
                          type="button"
                          id={"stack-member-mobile-#{member.id}"}
                          data-stack-member="true"
                          data-member-id={member.id}
                          data-stack-position={member.stack_position}
                          phx-click="select_task"
                          phx-value-id={member.id}
                          class="relative rounded border border-base-200/60 bg-base-100 py-3 pl-8 pr-2 text-left transition-colors hover:bg-base-200/60 min-h-[44px]"
                        >
                          <span class={[
                            "absolute left-1 top-3 inline-flex size-5 items-center justify-center rounded-full text-[10px] font-semibold",
                            member_node_class(member.status)
                          ]}>
                            {stack_position_glyph(member.stack_position)}
                          </span>
                          <div class="flex min-w-0 flex-wrap items-center gap-2">
                            <span class="flex-1 min-w-0 text-xs leading-snug truncate">
                              {member.title}
                            </span>
                            <span
                              :if={member_action_label}
                              class="badge badge-warning badge-xs gap-1 whitespace-nowrap shrink-0"
                              data-role="stack-member-mobile-action"
                              data-action-reason={member_action_reason_attr}
                            >
                              <span class="hero-eye size-3"></span>
                              {member_action_label}
                            </span>
                            <%!-- ADR-0046 member 8 (019f9b29-9c47) stage 3, mobile half.
                                 Same compact marker as the desktop member row; the
                                 `data-role` MUST differ because the two boards share
                                 ONE DOM (`lg:hidden` / `hidden lg:grid` — CSS
                                 visibility, not presence), so a shared value
                                 double-matches every selector. The component emits no
                                 `id` at all, so `data-role` is the only thing to
                                 split.
                                 It renders as a `<span>`, never a `<button>`: this
                                 row IS a `<button>` on mobile, and a nested button is
                                 invalid HTML that browsers reparent. --%>
                            <.planning_step_extension
                              task={member}
                              variant={:compact}
                              data_role="mobile-stack-member-planning-step"
                            />
                            <span class={"#{member_status_class} badge-xs whitespace-nowrap shrink-0"}>
                              {member_status_label}
                            </span>
                          </div>
                          <div
                            :if={member_dep_text}
                            data-role="dep-annotation"
                            class="mt-1 text-[10px] text-base-content/50"
                          >
                            <span class="text-violet-400" aria-hidden="true">↑</span>
                            {member_dep_text}
                          </div>
                        </button>
                      <% end %>
                    </div>
                  </div>
                <% _ -> %>
                  <% task = item %>
                  <% assignee = assignee_identity(task, @users_by_id, @agents_by_id) %>
                  <% mobile_review_count = Map.get(@review_counts, task.id, 0) %>
                  <% mobile_action_reason =
                    Tasks.needs_human_action_reason(task, mobile_review_count) %>
                  <%!-- Post-rejection fix (stage 4): same doubled-chip
                       pattern as the mobile stack-member row above —
                       the `task_display_status/1` "Plan Ready" badge
                       below already covers `:plan_pending_review`, so
                       suppress the action chip there. --%>
                  <% {mobile_action_label, mobile_action_reason_attr} =
                    mobile_stack_member_action_label(mobile_action_reason) %>
                  <% {mobile_status_label, mobile_status_class} = task_display_status(task) %>
                  <%!-- ADR-0046 member 8 (019f9b29-9c47) stage 2, mobile half.
                       Same wrapper shape as the desktop card. The `data-role`
                       values MUST differ from the desktop ones: `frontend/ui-ux.md`
                       records that the two boards share ONE DOM (`lg:hidden` /
                       `hidden lg:grid` — CSS visibility, not presence), so a shared
                       value double-matches every selector. The component emits no
                       `id` at all, so only `data-role` needs splitting.
                       The extension is a SIBLING of the card here too, which is what
                       keeps it out of the mobile card's own `<button>` — a `<button>`
                       inside a `<button>` is invalid HTML and browsers reparent it. --%>
                  <div class="flex flex-col" data-role="mobile-task-card-group">
                    <.planning_step_extension
                      task={task}
                      data_role="mobile-planning-step-extension"
                      class="min-h-[44px]"
                    />
                    <button
                      type="button"
                      phx-click="select_task"
                      phx-value-id={task.id}
                      class={[
                        "flex flex-col gap-1.5 rounded-box border border-base-300 bg-base-100 p-3 text-left transition-colors hover:bg-base-200/60 focus-visible-ring",
                        PlanningStepExtension.visible?(task) && "rounded-t-none"
                      ]}
                      data-task-id={task.id}
                    >
                      <div class="flex items-start gap-2">
                        <span
                          class={[
                            "mt-1.5 size-2 shrink-0 rounded-full",
                            status_dot_class(col_key)
                          ]}
                          aria-hidden="true"
                        >
                        </span>
                        <span class="text-sm font-medium leading-snug flex-1">{task.title}</span>
                        <span
                          :if={has_active_run?(task)}
                          class="mt-1.5 inline-block size-2 shrink-0 rounded-full bg-success animate-pulse"
                          title="Active run"
                        >
                        </span>
                      </div>
                      <div class="flex flex-wrap items-center gap-1.5 pl-4 text-xs text-base-content/60">
                        <%= if assignee do %>
                          <%= if assignee.type == :user do %>
                            <.human_avatar
                              name={assignee.name}
                              avatar_url={assignee.avatar_url}
                              seed={assignee.seed}
                              size="xs"
                              class="size-4 shrink-0"
                            />
                          <% else %>
                            <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-accent/15 text-[9px] font-bold text-accent">
                              {agent_initials(assignee.name)}
                            </span>
                          <% end %>
                          <span class="truncate">{assignee.name}</span>
                          <span aria-hidden="true">·</span>
                        <% end %>
                        <%!-- Sponsor chip (ADR 0042 stage 1). Only renders when
                           `sponsor_user_id` is set — an absent sponsor is
                           silent, not a noisy "Unsponsored" pill. No own-
                           sponsorship ring affordance — Rowan rejected it as
                           always wrong (stage 4 rework). --%>
                        <% sponsor = sponsor_identity(task, @users_by_id) %>
                        <%= if sponsor do %>
                          <.human_avatar
                            name={sponsor.name}
                            avatar_url={sponsor.avatar_url}
                            seed={sponsor.seed}
                            size="xs"
                            class="size-4 shrink-0"
                            title={"Sponsored by " <> sponsor.name}
                            data-role="sponsor-avatar"
                          />
                          <span class="truncate">{sponsor.name}</span>
                          <span aria-hidden="true">·</span>
                        <% end %>
                        <span :if={task.inserted_at} class="whitespace-nowrap">
                          {relative_time(task.inserted_at)}
                        </span>
                        <%!-- Badges-for-tasks-that-need-feedback (task
                           019e2c25 stage 3): mobile solo task cards now
                           render the same warning chip the stack-detail
                           rows + desktop kanban surface. The status badge
                           `task_display_status/1` is also rendered for the
                           four "interesting" statuses so "Plan Ready"
                           appears on mobile (previously hidden — that's
                           why a pending-review plan was invisible on the
                           mobile board). Mirrors the desktop kanban
                           gating in tasks_live.html.heex line ~717-723. --%>
                        <span
                          :if={task.status in ~w(blocked planning in_review deploying)}
                          class={"#{mobile_status_class} badge-xs"}
                        >
                          {mobile_status_label}
                        </span>
                        <span
                          :if={mobile_action_label}
                          class="badge badge-warning badge-xs gap-1"
                          data-role="mobile-task-action"
                          data-action-reason={mobile_action_reason_attr}
                        >
                          <span class="hero-eye size-3"></span>
                          {mobile_action_label}
                        </span>
                      </div>
                    </button>
                  </div>
              <% end %>
            <% end %>
          </div>
        </div>

        <%!-- With a search active, "no matching tasks" is the accurate
             message — "tap + to create one" would mislead. --%>
        <.empty_state
          :if={search_active?(@task_search_query) && empty_board?(@board_items)}
          variant={:minimal}
        >
          <:body>No matching tasks for "{@task_search_query}".</:body>
        </.empty_state>

        <.empty_state
          :if={!search_active?(@task_search_query) && empty_board?(@board_items)}
          variant={:minimal}
        >
          <:body>No tasks yet — tap the + button to create one.</:body>
        </.empty_state>

        <.empty_state
          :if={
            !empty_board?(@board_items) &&
              Map.get(@board_items, @active_status_filter, []) == []
          }
          variant={:minimal}
        >
          <:body>
            No tasks in {active_status_label(@active_status_filter, @mobile_columns)}.
          </:body>
        </.empty_state>
      </div>
    </div>

    <%!-- Kanban board (desktop, Stage 2 of Tasks v2 — 2026-05-19).
         7 columns: Backlog / Planning / In Progress / Blocked /
         In Review / Deploying / Done. Hidden below `lg` (1024px) — the
         pill-filtered mobile list above covers tablet + phone since 7
         columns don't fit comfortably under 1280px. At lg-1024 the
         board overflows horizontally; the user scrolls inside the
         board container.

         Items per column come from `desktop_column_items/3` which
         merges `@columns` (task-only, atom-keyed from
         `Platform.Tasks.list_by_status/1`) with
         `@desktop_stacks_by_column` (stack-only, string-keyed),
         interleaved by `updated_at` desc per ADR 0041.

         Stage 3 (2026-05-19): `desktop_column_items_for_scope/4`
         wraps `desktop_column_items/3` with the active scope-rail
         selection — `:all` and `:fabrikam` are passthrough today; the
         other four scopes render empty until `tasks.org_id` lands. --%>
    <%!-- Stage-2 of task 019f3f22 (ADR-0042 sponsor visibility):
         board-level custom empty state — shown ONLY when the
         "Sponsored by me" filter is active AND every kanban column
         resolves to zero items. Replaces the per-column generic
         "No tasks" empty states so the user sees a single, direct
         message ("You're not sponsoring any tasks currently") instead
         of seven small "No tasks" chips. The kanban board container
         below (`#kanban-board`) remains in the DOM either way so the
         `KanbanDragDrop` hook stays mounted — we render either the
         empty state OR the column list inside it. --%>
    <div
      id="kanban-board"
      phx-hook="KanbanDragDrop"
      class="hidden lg:flex flex-1 gap-3 overflow-x-auto p-4"
    >
      <%!-- Search banner outranks the sponsor one: with a query active,
           "no matching tasks" is the accurate explanation for the empty
           board even if the sponsor filter is also on. --%>
      <div
        :if={
          search_active?(@task_search_query) and
            board_columns_empty?(
              @kanban_columns,
              @columns,
              @desktop_stacks_by_column,
              @scope_filter
            )
        }
        data-role="search-empty-state"
        class="flex flex-1 items-center justify-center py-16"
      >
        <.empty_state variant={:minimal}>
          <:body>No matching tasks for "{@task_search_query}".</:body>
        </.empty_state>
      </div>
      <div
        :if={
          @sponsor_filter == :mine and not search_active?(@task_search_query) and
            board_columns_empty?(
              @kanban_columns,
              @columns,
              @desktop_stacks_by_column,
              @scope_filter
            )
        }
        data-role="sponsor-filter-empty-state"
        class="flex flex-1 items-center justify-center py-16"
      >
        <.empty_state variant={:minimal}>
          <:body>You're not sponsoring any tasks or stacks currently.</:body>
        </.empty_state>
      </div>
      <div
        :for={{col_key, col_label} <- @kanban_columns}
        :if={
          not ((@sponsor_filter == :mine or search_active?(@task_search_query)) and
                 board_columns_empty?(
                   @kanban_columns,
                   @columns,
                   @desktop_stacks_by_column,
                   @scope_filter
                 ))
        }
        id={"column-#{col_key}"}
        data-column={col_key}
        class="flex w-56 min-w-[14rem] flex-shrink-0 flex-col rounded-box bg-base-200/50 transition-all duration-150"
      >
        <%!-- Column header --%>
        <div class="flex items-center justify-between px-3 py-2">
          <h2 class={"text-xs font-semibold uppercase tracking-wider #{column_header_class(col_key)}"}>
            {col_label}
          </h2>
          <span class="badge badge-ghost badge-xs">
            {length(
              desktop_column_items_for_scope(
                @columns,
                @desktop_stacks_by_column,
                col_key,
                @scope_filter
              )
            )}
          </span>
        </div>

        <%!-- Board items (task cards + collapsed stack cards).
             Pattern-match on `item.__struct__`: %Platform.Tasks.Stack{}
             renders the new collapsed stack card; %Platform.Tasks.Task{}
             keeps the existing task card rendering. Stacks are NOT
             draggable (stack-level reordering is out of scope for T7) —
             only tasks carry `draggable="true"` and the KanbanDragDrop
             hook's drag handlers. --%>
        <div class="flex flex-1 flex-col gap-2 overflow-y-auto px-2 pb-2">
          <%= for item <- desktop_column_items_for_scope(@columns, @desktop_stacks_by_column, col_key, @scope_filter) do %>
            <%= case item.__struct__ do %>
              <% Platform.Tasks.Stack -> %>
                <% board_data =
                  Map.get(@stack_board_data, item.id, %{
                    member_count: 0,
                    dep_edge_count: 0,
                    ready_count: 0
                  }) %>
                <%!-- Collapsed stack card. Purple violet-500 left border
                     accent matches mock canvas 019e1a16 rev 2
                     (`--stk: #7b5cff`). Clicking the HEADER toggles
                     `:expanded_stacks` MapSet membership; the
                     expansion render is a sibling block so member
                     clicks do NOT bubble back into the toggle handler
                     (stage 3 §5). --%>
                <div
                  id={"stack-card-#{item.id}"}
                  data-stack-card="true"
                  data-stack-id={item.id}
                  data-expanded={
                    if(MapSet.member?(@expanded_stacks, item.id), do: "true", else: "false")
                  }
                  class="group card card-compact border-l-4 border-violet-500 border border-base-300 bg-base-100 shadow-sm transition-all hover:shadow-md"
                >
                  <%!-- T8 stage 1: header opens the stack detail panel.
                       Chevron is split into its own SIBLING button so
                       the inline-expansion toggle remains reachable
                       without bubbling through the panel opener
                       (Discord "click thread to enter" pattern, Option A
                       in the T8 dispatch).

                       The separation is structural, not defensive: the
                       chevron and `[data-role=stack-header]` are both
                       direct children of the `div.relative` below, so a
                       chevron click never traverses the header at all.
                       No ancestor of the chevron carries a phx-click or
                       any JS click/pointer listener (KanbanDragDrop
                       binds drag events only; nothing in assets/js
                       references stack-card / stack-header /
                       stack-chevron).

                       Do NOT "protect" the chevron with an inline
                       `onclick="event.stopPropagation()"`. There is
                       nothing to protect it from, and the two cannot
                       coexist: LiveView binds its click handler in the
                       BUBBLE phase on `window` (live_socket.js
                       bindClick/2), so an inline onclick — which runs at
                       TARGET phase — stops the event before LiveView
                       ever sees it and silently kills this phx-click.
                       That is exactly what shipped here and went
                       unnoticed for two months (task 019fa298); the
                       mobile chevron, which never had one, kept working.
                       Guarded by test/platform_web/inline_onclick_guard_test.exs. --%>
                  <div class="relative">
                    <div
                      class="card-body cursor-pointer gap-1.5 p-3 pr-9"
                      phx-click="open_stack_detail"
                      phx-value-id={item.id}
                      data-role="stack-header"
                    >
                      <%!-- Header row: icon + STACK tag + rollup progress --%>
                      <div class="flex min-w-0 items-center gap-1.5">
                        <span
                          class="hero-rectangle-stack size-4 shrink-0 text-violet-300"
                          aria-hidden="true"
                        >
                        </span>
                        <span class="text-[9px] font-semibold uppercase tracking-wider text-violet-300 shrink-0">
                          Stack
                        </span>
                        <span class="ml-auto text-[10px] text-base-content/50 font-medium whitespace-nowrap shrink-0">
                          {board_data.ready_count}/{board_data.member_count} ready
                        </span>
                      </div>

                      <%!-- Title row --%>
                      <h3 class="text-sm font-medium leading-snug truncate min-w-0">
                        {item.name}
                      </h3>

                      <%!-- Pills row: member count + dep edge count + optional
                           sponsor avatar (Stage 4 of task 019f487e —
                           ADR-0042 Decision 8). Mirrors the task-card
                           sponsor chip: absent sponsor renders nothing.
                           No own-sponsorship ring affordance — Rowan
                           rejected it as always wrong (stage 4 rework). --%>
                      <% stack_sponsor = sponsor_identity(item, @users_by_id) %>
                      <div class="flex min-w-0 items-center gap-1.5 text-[10px] text-base-content/60">
                        <span class="bg-base-200 px-1.5 py-0.5 rounded font-medium whitespace-nowrap shrink-0">
                          {board_data.member_count} tasks
                        </span>
                        <span class="bg-base-200 px-1.5 py-0.5 rounded font-medium whitespace-nowrap shrink-0">
                          {board_data.dep_edge_count} dep edges
                        </span>
                        <.human_avatar
                          :if={stack_sponsor}
                          name={stack_sponsor.name}
                          avatar_url={stack_sponsor.avatar_url}
                          seed={stack_sponsor.seed}
                          size="xs"
                          class="ml-auto size-4 shrink-0"
                          title={"Sponsored by " <> stack_sponsor.name}
                          data-role="stack-sponsor-avatar"
                        />
                      </div>
                    </div>
                    <button
                      type="button"
                      phx-click="toggle_stack_expand"
                      phx-value-id={item.id}
                      data-role="stack-chevron"
                      aria-label="Toggle stack expansion"
                      aria-expanded={
                        if(MapSet.member?(@expanded_stacks, item.id), do: "true", else: "false")
                      }
                      class="absolute right-1 top-2 flex h-9 w-7 items-center justify-center text-violet-300 hover:bg-base-200 rounded transition-colors focus-visible-ring"
                    >
                      <span
                        class={[
                          "hero-chevron-down size-3 transition-transform",
                          MapSet.member?(@expanded_stacks, item.id) && "rotate-180"
                        ]}
                        aria-hidden="true"
                      >
                      </span>
                    </button>
                  </div>

                  <%!-- Inline expansion — members rendered indented
                       below the header when this stack id is in
                       `:expanded_stacks`. Each row is its own
                       `phx-click="select_task"` target reusing the
                       task detail-panel handler (T8 will later add a
                       stack-level detail panel for header clicks). --%>
                  <div
                    :if={MapSet.member?(@expanded_stacks, item.id)}
                    data-role="stack-members"
                    data-stack-id={item.id}
                    class="flex flex-col gap-1.5 px-3 pb-3 pl-4"
                  >
                    <%= for member <- Enum.sort_by(board_data.members, & &1.stack_position) do %>
                      <% {status_label, status_class} = task_display_status(member) %>
                      <% dep_text =
                        dep_annotation_text(member, board_data.members) %>
                      <div
                        id={"stack-member-#{member.id}"}
                        data-stack-member="true"
                        data-member-id={member.id}
                        data-stack-position={member.stack_position}
                        phx-click="select_task"
                        phx-value-id={member.id}
                        class="relative cursor-pointer rounded border border-base-200/60 bg-base-100 py-2 pl-8 pr-2 transition-colors hover:bg-base-200/60 min-h-[44px]"
                      >
                        <span class={[
                          "absolute left-1 top-2 inline-flex size-5 items-center justify-center rounded-full text-[10px] font-semibold",
                          member_node_class(member.status)
                        ]}>
                          {stack_position_glyph(member.stack_position)}
                        </span>
                        <div class="flex min-w-0 items-center gap-2">
                          <span class="flex-1 min-w-0 text-xs leading-snug truncate">
                            {member.title}
                          </span>
                          <%!-- ADR-0046 member 8 (019f9b29-9c47) stage 3, desktop half.
                               COMPACT, not the fused strip: this row is a ~44px line
                               already carrying a position glyph, a truncated title, a
                               status badge and a dependency annotation, so the marker
                               is a single icon INSIDE the badge cluster rather than a
                               band above the row (a band would overlap the absolutely
                               positioned glyph at `left-1 top-2`).
                               `variant={:compact}` is failure-only — `failed` and
                               member 7's `no_ui_surface_contradicted`. `complete` and
                               the active cursor are suppressed here and remain on the
                               member's own detail panel; a fifth chip on every row of
                               every expanded stack is the noise that gets a feature
                               turned off.
                               The component's compact root is `shrink-0`, so under
                               `frontend/ui-ux.md`'s truncation rule the TITLE
                               (`flex-1 min-w-0 truncate`) is what yields, never the
                               marker. --%>
                          <.planning_step_extension
                            task={member}
                            variant={:compact}
                            data_role="stack-member-planning-step"
                          />
                          <span class={"#{status_class} badge-xs whitespace-nowrap shrink-0"}>
                            {status_label}
                          </span>
                        </div>
                        <div
                          :if={dep_text}
                          data-role="dep-annotation"
                          class="mt-1 text-[10px] text-base-content/50"
                        >
                          <span class="text-violet-400" aria-hidden="true">↑</span> {dep_text}
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% _ -> %>
                <% task = item %>
                <%!-- ADR-0046 member 8 (019f9b29-9c47) stage 2: the planning-step
                     extension is a SIBLING of the card inside a zero-gap
                     `flex flex-col` wrapper, not a child of it. Two reasons, both
                     load-bearing:
                     1. The column container is `flex flex-1 flex-col gap-2`, so an
                        unwrapped sibling would sit 0.5rem above the card and read as
                        a separate object. The wrapper makes that gap structurally
                        zero without a `-mb-2` magic number coupled to the column's
                        spacing token.
                     2. The wrapper carries NO `data-task-id`. `kanban_drag_drop.js`
                        resolves the drag source with `e.target.closest("[data-task-id]")`;
                        the card keeps the attribute and stays the drag source, and a
                        drag begun on the extension resolves to `null` so the hook
                        no-ops. Putting `data-task-id` here would fade the wrong
                        element on drag.
                     `rounded-t-none` is conditional on `visible?/1` so a task with
                     nothing to show renders a byte-identical card to before. --%>
                <div class="flex flex-col" data-role="task-card-group">
                  <.planning_step_extension task={task} data_role="planning-step-extension" />
                  <div
                    id={"task-card-#{task.id}"}
                    data-task-id={task.id}
                    draggable="true"
                    class={[
                      "group card card-compact cursor-grab border border-base-300 bg-base-100 shadow-sm transition-all hover:shadow-md active:cursor-grabbing",
                      PlanningStepExtension.visible?(task) && "rounded-t-none"
                    ]}
                    phx-click="select_task"
                    phx-value-id={task.id}
                  >
                    <div class="card-body gap-1 p-3">
                      <%!-- Project name --%>
                      <p
                        :if={task.project}
                        class="text-[10px] font-medium uppercase tracking-wider text-base-content/40"
                      >
                        {task.project.name}
                      </p>

                      <%!-- Title row --%>
                      <%!--
                v2 stage 3: kanban-card title is plain text. Clicking it
                bubbles to the card's outer `phx-click="select_task"` and
                opens the detail panel, where the title can be edited via
                the explicit edit-mode toggle.
              --%>
                      <div class="flex items-start justify-between gap-2">
                        <h3
                          id={"card-title-#{task.id}"}
                          class="text-sm font-medium leading-snug flex-1"
                          data-role="card-title"
                        >
                          {task.title}
                        </h3>
                        <div class="flex items-center gap-1 flex-shrink-0">
                          <%!-- Active run indicator --%>
                          <span
                            :if={has_active_run?(task)}
                            class="inline-block size-2 rounded-full bg-success animate-pulse"
                            title="Active run"
                          />
                          <%!-- Assignee --%>
                          <% assignee = assignee_identity(task, @users_by_id, @agents_by_id) %>
                          <%= if assignee do %>
                            <%= if assignee.type == :user do %>
                              <.human_avatar
                                name={assignee.name}
                                avatar_url={assignee.avatar_url}
                                seed={assignee.seed}
                                size="xs"
                                class="shrink-0"
                                title={assignee.name}
                              />
                            <% else %>
                              <span
                                class="flex size-5 items-center justify-center rounded-full bg-accent/15 text-[10px] font-bold text-accent ring-1 ring-accent/20"
                                title={assignee.name}
                                data-avatar-kind="agent"
                              >
                                {agent_initials(assignee.name)}
                              </span>
                            <% end %>
                          <% end %>
                          <%!-- Sponsor chip (ADR 0042 stage 1). Absent sponsor
                             renders nothing. No own-sponsorship ring
                             affordance — Rowan rejected it as always wrong
                             (stage 4 rework). Mirrors the mobile chip shape. --%>
                          <% sponsor = sponsor_identity(task, @users_by_id) %>
                          <.human_avatar
                            :if={sponsor}
                            name={sponsor.name}
                            avatar_url={sponsor.avatar_url}
                            seed={sponsor.seed}
                            size="xs"
                            class="shrink-0"
                            title={"Sponsored by " <> sponsor.name}
                            data-role="sponsor-avatar"
                          />
                          <%!-- Three-dot menu — opens a bottom sheet on mobile + a centered
                       sheet on desktop. Replaced the inert DaisyUI dropdown
                       (task 019e0d4b stage 2). The icon stays opacity-0 / hover-
                       reveal on desktop; on mobile it's always visible since
                       there's no hover signal.  --%>
                          <button
                            :if={deletable_task?(task)}
                            type="button"
                            phx-click="open_task_actions"
                            phx-value-id={task.id}
                            aria-label="Task actions"
                            title="Task actions"
                            class="btn btn-ghost btn-xs btn-square opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity"
                          >
                            <span class="hero-ellipsis-vertical size-4"></span>
                          </button>
                        </div>
                      </div>

                      <%!-- Author + assignee + date --%>
                      <div
                        :if={
                          task.reported_by || assignee_name(task, @agent_names) ||
                            task.inserted_at
                        }
                        class="mt-1 flex items-center gap-1.5 text-[10px] text-base-content/40"
                      >
                        <span
                          :if={task.reported_by}
                          class="truncate max-w-[100px]"
                          title={"Reported by " <> (task.reported_by || "")}
                        >
                          {task.reported_by}
                        </span>
                        <span :if={
                          task.reported_by &&
                            (assignee_name(task, @agent_names) || task.inserted_at)
                        }>
                          ·
                        </span>
                        <span
                          :if={assignee_name(task, @agent_names)}
                          class="truncate max-w-[100px]"
                        >
                          → {assignee_name(task, @agent_names)}
                        </span>
                        <span :if={assignee_name(task, @agent_names) && task.inserted_at}>·</span>
                        <span :if={task.inserted_at} class="whitespace-nowrap">
                          {relative_time(task.inserted_at)}
                        </span>
                      </div>

                      <%!-- Bottom row: priority + progress --%>
                      <div class="mt-1 flex items-center gap-2">
                        <span :if={task.priority} class={priority_badge_class(task.priority)}>
                          {task.priority}
                        </span>
                        <% {status_badge_label, status_badge_class} = task_display_status(task) %>
                        <span
                          :if={task.status in ~w(blocked planning in_review deploying)}
                          class={"#{status_badge_class} badge-xs"}
                        >
                          {status_badge_label}
                        </span>

                        <%!-- Blocked-by-deps badge: only when status="blocked" AND
                     metadata["unmet_dependencies"] is non-empty. Count is
                     read straight from metadata (no per-card DB hit). --%>
                        <span
                          :if={task.status == "blocked" and unmet_dependency_count(task) > 0}
                          class="badge badge-error badge-xs"
                          title="Waiting on dependencies"
                        >
                          Blocked · {unmet_dependency_count(task)}
                        </span>

                        <%!-- Review badge --%>
                        <span
                          :if={Map.get(@review_counts, task.id, 0) > 0}
                          class="badge badge-warning badge-xs gap-1"
                        >
                          <span class="hero-eye size-3"></span>
                          {Map.get(@review_counts, task.id)} review
                        </span>

                        <%!-- Meeting-triage `needs_promotion` badge (task
                     019f5e2b-8d29 stage 2, tooltip + icon polished in
                     task 019f6e2c stage 3). Rendered only for backlog
                     tasks flagged by the triage filer; clicking dispatches
                     `promote_task` which clears the flag AND atomically
                     transitions status → planning via `Platform.Tasks.promote/1`.
                     Mirrors the review-badge shape (badge-warning +
                     badge-xs). Backlog-scoped because promotion only
                     makes sense before the task leaves the entry column.
                     Browser-native `title=` tooltip — a Tippy hook per
                     kanban card is overkill for a single-line message. --%>
                        <button
                          :if={task.status == "backlog" and task.needs_promotion}
                          type="button"
                          class="badge badge-warning badge-xs gap-1 cursor-pointer"
                          phx-click="promote_task"
                          phx-value-id={task.id}
                          data-role="needs-promotion-badge"
                          title="Filed from a meeting canvas. Click to promote."
                        >
                          <span class="hero-arrow-up-circle size-3"></span> Needs promotion
                        </button>

                        <%!-- Plan stage progress --%>
                        <% progress = plan_progress(task) %>
                        <div :if={progress} class="flex flex-1 items-center gap-1">
                          <progress
                            class="progress progress-primary h-1 flex-1"
                            value={elem(progress, 0)}
                            max={elem(progress, 1)}
                          />
                          <span class="text-[10px] text-base-content/40">
                            {elem(progress, 0)}/{elem(progress, 1)}
                          </span>
                        </div>
                      </div>

                      <%!-- Per ADR 0029, plan approval is the only start signal.
                   No separate manual "Start" button on the card. The user
                   approves a plan from the detail panel, and the task
                   transitions automatically. --%>
                    </div>
                  </div>
                </div>
            <% end %>
          <% end %>

          <%!-- Per-column empty state. SPEC DEVIATION: spec §5.3 says
               :conversational with chips, but that's per-COLUMN here on a
               kanban with 4-5 columns — N Saru bubbles + chip pairs would
               clutter the board. :minimal keeps the column readable. The
               broader "no tasks anywhere" board-level conversational state
               is a separate concern that doesn't exist on this surface
               (no board-level @all_tasks == [] check); add later if Marlowe
               wants the V3 voice on the kanban-empty case. --%>
          <.empty_state
            :if={
              desktop_column_items_for_scope(
                @columns,
                @desktop_stacks_by_column,
                col_key,
                @scope_filter
              ) == []
            }
            variant={:minimal}
          >
            <:body>No tasks</:body>
          </.empty_state>
        </div>
      </div>
    </div>
  </div>

  <%!-- Task detail panel (slide-in from right). Bottom edge stops at
       the top of the bottom-nav, including iOS home-indicator safe-
       area: `--bottom-nav-height` is the nav's content row (56px on
       phones, 0 on desktop) and the nav adds
       `env(safe-area-inset-bottom)` below itself for the indicator.
       Without that env() addition the panel and nav don't meet on iOS
       — there's a ~34px gap where the panel ends above the nav's
       safe-area. Replaces PR #331's inner-scroller `pb-[calc(...)]`,
       which left visible dead space below content. --%>
  <div
    :if={@show_detail && @selected_task}
    class="fixed top-0 bottom-[calc(env(safe-area-inset-bottom)+var(--bottom-nav-height,0px))] right-0 z-30 flex w-full max-w-lg flex-col border-l border-base-300 bg-base-100 shadow-xl safe-area-top"
  >
    <div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
      <%= cond do %>
        <% @edit_mode and @editing_task_title_id == @selected_task.id -> %>
          <input
            type="text"
            name="value"
            value={@selected_task.title}
            phx-blur="update_task_title"
            phx-value-task-id={@selected_task.id}
            phx-hook="InlineEdit"
            data-submit-event="update_task_title"
            data-task-id={@selected_task.id}
            data-role="detail-title-input"
            class="input input-sm input-bordered text-sm font-semibold flex-1 mr-2"
            id={"detail-title-input-#{@selected_task.id}"}
          />
        <% @edit_mode -> %>
          <h2
            id={"detail-title-#{@selected_task.id}"}
            class="text-sm font-semibold truncate cursor-text rounded px-1 -mx-1 flex-1 border border-dashed border-base-300 hover:border-base-content/40 hover:bg-base-200"
            phx-click="start_edit_title"
            phx-value-task-id={@selected_task.id}
            data-role="detail-title"
            data-editable="true"
            title="Click to edit"
          >
            {@selected_task.title}
          </h2>
        <% true -> %>
          <h2
            id={"detail-title-#{@selected_task.id}"}
            class="text-sm font-semibold truncate flex-1"
            data-role="detail-title"
            data-editable="false"
          >
            {@selected_task.title}
          </h2>
      <% end %>
      <div class="flex items-center gap-1">
        <span
          :if={@edit_mode}
          class="badge badge-sm badge-primary badge-outline"
          data-role="edit-mode-indicator"
        >
          Edit mode
        </span>
        <button
          class={[
            "btn btn-sm btn-square max-sm:h-11 max-sm:w-11 max-sm:min-h-[44px] max-sm:min-w-[44px]",
            if(@edit_mode, do: "btn-primary", else: "btn-ghost")
          ]}
          phx-click="toggle_edit_mode"
          title="Toggle edit mode"
          aria-label="Toggle edit mode"
          data-role="edit-mode-toggle"
          data-edit-mode={to_string(@edit_mode)}
          aria-pressed={to_string(@edit_mode)}
        >
          <span class="hero-pencil-square size-4"></span>
        </button>
        <button
          :if={deletable_task?(@selected_task)}
          class="btn btn-sm btn-ghost btn-square text-error max-sm:h-11 max-sm:w-11 max-sm:min-h-[44px] max-sm:min-w-[44px]"
          phx-click="request_delete_task"
          title="Delete task"
          aria-label="Delete task"
        >
          <span class="hero-trash size-4"></span>
        </button>
        <%!-- Pin-to-Chat toggle (task 019f62a1 stage 4). Sponsor-only via
             DOM `:if` — the server-side re-check inside `toggle_task_chat_pin`
             is the real gate; the `:if` just keeps non-sponsors from seeing
             a non-functional button. Rendered for every status (including
             `backlog`) so a fresh task can be promoted into the rail before
             the plan engine ever creates its execution space. The pin write
             lazily materialises `chat_spaces` via `ExecutionSpace.find_or_create/1`.
             Icon `hero-map-pin(-solid)` — deliberately NOT `hero-bookmark`,
             which is already the message-level pin glyph. --%>
        <button
          :if={sponsor?(@selected_task, @current_user_id)}
          class={[
            "btn btn-sm btn-square max-sm:h-11 max-sm:w-11 max-sm:min-h-[44px] max-sm:min-w-[44px]",
            if(pinned_by_me?(@selected_task, @current_user_id, @my_pinned_task_ids),
              do: "btn-primary",
              else: "btn-ghost"
            )
          ]}
          phx-click="toggle_task_chat_pin"
          data-role="task-chat-pin-toggle"
          aria-pressed={
            to_string(pinned_by_me?(@selected_task, @current_user_id, @my_pinned_task_ids))
          }
          aria-label={
            if pinned_by_me?(@selected_task, @current_user_id, @my_pinned_task_ids),
              do: "Unpin task from Chat",
              else: "Pin task to Chat"
          }
          title={
            if pinned_by_me?(@selected_task, @current_user_id, @my_pinned_task_ids),
              do: "Unpin from Chat",
              else: "Pin to Chat"
          }
        >
          <span class={[
            if(pinned_by_me?(@selected_task, @current_user_id, @my_pinned_task_ids),
              do: "hero-map-pin-solid",
              else: "hero-map-pin"
            ),
            "size-4"
          ]}>
          </span>
        </button>
        <button
          class="btn btn-sm btn-ghost btn-square max-sm:h-11 max-sm:w-11 max-sm:min-h-[44px] max-sm:min-w-[44px]"
          phx-click="close_detail"
          aria-label="Close task details"
        >
          <span class="hero-x-mark size-4"></span>
        </button>
      </div>
    </div>

    <%!-- Inner scroller. The panel container (above) is bounded by
         `--bottom-nav-height`, so the scroll viewport already ends at
         the top of the bottom-tab nav and standard `p-4` padding
         suffices on every viewport. --%>
    <div class="flex-1 overflow-y-auto p-4 space-y-5">
      <%!-- Delete confirmation --%>
      <div
        :if={@confirm_delete}
        class="rounded-box border border-error bg-error/10 p-4 space-y-3"
      >
        <p class="text-sm font-medium text-error">
          Are you sure you want to delete this task?
        </p>
        <div class="flex gap-2">
          <button phx-click="confirm_delete_task" class="btn btn-error btn-sm">
            Yes, Delete
          </button>
          <button phx-click="cancel_delete_task" class="btn btn-ghost btn-sm">
            Cancel
          </button>
        </div>
      </div>

      <%!-- Status + Priority --%>
      <div class="flex flex-wrap items-center gap-2">
        <% {detail_status_label, detail_status_class} = task_display_status(@selected_task) %>
        <span class={detail_status_class}>{detail_status_label}</span>
        <span :if={@selected_task.priority} class={priority_badge_class(@selected_task.priority)}>
          {String.capitalize(@selected_task.priority)}
        </span>
        <span :if={@selected_task.project} class="text-xs text-base-content/50">
          {(@selected_task.project && @selected_task.project.name) || "—"}
        </span>
        <span :if={@selected_task.epic} class="text-xs text-base-content/50">
          / {(@selected_task.epic && @selected_task.epic.name) || "—"}
        </span>
      </div>

      <%!-- Linked-canvases strip (stage 5 of task_attach_canvas).
           Renders chips for canvases attached via the task_attach_canvas
           MCP tool (typically agent-uploaded evidence). Soft-deleted
           canvases stay in the strip with `text-error` styling so the
           user can detach the stale row rather than the chip silently
           disappearing.

           Clickthrough to `/canvases/:id` (task 019e2c4b stage 3) — this
           strip is the route's first in-app consumer and the reason
           agent-attached deliverables became clickable. A plain `href`,
           NOT `navigate`: the standalone page lives in its own
           `:canvas_standalone` live_session precisely so the
           `:enforce_external_scope` HTTP plug re-runs, and an anchor makes
           that full round-trip unconditional instead of leaning on
           LiveView's cross-live_session redirect behaviour.

           Soft-deleted rows (`canvas_present == false`) stay UNLINKED: the
           chip is a detach affordance at that point, not a destination.

           The × button posts `detach_canvas` which calls the context +
           broadcasts :task_updated for sibling sessions. --%>
      <div
        :if={@selected_task_canvases != []}
        class="flex flex-wrap items-center gap-2"
        data-role="linked-canvases-strip"
      >
        <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
          Canvases
        </span>
        <span
          :for={entry <- @selected_task_canvases}
          class="badge badge-outline gap-1"
          data-role="linked-canvas-chip"
          data-canvas-id={entry.canvas_id}
        >
          <.link
            :if={entry.canvas_present}
            href={~p"/canvases/#{entry.canvas_id}"}
            class="hover:underline"
            data-role="linked-canvas-chip-link"
          >
            {entry.title || "(untitled)"}
          </.link>
          <span :if={not entry.canvas_present} class="text-error">
            {entry.title || "(deleted canvas)"}
          </span>
          <button
            type="button"
            phx-click="detach_canvas"
            phx-value-canvas-id={entry.canvas_id}
            class="btn btn-xs btn-ghost btn-circle"
            aria-label="Detach canvas"
          >
            <span class="hero-x-mark size-3"></span>
          </button>
        </span>
      </div>

      <%!-- Priority + deploy_target metadata.
           Off (read-only): plain badges/labels.
           On (edit_mode): <select>s wired to the generic `update_task_field`
           event, wrapped in a dashed border affordance to signal "click to
           edit". Hidden `field`/`task-id` inputs travel with the change
           because `phx-change` only carries form params. --%>
      <% project_targets = project_deploy_targets(@selected_task.project) %>
      <% dropdown_value = deploy_target_dropdown_value(@selected_task) %>
      <div class="grid grid-cols-2 gap-3">
        <%= if @edit_mode do %>
          <form
            phx-change="update_task_field"
            class="flex flex-col gap-1 rounded border border-dashed border-base-300 hover:border-base-content/40 p-1"
            data-role="priority-form"
            data-editable="true"
          >
            <input type="hidden" name="field" value="priority" />
            <input type="hidden" name="task-id" value={@selected_task.id} />
            <label
              for={"priority-select-#{@selected_task.id}"}
              class="text-xs font-semibold uppercase tracking-wider text-base-content/50"
            >
              Priority
            </label>
            <select
              id={"priority-select-#{@selected_task.id}"}
              name="value"
              data-role="priority-select"
              class="select select-sm select-bordered cursor-pointer"
            >
              <option
                :for={p <- Platform.Tasks.Task.priorities()}
                value={p}
                selected={@selected_task.priority == p}
              >
                {String.capitalize(p)}
              </option>
            </select>
          </form>

          <form
            phx-change="update_task_field"
            class="flex flex-col gap-1 rounded border border-dashed border-base-300 hover:border-base-content/40 p-1"
            data-role="deploy-target-form"
            data-editable="true"
          >
            <input type="hidden" name="field" value="deploy_target" />
            <input type="hidden" name="task-id" value={@selected_task.id} />
            <label
              for={"deploy-target-select-#{@selected_task.id}"}
              class="text-xs font-semibold uppercase tracking-wider text-base-content/50"
            >
              Deploy target
            </label>
            <select
              id={"deploy-target-select-#{@selected_task.id}"}
              name="value"
              data-role="deploy-target-select"
              data-selected-value={dropdown_value}
              disabled={project_targets == []}
              class="select select-sm select-bordered cursor-pointer"
            >
              <option
                value=""
                selected={dropdown_value == ""}
                data-role="deploy-target-dropdown-inherit-option"
              >
                {edit_mode_inherit_option_label(@selected_task, project_targets)}
              </option>
              <option
                :for={t <- project_targets}
                value={t}
                selected={dropdown_value == t}
              >
                {deploy_target_label(t)}
              </option>
            </select>
          </form>
        <% else %>
          <div class="flex flex-col gap-1" data-role="priority-readonly" data-editable="false">
            <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
              Priority
            </span>
            <span class={[
              "badge badge-sm",
              if(@selected_task.priority,
                do: priority_badge_class(@selected_task.priority),
                else: "badge-ghost"
              )
            ]}>
              {if @selected_task.priority,
                do: String.capitalize(@selected_task.priority),
                else: "—"}
            </span>
          </div>

          <div
            class="flex flex-col gap-1"
            data-role="deploy-target-readonly"
            data-editable="false"
          >
            <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
              Deploy target
            </span>
            <.deploy_target_display task={@selected_task} />
          </div>
        <% end %>
      </div>

      <%!-- Assignee — no top-level display row. Per ADR 0044 (as amended
           by Rowan on 2026-07-08 stage-3 rejection), the per-phase
           "Assignees" section below is the SINGLE affordance for both
           reading and writing the assignee: it shows the breakdown by
           phase (contextually useful — the current phase is highlighted
           in `text-primary`) and its Configure button opens the
           canonical writer modal. The prior readonly "Current assignee"
           badge duplicated the derived current-phase pointer and has
           been removed. --%>

      <%!-- Sponsor (ADR 0042 stage 4). Nullable human shepherd distinct from
           the technical assignee above. Edit mode: always show the picker so
           a nil sponsor can be filled in. Readonly: hide the row entirely
           when nil to avoid a permanent "No Sponsor" chip cluttering the
           panel. Reuses the same `update_task_field` phx-change flow as
           the assignee dropdown; `sponsor_user_id` is whitelisted in the
           handler and the generic branch normalizes "" → nil for the
           nullable FK. --%>
      <div class="flex flex-col gap-1">
        <%= if @edit_mode do %>
          <form
            phx-change="update_task_field"
            class="flex flex-col gap-1 rounded border border-dashed border-base-300 hover:border-base-content/40 p-1"
            data-role="sponsor-form"
            data-editable="true"
          >
            <input type="hidden" name="field" value="sponsor_user_id" />
            <input type="hidden" name="task-id" value={@selected_task.id} />
            <label
              for={"sponsor-select-#{@selected_task.id}"}
              class="text-xs font-semibold uppercase tracking-wider text-base-content/50"
            >
              Sponsor
            </label>
            <select
              id={"sponsor-select-#{@selected_task.id}"}
              name="value"
              data-role="sponsor-select"
              class="select select-sm select-bordered cursor-pointer"
            >
              <option value="" selected={is_nil(@selected_task.sponsor_user_id)}>
                No Sponsor
              </option>
              <option
                :for={user <- @users}
                value={user.id}
                selected={@selected_task.sponsor_user_id == user.id}
              >
                {user.name || user.email}
              </option>
            </select>
          </form>
        <% else %>
          <div
            :if={@selected_task.sponsor_user_id}
            data-role="sponsor-readonly"
            data-editable="false"
            class="flex flex-col gap-1"
          >
            <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
              Sponsor
            </span>
            <span class="badge badge-sm badge-outline">
              {sponsor_name(@selected_task, @users_by_id)}
            </span>
          </div>
        <% end %>
      </div>

      <%!-- Reporter + Dates + Assignee name --%>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-base-content/50">
        <span :if={@selected_task.reported_by}>
          <span class="text-base-content/40">Reporter:</span> {@selected_task.reported_by}
        </span>
        <span :if={assignee_name(@selected_task, @agent_names)}>
          <span class="text-base-content/40">Assigned:</span> {assignee_name(
            @selected_task,
            @agent_names
          )}
        </span>
        <span :if={@selected_task.inserted_at}>
          <span class="text-base-content/40">Created:</span> {Calendar.strftime(
            @selected_task.inserted_at,
            "%b %d, %Y"
          )}
        </span>
        <span :if={@selected_task.updated_at}>
          <span class="text-base-content/40">Updated:</span> {relative_time(
            @selected_task.updated_at
          )}
        </span>
      </div>

      <%!-- Dependencies — listed in author order, with a status icon per
           row. Hidden entirely when the task has no deps. Resolved via
           a single Repo.all per render (detail panel only). --%>
      <% deps = dependency_summary(@selected_task) %>
      <div :if={deps != []} id="task-dependencies" class="flex flex-col gap-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
          Dependencies
        </span>
        <ul class="flex flex-col gap-1 text-xs">
          <li
            :for={dep <- deps}
            class="flex items-center gap-2 rounded bg-base-200 px-2 py-1"
          >
            <span class={"#{dependency_status_icon(dep.status)} size-4 shrink-0"}></span>
            <span class="truncate flex-1">
              {dep.title || "(missing dependency)"}
            </span>
            <span
              :if={dep.status}
              class="text-[10px] uppercase tracking-wider text-base-content/40"
            >
              {status_label(dep.status)}
            </span>
          </li>
        </ul>
      </div>

      <%!-- Assignees by phase — opens a modal that lets the user wire one
           agent for the whole task (Simple) or different agents per phase
           (Advanced). --%>
      <div :if={@agents != []} class="flex flex-col gap-2">
        <div class="flex items-center justify-between gap-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
            Assignees
          </span>
          <button
            type="button"
            phx-click="open_assignee_modal"
            class="btn btn-xs btn-ghost gap-1"
          >
            <span class="hero-cog-6-tooth size-3"></span> Configure
          </button>
        </div>
        <div class="grid grid-cols-3 gap-1 text-[11px]">
          <div :for={phase <- ~w(planning execution review)} class="rounded bg-base-200 p-1.5">
            <p class="text-[10px] uppercase tracking-wider text-base-content/40">
              {phase_label(phase)}
            </p>
            <p class={[
              "truncate font-medium",
              phase == current_phase_label(@selected_task) && "text-primary"
            ]}>
              {agent_name_for(@agents_by_id, phase_assignee_id(@selected_task, phase)) ||
                "Unassigned"}
            </p>
          </div>
        </div>
      </div>

      <%!-- Per ADR 0029, plan approval is the start signal. The user
           approves a plan from the plan-review panel below; that
           transitions the task to in_progress automatically. No separate
           manual "Start Task" button. --%>

      <%!-- Transition buttons --%>
      <div :if={available_transitions(@selected_task.status) != []} class="flex flex-wrap gap-2">
        <button
          :for={{target_status, label} <- available_transitions(@selected_task.status)}
          class={transition_btn_class(target_status)}
          phx-click="transition_task"
          phx-value-id={@selected_task.id}
          phx-value-status={target_status}
        >
          {label}
        </button>
      </div>

      <%!-- Reopen-with-feedback button (done tasks only).
           Sits adjacent to the transition-buttons block so it reads as a
           top-level task action. Opens a modal that captures a free-form
           reason; Tasks.reopen_with_feedback/3 rejects the active plan and
           moves the task back to `planning`. --%>
      <div :if={@selected_task.status == "done"} class="flex flex-wrap gap-2">
        <button
          type="button"
          phx-click="open_reopen_modal"
          data-role="reopen-task-button"
          class="btn btn-sm btn-warning gap-1"
        >
          <span class="hero-arrow-uturn-left size-4"></span> Reopen with feedback
        </button>
      </div>

      <%!-- Return-to-planning button (in-flight tasks only: in_progress,
           in_review, deploying). Mirrors the reopen block but uses
           btn-error tone because supersede kills any in-flight executor
           work. Opens a confirm modal; Tasks.supersede_current_plan/3
           marks the current plan `superseded` and drops the task back to
           `planning`. Branch and any open PR are left intact. --%>
      <div
        :if={@selected_task.status in ~w(in_progress in_review deploying)}
        class="flex flex-wrap gap-2"
      >
        <button
          type="button"
          phx-click="open_supersede_modal"
          data-role="supersede-plan-button"
          class="btn btn-sm btn-error gap-1"
        >
          <span class="hero-arrow-uturn-left size-4"></span> Return to planning
        </button>
      </div>

      <%!-- Description — click "Edit" to swap the rendered markdown for a
           textarea + Save/Cancel. Toggle, not split-preview, per the
           plan's "cheaper path that's still nice". Edit button is only
           rendered when @edit_mode is true; in read-only mode the
           rendered markdown is the only thing visible. --%>
      <div
        class={[
          "space-y-1",
          @edit_mode &&
            "rounded border border-dashed border-base-300 hover:border-base-content/40 p-1"
        ]}
        data-role="description-block"
        data-editable={to_string(@edit_mode)}
      >
        <div class="flex items-center justify-between gap-2">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
            Description
          </h3>
          <button
            :if={@edit_mode and !@editing_description}
            type="button"
            phx-click="start_edit_description"
            data-role="description-edit-button"
            class="btn btn-xs btn-ghost gap-1"
          >
            <span class="hero-pencil-square size-3"></span> Edit
          </button>
        </div>

        <%= if @edit_mode and @editing_description do %>
          <form
            id="task-description-form"
            phx-hook="ButtonLoading"
            phx-submit="save_description"
            data-role="description-form"
            class="space-y-2"
          >
            <textarea
              name="description"
              rows="8"
              data-role="description-textarea"
              class="textarea textarea-bordered w-full text-sm font-mono"
            >{@selected_task.description}</textarea>
            <div class="flex gap-2">
              <button type="submit" class="btn btn-primary btn-sm" data-role="description-save">
                Save
              </button>
              <button
                type="button"
                phx-click="cancel_edit_description"
                class="btn btn-ghost btn-sm"
                data-role="description-cancel"
              >
                Cancel
              </button>
            </div>
          </form>
        <% else %>
          <div
            :if={@selected_task.description}
            id={"task-desc-#{@selected_task.id}"}
            data-role="description-rendered"
            class="prose prose-sm max-w-none text-sm text-base-content/80 chat-markdown task-markdown"
          >
            {Platform.Chat.ContentRenderer.render_message(@selected_task.description)}
          </div>
          <p
            :if={!@selected_task.description}
            data-role="description-empty"
            class="text-sm text-base-content/40 italic"
          >
            {if @edit_mode,
              do: "No description yet — click Edit to add one.",
              else: "No description yet."}
          </p>
        <% end %>
      </div>

      <%!-- Pending Review --%>
      <div :if={@pending_reviews != []} class="space-y-2">
        <div class="flex items-center gap-2">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
            Pending Review
          </h3>
          <span class="badge badge-warning badge-xs">{length(@pending_reviews)}</span>
        </div>

        <div
          :for={review <- @pending_reviews}
          class="rounded-box border border-warning bg-warning/5 p-3 space-y-3"
        >
          <div class="flex items-center justify-between text-xs text-base-content/50">
            <span :if={review.submitted_by}>
              Submitted by {review.submitted_by}
            </span>
            <span>{Calendar.strftime(review.inserted_at, "%b %d, %H:%M")}</span>
          </div>

          <div
            :for={item <- review.items}
            class="rounded-lg border border-base-300 bg-base-100 p-3 space-y-2"
          >
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium">{item.label}</span>
              <%= cond do %>
                <% item.status == "approved" -> %>
                  <span class="badge badge-success badge-xs gap-1">
                    <span class="hero-check-circle size-3"></span> Approved
                  </span>
                <% item.status == "needs_revision" -> %>
                  <span class="badge badge-warning badge-xs">Needs revision</span>
                <% true -> %>
                  <span class="badge badge-ghost badge-xs">Pending</span>
              <% end %>
            </div>

            <p :if={item.content} class="text-xs text-base-content/70 whitespace-pre-wrap">
              {item.content}
            </p>

            <div :if={item.canvas_id} class="flex items-center gap-2 text-xs">
              <span class="badge badge-outline badge-xs gap-1">
                <span class="hero-squares-2x2 size-3"></span> Linked output
              </span>
              <button
                class="btn btn-ghost btn-xs"
                phx-click="open_review_canvas"
                phx-value-canvas-id={item.canvas_id}
              >
                View output
              </button>
            </div>

            <%!-- Feedback display for rejected items --%>
            <div
              :if={item.status == "needs_revision" && item.feedback}
              class="rounded bg-warning/10 p-2 text-xs text-warning-content"
            >
              <span class="font-medium">Feedback:</span> {item.feedback}
            </div>

            <%!-- Action buttons for pending items --%>
            <div :if={item.status == "pending"} class="flex items-center gap-2">
              <button
                class="btn btn-success btn-xs"
                phx-click="approve_review_item"
                phx-value-item-id={item.id}
              >
                <span class="hero-check size-3"></span> Approve
              </button>
              <button
                class="btn btn-ghost btn-xs"
                phx-click="toggle_review_feedback"
                phx-value-item-id={item.id}
              >
                <span class="hero-chat-bubble-left size-3"></span> Send feedback
              </button>
            </div>

            <%!-- Feedback textarea (toggled) --%>
            <div
              :if={item.status == "pending" && MapSet.member?(@review_feedback_open, item.id)}
              class="space-y-2"
            >
              <textarea
                class="textarea textarea-bordered textarea-xs w-full"
                placeholder="Describe what needs to change..."
                phx-keyup="update_review_feedback_text"
                phx-value-item-id={item.id}
              >{Map.get(@review_items_feedback, item.id, "")}</textarea>
              <button
                class="btn btn-warning btn-xs"
                phx-click="submit_review_feedback"
                phx-value-item-id={item.id}
                phx-value-feedback={Map.get(@review_items_feedback, item.id, "")}
              >
                Submit Feedback
              </button>
            </div>
          </div>
        </div>
      </div>

      <%!-- Skills --%>
      <div class="space-y-2">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/50 flex items-center gap-1">
          <span class="hero-book-open size-3"></span> Skills
        </h3>

        <%!-- Attached skill chips --%>
        <div :if={@attached_skills != []} class="flex flex-wrap gap-2">
          <div
            :for={{skill, source} <- @attached_skills}
            class={
              "flex items-center gap-1 rounded-full px-2 py-0.5 text-xs " <>
                if source == "task",
                  do: "bg-primary/10 text-primary border border-primary/20",
                  else: "bg-base-200 text-base-content/60 border border-base-300"
            }
          >
            <span class="font-medium">{skill.name}</span>
            <span :if={source != "task"} class="text-[10px] opacity-70">
              (from {String.capitalize(source)})
            </span>
            <button
              :if={source == "task"}
              phx-click="detach_skill"
              phx-value-skill_id={skill.id}
              class="ml-0.5 text-primary/60 hover:text-primary"
              title="Remove skill"
            >
              <span class="hero-x-mark size-3"></span>
            </button>
          </div>
        </div>

        <%!-- Attach dropdown — only shows skills not already task-level attached --%>
        <% task_skill_ids =
          @attached_skills
          |> Enum.filter(fn {_, src} -> src == "task" end)
          |> Enum.map(fn {skill, _} -> skill.id end)
          |> MapSet.new() %>

        <% attachable =
          Enum.reject(@available_skills, fn s -> MapSet.member?(task_skill_ids, s.id) end) %>

        <div :if={attachable != []}>
          <form phx-change="attach_skill">
            <select
              class="select select-bordered select-xs w-full max-w-xs"
              name="skill_id"
            >
              <option value="">Attach a skill…</option>
              <option :for={skill <- attachable} value={skill.id}>{skill.name}</option>
            </select>
          </form>
        </div>
      </div>

      <%!-- Plan stages --%>
      <div :if={@selected_task.plans != []} class="space-y-2">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
          Plan
        </h3>
        <% {rejected_plans, active_plans} = partition_plans(@selected_task) %>

        <%!-- Folded rejected revisions (oldest first). Each row is a clickable
             summary that reveals the full plan body when expanded. --%>
        <div
          :for={plan <- rejected_plans}
          class="rounded-box border border-base-300/60 bg-base-200/20 overflow-hidden"
        >
          <% expanded? = plan_expanded?(@expanded_plans, plan) %>
          <button
            type="button"
            data-role="plan-summary"
            data-plan-id={plan.id}
            phx-click={if expanded?, do: "collapse_plan", else: "expand_plan"}
            phx-value-plan-id={plan.id}
            class="flex h-8 w-full items-center gap-2 px-3 text-xs text-base-content/50 hover:bg-base-200/40 transition-colors"
          >
            <span class={[
              "hero-chevron-right size-3 shrink-0 transition-transform",
              expanded? && "rotate-90"
            ]}>
            </span>
            <span class="flex-1 text-left truncate">{plan_summary_label(plan)}</span>
          </button>
          <div
            :if={expanded?}
            data-role="plan-body"
            data-plan-id={plan.id}
            class="border-t border-base-300/60 p-3 space-y-2 bg-base-200/30"
          >
            <%!-- Full rejection reason. Renders nothing for legacy rows
                 where `rejection_reason` is nil so the body doesn't grow
                 an empty box. --%>
            <div
              :if={present?(plan.rejection_reason)}
              data-role="plan-rejection-reason"
              data-plan-id={plan.id}
              class="rounded border border-base-300/60 bg-base-100/40 px-3 py-2"
            >
              <p class="text-[10px] uppercase tracking-wider text-base-content/50 mb-1">
                Rejection reason
              </p>
              <p class="text-xs italic text-base-content/70 whitespace-pre-wrap">
                {plan.rejection_reason}
              </p>
            </div>
            <.plan_body plan={plan} />
          </div>
        </div>

        <%!-- Active plans render in full, exactly as before. --%>
        <div
          :for={plan <- active_plans}
          data-role="plan-body"
          data-plan-id={plan.id}
          class={"rounded-box border p-3 space-y-2 #{if plan.status == "pending_review", do: "border-warning bg-warning/5", else: "border-base-300 bg-base-200/30"}"}
        >
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium">v{plan.version}</span>
            <span :if={plan.status == "pending_review"} class="badge badge-warning badge-xs">
              pending review
            </span>
            <span :if={plan.status != "pending_review"} class="badge badge-outline badge-xs">
              {plan.status}
            </span>
          </div>
          <%!-- Approve / Reject buttons — prominent, above stages. Only the
               active pending_review plan gets these; folded rejected
               revisions never re-render the buttons.

               Reject is now a toggle: it opens an inline feedback drawer
               (see the `:if={@reject_plan_open == plan.id}` block below)
               and the actual rejection fires from the Confirm button
               inside that drawer via `submit_reject_with_feedback`. The
               legacy `reject_plan` event is still handled server-side
               for tests / power users wiring the click directly. --%>
          <div :if={plan.status == "pending_review"} class="flex gap-2">
            <button
              class="btn btn-sm btn-success flex-1"
              phx-click="approve_plan"
              phx-value-plan-id={plan.id}
            >
              Approve Plan
            </button>
            <button
              class="btn btn-sm btn-ghost btn-error"
              phx-click="toggle_reject_feedback"
              phx-value-plan-id={plan.id}
              data-role="plan-reject-toggle"
              data-plan-id={plan.id}
              aria-expanded={@reject_plan_open == plan.id}
            >
              <span :if={@reject_plan_open == plan.id} class="hero-x-mark size-3 mr-1"></span>
              {if @reject_plan_open == plan.id, do: "Cancel", else: "Reject"}
            </button>
          </div>

          <%!-- Inline reject-with-feedback drawer. Mirrors the per-review-
               item pattern shipped in the stack-feedback overlay (~line
               2563): a labelled textarea + Confirm / Cancel pair below
               the toggle. The 16px `text-base` class on touch keeps iOS
               from triggering form-zoom; the `pb-[env(safe-area-inset-
               bottom)]` echoes the FAB safe-area handling so the buttons
               stay reachable when the iOS keyboard pops the form into the
               bottom of the viewport. --%>
          <div
            :if={plan.status == "pending_review" and @reject_plan_open == plan.id}
            data-role="plan-reject-feedback-form"
            data-plan-id={plan.id}
            class="mt-2 space-y-2 rounded-lg border border-error/30 bg-error/5 p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]"
          >
            <label
              for={"plan-reject-feedback-#{plan.id}"}
              class="block text-[10px] uppercase tracking-wider text-base-content/60"
            >
              What needs to change?
            </label>
            <textarea
              id={"plan-reject-feedback-#{plan.id}"}
              name="feedback"
              rows="3"
              class="textarea textarea-bordered w-full text-base resize-y min-h-[5rem]"
              placeholder="Describe what the next plan should do differently…"
              phx-keyup="update_reject_feedback_text"
              phx-debounce="150"
              data-role="plan-reject-feedback-text"
              data-plan-id={plan.id}
            >{@reject_plan_feedback_text}</textarea>
            <div class="flex gap-2">
              <button
                type="button"
                class={[
                  "btn btn-sm btn-error flex-1",
                  String.trim(@reject_plan_feedback_text || "") == "" && "btn-disabled opacity-50"
                ]}
                disabled={String.trim(@reject_plan_feedback_text || "") == ""}
                aria-disabled={
                  if(String.trim(@reject_plan_feedback_text || "") == "",
                    do: "true",
                    else: "false"
                  )
                }
                phx-click="submit_reject_with_feedback"
                phx-value-plan-id={plan.id}
                data-role="plan-reject-feedback-submit"
                data-plan-id={plan.id}
              >
                Confirm rejection
              </button>
              <button
                type="button"
                class="btn btn-sm btn-ghost"
                phx-click="toggle_reject_feedback"
                phx-value-plan-id={plan.id}
                data-role="plan-reject-feedback-cancel"
                data-plan-id={plan.id}
              >
                Cancel
              </button>
            </div>
          </div>
          <.plan_body plan={plan} />
        </div>
      </div>

      <%!-- Execution Log --%>
      <div
        :if={!@execution_space_id and @steering_feedback}
        id="steering-feedback-empty"
        class={[
          "flex items-start gap-2 rounded-lg border px-3 py-2 text-xs",
          @steering_feedback.kind == :success && "border-success/30 bg-success/10 text-success",
          @steering_feedback.kind == :error && "border-error/30 bg-error/10 text-error"
        ]}
      >
        <span class={[
          "mt-0.5 size-4 shrink-0",
          @steering_feedback.kind == :success && "hero-check-circle",
          @steering_feedback.kind == :error && "hero-exclamation-circle"
        ]}>
        </span>
        <span>{@steering_feedback.message}</span>
      </div>

      <div :if={@execution_space_id} class="space-y-2">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
            Execution Log
          </h3>
          <button
            phx-click="toggle_execution_log"
            class="btn btn-ghost btn-xs btn-square"
            title={if @execution_log_collapsed, do: "Expand log", else: "Collapse log"}
          >
            <span class={"size-4 transition-transform #{if @execution_log_collapsed, do: "hero-chevron-down", else: "hero-chevron-up"}"}>
            </span>
          </button>
        </div>

        <div :if={!@execution_log_collapsed}>
          <div
            :if={@execution_log == []}
            class="text-xs text-base-content/30 italic py-2"
          >
            No messages yet
          </div>

          <div
            :if={@execution_log != []}
            id="execution-log-scroll"
            phx-hook="ExecutionLogScroll"
            phx-drop-target={@uploads.steering_attachments.ref}
            class="max-h-72 overflow-y-auto rounded-box border border-base-300 bg-base-200/30 p-2 space-y-1"
          >
            <div
              :for={msg <- @execution_log}
              class={"flex flex-col gap-0.5 text-xs #{if msg.log_only, do: "opacity-50", else: ""} #{if msg.content_type == "system", do: "border-l-2 border-base-300 pl-2", else: ""} #{if msg.sender_type == "user", do: "border-l-2 border-primary pl-2", else: ""}"}
            >
              <div class="flex items-start gap-2">
                <span class="text-base-content/40 whitespace-nowrap shrink-0">
                  {format_log_timestamp(msg.inserted_at)}
                </span>
                <span class={"font-medium shrink-0 #{log_sender_color(msg.sender_type, msg.content_type)}"}>
                  {msg.sender_name}
                </span>
                <span class="flex-1 whitespace-pre-wrap break-words">{msg.content}</span>
              </div>

              <%!-- Inline attachments --%>
              <div
                :if={Map.get(msg, :attachments, []) != []}
                class="flex flex-wrap gap-1.5 ml-[4.5rem]"
              >
                <%= for att <- Map.get(msg, :attachments, []) do %>
                  <%= if String.starts_with?(att.content_type || "", "image/") do %>
                    <a
                      href={~p"/chat/attachments/#{att.id}"}
                      target="_blank"
                      class="block"
                    >
                      <img
                        src={~p"/chat/attachments/#{att.id}"}
                        alt={att.filename}
                        class="max-h-40 rounded border border-base-300 hover:border-primary transition-colors"
                        loading="lazy"
                      />
                    </a>
                  <% else %>
                    <a
                      href={~p"/chat/attachments/#{att.id}"}
                      target="_blank"
                      class="inline-flex items-center gap-1 rounded-lg border border-base-300 bg-base-200 px-2 py-1 text-xs hover:border-primary transition-colors"
                    >
                      <span class="hero-document size-3.5 text-base-content/50"></span>
                      <span class="truncate max-w-[120px]">{att.filename}</span>
                    </a>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

          <%!-- Steering compose input --%>
          <.form
            for={@steering_compose_form}
            id="steering-compose-form"
            phx-hook="ButtonLoading"
            phx-submit="send_steering_message"
            phx-change="steering_changed"
            class="mt-2 border-t border-base-300 pt-2"
          >
            <%!-- Upload previews --%>
            <div
              :if={@uploads.steering_attachments.entries != [] or @steering_upload_previews != []}
              class="flex flex-wrap gap-2 mb-2"
            >
              <div
                :for={entry <- @uploads.steering_attachments.entries}
                :if={@uploads.steering_attachments.entries != []}
                class="relative group"
              >
                <%= if String.starts_with?(entry.client_type, "image/") do %>
                  <.live_img_preview
                    entry={entry}
                    class="w-16 h-16 object-cover rounded-lg border border-base-300"
                  />
                <% else %>
                  <div class="w-16 h-16 rounded-lg border border-base-300 bg-base-200 flex flex-col items-center justify-center gap-0.5 px-1">
                    <span class="hero-document size-5 text-base-content/40"></span>
                    <span class="text-[8px] text-base-content/60 truncate w-full text-center">
                      {entry.client_name}
                    </span>
                  </div>
                <% end %>

                <button
                  type="button"
                  phx-click="cancel_steering_upload"
                  phx-value-ref={entry.ref}
                  class="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-error text-error-content flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-sm"
                  title="Remove"
                >
                  <span class="hero-x-mark size-3"></span>
                </button>

                <div
                  :if={entry.progress > 0 and entry.progress < 100}
                  class="absolute bottom-0.5 left-0.5 right-0.5"
                >
                  <div class="h-1 rounded-full bg-base-300 overflow-hidden">
                    <div
                      class="h-full bg-primary transition-all duration-300"
                      style={"width: #{entry.progress}%"}
                    >
                    </div>
                  </div>
                </div>
              </div>

              <div
                :for={entry <- @steering_upload_previews}
                :if={@uploads.steering_attachments.entries == []}
                class="relative group"
              >
                <div class="w-16 h-16 rounded-lg border border-base-300 bg-base-200 flex flex-col items-center justify-center gap-0.5 px-1">
                  <span class={[
                    "size-5 text-base-content/40",
                    String.starts_with?(entry.client_type, "image/") && "hero-photo",
                    !String.starts_with?(entry.client_type, "image/") && "hero-document"
                  ]}>
                  </span>
                  <span class="text-[8px] text-base-content/60 truncate w-full text-center">
                    {entry.client_name}
                  </span>
                </div>

                <button
                  type="button"
                  phx-click="cancel_steering_upload"
                  phx-value-ref={entry.ref}
                  class="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-error text-error-content flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-sm"
                  title="Remove"
                >
                  <span class="hero-x-mark size-3"></span>
                </button>
              </div>
            </div>

            <%!-- Upload errors --%>
            <p
              :for={error <- upload_errors(@uploads.steering_attachments)}
              class="text-xs text-error mb-1"
            >
              {upload_error_to_string(error)}
            </p>

            <div :for={entry <- @uploads.steering_attachments.entries}>
              <p
                :for={error <- upload_errors(@uploads.steering_attachments, entry)}
                class="text-xs text-error mb-1"
              >
                {entry.client_name}: {upload_error_to_string(error)}
              </p>
            </div>

            <%!-- Compose row: [+] [input stretches] [send] --%>
            <div class="flex items-center gap-2">
              <button
                type="button"
                onclick="this.closest('form').querySelector('input[type=file]').click()"
                class="flex-shrink-0 cursor-pointer rounded-full w-9 h-9 flex items-center justify-center text-base-content/50 hover:bg-base-300 transition-colors"
                title="Attach files"
                disabled={is_nil(@execution_space_id)}
              >
                <span class="hero-plus size-5"></span>
              </button>

              <.live_file_input upload={@uploads.steering_attachments} class="hidden" />

              <textarea
                name="steering[text]"
                id={@steering_compose_form[:text].id}
                placeholder="Steer the agent..."
                autocomplete="off"
                rows="1"
                class="min-w-0 flex-1 rounded-xl text-sm resize-none bg-base-100 border border-base-300 focus:border-primary focus:outline-none transition-colors"
                style="line-height:1.5;padding:6px 12px;min-height:33px;max-height:200px;overflow-y:auto;field-sizing:content"
                phx-hook="ComposeInput"
                disabled={is_nil(@execution_space_id)}
              >{Phoenix.HTML.Form.normalize_value("text", @steering_compose_form[:text].value)}</textarea>

              <button
                type="submit"
                class="flex-shrink-0 w-9 h-9 rounded-full btn btn-primary btn-sm flex items-center justify-center p-0"
                disabled={is_nil(@execution_space_id)}
                title="Send steering message"
              >
                <span class="hero-paper-airplane size-4 -rotate-45"></span>
              </button>
            </div>

            <div
              :if={@steering_feedback}
              id="steering-feedback"
              class={[
                "mt-2 flex items-start gap-2 rounded-lg border px-3 py-2 text-xs",
                @steering_feedback.kind == :success &&
                  "border-success/30 bg-success/10 text-success",
                @steering_feedback.kind == :error && "border-error/30 bg-error/10 text-error"
              ]}
            >
              <span class={[
                "mt-0.5 size-4 shrink-0",
                @steering_feedback.kind == :success && "hero-check-circle",
                @steering_feedback.kind == :error && "hero-exclamation-circle"
              ]}>
              </span>
              <span>{@steering_feedback.message}</span>
            </div>
          </.form>
        </div>
      </div>

      <%!-- Outputs --%>
      <div :if={@execution_space_id} class="space-y-2">
        <div class="flex items-center gap-2">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
            Outputs
          </h3>
          <span :if={@output_canvases != []} class="badge badge-ghost badge-xs">
            {length(@output_canvases)}
          </span>
        </div>

        <div :if={@output_canvases == []} class="text-xs text-base-content/30 italic py-1">
          No outputs yet
        </div>

        <div :if={@output_canvases != []} class="space-y-3">
          <div
            :for={canvas <- Enum.reverse(@output_canvases)}
            class="rounded-box border border-base-300 bg-base-100 p-3 space-y-2"
          >
            <div class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <div class="truncate text-sm font-medium">{canvas.title || "Output"}</div>
                <div class="text-xs text-base-content/50">
                  {Platform.Chat.CanvasDocument.root_kind(canvas.document) || "canvas"} • {Calendar.strftime(
                    canvas.inserted_at,
                    "%b %-d, %-I:%M %p"
                  )}
                </div>
              </div>
              <div class="flex items-center gap-2">
                <span
                  :if={MapSet.member?(@review_output_ids, canvas.id)}
                  class="badge badge-warning badge-xs"
                >
                  Review item
                </span>
                <button
                  class="btn btn-ghost btn-xs"
                  phx-click="canvas_open"
                  phx-value-canvas-id={canvas.id}
                >
                  Open
                </button>
              </div>
            </div>

            <div class="overflow-hidden rounded-box border border-base-200 bg-base-200/30">
              <PlatformWeb.Chat.CanvasRenderer.canvas_document
                canvas={canvas}
                inline={true}
                show_header={false}
                dom_id_base="tasks-output-inline"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%!-- Stack detail panel (T8 stage 1 — slide-in from right).
       Mirrors the per-task detail container shape so the two panels
       feel visually identical. Stage 1 ships head + action row;
       stages 2-5 fill in meta-grid, dep DAG, members list, and
       mobile takeover. Purple accent (#7b5cff) matches mock canvas
       019e1a16 rev 2 (.stk-tag style). --%>
  <%!-- T8 stage 5 (revised stage 1 of task 019e38c7): mobile takeover
       + sticky action bar. Container shape mirrors the per-task detail
       panel at line ~865 EXACTLY — explicit `top-0 right-0
       bottom-[calc(...)]` with no `inset-0` shorthand. The old shape
       used `inset-0 ... bottom-[calc(...)]`: Tailwind's same-specificity
       ordering left `inset-0`'s `bottom:0` competing with the calc
       override on mobile, which broke iOS WebKit's overflow
       calculations and left the body unscrollable below the fold.
       Mobile widens to full screen via `left-0 max-w-full`; md+ narrows
       to a right-edge slide-in via `md:left-auto md:max-w-lg`. Bottom
       edge stops at the top of the bottom-nav (including iOS home-
       indicator safe-area) via `bottom-[calc(env(safe-area-inset-
       bottom)+var(--bottom-nav-height,0px))]` on the panel container.
       No defense-in-depth `pb-` on the inner scroller — PR #335
       stripped that pattern as dead space. --%>
  <div
    :if={@show_stack_detail && @selected_stack}
    id="stack-detail-panel"
    data-role="stack-detail-panel"
    data-stack-id={@selected_stack.id}
    class="fixed top-0 left-0 md:left-auto right-0 bottom-[calc(env(safe-area-inset-bottom)+var(--bottom-nav-height,0px))] z-30 flex w-full max-w-full md:max-w-lg flex-col border-l border-base-300 bg-base-100 shadow-xl safe-area-top"
  >
    <%!-- Head/app bar. On mobile the chrome is a back arrow + Stack
         tag + overflow kebab (matching the mock's `.detail-appbar`).
         On desktop the head retains the stage 1 shape: title + close X
         button on the right. The back arrow + kebab carry `md:hidden`;
         the desktop close X carries `hidden md:flex`. The Stack tag
         and title/description block render on both viewports. --%>
    <%!-- Single scroll region for the whole panel body: head + meta grid +
         DAG/members. Previously only the DAG/members region scrolled and
         the head/meta sat outside it as unshrinkable flex items — a stack
         with a long description made the head taller than the panel, which
         squeezed the scroller to ~0px and pushed it past the panel's bottom
         edge, so the graph and member list were unreachable at every
         breakpoint. Scrolling at this level makes the surface hold for
         arbitrarily long descriptions AND arbitrarily many members. The
         action bar stays outside as a pinned `shrink-0` footer. --%>
    <div class="flex min-h-0 flex-1 flex-col overflow-y-auto" data-role="stack-detail-scroll">
      <div class="shrink-0 flex items-start justify-between gap-3 border-b border-base-300 px-4 py-3">
        <%!-- Mobile back arrow: same handler as the desktop close X. --%>
        <button
          type="button"
          class="btn btn-sm btn-ghost btn-square shrink-0 md:hidden"
          phx-click="close_stack_detail"
          aria-label="Back"
          data-role="stack-detail-back"
        >
          <span class="hero-arrow-left size-4"></span>
        </button>
        <div class="flex min-w-0 flex-1 flex-col gap-1.5">
          <div class="flex min-w-0 items-center gap-2">
            <span
              class="hero-rectangle-stack size-4 shrink-0 text-violet-300"
              aria-hidden="true"
            >
            </span>
            <span
              class="text-[9px] font-semibold uppercase tracking-wider shrink-0"
              style="color:#7b5cff"
              data-role="stack-tag"
            >
              Stack
            </span>
          </div>
          <h2
            id={"stack-detail-title-#{@selected_stack.id}"}
            class="text-lg font-semibold leading-tight truncate"
            data-role="stack-detail-title"
          >
            {@selected_stack.name}
          </h2>
          <p
            :if={@selected_stack.description && @selected_stack.description != ""}
            class="text-xs text-base-content/60 leading-snug"
            data-role="stack-detail-description"
          >
            {@selected_stack.description}
          </p>
        </div>
        <%!-- Stage 2 of task 019e2c27 (Stack-Level Review Rollup): chrome
           pill that surfaces the count of open review_requests across
           every member of this stack. Hidden entirely when the count
           is 0 — the chrome stays clutter-free unless there's actual
           feedback waiting. Sits between the title block and the
           overflow kebab / close X so it's visible on both mobile
           (left of the kebab) and desktop (left of the close X).
           Click toggles `show_stack_feedback_overlay` via the stage-2
           handler stub; stage 3 will render the actual rollup overlay. --%>
        <button
          :if={@selected_stack_pending_review_count > 0}
          type="button"
          class="badge badge-warning badge-sm gap-1 shrink-0 self-center cursor-pointer"
          phx-click="open_stack_feedback_overlay"
          aria-label={"Needs feedback (#{@selected_stack_pending_review_count})"}
          data-role="stack-detail-needs-feedback-pill"
          data-pending-count={@selected_stack_pending_review_count}
        >
          <span class="hero-eye size-3" aria-hidden="true"></span>
          <span>Needs feedback ({@selected_stack_pending_review_count})</span>
        </button>
        <%!-- Mobile overflow kebab. No-op trigger for now (visual parity
           with the mock); when stack-level overflow actions land they
           wire here. --%>
        <button
          type="button"
          class="btn btn-sm btn-ghost btn-square shrink-0 md:hidden"
          aria-label="Stack actions"
          data-role="stack-detail-overflow"
        >
          <span class="hero-ellipsis-vertical size-4"></span>
        </button>
        <%!-- Desktop close X. Hidden on mobile (the back arrow replaces
           it on the left); visible on md+ where the slide-in shape
           keeps the close affordance on the right. --%>
        <button
          type="button"
          class="hidden md:flex btn btn-sm btn-ghost btn-square shrink-0"
          phx-click="close_stack_detail"
          aria-label="Close stack details"
          data-role="stack-detail-close"
        >
          <span class="hero-x-mark size-4"></span>
        </button>
      </div>

      <%!-- Meta-grid (T8 stage 2): 4-cell summary under the head.
         Desktop = 4 columns horizontal; mobile baseline 2x2 lands in
         stage 5. Cells: status (color-coded), members (count · ready),
         dep-edges (count · valid DAG / cycle detected), branch (mono).
         Computed via `stack_meta/2` to keep the template clean. --%>
      <% meta = stack_meta(@selected_stack, @selected_stack_members) %>
      <div
        class="shrink-0 grid grid-cols-2 md:grid-cols-4 gap-2 border-b border-base-300 px-4 py-3"
        data-role="stack-detail-meta"
      >
        <div class="meta-cell rounded-md bg-base-300 p-2" data-role="meta-cell-status">
          <div class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
            Status
          </div>
          <div
            class={"mt-1 text-sm font-medium #{meta.status.class}"}
            data-role="meta-cell-status-value"
          >
            {meta.status.label}
          </div>
        </div>
        <div class="meta-cell rounded-md bg-base-300 p-2" data-role="meta-cell-members">
          <div class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
            Members
          </div>
          <div class="mt-1 text-sm font-medium" data-role="meta-cell-members-value">
            {meta.members.text}
          </div>
        </div>
        <div class="meta-cell rounded-md bg-base-300 p-2" data-role="meta-cell-dep-edges">
          <div class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
            Dep edges
          </div>
          <div
            class={"mt-1 text-sm font-medium #{dep_edges_class(meta.dep_edges)}"}
            data-role="meta-cell-dep-edges-value"
          >
            {meta.dep_edges.text}
          </div>
        </div>
        <div class="meta-cell rounded-md bg-base-300 p-2" data-role="meta-cell-branch">
          <div class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
            Branch
          </div>
          <div
            class="mt-1 truncate font-mono text-xs text-base-content"
            data-role="meta-cell-branch-value"
            title={meta.branch}
          >
            {meta.branch}
          </div>
        </div>
      </div>

      <%!-- Body: stage 3 ships the dep DAG SVG in the left column; stage 4
         adds the members list in the right column (mobile collapses to a
         single column in stage 5). The body is a 2-column grid so the
         DAG and members list share width 1:1 on desktop. --%>
      <% dag = stack_dag_layout(@selected_stack_members)
      {dag_w, dag_h} = dag.viewbox %>
      <div
        class="shrink-0 p-4 grid grid-cols-1 md:grid-cols-2 gap-4 items-start"
        data-role="stack-detail-body"
      >
        <%!-- Left column: dep DAG. `.dag` matches the mock chrome
           (rounded base-300 backdrop, modest padding). The SVG fills the
           container (`w-full h-full`); `preserveAspectRatio` keeps the
           graph legible as the aspect changes. Stage 3 will add the
           expand-to-modal affordance atop this container. --%>
        <div
          id="stack-detail-dag-container"
          class="dag relative h-56 md:h-64 rounded bg-base-300 p-2"
          data-role="stack-detail-dag"
        >
          <svg
            viewBox={"0 0 #{dag_w} #{dag_h}"}
            preserveAspectRatio="xMidYMid meet"
            xmlns="http://www.w3.org/2000/svg"
            class="w-full h-full block"
            data-role="stack-detail-dag-svg"
          >
            <%!-- Edges render as dashed lines with no arrowhead per Rowan's
               T8 stage-5 review: direction is implicit from the
               topological-row layout (sources are above targets), so
               the marker-end arrowhead is intentionally omitted. --%>
            <%= for edge <- dag.edges do %>
              <line
                x1={edge.x1}
                y1={edge.y1}
                x2={edge.x2}
                y2={edge.y2}
                stroke="#7b5cff"
                stroke-width="1.4"
                stroke-dasharray="6,4"
                data-role="stack-detail-dag-edge"
                data-from-id={edge.from_id}
                data-to-id={edge.to_id}
              />
            <% end %>
            <%= for node <- dag.nodes do %>
              <% style = dag_node_style(node.status) %>
              <g data-role="stack-detail-dag-node" data-node-id={node.id}>
                <rect
                  x={node.x}
                  y={node.y}
                  width={node.w}
                  height={node.h}
                  rx="6"
                  fill={style.fill}
                  stroke={style.stroke}
                  stroke-width="1.2"
                  stroke-dasharray={style.dasharray}
                  data-status={node.status}
                />
                <text
                  x={node.x + 12}
                  y={node.y + 18}
                  font-size="11"
                  font-weight="700"
                  fill={style.num_color}
                >
                  {node.num}
                </text>
                <text x={node.x + 26} y={node.y + 18} font-size="9" fill={style.text}>
                  {dag_node_label(node.label)}
                </text>
                <text
                  x={node.x + 26}
                  y={node.y + 34}
                  font-size="7"
                  letter-spacing="0.5"
                  fill={style.caption_color}
                >
                  {style.caption}
                </text>
              </g>
            <% end %>
          </svg>
          <%!-- Expand-to-modal affordance (stage 3 of task 019f487e). Ghost
             icon-button positioned top-right of the dep-graph container;
             semantic-token colors only (no hard-coded hex). On click,
             sets `:stack_graph_expanded` true so the fullscreen modal
             renders (see the modal block below the review-canvas modal).
             --%>
          <button
            type="button"
            aria-label="Expand dep graph"
            data-role="stack-detail-dag-expand"
            phx-click="open_stack_graph_expand"
            class="btn btn-ghost btn-sm btn-square absolute top-1 right-1 text-base-content/60 hover:bg-base-content/10 max-sm:h-11 max-sm:w-11 max-sm:min-h-[44px] max-sm:min-w-[44px]"
          >
            <span class="hero-arrows-pointing-out size-4" aria-hidden="true"></span>
          </button>
        </div>
        <%!-- Right column: linear members list (T8 stage 4). One row per
           in-stack member ordered by `stack_position`. Each row carries
           a circular position badge (status-coloured), the truncated
           title, a status pill on the right, and an optional dep
           annotation line below ("depends on ① + ②" /
           "depends on ① (parallel with ②)") suppressed when the member
           has no in-stack predecessors. Rows are clickable: clicking
           one push_patches to /tasks/:id and closes this stack panel
           (close-and-open behavior — the per-task detail slides in to
           replace the stack panel). --%>
        <%!-- Members column. The panel-level scroll region
           (`stack-detail-scroll`) handles vertical overflow for the entire
           panel; the column itself must NOT carry its own scroller or iOS
           WebKit's momentum scroll fights itself on mobile (the
           single-column grid stacks DAG above members and the user
           can't reach the bottom rows). See task 019e38c7 stage 1. --%>
        <div
          class="flex flex-col gap-2"
          data-role="stack-detail-members"
        >
          <div
            class="flex items-center gap-2"
            data-role="stack-detail-members-header"
          >
            <span class="text-xs font-semibold uppercase tracking-wider text-base-content/60">
              Members
            </span>
            <span class="text-[10px] text-base-content/50">(dispatch order)</span>
          </div>
          <div class="mlist flex flex-col gap-1.5" data-role="stack-detail-members-list">
            <%= for member <- @selected_stack_members do %>
              <% {pill_label, pill_class} = member_status_pill(member.status)
              annotation = member_dep_annotation(member, @selected_stack_members)
              assignment = member_assignment_badge(member)
              review_count = Map.get(@selected_stack_member_review_counts, member.id, 0)
              action_reason = Tasks.needs_human_action_reason(member, review_count)
              {action_label, action_reason_attr} = stack_member_action_label(action_reason) %>
              <div
                class="mlist-item rounded-md bg-base-300 border border-base-300 p-2 cursor-pointer hover:bg-base-200 transition-colors"
                phx-click="select_task"
                phx-value-id={member.id}
                data-role="stack-detail-member-row"
                data-member-id={member.id}
                data-member-status={member.status}
              >
                <div class="flex items-center gap-2">
                  <span
                    class={"inline-flex size-5 items-center justify-center rounded-full text-[11px] font-semibold shrink-0 #{member_node_class(member.status)}"}
                    data-role="stack-detail-member-num"
                  >
                    {stack_position_glyph(member.stack_position)}
                  </span>
                  <span
                    class="flex-1 truncate text-sm text-base-content"
                    data-role="stack-detail-member-title"
                  >
                    {member.title}
                  </span>
                  <%!-- Assignment badge (ADR 0041): `inherited` = follows the
                     stack-level default; `override` = carries an individual
                     assignee, protected from stack-level fan-out. Overridden
                     rows expose an inline "clear" action that returns the
                     member to inheriting. --%>
                  <%= if assignment == "override" do %>
                    <button
                      type="button"
                      class="shrink-0 inline-flex items-center gap-0.5 rounded bg-warning/20 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-warning hover:bg-warning/30"
                      phx-click="clear_member_override"
                      phx-value-id={member.id}
                      data-confirm="Clear this member's individual override and return it to inheriting the stack default?"
                      data-role="stack-detail-member-assignment"
                      data-assignment="override"
                      title="Clear override — return to inheriting the stack default"
                    >
                      override <span class="hero-x-mark size-3"></span>
                    </button>
                  <% else %>
                    <span
                      class="shrink-0 rounded bg-base-content/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-base-content/60"
                      data-role="stack-detail-member-assignment"
                      data-assignment="inherited"
                    >
                      inherited
                    </span>
                  <% end %>
                  <%!-- Badges-for-tasks-that-need-feedback (task 019e2c25
                     stage 2): per-row "Needs review" / "Plan ready"
                     warning chip rendered when Tasks.needs_human_action?
                     evaluates true for this member. The data-action-reason
                     attribute carries the precise predicate branch
                     (`plan_pending_review`, `review_request_pending`,
                     `validation_failed`) so the badge is targetable from
                     tests + dataview drilldowns. --%>
                  <span
                    :if={action_label}
                    class="shrink-0 badge badge-warning badge-xs gap-1"
                    data-role="stack-detail-member-action"
                    data-action-reason={action_reason_attr}
                  >
                    <span class="hero-eye size-3"></span>
                    {action_label}
                  </span>
                  <span
                    class={"shrink-0 rounded px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider #{pill_class}"}
                    data-role="stack-detail-member-pill"
                  >
                    {pill_label}
                  </span>
                </div>
                <div
                  :if={annotation}
                  class="pl-7 text-[10px] text-base-content/50"
                  data-role="stack-detail-member-deps"
                >
                  {annotation}
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%!-- Action row: Abandon (ghost) + View rollup PR (primary).
         The PR anchor is disabled when no rollup PR has been opened
         yet (metadata.rollup_pr.url is nil). --%>
    <% rollup_pr_url =
      case @selected_stack.metadata do
        %{"rollup_pr" => %{"url" => url}} when is_binary(url) and url != "" -> url
        _ -> nil
      end %>
    <%!-- Pinned bottom action bar (T8 stage 5). It is the last, non-
         shrinking child of the panel's flex column, so it stays at the
         panel's bottom edge on mobile (where the panel is full-screen and
         the region above it scrolls) and on desktop alike. The panel
         container's
         `bottom-[calc(env(safe-area-inset-bottom)+var(--bottom-nav-
         height,0px))]` constraint (PR #335 pattern) keeps the bar
         from being occluded by the bottom-tab nav on iOS — no
         defense-in-depth pb on this bar is required. --%>
    <% has_backlog_member? =
      Enum.any?(@selected_stack_members, &(&1.status == "backlog")) %>
    <div
      class="shrink-0 flex gap-2 border-t border-base-300 bg-base-100 px-4 py-3"
      data-role="stack-detail-actions"
    >
      <%!-- Start Planning (T8 stage 3): stack-level mirror of the per-task
           "Start Planning" button. Cascades every `backlog` member to
           `planning` via Stacks.start_planning/1. Rendered only when the
           stack has at least one `backlog` member — a stack with nothing
           to plan does not show the control. --%>
      <button
        :if={has_backlog_member?}
        type="button"
        class="btn btn-ghost btn-sm flex-1"
        phx-click="start_stack_planning"
        data-role="stack-detail-start-planning"
      >
        <span class="hero-play size-4"></span> Start Planning
      </button>
      <%!-- Assign Agents (ADR 0041): opens the stack-level assignee modal.
           The stack-level assignment fans out to every member that is not
           individually overridden. --%>
      <button
        type="button"
        class="btn btn-ghost btn-sm flex-1"
        phx-click="open_stack_assignee_modal"
        data-role="stack-detail-assign-agents"
      >
        <span class="hero-user-group size-4"></span> Assign Agents
      </button>
      <button
        type="button"
        class="btn btn-ghost btn-sm flex-1"
        phx-click="abandon_stack"
        data-confirm="Abandon this stack? This cannot be undone."
        data-role="stack-detail-abandon"
      >
        Abandon
      </button>
      <%= if rollup_pr_url do %>
        <a
          href={rollup_pr_url}
          target="_blank"
          rel="noopener"
          class="btn btn-primary btn-sm flex-1"
          data-role="stack-detail-rollup-pr"
        >
          View rollup PR
        </a>
      <% else %>
        <button
          type="button"
          class="btn btn-primary btn-sm flex-1 btn-disabled"
          disabled
          aria-disabled="true"
          data-role="stack-detail-rollup-pr"
        >
          View rollup PR
        </button>
      <% end %>
    </div>
  </div>

  <%!-- Stage 3 of task 019e2c27 (Stack-Level Review Rollup): the rollup
       overlay. Modal/takeover surface that floats OVER the stack pane
       (NOT inline in it — the inline layout was the design Rowan rejected
       from v1). Lists every open ReviewRequest across the stack's
       members; each row renders the member task title + the canvas
       content inline via the same CanvasRenderer.canvas_document
       component the per-task `active_review_canvas` modal uses (gold-
       standard pattern at line ~2410 below).

       Layout:
         * z-40 sits ABOVE the stack panel (z-30) so it visually replaces
           the pane while keeping the panel mounted underneath — closing
           the overlay returns the user directly to the stack pane.
         * z-50 is reserved for the per-canvas `active_review_canvas`
           modal, which a future stage may open from a drill-down here.
         * Mobile (default): full-screen takeover (`inset-0`). The chrome
           pill is the trigger so the user never lands on this surface
           without a count to read; the takeover style matches the v2
           plan's "full-screen takeover on 375x812".
         * Desktop (md+): the panel is `max-w-lg` on the right edge; the
           overlay mirrors that and pins to the same column so it
           visually replaces the pane (NOT a small modal floating in the
           board's empty space). Backdrop fills the rest of the viewport
           with a black wash so it's clear the board is non-interactive.
         * Bottom edge mirrors the stack-detail panel's safe-area
           constraint so the takeover does not bleed under the bottom
           nav on iOS PWA.
         * Backdrop click dismisses (`close_stack_feedback_overlay`); the
           top-right X is a redundant explicit close.

       Stage-4 work (this stage): the approve/reject buttons on each
       item are wired against `ReviewRequests.approve_item/2` +
       `ReviewRequests.reject_item/3`. Approve is one-click; reject
       expands an inline textarea (mirrors the per-task
       `submit_review_feedback` UX) so the reviewer can give a reason. --%>
  <div
    :if={@show_stack_feedback_overlay && @selected_stack}
    id="stack-feedback-overlay"
    data-role="stack-feedback-overlay"
    data-stack-id={@selected_stack.id}
    class="fixed inset-0 z-40"
  >
    <%!-- Backdrop fills the viewport. On desktop the overlay panel is
         pinned to the right column (md:max-w-lg) so the backdrop
         visually wraps the rest of the board; click anywhere on the
         backdrop to dismiss. --%>
    <div
      class="absolute inset-0 bg-black/50"
      phx-click="close_stack_feedback_overlay"
      data-role="stack-feedback-overlay-backdrop"
    />
    <%!-- Overlay panel — full-screen takeover on mobile, pinned to the
         right edge on desktop matching the stack pane's column. --%>
    <div
      class="absolute inset-0 md:inset-y-0 md:left-auto md:right-0 bottom-[calc(env(safe-area-inset-bottom)+var(--bottom-nav-height,0px))] flex w-full max-w-full md:max-w-lg flex-col border-l border-base-300 bg-base-100 shadow-2xl safe-area-top"
      data-role="stack-feedback-overlay-panel"
    >
      <%!-- Overlay header: title + count + close X. Mirrors the stack-
           detail panel chrome shape for visual continuity, but uses the
           "Needs feedback" label so the user understands this is the
           drill-down from the chrome pill. --%>
      <div class="flex items-center justify-between gap-3 border-b border-base-300 px-4 py-3">
        <div class="flex min-w-0 items-center gap-2">
          <span class="hero-eye size-4 shrink-0 text-warning" aria-hidden="true"></span>
          <div class="min-w-0">
            <div class="text-sm font-semibold leading-tight truncate">
              Needs feedback
            </div>
            <div
              class="text-xs text-base-content/60"
              data-role="stack-feedback-overlay-count"
            >
              {@selected_stack_pending_review_count} pending {request_word(
                @selected_stack_pending_review_count
              )} across this stack
            </div>
          </div>
        </div>
        <button
          type="button"
          class="btn btn-ghost btn-sm btn-square shrink-0"
          phx-click="close_stack_feedback_overlay"
          aria-label="Close feedback overlay"
          data-role="stack-feedback-overlay-close"
        >
          <span class="hero-x-mark size-4"></span>
        </button>
      </div>

      <%!-- Scrollable body. Empty state is defensive: the chrome pill is
           hidden when the count is 0, so the overlay should never open
           with an empty list. If it does (e.g. PubSub flushed every RR
           between click and render), surface a neutral copy instead of a
           blank pane. --%>
      <div class="flex-1 overflow-y-auto px-4 py-3">
        <%= if @selected_stack_open_review_requests == [] do %>
          <div
            class="rounded-lg border border-dashed border-base-300 bg-base-200/50 p-6 text-center text-sm text-base-content/60"
            data-role="stack-feedback-overlay-empty"
          >
            No pending feedback on this stack.
          </div>
        <% else %>
          <ul class="flex flex-col gap-4" data-role="stack-feedback-overlay-list">
            <li
              :for={rr <- @selected_stack_open_review_requests}
              class="rounded-xl border border-base-300 bg-base-100"
              data-role="stack-feedback-overlay-item"
              data-review-request-id={rr.id}
              data-task-id={rr.task_id}
            >
              <%!-- Row header: member task title + drill-in link. --%>
              <div class="flex items-start justify-between gap-2 border-b border-base-300 px-3 py-2">
                <div class="min-w-0">
                  <div class="text-[10px] font-semibold uppercase tracking-wider text-base-content/50">
                    Member task
                  </div>
                  <%= if rr.member_task do %>
                    <.link
                      patch={~p"/tasks/#{rr.member_task.id}"}
                      class="block truncate text-sm font-medium text-base-content hover:underline"
                      data-role="stack-feedback-overlay-task-link"
                    >
                      {rr.member_task.title}
                    </.link>
                  <% else %>
                    <span class="block truncate text-sm font-medium text-base-content/60">
                      (member task missing)
                    </span>
                  <% end %>
                </div>
              </div>

              <%!-- Items: each one carries the canvas (or text content)
                   plus the (stage-4) approve/reject buttons. --%>
              <ul class="flex flex-col gap-3 p-3">
                <li
                  :for={item <- rr.items || []}
                  class="rounded-lg border border-base-300 bg-base-200/40 p-3"
                  data-role="stack-feedback-overlay-review-item"
                  data-review-item-id={item.id}
                >
                  <div class="mb-2 flex items-center justify-between gap-2">
                    <div class="min-w-0 truncate text-xs font-semibold text-base-content/80">
                      {item.label}
                    </div>
                    <div class="flex shrink-0 gap-1">
                      <%!-- Stage 4 wiring: Approve fires a single
                           `stack_feedback_approve_item` event with the
                           item id. Reject toggles an inline textarea
                           (mirrors the per-task `submit_review_feedback`
                           UX) so a feedback string is collected before
                           `ReviewRequests.reject_item/3` is called. --%>
                      <button
                        type="button"
                        class="btn btn-success btn-xs"
                        phx-click="stack_feedback_approve_item"
                        phx-value-id={item.id}
                        data-role="stack-feedback-overlay-approve"
                        data-review-item-id={item.id}
                        title="Approve this item"
                      >
                        <span class="hero-check size-3"></span> Approve
                      </button>
                      <button
                        type="button"
                        class="btn btn-error btn-xs"
                        phx-click="toggle_stack_feedback_reject"
                        phx-value-id={item.id}
                        data-role="stack-feedback-overlay-reject"
                        data-review-item-id={item.id}
                        title="Reject this item with feedback"
                      >
                        <span class="hero-x-mark size-3"></span> Reject
                      </button>
                    </div>
                  </div>

                  <%!-- Reject feedback textarea + submit. Toggled by
                       `toggle_stack_feedback_reject` (the Reject button
                       above). Lives in overlay-scoped assigns
                       (`:stack_feedback_reject_open` /
                       `:stack_feedback_reject_text`) so opening this
                       drawer here does NOT also expand the per-task
                       review panel's separate reject UI underneath. --%>
                  <div
                    :if={MapSet.member?(@stack_feedback_reject_open, item.id)}
                    class="mb-2 space-y-2"
                    data-role="stack-feedback-overlay-reject-form"
                    data-review-item-id={item.id}
                  >
                    <textarea
                      class="textarea textarea-bordered textarea-xs w-full"
                      placeholder="Describe what needs to change..."
                      phx-keyup="update_stack_feedback_reject_text"
                      phx-value-id={item.id}
                      data-role="stack-feedback-overlay-reject-text"
                      data-review-item-id={item.id}
                    >{Map.get(@stack_feedback_reject_text, item.id, "")}</textarea>
                    <button
                      type="button"
                      class="btn btn-warning btn-xs"
                      phx-click="stack_feedback_reject_item"
                      phx-value-id={item.id}
                      phx-value-feedback={Map.get(@stack_feedback_reject_text, item.id, "")}
                      data-role="stack-feedback-overlay-reject-submit"
                      data-review-item-id={item.id}
                    >
                      Submit feedback
                    </button>
                  </div>
                  <%!-- Canvas content (inline) — same component the per-
                       task `active_review_canvas` modal uses. If the item
                       carries free-form `content` instead of a canvas
                       reference, render that as the fallback so the
                       reviewer sees something either way. --%>
                  <%= cond do %>
                    <% canvas = is_binary(item.canvas_id) && Map.get(@selected_stack_open_review_canvases, item.canvas_id) -> %>
                      <div
                        class="rounded-md border border-base-300 bg-base-100 p-2"
                        data-role="stack-feedback-overlay-canvas"
                        data-canvas-id={canvas.id}
                      >
                        <PlatformWeb.Chat.CanvasRenderer.canvas_document
                          canvas={canvas}
                          show_header={false}
                          dom_id_base={"stack-feedback-overlay-canvas-#{canvas.id}"}
                        />
                      </div>
                    <% is_binary(item.content) and item.content != "" -> %>
                      <pre
                        class="overflow-x-auto whitespace-pre-wrap rounded-md border border-base-300 bg-base-100 p-2 text-xs text-base-content/80"
                        data-role="stack-feedback-overlay-content"
                      >{item.content}</pre>
                    <% true -> %>
                      <div
                        class="rounded-md border border-dashed border-base-300 bg-base-100 p-2 text-xs text-base-content/50"
                        data-role="stack-feedback-overlay-empty-item"
                      >
                        No reviewable content attached.
                      </div>
                  <% end %>
                </li>
              </ul>
            </li>
          </ul>
        <% end %>
      </div>

      <%!-- Sticky bottom close button — mirrors the stack-detail panel
           action bar so the dismiss target is reachable on tall mobile
           viewports without scrolling all the way back up. --%>
      <div
        class="mt-auto sticky bottom-0 flex gap-2 border-t border-base-300 bg-base-100 px-4 py-3"
        data-role="stack-feedback-overlay-actions"
      >
        <button
          type="button"
          class="btn btn-ghost btn-sm flex-1"
          phx-click="close_stack_feedback_overlay"
          data-role="stack-feedback-overlay-close-bottom"
        >
          Close
        </button>
      </div>
    </div>
  </div>

  <%!-- Review canvas modal --%>
  <div
    :if={@active_review_canvas}
    class="fixed inset-0 z-50 flex items-center justify-center px-4 py-6"
  >
    <div class="absolute inset-0 bg-black/50" phx-click="close_review_canvas" />
    <div class="relative z-10 flex max-h-[90vh] w-full max-w-6xl flex-col overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-2xl">
      <div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
        <div class="min-w-0">
          <div class="truncate text-sm font-semibold">
            {@active_review_canvas.title || "Review canvas"}
          </div>
          <div class="text-xs text-base-content/60">
            {Platform.Chat.CanvasDocument.root_kind(@active_review_canvas.document) || "canvas"}
          </div>
        </div>
        <button
          class="btn btn-ghost btn-sm btn-square"
          phx-click="close_review_canvas"
          aria-label="Close review canvas"
        >
          <span class="hero-x-mark size-4"></span>
        </button>
      </div>
      <div class="overflow-auto p-4">
        <PlatformWeb.Chat.CanvasRenderer.canvas_document
          canvas={@active_review_canvas}
          show_header={false}
          dom_id_base="tasks-review-modal"
        />
      </div>
    </div>
  </div>

  <%!-- Stack dep-graph fullscreen modal. Mirrors the active_review_canvas
       modal chrome above; body re-renders the same stack_dag_layout SVG at
       a much larger container size so 6+ node stacks are legible. Escape
       key close pattern matches the reaction-picker at chat_live.html.heex
       :988. Mobile: card fills viewport via max-sm:* utility overrides so
       tiny iPhone-class canvases reclaim every pixel. --%>
  <div
    :if={@stack_graph_expanded && @selected_stack_members not in [nil, []]}
    id="stack-detail-dag-modal"
    data-role="stack-detail-dag-modal"
    class="fixed inset-0 z-50 flex items-center justify-center px-4 py-6 max-sm:p-0"
    phx-window-keydown="close_stack_graph_expand"
    phx-key="Escape"
  >
    <div
      class="absolute inset-0 bg-black/50"
      phx-click="close_stack_graph_expand"
      data-role="stack-detail-dag-modal-backdrop"
      aria-hidden="true"
    />
    <div class="relative z-10 flex max-h-[90vh] w-full max-w-6xl flex-col overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-2xl max-sm:h-screen max-sm:max-h-none max-sm:w-screen max-sm:rounded-none max-sm:border-0">
      <div class="flex items-center justify-between border-b border-base-300 px-4 py-3 pt-[max(0.75rem,env(safe-area-inset-top))]">
        <div class="min-w-0">
          <div class="truncate text-sm font-semibold">Stack dep graph</div>
          <div class="text-xs text-base-content/60">
            {length(@selected_stack_members)} members
          </div>
        </div>
        <button
          type="button"
          class="btn btn-ghost btn-sm btn-square"
          phx-click="close_stack_graph_expand"
          aria-label="Close dep graph"
          data-role="stack-detail-dag-modal-close"
        >
          <span class="hero-x-mark size-4"></span>
        </button>
      </div>
      <div class="flex-1 overflow-auto p-4 pb-[max(1rem,env(safe-area-inset-bottom))] bg-base-300">
        <% dag_modal = stack_dag_layout(@selected_stack_members)
        {mw, mh} = dag_modal.viewbox %>
        <svg
          viewBox={"0 0 #{mw} #{mh}"}
          preserveAspectRatio="xMidYMid meet"
          xmlns="http://www.w3.org/2000/svg"
          class="w-full h-full min-h-[60vh] block"
          data-role="stack-detail-dag-modal-svg"
        >
          <%= for edge <- dag_modal.edges do %>
            <line
              x1={edge.x1}
              y1={edge.y1}
              x2={edge.x2}
              y2={edge.y2}
              stroke="#7b5cff"
              stroke-width="1.4"
              stroke-dasharray="6,4"
              data-role="stack-detail-dag-modal-edge"
              data-from-id={edge.from_id}
              data-to-id={edge.to_id}
            />
          <% end %>
          <%= for node <- dag_modal.nodes do %>
            <% style = dag_node_style(node.status) %>
            <g data-role="stack-detail-dag-modal-node" data-node-id={node.id}>
              <rect
                x={node.x}
                y={node.y}
                width={node.w}
                height={node.h}
                rx="6"
                fill={style.fill}
                stroke={style.stroke}
                stroke-width="1.2"
                stroke-dasharray={style.dasharray}
                data-status={node.status}
              />
              <text
                x={node.x + 12}
                y={node.y + 18}
                font-size="11"
                font-weight="700"
                fill={style.num_color}
              >
                {node.num}
              </text>
              <text x={node.x + 26} y={node.y + 18} font-size="9" fill={style.text}>
                {dag_node_label(node.label)}
              </text>
              <text
                x={node.x + 26}
                y={node.y + 34}
                font-size="7"
                letter-spacing="0.5"
                fill={style.caption_color}
              >
                {style.caption}
              </text>
            </g>
          <% end %>
        </svg>
      </div>
    </div>
  </div>

  <%!-- Reopen-with-feedback modal (mirrors the assignee-modal shape:
       mobile-first bottom sheet on small screens, centered dialog on
       >=sm). Submit is disabled client-side until the textarea has
       non-whitespace content; the server also re-validates and surfaces
       `:reason_required` as a flash if the client check is bypassed. --%>
  <div
    :if={@show_reopen_modal && @selected_task}
    class="fixed inset-0 z-50 flex items-end sm:items-center justify-center"
    id="reopen-modal"
  >
    <%!-- Backdrop --%>
    <div class="absolute inset-0 bg-black/40" phx-click="close_reopen_modal" />

    <%!-- Sheet / dialog --%>
    <div class="relative w-full max-w-lg rounded-t-2xl sm:rounded-2xl bg-base-100 shadow-2xl pb-[env(safe-area-inset-bottom)] max-h-[90vh] overflow-y-auto">
      <%!-- Header --%>
      <div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
        <div class="min-w-0">
          <h2 class="text-base font-semibold">Reopen with feedback</h2>
          <p class="mt-0.5 text-xs text-base-content/60 truncate">
            {@selected_task.title}
          </p>
        </div>
        <button
          type="button"
          phx-click="close_reopen_modal"
          class="btn btn-sm btn-ghost btn-square"
          aria-label="Close"
        >
          <span class="hero-x-mark size-4"></span>
        </button>
      </div>

      <%!-- Form body --%>
      <form
        id="task-reopen-form"
        phx-hook="ButtonLoading"
        phx-submit="submit_reopen"
        class="flex flex-col gap-3 px-4 py-4"
      >
        <div class="flex flex-col gap-1">
          <label
            for="reopen-reason-textarea"
            class="text-xs font-semibold uppercase tracking-wider text-base-content/60"
          >
            Why is this being reopened?
          </label>
          <textarea
            id="reopen-reason-textarea"
            name="reason"
            data-role="reopen-reason-textarea"
            rows="5"
            phx-change="reopen_reason_changed"
            placeholder="Describe what's wrong, what's missing, or what should change. The active plan will be rejected with this reason and the task will return to planning."
            class="textarea textarea-bordered w-full text-sm"
          >{@reopen_reason}</textarea>
          <p
            :if={String.trim(@reopen_reason) == ""}
            class="text-xs text-base-content/50"
            data-role="reopen-reason-hint"
          >
            A reason is required so the planner has context for the next revision.
          </p>
        </div>

        <div class="flex items-center justify-end gap-2 pt-1">
          <button
            type="button"
            phx-click="close_reopen_modal"
            class="btn btn-ghost btn-sm"
          >
            Cancel
          </button>
          <button
            type="submit"
            data-role="reopen-submit-button"
            class="btn btn-warning btn-sm"
            disabled={String.trim(@reopen_reason) == ""}
          >
            Reopen task
          </button>
        </div>
      </form>
    </div>
  </div>

  <%!-- Return-to-planning modal (in-flight tasks). Same bottom-sheet /
       centered-dialog shape as the reopen modal; only the copy, event
       names, and destructive tone differ. Server-side re-validates the
       reason and surfaces `:reason_required` / `:not_in_flight` /
       `:no_active_plan` as flashes if the client check is bypassed. --%>
  <div
    :if={@show_supersede_modal && @selected_task}
    class="fixed inset-0 z-50 flex items-end sm:items-center justify-center"
    id="supersede-modal"
  >
    <%!-- Backdrop --%>
    <div class="absolute inset-0 bg-black/40" phx-click="close_supersede_modal" />

    <%!-- Sheet / dialog --%>
    <div class="relative w-full max-w-lg rounded-t-2xl sm:rounded-2xl bg-base-100 shadow-2xl pb-[env(safe-area-inset-bottom)] max-h-[90vh] overflow-y-auto">
      <%!-- Header --%>
      <div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
        <div class="min-w-0">
          <h2 class="text-base font-semibold">Return to planning</h2>
          <p class="mt-0.5 text-xs text-base-content/60 truncate">
            {@selected_task.title}
          </p>
        </div>
        <button
          type="button"
          phx-click="close_supersede_modal"
          class="btn btn-sm btn-ghost btn-square"
          aria-label="Close"
        >
          <span class="hero-x-mark size-4"></span>
        </button>
      </div>

      <%!-- Form body --%>
      <form
        id="task-supersede-form"
        phx-hook="ButtonLoading"
        phx-submit="submit_supersede"
        class="flex flex-col gap-3 px-4 py-4"
      >
        <p class="text-xs text-base-content/70" data-role="supersede-explanation">
          This marks the current plan superseded and requires re-planning. Any in-flight executor will stop. The task branch and any open PR are kept intact.
        </p>

        <div class="flex flex-col gap-1">
          <label
            for="supersede-reason-textarea"
            class="text-xs font-semibold uppercase tracking-wider text-base-content/60"
          >
            Why is this being returned to planning?
          </label>
          <textarea
            id="supersede-reason-textarea"
            name="reason"
            data-role="supersede-reason-textarea"
            rows="5"
            phx-change="supersede_reason_changed"
            placeholder="Describe what's wrong or what should change. The current plan will be marked superseded and the task will return to planning."
            class="textarea textarea-bordered w-full text-sm"
          >{@supersede_reason}</textarea>
          <p
            :if={String.trim(@supersede_reason) == ""}
            class="text-xs text-base-content/50"
            data-role="supersede-reason-hint"
          >
            A reason is required so the planner has context for the next revision.
          </p>
        </div>

        <div class="flex items-center justify-end gap-2 pt-1">
          <button
            type="button"
            phx-click="close_supersede_modal"
            class="btn btn-ghost btn-sm"
          >
            Cancel
          </button>
          <button
            type="submit"
            data-role="supersede-submit-button"
            class="btn btn-error btn-sm"
            disabled={String.trim(@supersede_reason) == ""}
          >
            Return to planning
          </button>
        </div>
      </form>
    </div>
  </div>

  <%!-- Single create FAB + anchored menu (re-skin Phase 2 stage 2, task
       019f51ca) replaces the pre-reskin triple FAB stack. Mobile-only
       (md:hidden) — desktop creates via the page-header split button.
       The `@selected_task && "max-md:hidden"` guard keeps the FAB out of
       the way while the task detail panel is open on mobile. Menu items
       fire the SAME sheet-toggle events the old FABs did; those handlers
       also reset :fab_menu_open so picking an item closes the menu.
       data-role="project-create-fab" stays on the New-Project menu item
       for e2e selector stability. --%>
  <.fab_create
    id="tasks-create-fab"
    open={@fab_menu_open}
    toggle_event="toggle_fab_menu"
    label="Create"
    class={["md:hidden", @selected_task && "max-md:hidden"]}
    data-role="fab-create"
  >
    <button
      type="button"
      role="menuitem"
      phx-click="toggle_task_sheet"
      class="flex min-h-11 items-center gap-2 rounded-lg px-3 py-2 text-left text-sm font-medium text-primary hover:bg-base-200 focus-visible-ring"
      data-role="fab-new-task"
    >
      <span class="hero-plus size-4"></span> New Task
    </button>
    <button
      type="button"
      role="menuitem"
      phx-click="toggle_epic_sheet"
      class="flex min-h-11 items-center gap-2 rounded-lg px-3 py-2 text-left text-sm hover:bg-base-200 focus-visible-ring"
      data-role="fab-new-epic"
    >
      <span class="hero-rectangle-stack size-4"></span> New Epic
    </button>
    <button
      type="button"
      role="menuitem"
      phx-click="toggle_project_create_sheet"
      class="flex min-h-11 items-center gap-2 rounded-lg px-3 py-2 text-left text-sm hover:bg-base-200 focus-visible-ring"
      data-role="project-create-fab"
    >
      <span class="hero-folder-plus size-4"></span> New Project
    </button>
  </.fab_create>

  <%!-- Mobile project filter sheet (task 019e0d4b stage 3 sub a). Slides
       in from the left on mobile, hidden entirely on md+ where the project
       filter lives in a different surface. --%>
  <.sheet
    id="project-sheet"
    open={@show_project_sheet}
    placement={:left}
    on_close="close_project_sheet"
    class="md:hidden"
  >
    <:title>Projects</:title>
    <%!-- Stage 5 of ADR-0042: grouped by org with the same <details> shape
         as the desktop sidebar so the mobile sheet stays visually consistent. --%>
    <div class="flex flex-col">
      <details
        :for={{org_slug, _org_name, org_projects} <- @project_sections}
        open
        class="relative"
        data-role="project-group"
        data-org-slug={org_slug}
      >
        <summary class={[
          "flex items-center gap-2 px-3 py-2 text-xs font-semibold uppercase tracking-widest text-base-content/60 cursor-pointer select-none",
          (@fabrikam_admin? and org_slug not in ["fabrikam", "_unassigned"]) && "pr-9"
        ]}>
          <span class={"size-2 rounded-full bg-current #{Tenancy.scope_color(org_slug)}"}></span>
          <span>{Tenancy.scope_label(org_slug)}</span>
          <span class="ml-auto text-[10px] tracking-normal text-base-content/40">
            {length(org_projects)}
          </span>
        </summary>
        <%!-- Mobile org kebab: same lifecycle_menu + events as the desktop
             sidebar, keyed with a `mobile-` prefix so its open-state never
             collides with the desktop menu's data-menu-key in the DOM.
             Positioned sibling of <summary> so a tap opens the menu without
             toggling the native <details>. Root org (Fabrikam) is never offered. --%>
        <.lifecycle_menu
          :if={@fabrikam_admin? and org_slug not in ["fabrikam", "_unassigned"]}
          key={"mobile-org:#{org_slug}"}
          open={@lifecycle_menu_key == "mobile-org:#{org_slug}"}
          type="org"
          id={org_slug}
          name={Tenancy.scope_label(org_slug)}
          class="absolute right-1 top-1.5"
        />
        <div
          :for={project <- org_projects}
          class="relative flex items-center hover:bg-base-200"
        >
          <button
            phx-click="select_project"
            phx-value-id={project.id}
            class={"min-w-0 flex-1 text-left px-5 py-2 text-sm truncate #{if @selected_project_id == project.id, do: "bg-base-200 font-medium"}"}
          >
            {project.name}
          </button>
          <%!-- Kebab stays visible on touch (no hover reveal like desktop). --%>
          <.lifecycle_menu
            :if={@fabrikam_admin?}
            key={"mobile-project:#{project.id}"}
            open={@lifecycle_menu_key == "mobile-project:#{project.id}"}
            type="project"
            id={project.id}
            name={project.name}
            class="relative pr-2"
          />
        </div>
      </details>
    </div>
    <:actions>
      <button phx-click="clear_filters" class="btn btn-xs btn-ghost w-full">
        All Projects
      </button>
    </:actions>
  </.sheet>

  <%!-- Per-phase assignee modal (mobile-first; full-screen sheet on small,
       centered dialog on >=sm) --%>
  <div
    :if={@show_assignee_modal && @selected_task}
    class="fixed inset-0 z-50 flex items-end sm:items-center justify-center"
    id="assignee-modal"
  >
    <%!-- Backdrop --%>
    <div class="absolute inset-0 bg-black/40" phx-click="close_assignee_modal" />

    <%!-- Sheet / dialog --%>
    <div class="relative w-full max-w-lg rounded-t-2xl sm:rounded-2xl bg-base-100 shadow-2xl pb-[env(safe-area-inset-bottom)] max-h-[90vh] overflow-y-auto">
      <%!-- Header --%>
      <div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
        <div>
          <h2 class="text-base font-semibold">Assign Agents</h2>
          <p class="mt-0.5 text-xs text-base-content/60">
            {@selected_task.title}
          </p>
        </div>
        <button
          type="button"
          phx-click="close_assignee_modal"
          class="btn btn-sm btn-ghost btn-square"
          aria-label="Close"
        >
          <span class="hero-x-mark size-4"></span>
        </button>
      </div>

      <%!-- Mode toggle (segmented) --%>
      <div class="flex items-center justify-between px-4 py-3 border-b border-base-300 gap-3">
        <p class="text-xs text-base-content/60 leading-snug">
          {if @assignee_modal_mode == :advanced,
            do: "One agent per phase. Build the DAG.",
            else: "One agent for the whole task."}
        </p>
        <div class="join shrink-0">
          <button
            type="button"
            phx-click="set_assignee_modal_mode"
            phx-value-mode="simple"
            class={[
              "btn btn-sm join-item",
              @assignee_modal_mode == :simple && "btn-primary",
              @assignee_modal_mode != :simple && "btn-ghost"
            ]}
            aria-pressed={if @assignee_modal_mode == :simple, do: "true", else: "false"}
          >
            Simple
          </button>
          <button
            type="button"
            phx-click="set_assignee_modal_mode"
            phx-value-mode="advanced"
            class={[
              "btn btn-sm join-item",
              @assignee_modal_mode == :advanced && "btn-primary",
              @assignee_modal_mode != :advanced && "btn-ghost"
            ]}
            aria-pressed={if @assignee_modal_mode == :advanced, do: "true", else: "false"}
          >
            Advanced
          </button>
        </div>
      </div>

      <%!-- Form body --%>
      <form
        id="task-assignees-form"
        phx-hook="ButtonLoading"
        phx-submit="save_assignees"
        class="flex flex-col gap-3 px-4 py-4"
      >
        <%!-- Simple mode --%>
        <div :if={@assignee_modal_mode == :simple} class="flex flex-col gap-1">
          <label class="text-xs font-semibold uppercase tracking-wider text-base-content/60">
            Agent (all phases)
          </label>
          <select
            name="assignees[all]"
            class="select select-bordered select-sm w-full"
          >
            <option value="">Unassigned</option>
            <option
              :for={agent <- @agents}
              value={agent.id}
              selected={
                phase_assignee_id(@selected_task, "execution") == agent.id ||
                  (is_nil(phase_assignee_id(@selected_task, "execution")) &&
                     @selected_task.assignee_id == agent.id)
              }
            >
              {agent.name}
            </option>
          </select>
        </div>

        <%!-- Advanced mode: per-phase pickers --%>
        <div :if={@assignee_modal_mode == :advanced} class="flex flex-col gap-3">
          <div :for={phase <- ~w(planning execution review)} class="flex flex-col gap-1">
            <label class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-base-content/60">
              <span>{phase_label(phase)}</span>
              <span
                :if={phase == current_phase_label(@selected_task)}
                class="badge badge-primary badge-xs"
              >
                Current
              </span>
            </label>
            <select
              name={"assignees[" <> phase <> "]"}
              class="select select-bordered select-sm w-full"
            >
              <option value="">Unassigned</option>
              <option
                :for={agent <- @agents}
                value={agent.id}
                selected={phase_assignee_id(@selected_task, phase) == agent.id}
              >
                {agent.name}
              </option>
            </select>
          </div>

          <p class="mt-1 text-[11px] text-base-content/50">
            The current-phase agent is the one the task router dispatches to right now.
            When the task transitions across phases, the assignee is updated automatically.
          </p>
        </div>

        <%!-- Actions --%>
        <div class="mt-2 flex justify-end gap-2 border-t border-base-300 pt-3">
          <button
            type="button"
            phx-click="close_assignee_modal"
            class="btn btn-sm btn-ghost"
          >
            Cancel
          </button>
          <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>

  <%!-- Stack-level assignee modal (ADR 0041 — assign agents at the stack
       level). Mirrors the per-task assignee modal: simple/advanced
       segmented control, same sheet-on-mobile / dialog-on-desktop shape.
       The stack-level assignment is the default that fans out to every
       member that is not individually overridden. --%>
  <div
    :if={@show_stack_assignee_modal && @selected_stack}
    class="fixed inset-0 z-50 flex items-end sm:items-center justify-center"
    id="stack-assignee-modal"
  >
    <%!-- Backdrop --%>
    <div class="absolute inset-0 bg-black/40" phx-click="close_stack_assignee_modal" />

    <%!-- Sheet / dialog --%>
    <div class="relative w-full max-w-lg rounded-t-2xl sm:rounded-2xl bg-base-100 shadow-2xl pb-[env(safe-area-inset-bottom)] max-h-[90vh] overflow-y-auto">
      <%!-- Header --%>
      <div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
        <div>
          <h2 class="text-base font-semibold">Assign Agents</h2>
          <p class="mt-0.5 text-xs text-base-content/60">
            {@selected_stack.name} · stack-level default
          </p>
        </div>
        <button
          type="button"
          phx-click="close_stack_assignee_modal"
          class="btn btn-sm btn-ghost btn-square"
          aria-label="Close"
        >
          <span class="hero-x-mark size-4"></span>
        </button>
      </div>

      <%!-- Mode toggle (segmented) --%>
      <div class="flex items-center justify-between px-4 py-3 border-b border-base-300 gap-3">
        <p class="text-xs text-base-content/60 leading-snug">
          {if @stack_assignee_modal_mode == :advanced,
            do: "One agent per phase, applied to every member.",
            else: "One agent for the whole stack."}
        </p>
        <div class="join shrink-0">
          <button
            type="button"
            phx-click="set_stack_assignee_modal_mode"
            phx-value-mode="simple"
            class={[
              "btn btn-sm join-item",
              @stack_assignee_modal_mode == :simple && "btn-primary",
              @stack_assignee_modal_mode != :simple && "btn-ghost"
            ]}
            aria-pressed={if @stack_assignee_modal_mode == :simple, do: "true", else: "false"}
          >
            Simple
          </button>
          <button
            type="button"
            phx-click="set_stack_assignee_modal_mode"
            phx-value-mode="advanced"
            class={[
              "btn btn-sm join-item",
              @stack_assignee_modal_mode == :advanced && "btn-primary",
              @stack_assignee_modal_mode != :advanced && "btn-ghost"
            ]}
            aria-pressed={if @stack_assignee_modal_mode == :advanced, do: "true", else: "false"}
          >
            Advanced
          </button>
        </div>
      </div>

      <%!-- Form body --%>
      <form
        id="stack-assignees-form"
        phx-hook="ButtonLoading"
        phx-submit="save_stack_assignees"
        class="flex flex-col gap-3 px-4 py-4"
      >
        <%!-- Simple mode --%>
        <div :if={@stack_assignee_modal_mode == :simple} class="flex flex-col gap-1">
          <label class="text-xs font-semibold uppercase tracking-wider text-base-content/60">
            Agent (all phases)
          </label>
          <select
            name="assignees[all]"
            class="select select-bordered select-sm w-full"
          >
            <option value="">Unassigned</option>
            <option
              :for={agent <- @agents}
              value={agent.id}
              selected={stack_phase_assignee_id(@selected_stack, "execution") == agent.id}
            >
              {agent.name}
            </option>
          </select>
        </div>

        <%!-- Advanced mode: per-phase pickers --%>
        <div :if={@stack_assignee_modal_mode == :advanced} class="flex flex-col gap-3">
          <div :for={phase <- ~w(planning execution review)} class="flex flex-col gap-1">
            <label class="text-xs font-semibold uppercase tracking-wider text-base-content/60">
              {phase_label(phase)}
            </label>
            <select
              name={"assignees[" <> phase <> "]"}
              class="select select-bordered select-sm w-full"
            >
              <option value="">Unassigned</option>
              <option
                :for={agent <- @agents}
                value={agent.id}
                selected={stack_phase_assignee_id(@selected_stack, phase) == agent.id}
              >
                {agent.name}
              </option>
            </select>
          </div>

          <p class="mt-1 text-[11px] text-base-content/50">
            This stack-level assignment is the default. It fans out to every member that
            isn't individually overridden — members with their own assignment are left
            untouched.
          </p>
        </div>

        <%!-- Actions --%>
        <div class="mt-2 flex justify-end gap-2 border-t border-base-300 pt-3">
          <button
            type="button"
            phx-click="close_stack_assignee_modal"
            class="btn btn-sm btn-ghost"
          >
            Cancel
          </button>
          <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>

  <%!-- New-task sheet (task 019e0d4b stage 3 sub b). Bottom sheet on mobile,
       centered card on desktop per <.sheet> spec §3 @media(min-width: 768px).
       The form lives inside :inner_block; submit buttons stay inside the form
       for proper form-submission semantics (not in :actions slot).

       :if={@show_task_sheet} on the Sheet itself (rather than open={@flag})
       — the form has many select dropdowns (project, epic, agent) that would
       otherwise leak option text into the always-rendered DOM and break
       refute-by-text assertions in the existing test suite (e.g. the epic-
       toggle-collapse test). --%>
  <.sheet
    :if={@show_task_sheet}
    id="task-sheet"
    open={true}
    placement={:bottom}
    on_close="close_task_sheet"
  >
    <:title>New Task</:title>
    <.form
      for={@task_form}
      id="create-task-form"
      phx-hook="ButtonLoading"
      phx-change="validate_task"
      phx-submit="create_task"
      class="form-fields space-y-4"
    >
      <%!-- Title --%>
      <div>
        <label class="label label-text text-xs font-medium">Title *</label>
        <input
          type="text"
          name="task[title]"
          value={@task_form[:title].value}
          required
          placeholder="Add unread badges"
          class="input input-bordered w-full"
        />
      </div>

      <%!-- Project. Stage 5 of ADR-0042 groups options by their owning org
           via <optgroup>, mirroring the sidebar's grouped layout. --%>
      <div>
        <label class="label label-text text-xs font-medium">Project *</label>
        <select name="task[project_id]" class="select select-bordered w-full" required>
          <option value="">Select project</option>
          <optgroup
            :for={{org_slug, _org_name, org_projects} <- @projects_by_org}
            label={Tenancy.scope_label(org_slug)}
          >
            <option
              :for={project <- org_projects}
              value={project.id}
              selected={@task_form[:project_id].value == project.id}
            >
              {project.name}
            </option>
          </optgroup>
        </select>
      </div>

      <%!-- What --%>
      <div>
        <label class="label label-text text-xs font-medium">What *</label>
        <textarea
          name="task[what]"
          required
          placeholder="What is being changed or added?"
          style="field-sizing:content"
          class="textarea textarea-bordered w-full min-h-10 max-h-50 leading-normal"
        >{@sheet_what}</textarea>
      </div>

      <%!-- Why --%>
      <div>
        <label class="label label-text text-xs font-medium">Why *</label>
        <textarea
          name="task[why]"
          required
          placeholder="Why is this change needed?"
          style="field-sizing:content"
          class="textarea textarea-bordered w-full min-h-10 max-h-50 leading-normal"
        >{@sheet_why}</textarea>
      </div>

      <%!-- Epic --%>
      <div>
        <label class="label label-text text-xs font-medium">Epic</label>
        <select name="task[epic_id]" class="select select-bordered w-full">
          <option value="">None</option>
          <option
            :for={epic <- @epics}
            value={epic.id}
            selected={@task_form[:epic_id].value == epic.id}
          >
            {epic.name}
          </option>
        </select>
      </div>

      <%!-- Agent --%>
      <div>
        <label class="label label-text text-xs font-medium">Agent</label>
        <select name="task[assignee_id]" class="select select-bordered w-full">
          <option value="">None</option>
          <option
            :for={agent <- @agents}
            value={agent.id}
            selected={@task_form[:assignee_id].value == agent.id}
          >
            {agent.name}
          </option>
        </select>
        <input type="hidden" name="task[assignee_type]" value="agent" />
      </div>

      <%!-- Sponsor — nullable human user who shepherds this task (ADR-0042
           stage 3). Distinct from Agent (technical assignee): a Sponsor is the
           human owner of "does this ship?" not "does this compile?". Defaults
           to No Sponsor for v1 to prevent thoughtless assignment; the acting
           user can pick themselves explicitly. --%>
      <div>
        <label class="label label-text text-xs font-medium">Sponsor</label>
        <select name="task[sponsor_user_id]" class="select select-bordered w-full">
          <option value="" selected={is_nil(@task_form[:sponsor_user_id].value)}>
            No Sponsor
          </option>
          <option
            :for={user <- @users}
            value={user.id}
            selected={@task_form[:sponsor_user_id].value == user.id}
          >
            {user.name}
          </option>
        </select>
      </div>

      <%!-- Auto-approve plan (019f25f2 stage 4) — skips the human plan-review
           step when the plan meets preconditions (every stage has an assignee).
           Backend precondition lives in Platform.Tasks.submit_plan_for_review/1
           (see stage 2). Copy stays in the "stages" mental model even though
           the log path uses the more precise "execution/review assignee" term. --%>
      <div class="space-y-2">
        <label class="label cursor-pointer justify-start gap-2">
          <input
            type="checkbox"
            name="task[auto_approve_plan]"
            value="true"
            checked={@auto_approve_plan_enabled}
            class="toggle toggle-sm toggle-primary"
            phx-click="toggle_auto_approve_plan"
          />
          <span class="label-text text-xs">Auto-approve plan</span>
          <div
            class="tooltip tooltip-top"
            data-tip="Skip the human approval step when the plan is submitted. Requires every stage to have an assigned agent."
          >
            <span class="hero-information-circle size-3.5 opacity-50"></span>
          </div>
        </label>
      </div>

      <%!-- Deploy target — nullable string; entries come from the selected
           project's deploy_config.deploy_targets. Selector disabled when the
           project has none configured or when no project is selected yet.
           Mirrors the detail-pane deploy_target dropdown at
           tasks_live.html.heex line ~1305. Distinct from Deploy Strategy
           (below) which sets the strategy shape rather than the destination.
           ADR 0044 stage 4 — sheet↔MCP parity. --%>
      <div>
        <label class="label label-text text-xs font-medium">Deploy Target</label>
        <% sheet_project_targets = sheet_project_deploy_targets(@task_form, @projects_by_org) %>
        <select
          name="task[deploy_target]"
          data-role="sheet-deploy-target-select"
          disabled={sheet_project_targets == []}
          class="select select-bordered w-full"
        >
          <option value="" selected={is_nil(@task_form[:deploy_target].value)}>
            {if sheet_project_targets == [], do: "(no targets configured)", else: "(none)"}
          </option>
          <option
            :for={t <- sheet_project_targets}
            value={t}
            selected={@task_form[:deploy_target].value == t}
          >
            {deploy_target_label(t)}
          </option>
        </select>
      </div>

      <%!-- Deploy Strategy --%>
      <div>
        <label class="label label-text text-xs font-medium">Deploy Strategy</label>
        <select
          name="task[deploy_strategy_type]"
          id="deploy-strategy-type"
          class="select select-bordered w-full"
          phx-change="validate_task"
        >
          <option value="inherit">Inherit from project</option>
          <option value="pr_merge">PR Merge</option>
          <option value="docker_deploy">Docker Deploy</option>
          <option value="skill_driven">Skill Driven</option>
          <option value="manual">Manual</option>
          <option value="none">None (skip deploy)</option>
        </select>
      </div>
      <%!-- Auto-merge config — visible only when PR Merge is selected --%>
      <div
        :if={@deploy_strategy_type == "pr_merge"}
        class="space-y-2 pl-2 border-l-2 border-base-300"
      >
        <label class="label cursor-pointer justify-start gap-2">
          <input
            type="checkbox"
            name="task[auto_merge]"
            value="true"
            checked={@auto_merge_enabled}
            class="toggle toggle-sm toggle-primary"
            phx-click="toggle_auto_merge"
          />
          <span class="label-text text-xs">
            Auto-merge after CI passes
          </span>
          <div
            class="tooltip tooltip-top"
            data-tip="When enabled, PRs are automatically merged after CI passes. When disabled, a human must click merge."
          >
            <span class="hero-information-circle size-3.5 opacity-50"></span>
          </div>
        </label>
        <div :if={@auto_merge_enabled}>
          <label class="label label-text text-xs font-medium">Merge Method</label>
          <select
            name="task[merge_method]"
            class="select select-bordered select-xs w-full"
          >
            <option value="squash" selected={@merge_method == "squash"}>Squash</option>
            <option value="merge" selected={@merge_method == "merge"}>Merge commit</option>
            <option value="rebase" selected={@merge_method == "rebase"}>Rebase</option>
          </select>
        </div>
      </div>

      <%!-- Validation Mode --%>
      <div>
        <label class="label label-text text-xs font-medium">Validation</label>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            phx-click="toggle_validation_mode"
            phx-value-mode="show_me"
            class={"btn btn-sm #{if MapSet.member?(@validation_modes, "show_me"), do: "btn-primary", else: "btn-outline"}"}
          >
            Show me
          </button>
          <button
            type="button"
            phx-click="toggle_validation_mode"
            phx-value-mode="handle_it"
            class={"btn btn-sm #{if MapSet.member?(@validation_modes, "handle_it"), do: "btn-primary", else: "btn-outline"}"}
          >
            Handle it
          </button>
          <button
            type="button"
            phx-click="toggle_validation_mode"
            phx-value-mode="manual"
            class={"btn btn-sm #{if MapSet.member?(@validation_modes, "manual"), do: "btn-primary", else: "btn-outline"}"}
          >
            Manual
          </button>
        </div>
        <textarea
          :if={MapSet.member?(@validation_modes, "manual")}
          name="task[manual_validation_text]"
          placeholder="Describe the validation criteria..."
          style="line-height:1.5;padding:6px 12px;min-height:33px;max-height:200px;overflow-y:auto;field-sizing:content"
          class="textarea textarea-bordered mt-2 w-full text-sm"
        >{@manual_validation_text}</textarea>
      </div>

      <%!-- Attachments --%>
      <div>
        <label class="label label-text text-xs font-medium">Attachments</label>
        <.live_file_input
          upload={@uploads.task_attachments}
          class="file-input file-input-bordered file-input-sm w-full"
        />
        <div
          :for={entry <- @uploads.task_attachments.entries}
          class="mt-2 flex items-center gap-2 text-xs"
        >
          <span class="flex-1 truncate">{entry.client_name}</span>
          <span class="text-base-content/40">
            {Float.round(entry.client_size / 1_000, 1)} KB
          </span>
          <button
            type="button"
            phx-click="cancel_task_upload"
            phx-value-ref={entry.ref}
            class="btn btn-ghost btn-xs btn-square"
          >
            <span class="hero-x-mark size-3"></span>
          </button>
        </div>
        <div
          :for={err <- upload_errors(@uploads.task_attachments)}
          class="mt-1 text-xs text-error"
        >
          {err}
        </div>
      </div>

      <%!-- Submit buttons --%>
      <div class="flex gap-2 pt-2">
        <button
          type="submit"
          name="task[action]"
          value="create"
          class="btn btn-primary btn-sm flex-1"
        >
          Create Task
        </button>
        <button
          type="submit"
          name="task[action]"
          value="create_and_plan"
          class="btn btn-secondary btn-sm flex-1"
        >
          Create & Request Plan
        </button>
      </div>
    </.form>
  </.sheet>

  <%!-- New-epic sheet (task 019d60ca stage 3). Mirrors the new-task sheet
       wrapper styling so the mobile bottom-sheet pattern stays consistent
       (env(safe-area-inset-bottom) padding, max-h-75vh scroll, rounded-t-2xl
       drawer card). The form is intentionally smaller than tasks: epics are
       containers with no agent / plan / validation knobs at create time. --%>
  <.sheet
    :if={@show_epic_sheet}
    id="epic-sheet"
    open={true}
    placement={:bottom}
    on_close="close_epic_sheet"
  >
    <:title>New Epic</:title>
    <.form
      for={@epic_form}
      id="create-epic-form"
      phx-change="validate_epic"
      phx-submit="create_epic"
      class="form-fields space-y-4"
    >
      <%!-- Name --%>
      <div>
        <label class="label label-text text-xs font-medium">Name *</label>
        <input
          type="text"
          name="epic[name]"
          value={@epic_form[:name].value}
          required
          placeholder="Mobile redesign"
          class="input input-bordered w-full"
        />
        <p
          :for={msg <- Enum.map(@epic_form[:name].errors, &translate_error/1)}
          class="mt-1 text-xs text-error"
        >
          {msg}
        </p>
      </div>

      <%!-- Project. When the board is filtered to a single project we hide
           the picker entirely and pin via a hidden input — matches Rowan's
           brief and removes a redundant click. Otherwise show a select. --%>
      <%= if @selected_project_id do %>
        <input type="hidden" name="epic[project_id]" value={@selected_project_id} />
      <% else %>
        <div>
          <label class="label label-text text-xs font-medium">Project *</label>
          <select
            name="epic[project_id]"
            class="select select-bordered w-full"
            required
          >
            <option value="">Select project</option>
            <%!-- Stage 5 of ADR-0042: group by owning org via <optgroup>. --%>
            <optgroup
              :for={{org_slug, _org_name, org_projects} <- @projects_by_org}
              label={Tenancy.scope_label(org_slug)}
            >
              <option
                :for={project <- org_projects}
                value={project.id}
                selected={@epic_form[:project_id].value == project.id}
              >
                {project.name}
              </option>
            </optgroup>
          </select>
          <p
            :for={msg <- Enum.map(@epic_form[:project_id].errors, &translate_error/1)}
            class="mt-1 text-xs text-error"
          >
            {msg}
          </p>
        </div>
      <% end %>

      <%!-- Description (optional) --%>
      <div>
        <label class="label label-text text-xs font-medium">Description</label>
        <textarea
          name="epic[description]"
          placeholder="What is this epic about?"
          style="line-height:1.5;padding:6px 12px;min-height:33px;max-height:200px;overflow-y:auto;field-sizing:content"
          class="textarea textarea-bordered w-full text-sm"
        >{@epic_form[:description].value}</textarea>
      </div>

      <%!-- Acceptance criteria (optional) --%>
      <div>
        <label class="label label-text text-xs font-medium">Acceptance criteria</label>
        <textarea
          name="epic[acceptance_criteria]"
          placeholder="How will we know this epic is done?"
          style="line-height:1.5;padding:6px 12px;min-height:33px;max-height:200px;overflow-y:auto;field-sizing:content"
          class="textarea textarea-bordered w-full text-sm"
        >{@epic_form[:acceptance_criteria].value}</textarea>
      </div>

      <%!-- Target branch (optional) --%>
      <div>
        <label class="label label-text text-xs font-medium">Target branch</label>
        <input
          type="text"
          name="epic[target_branch]"
          value={@epic_form[:target_branch].value}
          placeholder="main"
          class="input input-bordered w-full"
        />
      </div>

      <%!-- Deploy target (optional) --%>
      <div>
        <label class="label label-text text-xs font-medium">Deploy target</label>
        <input
          type="text"
          name="epic[deploy_target]"
          value={@epic_form[:deploy_target].value}
          placeholder="staging"
          class="input input-bordered w-full"
        />
      </div>

      <%!-- Submit + Cancel --%>
      <div class="flex gap-2 pt-2">
        <button
          type="button"
          phx-click="close_epic_sheet"
          class="btn btn-ghost btn-sm flex-1"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="btn btn-primary btn-sm flex-1"
        >
          Create Epic
        </button>
      </div>
    </.form>
  </.sheet>

  <%!-- New-Project sheet (ADR-0042 stage 5). Mirrors the New-Epic sheet's
       shape: bottom drawer on mobile, modal on desktop (the `.sheet`
       component handles the responsive split). The form requires org_id;
       defaults to the current user's primary membership's org, else Fabrikam. --%>
  <.sheet
    :if={@show_project_create_sheet}
    id="project-create-sheet"
    open={true}
    placement={:bottom}
    on_close="close_project_create_sheet"
  >
    <:title>New Project</:title>
    <.form
      for={@project_form}
      id="create-project-form"
      phx-change="validate_project"
      phx-submit="create_project"
      class="form-fields space-y-4"
      data-role="project-create-form"
    >
      <%!-- Name --%>
      <div>
        <label class="label label-text text-xs font-medium">Name *</label>
        <input
          type="text"
          name="project[name]"
          value={@project_form[:name].value}
          required
          placeholder="Storefront"
          class="input input-bordered w-full"
        />
        <p
          :for={msg <- Enum.map(@project_form[:name].errors, &translate_error/1)}
          class="mt-1 text-xs text-error"
        >
          {msg}
        </p>
      </div>

      <%!-- Slug (optional — auto-derived from name when blank) --%>
      <div>
        <label class="label label-text text-xs font-medium">Slug</label>
        <input
          type="text"
          name="project[slug]"
          value={@project_form[:slug].value}
          placeholder="storefront"
          class="input input-bordered w-full"
        />
        <p
          :for={msg <- Enum.map(@project_form[:slug].errors, &translate_error/1)}
          class="mt-1 text-xs text-error"
        >
          {msg}
        </p>
        <p class="mt-1 text-xs text-base-content/40">
          Leave blank to auto-derive from name.
        </p>
      </div>

      <%!-- Org (required per ADR-0042). --%>
      <div>
        <label class="label label-text text-xs font-medium">Org *</label>
        <select
          name="project[org_id]"
          class="select select-bordered w-full"
          required
          data-role="project-create-org-select"
        >
          <option value="">Select org</option>
          <option
            :for={org <- @orgs}
            value={org.id}
            selected={@project_form[:org_id].value == org.id}
          >
            {Tenancy.scope_label(org.slug)}
          </option>
        </select>
        <p
          :for={msg <- Enum.map(@project_form[:org_id].errors, &translate_error/1)}
          class="mt-1 text-xs text-error"
        >
          {msg}
        </p>
      </div>

      <%!-- Submit + Cancel --%>
      <div class="flex gap-2 pt-2">
        <button
          type="button"
          phx-click="close_project_create_sheet"
          class="btn btn-ghost btn-sm flex-1"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="btn btn-primary btn-sm flex-1"
        >
          Create Project
        </button>
      </div>
    </.form>
  </.sheet>

  <%!-- Per-row task-actions sheet (task 019e0d4b stage 2). Replaces the
       inert mobile DaisyUI dropdown that used to live inline in each
       task row. Single sheet at the page bottom; renders only when
       @open_task_actions_id is set. The sheet's :open attr drives the
       slide-in animation; @open_task_actions_id is the source of truth
       for which row's actions are showing. --%>
  <.sheet
    :if={@open_task_actions_id}
    id="task-actions-sheet"
    open={true}
    placement={:bottom}
    on_close="close_task_actions"
  >
    <:title>Task actions</:title>
    <div class="flex flex-col gap-1">
      <button
        type="button"
        phx-click="select_task_and_delete"
        phx-value-id={@open_task_actions_id}
        class="flex items-center gap-3 rounded-lg px-4 py-3 text-left text-error hover:bg-base-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-error/60"
      >
        <span class="hero-trash size-5"></span>
        <span class="font-medium">Delete task</span>
      </button>
    </div>
  </.sheet>

  <%!-- Schedule-deletion confirm dialog (task 019f4eaa stage 6). Archive is
       instant + reversible with no modal; only this destructive step confirms. --%>
  <.schedule_delete_modal
    resource={@delete_modal}
    retention_days={Tenancy.Lifecycle.retention_days()}
  />

  <%!-- Archive undo toast (task 019f4eaa). Archive stays instant + dialog-free
       by design; this says what it took and keeps the reversal one click away.
       Top-level sibling — pinned chrome must never nest in an :if region. --%>
  <.archive_undo_toast undo={@undo_archive} />
</div>
