<div
  id="tasks-last-project"
  phx-hook="LastProject"
  data-selected-project-id={@selected_project_id || "__all__"}
  class="flex h-full min-h-0"
>
  <%!-- Desktop sidebar --%>
  <aside
    :if={@sidebar_open}
    class="hidden w-56 shrink-0 flex-col border-r border-base-300 bg-base-100 md:flex"
  >
    <div class="flex items-center justify-between border-b border-base-300 px-3 py-3">
      <span class="text-xs font-semibold uppercase tracking-widest text-base-content/60">
        Projects
      </span>
      <div class="flex items-center gap-1">
        <button
          phx-click="toggle_projects_section"
          class="btn btn-ghost btn-xs btn-square"
          title={if @projects_collapsed, do: "Expand projects", else: "Collapse projects"}
        >
          <span class={"size-4 transition-transform #{if @projects_collapsed, do: "hero-chevron-down", else: "hero-chevron-up"}"}>
          </span>
        </button>
        <button
          phx-click="toggle_sidebar"
          class="btn btn-ghost btn-xs btn-square"
          title="Close sidebar"
        >
          <span class="hero-chevron-left size-4"></span>
        </button>
      </div>
    </div>

    <div :if={!@projects_collapsed} class="flex-1 overflow-y-auto">
      <button
        :for={project <- @projects}
        phx-click="select_project"
        phx-value-id={project.id}
        class={"w-full text-left px-3 py-2 text-sm hover:bg-base-200 #{if @selected_project_id == project.id, do: "bg-base-200 font-medium"}"}
      >
        {project.name}
      </button>
    </div>

    <div class="border-t border-base-300 p-2">
      <button phx-click="clear_filters" class="btn btn-xs btn-ghost w-full">All Projects</button>
    </div>
  </aside>

  <%!-- Sidebar collapsed toggle (desktop) --%>
  <button
    :if={!@sidebar_open}
    phx-click="toggle_sidebar"
    class="hidden md:flex items-center justify-center w-6 shrink-0 border-r border-base-300 hover:bg-base-200"
    title="Expand sidebar"
  >
    <span class="hero-chevron-right size-4 text-base-content/50"></span>
  </button>

  <%!-- Main content area --%>
  <div class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden">
    <%!-- Board header --%>
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-base-300 px-4 py-3">
      <div class="flex items-center gap-3">
        <%!-- Mobile: project sheet trigger --%>
        <button
          phx-click="toggle_project_sheet"
          class="btn btn-ghost btn-xs btn-square md:hidden"
          title="Projects"
          aria-label="Open projects menu"
        >
          <span class="hero-bars-3 size-4"></span>
        </button>
        <h1 class="text-sm font-semibold uppercase tracking-widest text-base-content/60">
          Tasks
        </h1>
        <span class="badge badge-ghost badge-sm">{length(@all_tasks)}</span>
        <span :if={@pending_plan_count > 0} class="badge badge-warning badge-sm gap-1">
          {@pending_plan_count} awaiting review
        </span>
      </div>

      <%!-- Active filter breadcrumb --%>
      <div :if={@selected_project_id} class="flex items-center gap-1 text-xs text-base-content/60">
        <span :for={p <- @projects} :if={p.id == @selected_project_id}>{p.name}</span>
        <span :if={@selected_epic_id}>
          / <span :for={e <- @epics} :if={e.id == @selected_epic_id}>{e.name}</span>
        </span>
        <button
          phx-click="clear_filters"
          class="btn btn-ghost btn-xs btn-square ml-1"
          aria-label="Clear filters"
        >
          <span class="hero-x-mark size-3"></span>
        </button>
      </div>
    </div>

    <%!-- Epics above board --%>
    <div :if={@selected_project_id && @epics != []} class="px-4 pt-3" id="epics-section">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold uppercase tracking-widest text-base-content/50">
          Epics
        </span>
        <button
          phx-click="toggle_epics_panel"
          class="btn btn-ghost btn-xs btn-square"
          aria-label={if @epics_collapsed, do: "Expand epics", else: "Collapse epics"}
          aria-expanded={if @epics_collapsed, do: "false", else: "true"}
        >
          <span class={"size-4 transition-transform #{if @epics_collapsed, do: "hero-chevron-down", else: "hero-chevron-up"}"}>
          </span>
        </button>
      </div>
      <div :if={!@epics_collapsed} class="flex gap-3 overflow-x-auto pb-2">
        <div
          :for={epic <- @epics}
          phx-click="select_epic"
          phx-value-id={epic.id}
          class={"card card-compact min-w-[180px] max-w-[220px] shrink-0 cursor-pointer border bg-base-100 shadow-sm transition-all hover:shadow-md #{if @selected_epic_id == epic.id, do: "border-primary ring-2 ring-primary", else: "border-base-300"}"}
        >
          <div class="card-body gap-1 p-3">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-sm font-bold truncate">{epic.name}</h3>
              <span class={epic_status_badge_class(epic.status)}>{epic.status}</span>
            </div>
            <p :if={epic.description} class="text-xs text-base-content/60 line-clamp-2">
              {epic.description}
            </p>
            <div class="flex items-center gap-2 mt-1 text-xs text-base-content/50">
              <span>{epic.task_count} tasks</span>
              <span class="text-success">{epic.done_count} done</span>
            </div>
            <div
              :if={Map.get(epic, :target_branch)}
              class="flex items-center gap-1 mt-1 text-xs text-info"
            >
              <span class="hero-code-bracket size-3"></span>
              <span class="truncate">{Map.get(epic, :target_branch)}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%!-- Mobile task list — section-grouped vertical layout (audit 1B-USE-2).
         Replaces the horizontal kanban below md:. The kanban below this block
         is hidden on mobile via the same breakpoint, so desktop stays
         unchanged.

         Status-filter pill bar (Marlowe + Rowan, 2026-05-12) reuses the chat
         channel-pill pattern. Default-active = "in_progress" so users land
         on actionable work; previously the section iteration began at
         "Backlog" which buried in-progress work below the scroll fold. The
         @mobile_columns order (in_progress first) controls both the pill
         order and the rendered-section order — desktop @kanban_columns is
         unchanged. --%>
    <%!-- The inner scroll container (`flex-1 overflow-y-auto pb-24`)
         provides comfortable scroll-end padding so the last task isn't
         flush with the bottom-nav. The outer wrapper used to also carry
         pb-24 (pre-PR #334, when the shell wasn't properly bounded);
         that's now redundant and shows up as ~96px of empty space below
         the scroller. --%>
    <div
      :if={!(@show_detail && @selected_task)}
      id="tasks-mobile-list"
      class="md:hidden flex flex-1 flex-col overflow-hidden"
    >
      <%!-- T6 status-filter pill nav (PR #328). Counts are derived from
           `@board_items` so stack cards contribute to the per-pill
           total — `@columns` is task-only and would undercount. --%>
      <nav
        id="tasks-status-filter-pills"
        phx-hook="TasksStatusFilter"
        class="flex items-center gap-2 overflow-x-auto px-3 py-2 border-b border-base-content/10 shrink-0"
        style="scrollbar-width: none; -webkit-overflow-scrolling: touch;"
        aria-label="Filter tasks by status"
      >
        <button
          :for={{col_key, col_label} <- @mobile_columns}
          type="button"
          phx-click="filter_by_status"
          phx-value-status={col_key}
          aria-pressed={@active_status_filter == col_key}
          class={[
            "flex items-center gap-1.5 px-3 py-1.5 rounded-full whitespace-nowrap text-[13px] font-medium shrink-0 transition-all",
            "active:scale-[0.97] ease-[cubic-bezier(0.16,1,0.3,1)]",
            if @active_status_filter == col_key do
              "bg-primary text-primary-content shadow-[0_0_16px_oklch(0.78_0.14_207_/_0.18)]"
            else
              "bg-base-200 text-base-content/70 border border-base-content/10 hover:bg-base-300"
            end
          ]}
        >
          <span class={["size-1.5 rounded-full", status_dot_class(col_key)]} aria-hidden="true">
          </span>
          {col_label}
          <span
            :if={length(Map.get(@board_items, col_key, [])) > 0}
            class={[
              "inline-flex items-center justify-center min-w-[18px] h-[18px] rounded-full text-[10px] font-bold tabular-nums",
              if(@active_status_filter == col_key,
                do: "bg-primary-content/20 text-primary-content",
                else: "bg-base-300 text-base-content/70"
              )
            ]}
          >
            {length(Map.get(@board_items, col_key, []))}
          </span>
        </button>
      </nav>

      <%!-- T7 mobile section list, rebased on top of T6's pill filter.
           Iterates `@mobile_columns` for ordering + only renders the
           active-filter section. Items come from `@board_items` so
           stack cards interleave with standalone tasks (sorted by
           `updated_at`, ADR 0041). Stack cards include the stage-3
           expansion contract (`stack-member-mobile-#{id}` rows + dep
           annotations). Empty-state checks also use `@board_items`. --%>
      <div class="flex-1 overflow-y-auto px-3 pb-24">
        <div
          :for={{col_key, col_label} <- @mobile_columns}
          :if={@active_status_filter == col_key && Map.get(@board_items, col_key, []) != []}
          class="mt-4 first:mt-2"
        >
          <h2 class="text-xs font-semibold uppercase tracking-widest text-base-content/50 mb-2 px-1">
            {col_label} · {length(Map.get(@board_items, col_key, []))}
          </h2>
          <div class="flex flex-col gap-2">
            <% column_items = Map.get(@board_items, col_key, []) %>
            <%= for item <- column_items do %>
              <%= case item.__struct__ do %>
                <% Platform.Tasks.Stack -> %>
                  <% board_data =
                    Map.get(@stack_board_data, item.id, %{
                      member_count: 0,
                      dep_edge_count: 0,
                      ready_count: 0,
                      members: []
                    }) %>
                  <div
                    data-stack-card="true"
                    data-stack-id={item.id}
                    data-expanded={
                      if(MapSet.member?(@expanded_stacks, item.id), do: "true", else: "false")
                    }
                    class="flex flex-col rounded-box border-l-4 border-violet-500 border border-base-300 bg-base-100"
                  >
                    <%!-- T8 stage 1: header opens the stack detail
                         panel. Chevron is split into its own sibling
                         button so the inline-expansion toggle remains
                         reachable without bubbling through the panel
                         opener (Discord "click thread to enter" pattern,
                         Option A in the T8 dispatch). --%>
                    <div class="relative flex min-w-0 items-stretch">
                      <button
                        type="button"
                        phx-click="open_stack_detail"
                        phx-value-id={item.id}
                        data-role="stack-header"
                        class="flex min-w-0 flex-1 flex-col gap-1.5 p-3 text-left transition-colors hover:bg-base-200/60 focus-visible-ring min-h-[44px]"
                      >
                        <div class="flex min-w-0 items-center gap-2 pr-7">
                          <span
                            class="hero-rectangle-stack size-4 shrink-0 text-violet-300"
                            aria-hidden="true"
                          >
                          </span>
                          <span class="text-[9px] font-semibold uppercase tracking-wider text-violet-300 shrink-0">
                            Stack
                          </span>
                          <span class="ml-auto text-[10px] text-base-content/50 font-medium whitespace-nowrap shrink-0">
                            {board_data.ready_count}/{board_data.member_count} ready
                          </span>
                        </div>
                        <h3 class="text-sm font-medium leading-snug truncate min-w-0">
                          {item.name}
                        </h3>
                        <div class="flex min-w-0 items-center gap-1.5 text-[10px] text-base-content/60">
                          <span class="bg-base-200 px-1.5 py-0.5 rounded whitespace-nowrap shrink-0">
                            {board_data.member_count} tasks
                          </span>
                          <span class="bg-base-200 px-1.5 py-0.5 rounded whitespace-nowrap shrink-0">
                            {board_data.dep_edge_count} dep edges
                          </span>
                        </div>
                      </button>
                      <button
                        type="button"
                        phx-click="toggle_stack_expand"
                        phx-value-id={item.id}
                        data-role="stack-chevron"
                        aria-label="Toggle stack expansion"
                        aria-expanded={
                          if(MapSet.member?(@expanded_stacks, item.id), do: "true", else: "false")
                        }
                        class="absolute right-0 top-0 flex h-11 w-9 items-center justify-center text-violet-300 transition-colors hover:bg-base-200/60 focus-visible-ring"
                      >
                        <span
                          class={[
                            "hero-chevron-down size-3 transition-transform",
                            MapSet.member?(@expanded_stacks, item.id) && "rotate-180"
                          ]}
                          aria-hidden="true"
                        >
                        </span>
                      </button>
                    </div>
                    <div
                      :if={MapSet.member?(@expanded_stacks, item.id)}
                      data-role="stack-members"
                      data-stack-id={item.id}
                      class="flex flex-col gap-1.5 px-3 pb-3 pl-4"
                    >
                      <%= for member <- Enum.sort_by(board_data.members, & &1.stack_position) do %>
                        <% {member_status_label, member_status_class} =
                          task_display_status(member) %>
                        <% member_dep_text = dep_annotation_text(member, board_data.members) %>
                        <button
                          type="button"
                          id={"stack-member-mobile-#{member.id}"}
                          data-stack-member="true"
                          data-member-id={member.id}
                          data-stack-position={member.stack_position}
                          phx-click="select_task"
                          phx-value-id={member.id}
                          class="relative rounded border border-base-200/60 bg-base-100 py-3 pl-8 pr-2 text-left transition-colors hover:bg-base-200/60 min-h-[44px]"
                        >
                          <span class={[
                            "absolute left-1 top-3 inline-flex size-5 items-center justify-center rounded-full text-[10px] font-semibold",
                            member_node_class(member.status)
                          ]}>
                            {stack_position_glyph(member.stack_position)}
                          </span>
                          <div class="flex min-w-0 items-center gap-2">
                            <span class="flex-1 min-w-0 text-xs leading-snug truncate">
                              {member.title}
                            </span>
                            <span class={"#{member_status_class} badge-xs whitespace-nowrap shrink-0"}>
                              {member_status_label}
                            </span>
                          </div>
                          <div
                            :if={member_dep_text}
                            data-role="dep-annotation"
                            class="mt-1 text-[10px] text-base-content/50"
                          >
                            <span class="text-violet-400" aria-hidden="true">↑</span>
                            {member_dep_text}
                          </div>
                        </button>
                      <% end %>
                    </div>
                  </div>
                <% _ -> %>
                  <% task = item %>
                  <% assignee = assignee_identity(task, @users_by_id, @agents_by_id) %>
                  <button
                    type="button"
                    phx-click="select_task"
                    phx-value-id={task.id}
                    class="flex flex-col gap-1.5 rounded-box border border-base-300 bg-base-100 p-3 text-left transition-colors hover:bg-base-200/60 focus-visible-ring"
                    data-task-id={task.id}
                  >
                    <div class="flex items-start gap-2">
                      <span
                        class={["mt-1.5 size-2 shrink-0 rounded-full", status_dot_class(col_key)]}
                        aria-hidden="true"
                      >
                      </span>
                      <span class="text-sm font-medium leading-snug flex-1">{task.title}</span>
                      <span
                        :if={has_active_run?(task)}
                        class="mt-1.5 inline-block size-2 shrink-0 rounded-full bg-success animate-pulse"
                        title="Active run"
                      >
                      </span>
                    </div>
                    <div class="flex items-center gap-1.5 pl-4 text-xs text-base-content/60">
                      <%= if assignee do %>
                        <%= if assignee.type == :user do %>
                          <.human_avatar
                            name={assignee.name}
                            avatar_url={assignee.avatar_url}
                            seed={assignee.seed}
                            size="xs"
                            class="size-4 shrink-0"
                          />
                        <% else %>
                          <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-accent/15 text-[9px] font-bold text-accent">
                            {agent_initials(assignee.name)}
                          </span>
                        <% end %>
                        <span class="truncate">{assignee.name}</span>
                        <span aria-hidden="true">·</span>
                      <% end %>
                      <span :if={task.inserted_at} class="whitespace-nowrap">
                        {relative_time(task.inserted_at)}
                      </span>
                    </div>
                  </button>
              <% end %>
            <% end %>
          </div>
        </div>

        <.empty_state :if={empty_board?(@board_items)} variant={:minimal}>
          <:body>No tasks yet — tap the + button to create one.</:body>
        </.empty_state>

        <.empty_state
          :if={
            !empty_board?(@board_items) &&
              Map.get(@board_items, @active_status_filter, []) == []
          }
          variant={:minimal}
        >
          <:body>
            No tasks in {active_status_label(@active_status_filter, @mobile_columns)}.
          </:body>
        </.empty_state>
      </div>
    </div>

    <%!-- Kanban board (desktop). Hidden on mobile in favor of the
         section-grouped list above. --%>
    <div
      id="kanban-board"
      phx-hook="KanbanDragDrop"
      class="hidden md:flex flex-1 gap-4 overflow-x-auto p-4"
    >
      <div
        :for={{col_key, col_label} <- @kanban_columns}
        id={"column-#{col_key}"}
        data-column={col_key}
        class="flex w-72 min-w-[18rem] flex-shrink-0 flex-col rounded-box bg-base-200/50 transition-all duration-150"
      >
        <%!-- Column header --%>
        <div class="flex items-center justify-between px-3 py-2">
          <h2 class={"text-xs font-semibold uppercase tracking-wider #{column_header_class(col_key)}"}>
            {col_label}
          </h2>
          <span class="badge badge-ghost badge-xs">
            {length(Map.get(@board_items, col_key, []))}
          </span>
        </div>

        <%!-- Board items (task cards + collapsed stack cards).
             Pattern-match on `item.__struct__`: %Platform.Tasks.Stack{}
             renders the new collapsed stack card; %Platform.Tasks.Task{}
             keeps the existing task card rendering. Stacks are NOT
             draggable (stack-level reordering is out of scope for T7) —
             only tasks carry `draggable="true"` and the KanbanDragDrop
             hook's drag handlers. --%>
        <div class="flex flex-1 flex-col gap-2 overflow-y-auto px-2 pb-2">
          <%= for item <- Map.get(@board_items, col_key, []) do %>
            <%= case item.__struct__ do %>
              <% Platform.Tasks.Stack -> %>
                <% board_data =
                  Map.get(@stack_board_data, item.id, %{
                    member_count: 0,
                    dep_edge_count: 0,
                    ready_count: 0
                  }) %>
                <%!-- Collapsed stack card. Purple violet-500 left border
                     accent matches mock canvas 019e1a16 rev 2
                     (`--stk: #7b5cff`). Clicking the HEADER toggles
                     `:expanded_stacks` MapSet membership; the
                     expansion render is a sibling block so member
                     clicks do NOT bubble back into the toggle handler
                     (stage 3 §5). --%>
                <div
                  id={"stack-card-#{item.id}"}
                  data-stack-card="true"
                  data-stack-id={item.id}
                  data-expanded={
                    if(MapSet.member?(@expanded_stacks, item.id), do: "true", else: "false")
                  }
                  class="group card card-compact border-l-4 border-violet-500 border border-base-300 bg-base-100 shadow-sm transition-all hover:shadow-md"
                >
                  <%!-- T8 stage 1: header opens the stack detail panel.
                       Chevron is split into its own sibling button so
                       the inline-expansion toggle remains reachable
                       without bubbling through the panel opener
                       (Discord "click thread to enter" pattern, Option A
                       in the T8 dispatch). The chevron button uses
                       `onclick=stopPropagation` so its click does NOT
                       bubble up into the surrounding header div's
                       phx-click. --%>
                  <div class="relative">
                    <div
                      class="card-body cursor-pointer gap-1.5 p-3 pr-9"
                      phx-click="open_stack_detail"
                      phx-value-id={item.id}
                      data-role="stack-header"
                    >
                      <%!-- Header row: icon + STACK tag + rollup progress --%>
                      <div class="flex min-w-0 items-center gap-1.5">
                        <span
                          class="hero-rectangle-stack size-4 shrink-0 text-violet-300"
                          aria-hidden="true"
                        >
                        </span>
                        <span class="text-[9px] font-semibold uppercase tracking-wider text-violet-300 shrink-0">
                          Stack
                        </span>
                        <span class="ml-auto text-[10px] text-base-content/50 font-medium whitespace-nowrap shrink-0">
                          {board_data.ready_count}/{board_data.member_count} ready
                        </span>
                      </div>

                      <%!-- Title row --%>
                      <h3 class="text-sm font-medium leading-snug truncate min-w-0">
                        {item.name}
                      </h3>

                      <%!-- Pills row: member count + dep edge count. --%>
                      <div class="flex min-w-0 items-center gap-1.5 text-[10px] text-base-content/60">
                        <span class="bg-base-200 px-1.5 py-0.5 rounded font-medium whitespace-nowrap shrink-0">
                          {board_data.member_count} tasks
                        </span>
                        <span class="bg-base-200 px-1.5 py-0.5 rounded font-medium whitespace-nowrap shrink-0">
                          {board_data.dep_edge_count} dep edges
                        </span>
                      </div>
                    </div>
                    <button
                      type="button"
                      phx-click="toggle_stack_expand"
                      phx-value-id={item.id}
                      data-role="stack-chevron"
                      onclick="event.stopPropagation()"
                      aria-label="Toggle stack expansion"
                      aria-expanded={
                        if(MapSet.member?(@expanded_stacks, item.id), do: "true", else: "false")
                      }
                      class="absolute right-1 top-2 flex h-9 w-7 items-center justify-center text-violet-300 hover:bg-base-200 rounded transition-colors focus-visible-ring"
                    >
                      <span
                        class={[
                          "hero-chevron-down size-3 transition-transform",
                          MapSet.member?(@expanded_stacks, item.id) && "rotate-180"
                        ]}
                        aria-hidden="true"
                      >
                      </span>
                    </button>
                  </div>

                  <%!-- Inline expansion — members rendered indented
                       below the header when this stack id is in
                       `:expanded_stacks`. Each row is its own
                       `phx-click="select_task"` target reusing the
                       task detail-panel handler (T8 will later add a
                       stack-level detail panel for header clicks). --%>
                  <div
                    :if={MapSet.member?(@expanded_stacks, item.id)}
                    data-role="stack-members"
                    data-stack-id={item.id}
                    class="flex flex-col gap-1.5 px-3 pb-3 pl-4"
                  >
                    <%= for member <- Enum.sort_by(board_data.members, & &1.stack_position) do %>
                      <% {status_label, status_class} = task_display_status(member) %>
                      <% dep_text =
                        dep_annotation_text(member, board_data.members) %>
                      <div
                        id={"stack-member-#{member.id}"}
                        data-stack-member="true"
                        data-member-id={member.id}
                        data-stack-position={member.stack_position}
                        phx-click="select_task"
                        phx-value-id={member.id}
                        class="relative cursor-pointer rounded border border-base-200/60 bg-base-100 py-2 pl-8 pr-2 transition-colors hover:bg-base-200/60 min-h-[44px]"
                      >
                        <span class={[
                          "absolute left-1 top-2 inline-flex size-5 items-center justify-center rounded-full text-[10px] font-semibold",
                          member_node_class(member.status)
                        ]}>
                          {stack_position_glyph(member.stack_position)}
                        </span>
                        <div class="flex min-w-0 items-center gap-2">
                          <span class="flex-1 min-w-0 text-xs leading-snug truncate">
                            {member.title}
                          </span>
                          <span class={"#{status_class} badge-xs whitespace-nowrap shrink-0"}>
                            {status_label}
                          </span>
                        </div>
                        <div
                          :if={dep_text}
                          data-role="dep-annotation"
                          class="mt-1 text-[10px] text-base-content/50"
                        >
                          <span class="text-violet-400" aria-hidden="true">↑</span> {dep_text}
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% _ -> %>
                <% task = item %>
                <div
                  id={"task-card-#{task.id}"}
                  data-task-id={task.id}
                  draggable="true"
                  class="group card card-compact cursor-grab border border-base-300 bg-base-100 shadow-sm transition-all hover:shadow-md active:cursor-grabbing"
                  phx-click="select_task"
                  phx-value-id={task.id}
                >
                  <div class="card-body gap-1 p-3">
                    <%!-- Project name --%>
                    <p
                      :if={task.project}
                      class="text-[10px] font-medium uppercase tracking-wider text-base-content/40"
                    >
                      {task.project.name}
                    </p>

                    <%!-- Title row --%>
                    <%!--
                v2 stage 3: kanban-card title is plain text. Clicking it
                bubbles to the card's outer `phx-click="select_task"` and
                opens the detail panel, where the title can be edited via
                the explicit edit-mode toggle.
              --%>
                    <div class="flex items-start justify-between gap-2">
                      <h3
                        id={"card-title-#{task.id}"}
                        class="text-sm font-medium leading-snug flex-1"
                        data-role="card-title"
                      >
                        {task.title}
                      </h3>
                      <div class="flex items-center gap-1 flex-shrink-0">
                        <%!-- Active run indicator --%>
                        <span
                          :if={has_active_run?(task)}
                          class="inline-block size-2 rounded-full bg-success animate-pulse"
                          title="Active run"
                        />
                        <%!-- Assignee --%>
                        <% assignee = assignee_identity(task, @users_by_id, @agents_by_id) %>
                        <%= if assignee do %>
                          <%= if assignee.type == :user do %>
                            <.human_avatar
                              name={assignee.name}
                              avatar_url={assignee.avatar_url}
                              seed={assignee.seed}
                              size="xs"
                              class="shrink-0"
                              title={assignee.name}
                            />
                          <% else %>
                            <span
                              class="flex size-5 items-center justify-center rounded-full bg-accent/15 text-[10px] font-bold text-accent ring-1 ring-accent/20"
                              title={assignee.name}
                              data-avatar-kind="agent"
                            >
                              {agent_initials(assignee.name)}
                            </span>
                          <% end %>
                        <% end %>
                        <%!-- Three-dot menu — opens a bottom sheet on mobile + a centered
                       sheet on desktop. Replaced the inert DaisyUI dropdown
                       (task 019e0d4b stage 2). The icon stays opacity-0 / hover-
                       reveal on desktop; on mobile it's always visible since
                       there's no hover signal.  --%>
                        <button
                          :if={deletable_task?(task)}
                          type="button"
                          phx-click="open_task_actions"
                          phx-value-id={task.id}
                          aria-label="Task actions"
                          title="Task actions"
                          class="btn btn-ghost btn-xs btn-square opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity"
                        >
                          <span class="hero-ellipsis-vertical size-4"></span>
                        </button>
                      </div>
                    </div>

                    <%!-- Author + assignee + date --%>
                    <div
                      :if={
                        task.reported_by || assignee_name(task, @agent_names) || task.inserted_at
                      }
                      class="mt-1 flex items-center gap-1.5 text-[10px] text-base-content/40"
                    >
                      <span
                        :if={task.reported_by}
                        class="truncate max-w-[100px]"
                        title={"Reported by " <> (task.reported_by || "")}
                      >
                        {task.reported_by}
                      </span>
                      <span :if={
                        task.reported_by &&
                          (assignee_name(task, @agent_names) || task.inserted_at)
                      }>
                        ·
                      </span>
                      <span :if={assignee_name(task, @agent_names)} class="truncate max-w-[100px]">
                        → {assignee_name(task, @agent_names)}
                      </span>
                      <span :if={assignee_name(task, @agent_names) && task.inserted_at}>·</span>
                      <span :if={task.inserted_at} class="whitespace-nowrap">
                        {relative_time(task.inserted_at)}
                      </span>
                    </div>

                    <%!-- Bottom row: priority + progress --%>
                    <div class="mt-1 flex items-center gap-2">
                      <span :if={task.priority} class={priority_badge_class(task.priority)}>
                        {task.priority}
                      </span>
                      <% {status_badge_label, status_badge_class} = task_display_status(task) %>
                      <span
                        :if={task.status in ~w(blocked planning in_review deploying)}
                        class={"#{status_badge_class} badge-xs"}
                      >
                        {status_badge_label}
                      </span>

                      <%!-- Blocked-by-deps badge: only when status="blocked" AND
                     metadata["unmet_dependencies"] is non-empty. Count is
                     read straight from metadata (no per-card DB hit). --%>
                      <span
                        :if={task.status == "blocked" and unmet_dependency_count(task) > 0}
                        class="badge badge-error badge-xs"
                        title="Waiting on dependencies"
                      >
                        Blocked · {unmet_dependency_count(task)}
                      </span>

                      <%!-- Review badge --%>
                      <span
                        :if={Map.get(@review_counts, task.id, 0) > 0}
                        class="badge badge-warning badge-xs gap-1"
                      >
                        <span class="hero-eye size-3"></span>
                        {Map.get(@review_counts, task.id)} review
                      </span>

                      <%!-- Plan stage progress --%>
                      <% progress = plan_progress(task) %>
                      <div :if={progress} class="flex flex-1 items-center gap-1">
                        <progress
                          class="progress progress-primary h-1 flex-1"
                          value={elem(progress, 0)}
                          max={elem(progress, 1)}
                        />
                        <span class="text-[10px] text-base-content/40">
                          {elem(progress, 0)}/{elem(progress, 1)}
                        </span>
                      </div>
                    </div>

                    <%!-- Per ADR 0029, plan approval is the only start signal.
                   No separate manual "Start" button on the card. The user
                   approves a plan from the detail panel, and the task
                   transitions automatically. --%>
                  </div>
                </div>
            <% end %>
          <% end %>

          <%!-- Per-column empty state. SPEC DEVIATION: spec §5.3 says
               :conversational with chips, but that's per-COLUMN here on a
               kanban with 4-5 columns — N Saru bubbles + chip pairs would
               clutter the board. :minimal keeps the column readable. The
               broader "no tasks anywhere" board-level conversational state
               is a separate concern that doesn't exist on this surface
               (no board-level @all_tasks == [] check); add later if Marlowe
               wants the V3 voice on the kanban-empty case. --%>
          <.empty_state :if={Map.get(@board_items, col_key, []) == []} variant={:minimal}>
            <:body>No tasks</:body>
          </.empty_state>
        </div>
      </div>
    </div>
  </div>

  <%!-- Task detail panel (slide-in from right). Bottom edge stops at
       the top of the bottom-nav, including iOS home-indicator safe-
       area: `--bottom-nav-height` is the nav's content row (56px on
       phones, 0 on desktop) and the nav adds
       `env(safe-area-inset-bottom)` below itself for the indicator.
       Without that env() addition the panel and nav don't meet on iOS
       — there's a ~34px gap where the panel ends above the nav's
       safe-area. Replaces PR #331's inner-scroller `pb-[calc(...)]`,
       which left visible dead space below content. --%>
  <div
    :if={@show_detail && @selected_task}
    class="fixed top-0 bottom-[calc(env(safe-area-inset-bottom)+var(--bottom-nav-height,0px))] right-0 z-30 flex w-full max-w-lg flex-col border-l border-base-300 bg-base-100 shadow-xl safe-area-top"
  >
    <div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
      <%= cond do %>
        <% @edit_mode and @editing_task_title_id == @selected_task.id -> %>
          <input
            type="text"
            name="value"
            value={@selected_task.title}
            phx-blur="update_task_title"
            phx-value-task-id={@selected_task.id}
            phx-hook="InlineEdit"
            data-submit-event="update_task_title"
            data-task-id={@selected_task.id}
            data-role="detail-title-input"
            class="input input-sm input-bordered text-sm font-semibold flex-1 mr-2"
            id={"detail-title-input-#{@selected_task.id}"}
          />
        <% @edit_mode -> %>
          <h2
            id={"detail-title-#{@selected_task.id}"}
            class="text-sm font-semibold truncate cursor-text rounded px-1 -mx-1 flex-1 border border-dashed border-base-300 hover:border-base-content/40 hover:bg-base-200"
            phx-click="start_edit_title"
            phx-value-task-id={@selected_task.id}
            data-role="detail-title"
            data-editable="true"
            title="Click to edit"
          >
            {@selected_task.title}
          </h2>
        <% true -> %>
          <h2
            id={"detail-title-#{@selected_task.id}"}
            class="text-sm font-semibold truncate flex-1"
            data-role="detail-title"
            data-editable="false"
          >
            {@selected_task.title}
          </h2>
      <% end %>
      <div class="flex items-center gap-1">
        <span
          :if={@edit_mode}
          class="badge badge-sm badge-primary badge-outline"
          data-role="edit-mode-indicator"
        >
          Edit mode
        </span>
        <button
          class={[
            "btn btn-sm btn-square",
            if(@edit_mode, do: "btn-primary", else: "btn-ghost")
          ]}
          phx-click="toggle_edit_mode"
          title="Toggle edit mode"
          aria-label="Toggle edit mode"
          data-role="edit-mode-toggle"
          data-edit-mode={to_string(@edit_mode)}
          aria-pressed={to_string(@edit_mode)}
        >
          <span class="hero-pencil-square size-4"></span>
        </button>
        <button
          :if={deletable_task?(@selected_task)}
          class="btn btn-sm btn-ghost btn-square text-error"
          phx-click="request_delete_task"
          title="Delete task"
          aria-label="Delete task"
        >
          <span class="hero-trash size-4"></span>
        </button>
        <button
          class="btn btn-sm btn-ghost btn-square"
          phx-click="close_detail"
          aria-label="Close task details"
        >
          <span class="hero-x-mark size-4"></span>
        </button>
      </div>
    </div>

    <%!-- Inner scroller. The panel container (above) is bounded by
         `--bottom-nav-height`, so the scroll viewport already ends at
         the top of the bottom-tab nav and standard `p-4` padding
         suffices on every viewport. --%>
    <div class="flex-1 overflow-y-auto p-4 space-y-5">
      <%!-- Delete confirmation --%>
      <div
        :if={@confirm_delete}
        class="rounded-box border border-error bg-error/10 p-4 space-y-3"
      >
        <p class="text-sm font-medium text-error">
          Are you sure you want to delete this task?
        </p>
        <div class="flex gap-2">
          <button phx-click="confirm_delete_task" class="btn btn-error btn-sm">
            Yes, Delete
          </button>
          <button phx-click="cancel_delete_task" class="btn btn-ghost btn-sm">
            Cancel
          </button>
        </div>
      </div>

      <%!-- Status + Priority --%>
      <div class="flex flex-wrap items-center gap-2">
        <% {detail_status_label, detail_status_class} = task_display_status(@selected_task) %>
        <span class={detail_status_class}>{detail_status_label}</span>
        <span :if={@selected_task.priority} class={priority_badge_class(@selected_task.priority)}>
          {String.capitalize(@selected_task.priority)}
        </span>
        <span :if={@selected_task.project} class="text-xs text-base-content/50">
          {(@selected_task.project && @selected_task.project.name) || "—"}
        </span>
        <span :if={@selected_task.epic} class="text-xs text-base-content/50">
          / {(@selected_task.epic && @selected_task.epic.name) || "—"}
        </span>
      </div>

      <%!-- Priority + deploy_target metadata.
           Off (read-only): plain badges/labels.
           On (edit_mode): <select>s wired to the generic `update_task_field`
           event, wrapped in a dashed border affordance to signal "click to
           edit". Hidden `field`/`task-id` inputs travel with the change
           because `phx-change` only carries form params. --%>
      <% project_targets = project_deploy_targets(@selected_task.project) %>
      <div class="grid grid-cols-2 gap-3">
        <%= if @edit_mode do %>
          <form
            phx-change="update_task_field"
            class="flex flex-col gap-1 rounded border border-dashed border-base-300 hover:border-base-content/40 p-1"
            data-role="priority-form"
            data-editable="true"
          >
            <input type="hidden" name="field" value="priority" />
            <input type="hidden" name="task-id" value={@selected_task.id} />
            <label
              for={"priority-select-#{@selected_task.id}"}
              class="text-xs font-semibold uppercase tracking-wider text-base-content/50"
            >
              Priority
            </label>
            <select
              id={"priority-select-#{@selected_task.id}"}
              name="value"
              data-role="priority-select"
              class="select select-sm select-bordered cursor-pointer"
            >
              <option
                :for={p <- Platform.Tasks.Task.priorities()}
                value={p}
                selected={@selected_task.priority == p}
              >
                {String.capitalize(p)}
              </option>
            </select>
          </form>

          <form
            phx-change="update_task_field"
            class="flex flex-col gap-1 rounded border border-dashed border-base-300 hover:border-base-content/40 p-1"
            data-role="deploy-target-form"
            data-editable="true"
          >
            <input type="hidden" name="field" value="deploy_target" />
            <input type="hidden" name="task-id" value={@selected_task.id} />
            <label
              for={"deploy-target-select-#{@selected_task.id}"}
              class="text-xs font-semibold uppercase tracking-wider text-base-content/50"
            >
              Deploy target
            </label>
            <select
              id={"deploy-target-select-#{@selected_task.id}"}
              name="value"
              data-role="deploy-target-select"
              disabled={project_targets == []}
              class="select select-sm select-bordered cursor-pointer"
            >
              <option value="" selected={is_nil(@selected_task.deploy_target)}>
                {if project_targets == [], do: "(no targets configured)", else: "(none)"}
              </option>
              <option
                :for={t <- project_targets}
                value={t}
                selected={@selected_task.deploy_target == t}
              >
                {deploy_target_label(t)}
              </option>
            </select>
          </form>
        <% else %>
          <div class="flex flex-col gap-1" data-role="priority-readonly" data-editable="false">
            <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
              Priority
            </span>
            <span class={[
              "badge badge-sm",
              if(@selected_task.priority,
                do: priority_badge_class(@selected_task.priority),
                else: "badge-ghost"
              )
            ]}>
              {if @selected_task.priority,
                do: String.capitalize(@selected_task.priority),
                else: "—"}
            </span>
          </div>

          <div
            class="flex flex-col gap-1"
            data-role="deploy-target-readonly"
            data-editable="false"
          >
            <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
              Deploy target
            </span>
            <span class="badge badge-sm badge-outline">
              {cond do
                @selected_task.deploy_target -> deploy_target_label(@selected_task.deploy_target)
                project_targets == [] -> "(no targets configured)"
                true -> "(none)"
              end}
            </span>
          </div>
        <% end %>
      </div>

      <%!-- Task-level assignee. Off: plain badge. On: <select>.
           Distinct from the per-phase assignee modal (which writes
           `phase_assignees`); this sets the top-level `assignee_id` and
           is the value the kanban thumbnail / TaskRouter dispatch reads.
           Reuses `@agents` already fetched at mount for the per-phase
           modal landed in 019df0d7. --%>
      <div :if={@agents != []} class="flex flex-col gap-1">
        <%= if @edit_mode do %>
          <form
            phx-change="update_task_field"
            class="flex flex-col gap-1 rounded border border-dashed border-base-300 hover:border-base-content/40 p-1"
            data-role="assignee-form"
            data-editable="true"
          >
            <input type="hidden" name="field" value="assignee_id" />
            <input type="hidden" name="task-id" value={@selected_task.id} />
            <label
              for={"assignee-select-#{@selected_task.id}"}
              class="text-xs font-semibold uppercase tracking-wider text-base-content/50"
            >
              Assignee (task-level)
            </label>
            <select
              id={"assignee-select-#{@selected_task.id}"}
              name="value"
              data-role="assignee-select"
              class="select select-sm select-bordered cursor-pointer"
            >
              <option value="" selected={is_nil(@selected_task.assignee_id)}>
                Unassigned
              </option>
              <option
                :for={a <- @agents}
                value={a.id}
                selected={@selected_task.assignee_id == a.id}
              >
                {a.name}
              </option>
            </select>
          </form>
        <% else %>
          <div data-role="assignee-readonly" data-editable="false" class="flex flex-col gap-1">
            <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
              Assignee (task-level)
            </span>
            <span class="badge badge-sm badge-outline">
              {assignee_name(@selected_task, @agent_names) || "Unassigned"}
            </span>
          </div>
        <% end %>
      </div>

      <%!-- Reporter + Dates + Assignee name --%>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-base-content/50">
        <span :if={@selected_task.reported_by}>
          <span class="text-base-content/40">Reporter:</span> {@selected_task.reported_by}
        </span>
        <span :if={assignee_name(@selected_task, @agent_names)}>
          <span class="text-base-content/40">Assigned:</span> {assignee_name(
            @selected_task,
            @agent_names
          )}
        </span>
        <span :if={@selected_task.inserted_at}>
          <span class="text-base-content/40">Created:</span> {Calendar.strftime(
            @selected_task.inserted_at,
            "%b %d, %Y"
          )}
        </span>
        <span :if={@selected_task.updated_at}>
          <span class="text-base-content/40">Updated:</span> {relative_time(
            @selected_task.updated_at
          )}
        </span>
      </div>

      <%!-- Dependencies — listed in author order, with a status icon per
           row. Hidden entirely when the task has no deps. Resolved via
           a single Repo.all per render (detail panel only). --%>
      <% deps = dependency_summary(@selected_task) %>
      <div :if={deps != []} id="task-dependencies" class="flex flex-col gap-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
          Dependencies
        </span>
        <ul class="flex flex-col gap-1 text-xs">
          <li
            :for={dep <- deps}
            class="flex items-center gap-2 rounded bg-base-200 px-2 py-1"
          >
            <span class={"#{dependency_status_icon(dep.status)} size-4 shrink-0"}></span>
            <span class="truncate flex-1">
              {dep.title || "(missing dependency)"}
            </span>
            <span
              :if={dep.status}
              class="text-[10px] uppercase tracking-wider text-base-content/40"
            >
              {status_label(dep.status)}
            </span>
          </li>
        </ul>
      </div>

      <%!-- Assignees by phase — opens a modal that lets the user wire one
           agent for the whole task (Simple) or different agents per phase
           (Advanced). --%>
      <div :if={@agents != []} class="flex flex-col gap-2">
        <div class="flex items-center justify-between gap-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
            Assignees
          </span>
          <button
            type="button"
            phx-click="open_assignee_modal"
            class="btn btn-xs btn-ghost gap-1"
          >
            <span class="hero-cog-6-tooth size-3"></span> Configure
          </button>
        </div>
        <div class="grid grid-cols-3 gap-1 text-[11px]">
          <div :for={phase <- ~w(planning execution review)} class="rounded bg-base-200 p-1.5">
            <p class="text-[10px] uppercase tracking-wider text-base-content/40">
              {phase_label(phase)}
            </p>
            <p class={[
              "truncate font-medium",
              phase == current_phase_label(@selected_task) && "text-primary"
            ]}>
              {agent_name_for(@agents_by_id, phase_assignee_id(@selected_task, phase)) ||
                "Unassigned"}
            </p>
          </div>
        </div>
      </div>

      <%!-- Per ADR 0029, plan approval is the start signal. The user
           approves a plan from the plan-review panel below; that
           transitions the task to in_progress automatically. No separate
           manual "Start Task" button. --%>

      <%!-- Transition buttons --%>
      <div :if={available_transitions(@selected_task.status) != []} class="flex flex-wrap gap-2">
        <button
          :for={{target_status, label} <- available_transitions(@selected_task.status)}
          class={transition_btn_class(target_status)}
          phx-click="transition_task"
          phx-value-id={@selected_task.id}
          phx-value-status={target_status}
        >
          {label}
        </button>
      </div>

      <%!-- Reopen-with-feedback button (done tasks only).
           Sits adjacent to the transition-buttons block so it reads as a
           top-level task action. Opens a modal that captures a free-form
           reason; Tasks.reopen_with_feedback/3 rejects the active plan and
           moves the task back to `planning`. --%>
      <div :if={@selected_task.status == "done"} class="flex flex-wrap gap-2">
        <button
          type="button"
          phx-click="open_reopen_modal"
          data-role="reopen-task-button"
          class="btn btn-sm btn-warning gap-1"
        >
          <span class="hero-arrow-uturn-left size-4"></span> Reopen with feedback
        </button>
      </div>

      <%!-- Deploy strategy --%>
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
          Deploy
        </span>
        <span class="badge badge-outline badge-sm">
          <%= if @selected_task.deploy_strategy do %>
            {deploy_strategy_label(@selected_task.deploy_strategy)}
          <% else %>
            <span class="text-base-content/40">Inherited from project</span>
          <% end %>
        </span>
      </div>

      <%!-- Description — click "Edit" to swap the rendered markdown for a
           textarea + Save/Cancel. Toggle, not split-preview, per the
           plan's "cheaper path that's still nice". Edit button is only
           rendered when @edit_mode is true; in read-only mode the
           rendered markdown is the only thing visible. --%>
      <div
        class={[
          "space-y-1",
          @edit_mode &&
            "rounded border border-dashed border-base-300 hover:border-base-content/40 p-1"
        ]}
        data-role="description-block"
        data-editable={to_string(@edit_mode)}
      >
        <div class="flex items-center justify-between gap-2">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
            Description
          </h3>
          <button
            :if={@edit_mode and !@editing_description}
            type="button"
            phx-click="start_edit_description"
            data-role="description-edit-button"
            class="btn btn-xs btn-ghost gap-1"
          >
            <span class="hero-pencil-square size-3"></span> Edit
          </button>
        </div>

        <%= if @edit_mode and @editing_description do %>
          <form
            id="task-description-form"
            phx-hook="ButtonLoading"
            phx-submit="save_description"
            data-role="description-form"
            class="space-y-2"
          >
            <textarea
              name="description"
              rows="8"
              data-role="description-textarea"
              class="textarea textarea-bordered w-full text-sm font-mono"
            >{@selected_task.description}</textarea>
            <div class="flex gap-2">
              <button type="submit" class="btn btn-primary btn-sm" data-role="description-save">
                Save
              </button>
              <button
                type="button"
                phx-click="cancel_edit_description"
                class="btn btn-ghost btn-sm"
                data-role="description-cancel"
              >
                Cancel
              </button>
            </div>
          </form>
        <% else %>
          <div
            :if={@selected_task.description}
            id={"task-desc-#{@selected_task.id}"}
            data-role="description-rendered"
            class="prose prose-sm max-w-none text-sm text-base-content/80 chat-markdown task-markdown"
          >
            {Platform.Chat.ContentRenderer.render_message(@selected_task.description)}
          </div>
          <p
            :if={!@selected_task.description}
            data-role="description-empty"
            class="text-sm text-base-content/40 italic"
          >
            {if @edit_mode,
              do: "No description yet — click Edit to add one.",
              else: "No description yet."}
          </p>
        <% end %>
      </div>

      <%!-- Skills --%>
      <div class="space-y-2">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/50 flex items-center gap-1">
          <span class="hero-book-open size-3"></span> Skills
        </h3>

        <%!-- Attached skill chips --%>
        <div :if={@attached_skills != []} class="flex flex-wrap gap-2">
          <div
            :for={{skill, source} <- @attached_skills}
            class={
              "flex items-center gap-1 rounded-full px-2 py-0.5 text-xs " <>
                if source == "task",
                  do: "bg-primary/10 text-primary border border-primary/20",
                  else: "bg-base-200 text-base-content/60 border border-base-300"
            }
          >
            <span class="font-medium">{skill.name}</span>
            <span :if={source != "task"} class="text-[10px] opacity-70">
              (from {String.capitalize(source)})
            </span>
            <button
              :if={source == "task"}
              phx-click="detach_skill"
              phx-value-skill_id={skill.id}
              class="ml-0.5 text-primary/60 hover:text-primary"
              title="Remove skill"
            >
              <span class="hero-x-mark size-3"></span>
            </button>
          </div>
        </div>

        <%!-- Attach dropdown — only shows skills not already task-level attached --%>
        <% task_skill_ids =
          @attached_skills
          |> Enum.filter(fn {_, src} -> src == "task" end)
          |> Enum.map(fn {skill, _} -> skill.id end)
          |> MapSet.new() %>

        <% attachable =
          Enum.reject(@available_skills, fn s -> MapSet.member?(task_skill_ids, s.id) end) %>

        <div :if={attachable != []}>
          <form phx-change="attach_skill">
            <select
              class="select select-bordered select-xs w-full max-w-xs"
              name="skill_id"
            >
              <option value="">Attach a skill…</option>
              <option :for={skill <- attachable} value={skill.id}>{skill.name}</option>
            </select>
          </form>
        </div>
      </div>

      <%!-- Plan stages --%>
      <div :if={@selected_task.plans != []} class="space-y-2">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
          Plan
        </h3>
        <% {rejected_plans, active_plans} = partition_plans(@selected_task) %>

        <%!-- Folded rejected revisions (oldest first). Each row is a clickable
             summary that reveals the full plan body when expanded. --%>
        <div
          :for={plan <- rejected_plans}
          class="rounded-box border border-base-300/60 bg-base-200/20 overflow-hidden"
        >
          <% expanded? = plan_expanded?(@expanded_plans, plan) %>
          <button
            type="button"
            data-role="plan-summary"
            data-plan-id={plan.id}
            phx-click={if expanded?, do: "collapse_plan", else: "expand_plan"}
            phx-value-plan-id={plan.id}
            class="flex h-8 w-full items-center gap-2 px-3 text-xs text-base-content/50 hover:bg-base-200/40 transition-colors"
          >
            <span class={[
              "hero-chevron-right size-3 shrink-0 transition-transform",
              expanded? && "rotate-90"
            ]}>
            </span>
            <span class="flex-1 text-left truncate">{plan_summary_label(plan)}</span>
          </button>
          <div
            :if={expanded?}
            data-role="plan-body"
            data-plan-id={plan.id}
            class="border-t border-base-300/60 p-3 space-y-2 bg-base-200/30"
          >
            <%!-- Full rejection reason. Renders nothing for legacy rows
                 where `rejection_reason` is nil so the body doesn't grow
                 an empty box. --%>
            <div
              :if={present?(plan.rejection_reason)}
              data-role="plan-rejection-reason"
              data-plan-id={plan.id}
              class="rounded border border-base-300/60 bg-base-100/40 px-3 py-2"
            >
              <p class="text-[10px] uppercase tracking-wider text-base-content/50 mb-1">
                Rejection reason
              </p>
              <p class="text-xs italic text-base-content/70 whitespace-pre-wrap">
                {plan.rejection_reason}
              </p>
            </div>
            <.plan_body plan={plan} />
          </div>
        </div>

        <%!-- Active plans render in full, exactly as before. --%>
        <div
          :for={plan <- active_plans}
          data-role="plan-body"
          data-plan-id={plan.id}
          class={"rounded-box border p-3 space-y-2 #{if plan.status == "pending_review", do: "border-warning bg-warning/5", else: "border-base-300 bg-base-200/30"}"}
        >
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium">v{plan.version}</span>
            <span :if={plan.status == "pending_review"} class="badge badge-warning badge-xs">
              pending review
            </span>
            <span :if={plan.status != "pending_review"} class="badge badge-outline badge-xs">
              {plan.status}
            </span>
          </div>
          <%!-- Approve / Reject buttons — prominent, above stages. Only the
               active pending_review plan gets these; folded rejected
               revisions never re-render the buttons. --%>
          <div :if={plan.status == "pending_review"} class="flex gap-2">
            <button
              class="btn btn-sm btn-success flex-1"
              phx-click="approve_plan"
              phx-value-plan-id={plan.id}
            >
              Approve Plan
            </button>
            <button
              class="btn btn-sm btn-ghost btn-error"
              phx-click="reject_plan"
              phx-value-plan-id={plan.id}
            >
              Reject
            </button>
          </div>
          <.plan_body plan={plan} />
        </div>
      </div>

      <%!-- Execution Log --%>
      <div
        :if={!@execution_space_id and @steering_feedback}
        id="steering-feedback-empty"
        class={[
          "flex items-start gap-2 rounded-lg border px-3 py-2 text-xs",
          @steering_feedback.kind == :success && "border-success/30 bg-success/10 text-success",
          @steering_feedback.kind == :error && "border-error/30 bg-error/10 text-error"
        ]}
      >
        <span class={[
          "mt-0.5 size-4 shrink-0",
          @steering_feedback.kind == :success && "hero-check-circle",
          @steering_feedback.kind == :error && "hero-exclamation-circle"
        ]}>
        </span>
        <span>{@steering_feedback.message}</span>
      </div>

      <div :if={@execution_space_id} class="space-y-2">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
            Execution Log
          </h3>
          <button
            phx-click="toggle_execution_log"
            class="btn btn-ghost btn-xs btn-square"
            title={if @execution_log_collapsed, do: "Expand log", else: "Collapse log"}
          >
            <span class={"size-4 transition-transform #{if @execution_log_collapsed, do: "hero-chevron-down", else: "hero-chevron-up"}"}>
            </span>
          </button>
        </div>

        <div :if={!@execution_log_collapsed}>
          <div
            :if={@execution_log == []}
            class="text-xs text-base-content/30 italic py-2"
          >
            No messages yet
          </div>

          <div
            :if={@execution_log != []}
            id="execution-log-scroll"
            phx-hook="ExecutionLogScroll"
            phx-drop-target={@uploads.steering_attachments.ref}
            class="max-h-72 overflow-y-auto rounded-box border border-base-300 bg-base-200/30 p-2 space-y-1"
          >
            <div
              :for={msg <- @execution_log}
              class={"flex flex-col gap-0.5 text-xs #{if msg.log_only, do: "opacity-50", else: ""} #{if msg.content_type == "system", do: "border-l-2 border-base-300 pl-2", else: ""} #{if msg.sender_type == "user", do: "border-l-2 border-primary pl-2", else: ""}"}
            >
              <div class="flex items-start gap-2">
                <span class="text-base-content/40 whitespace-nowrap shrink-0">
                  {format_log_timestamp(msg.inserted_at)}
                </span>
                <span class={"font-medium shrink-0 #{log_sender_color(msg.sender_type, msg.content_type)}"}>
                  {msg.sender_name}
                </span>
                <span class="flex-1 whitespace-pre-wrap break-words">{msg.content}</span>
              </div>

              <%!-- Inline attachments --%>
              <div
                :if={Map.get(msg, :attachments, []) != []}
                class="flex flex-wrap gap-1.5 ml-[4.5rem]"
              >
                <%= for att <- Map.get(msg, :attachments, []) do %>
                  <%= if String.starts_with?(att.content_type || "", "image/") do %>
                    <a
                      href={~p"/chat/attachments/#{att.id}"}
                      target="_blank"
                      class="block"
                    >
                      <img
                        src={~p"/chat/attachments/#{att.id}"}
                        alt={att.filename}
                        class="max-h-40 rounded border border-base-300 hover:border-primary transition-colors"
                        loading="lazy"
                      />
                    </a>
                  <% else %>
                    <a
                      href={~p"/chat/attachments/#{att.id}"}
                      target="_blank"
                      class="inline-flex items-center gap-1 rounded-lg border border-base-300 bg-base-200 px-2 py-1 text-xs hover:border-primary transition-colors"
                    >
                      <span class="hero-document size-3.5 text-base-content/50"></span>
                      <span class="truncate max-w-[120px]">{att.filename}</span>
                    </a>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

          <%!-- Steering compose input --%>
          <.form
            for={@steering_compose_form}
            id="steering-compose-form"
            phx-hook="ButtonLoading"
            phx-submit="send_steering_message"
            phx-change="steering_changed"
            class="mt-2 border-t border-base-300 pt-2"
          >
            <%!-- Upload previews --%>
            <div
              :if={@uploads.steering_attachments.entries != [] or @steering_upload_previews != []}
              class="flex flex-wrap gap-2 mb-2"
            >
              <div
                :for={entry <- @uploads.steering_attachments.entries}
                :if={@uploads.steering_attachments.entries != []}
                class="relative group"
              >
                <%= if String.starts_with?(entry.client_type, "image/") do %>
                  <.live_img_preview
                    entry={entry}
                    class="w-16 h-16 object-cover rounded-lg border border-base-300"
                  />
                <% else %>
                  <div class="w-16 h-16 rounded-lg border border-base-300 bg-base-200 flex flex-col items-center justify-center gap-0.5 px-1">
                    <span class="hero-document size-5 text-base-content/40"></span>
                    <span class="text-[8px] text-base-content/60 truncate w-full text-center">
                      {entry.client_name}
                    </span>
                  </div>
                <% end %>

                <button
                  type="button"
                  phx-click="cancel_steering_upload"
                  phx-value-ref={entry.ref}
                  class="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-error text-error-content flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-sm"
                  title="Remove"
                >
                  <span class="hero-x-mark size-3"></span>
                </button>

                <div
                  :if={entry.progress > 0 and entry.progress < 100}
                  class="absolute bottom-0.5 left-0.5 right-0.5"
                >
                  <div class="h-1 rounded-full bg-base-300 overflow-hidden">
                    <div
                      class="h-full bg-primary transition-all duration-300"
                      style={"width: #{entry.progress}%"}
                    >
                    </div>
                  </div>
                </div>
              </div>

              <div
                :for={entry <- @steering_upload_previews}
                :if={@uploads.steering_attachments.entries == []}
                class="relative group"
              >
                <div class="w-16 h-16 rounded-lg border border-base-300 bg-base-200 flex flex-col items-center justify-center gap-0.5 px-1">
                  <span class={[
                    "size-5 text-base-content/40",
                    String.starts_with?(entry.client_type, "image/") && "hero-photo",
                    !String.starts_with?(entry.client_type, "image/") && "hero-document"
                  ]}>
                  </span>
                  <span class="text-[8px] text-base-content/60 truncate w-full text-center">
                    {entry.client_name}
                  </span>
                </div>

                <button
                  type="button"
                  phx-click="cancel_steering_upload"
                  phx-value-ref={entry.ref}
                  class="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-error text-error-content flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-sm"
                  title="Remove"
                >
                  <span class="hero-x-mark size-3"></span>
                </button>
              </div>
            </div>

            <%!-- Upload errors --%>
            <p
              :for={error <- upload_errors(@uploads.steering_attachments)}
              class="text-xs text-error mb-1"
            >
              {upload_error_to_string(error)}
            </p>

            <div :for={entry <- @uploads.steering_attachments.entries}>
              <p
                :for={error <- upload_errors(@uploads.steering_attachments, entry)}
                class="text-xs text-error mb-1"
              >
                {entry.client_name}: {upload_error_to_string(error)}
              </p>
            </div>

            <%!-- Compose row: [+] [input stretches] [send] --%>
            <div class="flex items-center gap-2">
              <button
                type="button"
                onclick="this.closest('form').querySelector('input[type=file]').click()"
                class="flex-shrink-0 cursor-pointer rounded-full w-9 h-9 flex items-center justify-center text-base-content/50 hover:bg-base-300 transition-colors"
                title="Attach files"
                disabled={is_nil(@execution_space_id)}
              >
                <span class="hero-plus size-5"></span>
              </button>

              <.live_file_input upload={@uploads.steering_attachments} class="hidden" />

              <textarea
                name="steering[text]"
                id={@steering_compose_form[:text].id}
                placeholder="Steer the agent..."
                autocomplete="off"
                rows="1"
                class="min-w-0 flex-1 rounded-xl text-sm resize-none bg-base-100 border border-base-300 focus:border-primary focus:outline-none transition-colors"
                style="line-height:1.5;padding:6px 12px;min-height:33px;max-height:200px;overflow-y:auto;field-sizing:content"
                phx-hook="ComposeInput"
                disabled={is_nil(@execution_space_id)}
              >{Phoenix.HTML.Form.normalize_value("text", @steering_compose_form[:text].value)}</textarea>

              <button
                type="submit"
                class="flex-shrink-0 w-9 h-9 rounded-full btn btn-primary btn-sm flex items-center justify-center p-0"
                disabled={is_nil(@execution_space_id)}
                title="Send steering message"
              >
                <span class="hero-paper-airplane size-4 -rotate-45"></span>
              </button>
            </div>

            <div
              :if={@steering_feedback}
              id="steering-feedback"
              class={[
                "mt-2 flex items-start gap-2 rounded-lg border px-3 py-2 text-xs",
                @steering_feedback.kind == :success &&
                  "border-success/30 bg-success/10 text-success",
                @steering_feedback.kind == :error && "border-error/30 bg-error/10 text-error"
              ]}
            >
              <span class={[
                "mt-0.5 size-4 shrink-0",
                @steering_feedback.kind == :success && "hero-check-circle",
                @steering_feedback.kind == :error && "hero-exclamation-circle"
              ]}>
              </span>
              <span>{@steering_feedback.message}</span>
            </div>
          </.form>
        </div>
      </div>

      <%!-- Outputs --%>
      <div :if={@execution_space_id} class="space-y-2">
        <div class="flex items-center gap-2">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
            Outputs
          </h3>
          <span :if={@output_canvases != []} class="badge badge-ghost badge-xs">
            {length(@output_canvases)}
          </span>
        </div>

        <div :if={@output_canvases == []} class="text-xs text-base-content/30 italic py-1">
          No outputs yet
        </div>

        <div :if={@output_canvases != []} class="space-y-3">
          <div
            :for={canvas <- Enum.reverse(@output_canvases)}
            class="rounded-box border border-base-300 bg-base-100 p-3 space-y-2"
          >
            <div class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <div class="truncate text-sm font-medium">{canvas.title || "Output"}</div>
                <div class="text-xs text-base-content/50">
                  {Platform.Chat.CanvasDocument.root_kind(canvas.document) || "canvas"} • {Calendar.strftime(
                    canvas.inserted_at,
                    "%b %-d, %-I:%M %p"
                  )}
                </div>
              </div>
              <div class="flex items-center gap-2">
                <span
                  :if={MapSet.member?(@review_output_ids, canvas.id)}
                  class="badge badge-warning badge-xs"
                >
                  Review item
                </span>
                <button
                  class="btn btn-ghost btn-xs"
                  phx-click="canvas_open"
                  phx-value-canvas-id={canvas.id}
                >
                  Open
                </button>
              </div>
            </div>

            <div class="overflow-hidden rounded-box border border-base-200 bg-base-200/30">
              <PlatformWeb.Chat.CanvasRenderer.canvas_document
                canvas={canvas}
                inline={true}
                show_header={false}
                dom_id_base="tasks-output-inline"
              />
            </div>
          </div>
        </div>
      </div>

      <%!-- Pending Review --%>
      <div :if={@pending_reviews != []} class="space-y-2">
        <div class="flex items-center gap-2">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
            Pending Review
          </h3>
          <span class="badge badge-warning badge-xs">{length(@pending_reviews)}</span>
        </div>

        <div
          :for={review <- @pending_reviews}
          class="rounded-box border border-warning bg-warning/5 p-3 space-y-3"
        >
          <div class="flex items-center justify-between text-xs text-base-content/50">
            <span :if={review.submitted_by}>
              Submitted by {review.submitted_by}
            </span>
            <span>{Calendar.strftime(review.inserted_at, "%b %d, %H:%M")}</span>
          </div>

          <div
            :for={item <- review.items}
            class="rounded-lg border border-base-300 bg-base-100 p-3 space-y-2"
          >
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium">{item.label}</span>
              <%= cond do %>
                <% item.status == "approved" -> %>
                  <span class="badge badge-success badge-xs gap-1">
                    <span class="hero-check-circle size-3"></span> Approved
                  </span>
                <% item.status == "needs_revision" -> %>
                  <span class="badge badge-warning badge-xs">Needs revision</span>
                <% true -> %>
                  <span class="badge badge-ghost badge-xs">Pending</span>
              <% end %>
            </div>

            <p :if={item.content} class="text-xs text-base-content/70 whitespace-pre-wrap">
              {item.content}
            </p>

            <div :if={item.canvas_id} class="flex items-center gap-2 text-xs">
              <span class="badge badge-outline badge-xs gap-1">
                <span class="hero-squares-2x2 size-3"></span> Linked output
              </span>
              <button
                class="btn btn-ghost btn-xs"
                phx-click="open_review_canvas"
                phx-value-canvas-id={item.canvas_id}
              >
                View output
              </button>
            </div>

            <%!-- Feedback display for rejected items --%>
            <div
              :if={item.status == "needs_revision" && item.feedback}
              class="rounded bg-warning/10 p-2 text-xs text-warning-content"
            >
              <span class="font-medium">Feedback:</span> {item.feedback}
            </div>

            <%!-- Action buttons for pending items --%>
            <div :if={item.status == "pending"} class="flex items-center gap-2">
              <button
                class="btn btn-success btn-xs"
                phx-click="approve_review_item"
                phx-value-item-id={item.id}
              >
                <span class="hero-check size-3"></span> Approve
              </button>
              <button
                class="btn btn-ghost btn-xs"
                phx-click="toggle_review_feedback"
                phx-value-item-id={item.id}
              >
                <span class="hero-chat-bubble-left size-3"></span> Send feedback
              </button>
            </div>

            <%!-- Feedback textarea (toggled) --%>
            <div
              :if={item.status == "pending" && MapSet.member?(@review_feedback_open, item.id)}
              class="space-y-2"
            >
              <textarea
                class="textarea textarea-bordered textarea-xs w-full"
                placeholder="Describe what needs to change..."
                phx-keyup="update_review_feedback_text"
                phx-value-item-id={item.id}
              >{Map.get(@review_items_feedback, item.id, "")}</textarea>
              <button
                class="btn btn-warning btn-xs"
                phx-click="submit_review_feedback"
                phx-value-item-id={item.id}
                phx-value-feedback={Map.get(@review_items_feedback, item.id, "")}
              >
                Submit Feedback
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%!-- Stack detail panel (T8 stage 1 — slide-in from right).
       Mirrors the per-task detail container shape so the two panels
       feel visually identical. Stage 1 ships head + action row;
       stages 2-5 fill in meta-grid, dep DAG, members list, and
       mobile takeover. Purple accent (#7b5cff) matches mock canvas
       019e1a16 rev 2 (.stk-tag style). --%>
  <%!-- T8 stage 5: mobile takeover + sticky action bar.
       Container responsive classes:
       - On mobile (<md): `inset-0 max-w-full` so the panel fills the
         viewport edge-to-edge as a full-screen takeover.
       - On md+ (desktop): `md:inset-y-0 md:left-auto md:right-0
         md:max-w-lg` reverts to the slide-in shape from stages 1-4.
       Bottom edge mirrors PR #335's per-task panel pattern: stops at
       the top of the bottom-nav (including iOS home-indicator safe-
       area) via `bottom-[calc(env(safe-area-inset-bottom)+var(--bottom-
       nav-height,0px))]` on the panel container itself. No
       defense-in-depth `pb-` on the inner scroller — PR #335 stripped
       that pattern as dead space. --%>
  <div
    :if={@show_stack_detail && @selected_stack}
    id="stack-detail-panel"
    data-role="stack-detail-panel"
    data-stack-id={@selected_stack.id}
    class="fixed inset-0 md:inset-y-0 md:left-auto md:right-0 bottom-[calc(env(safe-area-inset-bottom)+var(--bottom-nav-height,0px))] z-30 flex w-full max-w-full md:max-w-lg flex-col border-l border-base-300 bg-base-100 shadow-xl safe-area-top"
  >
    <%!-- Head/app bar. On mobile the chrome is a back arrow + Stack
         tag + overflow kebab (matching the mock's `.detail-appbar`).
         On desktop the head retains the stage 1 shape: title + close X
         button on the right. The back arrow + kebab carry `md:hidden`;
         the desktop close X carries `hidden md:flex`. The Stack tag
         and title/description block render on both viewports. --%>
    <div class="flex items-start justify-between gap-3 border-b border-base-300 px-4 py-3">
      <%!-- Mobile back arrow: same handler as the desktop close X. --%>
      <button
        type="button"
        class="btn btn-sm btn-ghost btn-square shrink-0 md:hidden"
        phx-click="close_stack_detail"
        aria-label="Back"
        data-role="stack-detail-back"
      >
        <span class="hero-arrow-left size-4"></span>
      </button>
      <div class="flex min-w-0 flex-1 flex-col gap-1.5">
        <div class="flex min-w-0 items-center gap-2">
          <span
            class="hero-rectangle-stack size-4 shrink-0 text-violet-300"
            aria-hidden="true"
          >
          </span>
          <span
            class="text-[9px] font-semibold uppercase tracking-wider shrink-0"
            style="color:#7b5cff"
            data-role="stack-tag"
          >
            Stack
          </span>
        </div>
        <h2
          id={"stack-detail-title-#{@selected_stack.id}"}
          class="text-lg font-semibold leading-tight truncate"
          data-role="stack-detail-title"
        >
          {@selected_stack.name}
        </h2>
        <p
          :if={@selected_stack.description && @selected_stack.description != ""}
          class="text-xs text-base-content/60 leading-snug"
          data-role="stack-detail-description"
        >
          {@selected_stack.description}
        </p>
      </div>
      <%!-- Mobile overflow kebab. No-op trigger for now (visual parity
           with the mock); when stack-level overflow actions land they
           wire here. --%>
      <button
        type="button"
        class="btn btn-sm btn-ghost btn-square shrink-0 md:hidden"
        aria-label="Stack actions"
        data-role="stack-detail-overflow"
      >
        <span class="hero-ellipsis-vertical size-4"></span>
      </button>
      <%!-- Desktop close X. Hidden on mobile (the back arrow replaces
           it on the left); visible on md+ where the slide-in shape
           keeps the close affordance on the right. --%>
      <button
        type="button"
        class="hidden md:flex btn btn-sm btn-ghost btn-square shrink-0"
        phx-click="close_stack_detail"
        aria-label="Close stack details"
        data-role="stack-detail-close"
      >
        <span class="hero-x-mark size-4"></span>
      </button>
    </div>

    <%!-- Meta-grid (T8 stage 2): 4-cell summary under the head.
         Desktop = 4 columns horizontal; mobile baseline 2x2 lands in
         stage 5. Cells: status (color-coded), members (count · ready),
         dep-edges (count · valid DAG / cycle detected), branch (mono).
         Computed via `stack_meta/2` to keep the template clean. --%>
    <% meta = stack_meta(@selected_stack, @selected_stack_members) %>
    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-2 border-b border-base-300 px-4 py-3"
      data-role="stack-detail-meta"
    >
      <div class="meta-cell rounded-md bg-base-300 p-2" data-role="meta-cell-status">
        <div class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
          Status
        </div>
        <div
          class={"mt-1 text-sm font-medium #{meta.status.class}"}
          data-role="meta-cell-status-value"
        >
          {meta.status.label}
        </div>
      </div>
      <div class="meta-cell rounded-md bg-base-300 p-2" data-role="meta-cell-members">
        <div class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
          Members
        </div>
        <div class="mt-1 text-sm font-medium" data-role="meta-cell-members-value">
          {meta.members.text}
        </div>
      </div>
      <div class="meta-cell rounded-md bg-base-300 p-2" data-role="meta-cell-dep-edges">
        <div class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
          Dep edges
        </div>
        <div
          class={"mt-1 text-sm font-medium #{dep_edges_class(meta.dep_edges)}"}
          data-role="meta-cell-dep-edges-value"
        >
          {meta.dep_edges.text}
        </div>
      </div>
      <div class="meta-cell rounded-md bg-base-300 p-2" data-role="meta-cell-branch">
        <div class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
          Branch
        </div>
        <div
          class="mt-1 truncate font-mono text-xs text-base-content"
          data-role="meta-cell-branch-value"
          title={meta.branch}
        >
          {meta.branch}
        </div>
      </div>
    </div>

    <%!-- Body: stage 3 ships the dep DAG SVG in the left column; stage 4
         adds the members list in the right column (mobile collapses to a
         single column in stage 5). The body is a 2-column grid so the
         DAG and members list share width 1:1 on desktop. --%>
    <% dag = stack_dag_layout(@selected_stack_members)
    {dag_w, dag_h} = dag.viewbox %>
    <div
      class="flex-1 overflow-y-auto p-4 grid grid-cols-1 md:grid-cols-2 gap-4"
      data-role="stack-detail-body"
    >
      <%!-- Left column: dep DAG. `.dag` matches the mock chrome
           (rounded base-300 backdrop, modest padding). The SVG scales
           fluidly via `w-full h-auto`; viewBox keeps the aspect lock
           and the topological positions so node ② and ③ visibly share
           a row when they're parallel siblings. --%>
      <div class="dag rounded bg-base-300 p-2" data-role="stack-detail-dag">
        <svg
          viewBox={"0 0 #{dag_w} #{dag_h}"}
          xmlns="http://www.w3.org/2000/svg"
          class="w-full h-auto block"
          data-role="stack-detail-dag-svg"
        >
          <%!-- Edges render as dashed lines with no arrowhead per Rowan's
               T8 stage-5 review: direction is implicit from the
               topological-row layout (sources are above targets), so
               the marker-end arrowhead is intentionally omitted. --%>
          <%= for edge <- dag.edges do %>
            <line
              x1={edge.x1}
              y1={edge.y1}
              x2={edge.x2}
              y2={edge.y2}
              stroke="#7b5cff"
              stroke-width="1.4"
              stroke-dasharray="6,4"
              data-role="stack-detail-dag-edge"
              data-from-id={edge.from_id}
              data-to-id={edge.to_id}
            />
          <% end %>
          <%= for node <- dag.nodes do %>
            <% style = dag_node_style(node.status) %>
            <g data-role="stack-detail-dag-node" data-node-id={node.id}>
              <rect
                x={node.x}
                y={node.y}
                width={node.w}
                height={node.h}
                rx="6"
                fill={style.fill}
                stroke={style.stroke}
                stroke-width="1.2"
                stroke-dasharray={style.dasharray}
                data-status={node.status}
              />
              <text
                x={node.x + 12}
                y={node.y + 18}
                font-size="11"
                font-weight="700"
                fill={style.num_color}
              >
                {node.num}
              </text>
              <text x={node.x + 26} y={node.y + 18} font-size="9" fill={style.text}>
                {dag_node_label(node.label)}
              </text>
              <text
                x={node.x + 26}
                y={node.y + 34}
                font-size="7"
                letter-spacing="0.5"
                fill={style.caption_color}
              >
                {style.caption}
              </text>
            </g>
          <% end %>
        </svg>
      </div>
      <%!-- Right column: linear members list (T8 stage 4). One row per
           in-stack member ordered by `stack_position`. Each row carries
           a circular position badge (status-coloured), the truncated
           title, a status pill on the right, and an optional dep
           annotation line below ("depends on ① + ②" /
           "depends on ① (parallel with ②)") suppressed when the member
           has no in-stack predecessors. Rows are clickable: clicking
           one push_patches to /tasks/:id and closes this stack panel
           (close-and-open behavior — the per-task detail slides in to
           replace the stack panel). --%>
      <div
        class="flex flex-col gap-2 overflow-y-auto"
        data-role="stack-detail-members"
      >
        <div
          class="flex items-center gap-2"
          data-role="stack-detail-members-header"
        >
          <span class="text-xs font-semibold uppercase tracking-wider text-base-content/60">
            Members
          </span>
          <span class="text-[10px] text-base-content/50">(dispatch order)</span>
        </div>
        <div class="mlist flex flex-col gap-1.5" data-role="stack-detail-members-list">
          <%= for member <- @selected_stack_members do %>
            <% {pill_label, pill_class} = member_status_pill(member.status)
            annotation = member_dep_annotation(member, @selected_stack_members) %>
            <div
              class="mlist-item rounded-md bg-base-300 border border-base-300 p-2 cursor-pointer hover:bg-base-200 transition-colors"
              phx-click="select_task"
              phx-value-id={member.id}
              data-role="stack-detail-member-row"
              data-member-id={member.id}
              data-member-status={member.status}
            >
              <div class="flex items-center gap-2">
                <span
                  class={"inline-flex size-5 items-center justify-center rounded-full text-[11px] font-semibold shrink-0 #{member_node_class(member.status)}"}
                  data-role="stack-detail-member-num"
                >
                  {stack_position_glyph(member.stack_position)}
                </span>
                <span
                  class="flex-1 truncate text-sm text-base-content"
                  data-role="stack-detail-member-title"
                >
                  {member.title}
                </span>
                <span
                  class={"shrink-0 rounded px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider #{pill_class}"}
                  data-role="stack-detail-member-pill"
                >
                  {pill_label}
                </span>
              </div>
              <div
                :if={annotation}
                class="pl-7 text-[10px] text-base-content/50"
                data-role="stack-detail-member-deps"
              >
                {annotation}
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- Action row: Abandon (ghost) + View rollup PR (primary).
         The PR anchor is disabled when no rollup PR has been opened
         yet (metadata.rollup_pr.url is nil). --%>
    <% rollup_pr_url =
      case @selected_stack.metadata do
        %{"rollup_pr" => %{"url" => url}} when is_binary(url) and url != "" -> url
        _ -> nil
      end %>
    <%!-- Sticky bottom action bar (T8 stage 5). `mt-auto sticky
         bottom-0` keeps Abandon + View rollup PR pinned to the
         viewport bottom on mobile (where the panel is full-screen
         and the body scrolls beneath); on desktop the same bar
         renders flush with the panel bottom for placement
         consistency. The panel container's
         `bottom-[calc(env(safe-area-inset-bottom)+var(--bottom-nav-
         height,0px))]` constraint (PR #335 pattern) keeps the bar
         from being occluded by the bottom-tab nav on iOS — no
         defense-in-depth pb on this bar is required. --%>
    <div
      class="mt-auto sticky bottom-0 flex gap-2 border-t border-base-300 bg-base-100 px-4 py-3"
      data-role="stack-detail-actions"
    >
      <button
        type="button"
        class="btn btn-ghost btn-sm flex-1"
        phx-click="abandon_stack"
        data-confirm="Abandon this stack? This cannot be undone."
        data-role="stack-detail-abandon"
      >
        Abandon
      </button>
      <%= if rollup_pr_url do %>
        <a
          href={rollup_pr_url}
          target="_blank"
          rel="noopener"
          class="btn btn-primary btn-sm flex-1"
          data-role="stack-detail-rollup-pr"
        >
          View rollup PR
        </a>
      <% else %>
        <button
          type="button"
          class="btn btn-primary btn-sm flex-1 btn-disabled"
          disabled
          aria-disabled="true"
          data-role="stack-detail-rollup-pr"
        >
          View rollup PR
        </button>
      <% end %>
    </div>
  </div>

  <%!-- Review canvas modal --%>
  <div
    :if={@active_review_canvas}
    class="fixed inset-0 z-50 flex items-center justify-center px-4 py-6"
  >
    <div class="absolute inset-0 bg-black/50" phx-click="close_review_canvas" />
    <div class="relative z-10 flex max-h-[90vh] w-full max-w-6xl flex-col overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-2xl">
      <div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
        <div class="min-w-0">
          <div class="truncate text-sm font-semibold">
            {@active_review_canvas.title || "Review canvas"}
          </div>
          <div class="text-xs text-base-content/60">
            {Platform.Chat.CanvasDocument.root_kind(@active_review_canvas.document) || "canvas"}
          </div>
        </div>
        <button
          class="btn btn-ghost btn-sm btn-square"
          phx-click="close_review_canvas"
          aria-label="Close review canvas"
        >
          <span class="hero-x-mark size-4"></span>
        </button>
      </div>
      <div class="overflow-auto p-4">
        <PlatformWeb.Chat.CanvasRenderer.canvas_document
          canvas={@active_review_canvas}
          show_header={false}
          dom_id_base="tasks-review-modal"
        />
      </div>
    </div>
  </div>

  <%!-- Reopen-with-feedback modal (mirrors the assignee-modal shape:
       mobile-first bottom sheet on small screens, centered dialog on
       >=sm). Submit is disabled client-side until the textarea has
       non-whitespace content; the server also re-validates and surfaces
       `:reason_required` as a flash if the client check is bypassed. --%>
  <div
    :if={@show_reopen_modal && @selected_task}
    class="fixed inset-0 z-50 flex items-end sm:items-center justify-center"
    id="reopen-modal"
  >
    <%!-- Backdrop --%>
    <div class="absolute inset-0 bg-black/40" phx-click="close_reopen_modal" />

    <%!-- Sheet / dialog --%>
    <div class="relative w-full max-w-lg rounded-t-2xl sm:rounded-2xl bg-base-100 shadow-2xl pb-[env(safe-area-inset-bottom)] max-h-[90vh] overflow-y-auto">
      <%!-- Header --%>
      <div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
        <div class="min-w-0">
          <h2 class="text-base font-semibold">Reopen with feedback</h2>
          <p class="mt-0.5 text-xs text-base-content/60 truncate">
            {@selected_task.title}
          </p>
        </div>
        <button
          type="button"
          phx-click="close_reopen_modal"
          class="btn btn-sm btn-ghost btn-square"
          aria-label="Close"
        >
          <span class="hero-x-mark size-4"></span>
        </button>
      </div>

      <%!-- Form body --%>
      <form
        id="task-reopen-form"
        phx-hook="ButtonLoading"
        phx-submit="submit_reopen"
        class="flex flex-col gap-3 px-4 py-4"
      >
        <div class="flex flex-col gap-1">
          <label
            for="reopen-reason-textarea"
            class="text-xs font-semibold uppercase tracking-wider text-base-content/60"
          >
            Why is this being reopened?
          </label>
          <textarea
            id="reopen-reason-textarea"
            name="reason"
            data-role="reopen-reason-textarea"
            rows="5"
            phx-change="reopen_reason_changed"
            placeholder="Describe what's wrong, what's missing, or what should change. The active plan will be rejected with this reason and the task will return to planning."
            class="textarea textarea-bordered w-full text-sm"
          >{@reopen_reason}</textarea>
          <p
            :if={String.trim(@reopen_reason) == ""}
            class="text-xs text-base-content/50"
            data-role="reopen-reason-hint"
          >
            A reason is required so the planner has context for the next revision.
          </p>
        </div>

        <div class="flex items-center justify-end gap-2 pt-1">
          <button
            type="button"
            phx-click="close_reopen_modal"
            class="btn btn-ghost btn-sm"
          >
            Cancel
          </button>
          <button
            type="submit"
            data-role="reopen-submit-button"
            class="btn btn-warning btn-sm"
            disabled={String.trim(@reopen_reason) == ""}
          >
            Reopen task
          </button>
        </div>
      </form>
    </div>
  </div>

  <%!-- FAB: Create Task --%>
  <button
    phx-click="toggle_task_sheet"
    class={[
      "btn btn-primary btn-circle fixed bottom-[calc(env(safe-area-inset-bottom)+1.5rem+var(--bottom-nav-height,0px))] right-6 z-30 shadow-lg",
      @selected_task && "max-md:hidden"
    ]}
  >
    <span class="hero-plus size-6"></span>
  </button>

  <%!-- Mobile project filter sheet (task 019e0d4b stage 3 sub a). Slides
       in from the left on mobile, hidden entirely on md+ where the project
       filter lives in a different surface. --%>
  <.sheet
    id="project-sheet"
    open={@show_project_sheet}
    placement={:left}
    on_close="close_project_sheet"
    class="md:hidden"
  >
    <:title>Projects</:title>
    <div class="flex flex-col">
      <button
        :for={project <- @projects}
        phx-click="select_project"
        phx-value-id={project.id}
        class={"w-full text-left px-3 py-2 text-sm hover:bg-base-200 #{if @selected_project_id == project.id, do: "bg-base-200 font-medium"}"}
      >
        {project.name}
      </button>
    </div>
    <:actions>
      <button phx-click="clear_filters" class="btn btn-xs btn-ghost w-full">
        All Projects
      </button>
    </:actions>
  </.sheet>

  <%!-- Per-phase assignee modal (mobile-first; full-screen sheet on small,
       centered dialog on >=sm) --%>
  <div
    :if={@show_assignee_modal && @selected_task}
    class="fixed inset-0 z-50 flex items-end sm:items-center justify-center"
    id="assignee-modal"
  >
    <%!-- Backdrop --%>
    <div class="absolute inset-0 bg-black/40" phx-click="close_assignee_modal" />

    <%!-- Sheet / dialog --%>
    <div class="relative w-full max-w-lg rounded-t-2xl sm:rounded-2xl bg-base-100 shadow-2xl pb-[env(safe-area-inset-bottom)] max-h-[90vh] overflow-y-auto">
      <%!-- Header --%>
      <div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
        <div>
          <h2 class="text-base font-semibold">Assign Agents</h2>
          <p class="mt-0.5 text-xs text-base-content/60">
            {@selected_task.title}
          </p>
        </div>
        <button
          type="button"
          phx-click="close_assignee_modal"
          class="btn btn-sm btn-ghost btn-square"
          aria-label="Close"
        >
          <span class="hero-x-mark size-4"></span>
        </button>
      </div>

      <%!-- Mode toggle (segmented) --%>
      <div class="flex items-center justify-between px-4 py-3 border-b border-base-300 gap-3">
        <p class="text-xs text-base-content/60 leading-snug">
          {if @assignee_modal_mode == :advanced,
            do: "One agent per phase. Build the DAG.",
            else: "One agent for the whole task."}
        </p>
        <div class="join shrink-0">
          <button
            type="button"
            phx-click="set_assignee_modal_mode"
            phx-value-mode="simple"
            class={[
              "btn btn-sm join-item",
              @assignee_modal_mode == :simple && "btn-primary",
              @assignee_modal_mode != :simple && "btn-ghost"
            ]}
            aria-pressed={if @assignee_modal_mode == :simple, do: "true", else: "false"}
          >
            Simple
          </button>
          <button
            type="button"
            phx-click="set_assignee_modal_mode"
            phx-value-mode="advanced"
            class={[
              "btn btn-sm join-item",
              @assignee_modal_mode == :advanced && "btn-primary",
              @assignee_modal_mode != :advanced && "btn-ghost"
            ]}
            aria-pressed={if @assignee_modal_mode == :advanced, do: "true", else: "false"}
          >
            Advanced
          </button>
        </div>
      </div>

      <%!-- Form body --%>
      <form
        id="task-assignees-form"
        phx-hook="ButtonLoading"
        phx-submit="save_assignees"
        class="flex flex-col gap-3 px-4 py-4"
      >
        <%!-- Simple mode --%>
        <div :if={@assignee_modal_mode == :simple} class="flex flex-col gap-1">
          <label class="text-xs font-semibold uppercase tracking-wider text-base-content/60">
            Agent (all phases)
          </label>
          <select
            name="assignees[all]"
            class="select select-bordered select-sm w-full"
          >
            <option value="">Unassigned</option>
            <option
              :for={agent <- @agents}
              value={agent.id}
              selected={
                phase_assignee_id(@selected_task, "execution") == agent.id ||
                  (is_nil(phase_assignee_id(@selected_task, "execution")) &&
                     @selected_task.assignee_id == agent.id)
              }
            >
              {agent.name}
            </option>
          </select>
        </div>

        <%!-- Advanced mode: per-phase pickers --%>
        <div :if={@assignee_modal_mode == :advanced} class="flex flex-col gap-3">
          <div :for={phase <- ~w(planning execution review)} class="flex flex-col gap-1">
            <label class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-base-content/60">
              <span>{phase_label(phase)}</span>
              <span
                :if={phase == current_phase_label(@selected_task)}
                class="badge badge-primary badge-xs"
              >
                Current
              </span>
            </label>
            <select
              name={"assignees[" <> phase <> "]"}
              class="select select-bordered select-sm w-full"
            >
              <option value="">Unassigned</option>
              <option
                :for={agent <- @agents}
                value={agent.id}
                selected={phase_assignee_id(@selected_task, phase) == agent.id}
              >
                {agent.name}
              </option>
            </select>
          </div>

          <p class="mt-1 text-[11px] text-base-content/50">
            The current-phase agent is the one the task router dispatches to right now.
            When the task transitions across phases, the assignee is updated automatically.
          </p>
        </div>

        <%!-- Actions --%>
        <div class="mt-2 flex justify-end gap-2 border-t border-base-300 pt-3">
          <button
            type="button"
            phx-click="close_assignee_modal"
            class="btn btn-sm btn-ghost"
          >
            Cancel
          </button>
          <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>

  <%!-- New-task sheet (task 019e0d4b stage 3 sub b). Bottom sheet on mobile,
       centered card on desktop per <.sheet> spec §3 @media(min-width: 768px).
       The form lives inside :inner_block; submit buttons stay inside the form
       for proper form-submission semantics (not in :actions slot).

       :if={@show_task_sheet} on the Sheet itself (rather than open={@flag})
       — the form has many select dropdowns (project, epic, agent) that would
       otherwise leak option text into the always-rendered DOM and break
       refute-by-text assertions in the existing test suite (e.g. the epic-
       toggle-collapse test). --%>
  <.sheet
    :if={@show_task_sheet}
    id="task-sheet"
    open={true}
    placement={:bottom}
    on_close="close_task_sheet"
  >
    <:title>New Task</:title>
    <.form
      for={@task_form}
      id="create-task-form"
      phx-hook="ButtonLoading"
      phx-change="validate_task"
      phx-submit="create_task"
      class="space-y-4"
    >
      <%!-- Title --%>
      <div>
        <label class="label label-text text-xs font-medium">Title *</label>
        <input
          type="text"
          name="task[title]"
          value={@task_form[:title].value}
          required
          placeholder="Add unread badges"
          class="input input-bordered input-sm w-full"
        />
      </div>

      <%!-- Project --%>
      <div>
        <label class="label label-text text-xs font-medium">Project *</label>
        <select name="task[project_id]" class="select select-bordered select-sm w-full" required>
          <option value="">Select project</option>
          <option
            :for={project <- @projects}
            value={project.id}
            selected={@task_form[:project_id].value == project.id}
          >
            {project.name}
          </option>
        </select>
      </div>

      <%!-- What --%>
      <div>
        <label class="label label-text text-xs font-medium">What *</label>
        <textarea
          name="task[what]"
          required
          placeholder="What is being changed or added?"
          style="line-height:1.5;padding:6px 12px;min-height:33px;max-height:200px;overflow-y:auto;field-sizing:content"
          class="textarea textarea-bordered w-full text-sm"
        >{@sheet_what}</textarea>
      </div>

      <%!-- Why --%>
      <div>
        <label class="label label-text text-xs font-medium">Why *</label>
        <textarea
          name="task[why]"
          required
          placeholder="Why is this change needed?"
          style="line-height:1.5;padding:6px 12px;min-height:33px;max-height:200px;overflow-y:auto;field-sizing:content"
          class="textarea textarea-bordered w-full text-sm"
        >{@sheet_why}</textarea>
      </div>

      <%!-- Epic --%>
      <div>
        <label class="label label-text text-xs font-medium">Epic</label>
        <select name="task[epic_id]" class="select select-bordered select-sm w-full">
          <option value="">None</option>
          <option
            :for={epic <- @epics}
            value={epic.id}
            selected={@task_form[:epic_id].value == epic.id}
          >
            {epic.name}
          </option>
        </select>
      </div>

      <%!-- Agent --%>
      <div>
        <label class="label label-text text-xs font-medium">Agent</label>
        <select name="task[assignee_id]" class="select select-bordered select-sm w-full">
          <option value="">None</option>
          <option
            :for={agent <- @agents}
            value={agent.id}
            selected={@task_form[:assignee_id].value == agent.id}
          >
            {agent.name}
          </option>
        </select>
        <input type="hidden" name="task[assignee_type]" value="agent" />
      </div>

      <%!-- Deploy Strategy --%>
      <div>
        <label class="label label-text text-xs font-medium">Deploy Strategy</label>
        <select
          name="task[deploy_strategy_type]"
          id="deploy-strategy-type"
          class="select select-bordered select-sm w-full"
          phx-change="validate_task"
        >
          <option value="inherit">Inherit from project</option>
          <option value="pr_merge">PR Merge</option>
          <option value="docker_deploy">Docker Deploy</option>
          <option value="skill_driven">Skill Driven</option>
          <option value="manual">Manual</option>
          <option value="none">None (skip deploy)</option>
        </select>
      </div>
      <%!-- Auto-merge config — visible only when PR Merge is selected --%>
      <div
        :if={@deploy_strategy_type == "pr_merge"}
        class="space-y-2 pl-2 border-l-2 border-base-300"
      >
        <label class="label cursor-pointer justify-start gap-2">
          <input
            type="checkbox"
            name="task[auto_merge]"
            value="true"
            checked={@auto_merge_enabled}
            class="toggle toggle-sm toggle-primary"
            phx-click="toggle_auto_merge"
          />
          <span class="label-text text-xs">
            Auto-merge after CI passes
          </span>
          <div
            class="tooltip tooltip-right"
            data-tip="When enabled, PRs are automatically merged after CI passes. When disabled, a human must click merge."
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5 opacity-50"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                clip-rule="evenodd"
              />
            </svg>
          </div>
        </label>
        <div :if={@auto_merge_enabled}>
          <label class="label label-text text-xs font-medium">Merge Method</label>
          <select
            name="task[merge_method]"
            class="select select-bordered select-xs w-full"
          >
            <option value="squash" selected={@merge_method == "squash"}>Squash</option>
            <option value="merge" selected={@merge_method == "merge"}>Merge commit</option>
            <option value="rebase" selected={@merge_method == "rebase"}>Rebase</option>
          </select>
        </div>
      </div>

      <%!-- Validation Mode --%>
      <div>
        <label class="label label-text text-xs font-medium">Validation</label>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            phx-click="toggle_validation_mode"
            phx-value-mode="show_me"
            class={"btn btn-sm #{if MapSet.member?(@validation_modes, "show_me"), do: "btn-primary", else: "btn-outline"}"}
          >
            Show me
          </button>
          <button
            type="button"
            phx-click="toggle_validation_mode"
            phx-value-mode="handle_it"
            class={"btn btn-sm #{if MapSet.member?(@validation_modes, "handle_it"), do: "btn-primary", else: "btn-outline"}"}
          >
            Handle it
          </button>
          <button
            type="button"
            phx-click="toggle_validation_mode"
            phx-value-mode="manual"
            class={"btn btn-sm #{if MapSet.member?(@validation_modes, "manual"), do: "btn-primary", else: "btn-outline"}"}
          >
            Manual
          </button>
        </div>
        <textarea
          :if={MapSet.member?(@validation_modes, "manual")}
          name="task[manual_validation_text]"
          placeholder="Describe the validation criteria..."
          style="line-height:1.5;padding:6px 12px;min-height:33px;max-height:200px;overflow-y:auto;field-sizing:content"
          class="textarea textarea-bordered mt-2 w-full text-sm"
        >{@manual_validation_text}</textarea>
      </div>

      <%!-- Attachments --%>
      <div>
        <label class="label label-text text-xs font-medium">Attachments</label>
        <.live_file_input
          upload={@uploads.task_attachments}
          class="file-input file-input-bordered file-input-sm w-full"
        />
        <div
          :for={entry <- @uploads.task_attachments.entries}
          class="mt-2 flex items-center gap-2 text-xs"
        >
          <span class="flex-1 truncate">{entry.client_name}</span>
          <span class="text-base-content/40">
            {Float.round(entry.client_size / 1_000, 1)} KB
          </span>
          <button
            type="button"
            phx-click="cancel_task_upload"
            phx-value-ref={entry.ref}
            class="btn btn-ghost btn-xs btn-square"
          >
            <span class="hero-x-mark size-3"></span>
          </button>
        </div>
        <div
          :for={err <- upload_errors(@uploads.task_attachments)}
          class="mt-1 text-xs text-error"
        >
          {err}
        </div>
      </div>

      <%!-- Submit buttons --%>
      <div class="flex gap-2 pt-2">
        <button
          type="submit"
          name="task[action]"
          value="create"
          class="btn btn-primary btn-sm flex-1"
        >
          Create Task
        </button>
        <button
          type="submit"
          name="task[action]"
          value="create_and_plan"
          class="btn btn-secondary btn-sm flex-1"
        >
          Create & Request Plan
        </button>
      </div>
    </.form>
  </.sheet>

  <%!-- Per-row task-actions sheet (task 019e0d4b stage 2). Replaces the
       inert mobile DaisyUI dropdown that used to live inline in each
       task row. Single sheet at the page bottom; renders only when
       @open_task_actions_id is set. The sheet's :open attr drives the
       slide-in animation; @open_task_actions_id is the source of truth
       for which row's actions are showing. --%>
  <.sheet
    :if={@open_task_actions_id}
    id="task-actions-sheet"
    open={true}
    placement={:bottom}
    on_close="close_task_actions"
  >
    <:title>Task actions</:title>
    <div class="flex flex-col gap-1">
      <button
        type="button"
        phx-click="select_task_and_delete"
        phx-value-id={@open_task_actions_id}
        class="flex items-center gap-3 rounded-lg px-4 py-3 text-left text-error hover:bg-base-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-error/60"
      >
        <span class="hero-trash size-5"></span>
        <span class="font-medium">Delete task</span>
      </button>
    </div>
  </.sheet>
</div>
