<div
  id="tasks-last-project"
  class="flex h-full min-h-0"
>
  <%!-- Sidebar / Projects / Epics (task 01a008f6 stage 2). The desktop
       aside, the collapsed reopen rail and the three project/epic sheets
       all live in PlatformWeb.TasksLive.SidebarComponent, which carries
       its HEEx inline. Trigger sites elsewhere in this template reach it
       with phx-target="#tasks-sidebar". --%>
  <.live_component
    module={PlatformWeb.TasksLive.SidebarComponent}
    id="tasks-sidebar"
    access_scope={@access_scope}
    project_sections={@project_sections}
    projects_by_org={@projects_by_org}
    orgs={@orgs}
    root_admin?={@root_admin?}
    lifecycle_menu_key={@lifecycle_menu_key}
    mask_names?={@mask_names?}
    revealed_rail_ids={@revealed_rail_ids}
    mask_labels={@mask_labels}
    selected_project_id={@selected_project_id}
    current_user_id={@current_user_id}
  />

  <%!-- Phone Tasks list (task 01a1557a-b20a stage 2; header, sheets and the
       narrowed list task 01a161fd stage 3). Below lg it is the view at load;
       "Board" swaps to #tasks-main by a sticky JS class op. --%>
  <PlatformWeb.Tasks.MyTasksList.my_tasks_list
    filtered_tasks={@filtered_tasks}
    filtered_count={@filtered_count}
    row_limit={@tasks_my_list_limit}
    my_needs_you={@my_needs_you}
    mask_names?={@mask_names?}
    mask_labels={@mask_labels}
    projects={@projects}
    epics={@epics}
    active_scopes={@active_scopes}
    sheet={@tasks_filter_sheet}
    drill_epics={@tasks_filter_epics}
    selected_project_id={@selected_project_id}
    selected_epic_id={@selected_epic_id}
    board_sort={@board_sort}
    status_filters={@status_filters}
    kind_filters={@kind_filters}
    mine_filter={@mine_filter}
    sponsor_filter={@sponsor_filter}
    task_search_query={@task_search_query}
    scope_filter={@scope_filter}
    origin_filter={@origin_filter}
  />

  <%!-- Main content area --%>
  <div id="tasks-main" class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden max-lg:hidden">
    <%!-- Board header (re-skin Phase 2 stage 2, task 019f51ca): page_header
         replaces the ad-hoc header row. The count badge stays the
         UNFILTERED total (search narrows the board, not the headline).
         The scope rail + breadcrumb live in the :filters slot — they keep
         their ids/data-roles; the rail drops its own border-b because the
         header supplies the bottom hairline. --%>
    <.page_header
      id="tasks-page-header"
      title="Tasks"
      count={@visible_task_count || length(@all_tasks)}
    >
      <:leading>
        <button
          type="button"
          data-role="tasks-show-mine"
          aria-label="My tasks"
          phx-click={PlatformWeb.Tasks.MyTasksList.show_mine()}
          class="inline-flex size-11 shrink-0 items-center justify-center rounded-field text-base-content active:bg-base-100 focus-visible-ring lg:hidden"
        >
          <span class="hero-chevron-left size-5"></span>
        </button>
        <%!-- Mobile: project sheet trigger --%>
        <button
          phx-click="sidebar_toggle_project_sheet"
          phx-target="#tasks-sidebar"
          class="btn btn-ghost btn-xs btn-square md:hidden"
          title="Projects"
          aria-label="Open projects menu"
        >
          <span class="hero-bars-3 size-4"></span>
        </button>
        <%!-- Desktop picker and filters (task 01a161fd stage 4), lg only. --%>
        <PlatformWeb.Tasks.FilterDesktop.title_menu shell={assigns} />
      </:leading>
      <:badges>
        <span :if={@pending_plan_count > 0} class="badge badge-warning badge-sm gap-1">
          {@pending_plan_count} awaiting review
        </span>
      </:badges>
      <:search>
        <.search_input
          id="task-search"
          event="filter_search"
          target="#tasks-filters"
          value={@task_search_query}
          placeholder="Search tasks — id, title, sponsor, agent…"
          aria_label="Search tasks"
          class="w-full md:w-80"
        />
      </:search>
      <:primary_action>
        <div class="flex items-center gap-2">
          <%!-- hidden below md: mobile creates via the single FAB menu. --%>
          <div class="relative hidden md:block">
            <div class="join">
              <button
                type="button"
                phx-click="taskcreate_toggle_sheet"
                phx-target="#tasks-create"
                class="btn btn-primary btn-sm join-item focus-visible-ring"
                data-role="header-new-task"
              >
                <span class="hero-plus size-4"></span> New Task
              </button>
              <button
                type="button"
                phx-click="toggle_create_menu"
                class="btn btn-primary btn-sm join-item press-hold px-2 focus-visible-ring"
                aria-label="More create options"
                aria-haspopup="menu"
                aria-controls="header-create-menu"
                aria-expanded={to_string(@create_menu_open)}
                data-role="header-create-menu-trigger"
              >
                <span class="hero-chevron-down size-4"></span>
              </button>
            </div>
            <%!-- Styled-div dropdown (not a browser popover): scrim closes on
               tap-out/Escape; card reads elevation from --shadow-dropdown. --%>
            <div
              :if={@create_menu_open}
              class="fixed inset-0 z-30"
              phx-click="toggle_create_menu"
              phx-window-keydown="toggle_create_menu"
              phx-key="escape"
              aria-hidden="true"
            >
            </div>
            <div
              :if={@create_menu_open}
              id="header-create-menu"
              role="menu"
              aria-label="Create"
              class="absolute right-0 top-full z-40 mt-2 flex min-w-44 flex-col gap-2 rounded-box border border-base-content/10 bg-base-100 p-2"
              style="box-shadow: var(--shadow-dropdown);"
            >
              <button
                type="button"
                role="menuitem"
                phx-click="sidebar_toggle_epic_sheet"
                phx-target="#tasks-sidebar"
                class="flex items-center gap-2 rounded-lg px-3 py-2 text-left text-sm hover:bg-base-200 focus-visible-ring"
              >
                <span class="hero-rectangle-stack size-4"></span> New Epic
              </button>
              <button
                type="button"
                role="menuitem"
                phx-click="sidebar_toggle_project_create_sheet"
                phx-target="#tasks-sidebar"
                class="flex items-center gap-2 rounded-lg px-3 py-2 text-left text-sm hover:bg-base-200 focus-visible-ring"
                data-role="header-new-project"
              >
                <span class="hero-folder-plus size-4"></span> New Project
              </button>
            </div>
          </div>

          <PlatformWeb.Tasks.FilterDesktop.filter_menu shell={assigns} />
          <.settings_menu access_scope={@access_scope} open?={@settings_menu_open} />
        </div>
      </:primary_action>
      <:filters>
        <%!-- Board filtering (task 01a008f6 stage 6). Breadcrumb, scope rail
             and sponsor toggle render inside the component; the search input
             above and the mobile status pills below are trigger sites that
             reach it with phx-target="#tasks-filters" (a LiveComponent can
             only render in one place). --%>
        <.live_component
          module={PlatformWeb.Tasks.FiltersComponent}
          id="tasks-filters"
          scope_filter={@scope_filter}
          sponsor_filter={@sponsor_filter}
          kind_filters={@kind_filters}
          status_filters={@status_filters}
          mine_filter={@mine_filter}
          origin_filter={@origin_filter}
          board_sort={@board_sort}
          task_search_query={@task_search_query}
          scope_counts={@scope_counts}
          active_scopes={@active_scopes}
          projects={@projects}
          epics={@epics}
          mask_names?={@mask_names?}
          mask_labels={@mask_labels}
          selected_project_id={@selected_project_id}
          selected_epic_id={@selected_epic_id}
        />
      </:filters>
    </.page_header>

    <%!-- The board itself (task 01a008f6 stage 7): epics strip, mobile
         section list, desktop kanban and the per-row task-actions sheet.
         One contiguous region — 215-1281 in this file at c1762b82 — so it
         is a LiveComponent, not a LifecycleHook. Its PubSub subscriptions
         and refresh_board/1 could not follow it (PubSub delivers to the
         process, not to a component) and live in
         PlatformWeb.Tasks.BoardHooks. --%>
    <.live_component
      module={PlatformWeb.Tasks.BoardComponent}
      id="tasks-board"
      access_scope={@access_scope}
      current_user_id={@current_user_id}
      selected_project_id={@selected_project_id}
      selected_epic_id={@selected_epic_id}
      epics={@epics}
      mask_names?={@mask_names?}
      mask_labels={@mask_labels}
      epics_collapsed={@epics_collapsed}
      kanban_columns={@kanban_columns}
      mobile_columns={@mobile_columns}
      scope_filter={@scope_filter}
      sponsor_filter={@sponsor_filter}
      kind_filters={@kind_filters}
      status_filters={@status_filters}
      mine_filter={@mine_filter}
      origin_filter={@origin_filter}
      task_search_query={@task_search_query}
      columns={@columns}
      board_items={@board_items}
      board_sort={@board_sort}
      desktop_stacks_by_column={@desktop_stacks_by_column}
      stack_board_data={@stack_board_data}
      expanded_stacks={@expanded_stacks}
      review_counts={@review_counts}
      users_by_id={@users_by_id}
      agents_by_id={@agents_by_id}
      agent_names={@agent_names}
    />
  </div>

  <%!-- Task detail + inline edit + plan approval (task 01a008f6 stage 4).
       The panel container, header, detail body, plan-stage cards and the
       reopen modal render inline in the component's ~H. Execution &
       Steering (execution log + steering composer + Outputs) and the
       merge-control cluster stay HERE, passed down as the :steering and
       :panel_footer slots, so they keep the shell's assign scope and their
       untargeted events until stage 5 extracts them. --%>
  <.live_component
    module={PlatformWeb.Tasks.TaskDetailComponent}
    id="tasks-detail"
    detail_epoch={@detail_epoch}
    mask_names?={@mask_names?}
    mask_labels={@mask_labels}
    selected_task={@selected_task}
    show_detail={@show_detail}
    access_scope={@access_scope}
    current_user_id={@current_user_id}
    current_user_email={@current_user_email}
    my_pinned_task_ids={@my_pinned_task_ids}
    selected_task_canvases={@selected_task_canvases}
    attached_skills={@attached_skills}
    available_skills={@available_skills}
    pending_reviews={@pending_reviews}
    superseded_reviews={@superseded_reviews}
    review_canvases={@review_canvases}
    agents={@agents}
    agents_by_id={@agents_by_id}
    agent_names={@agent_names}
    users={@users}
    users_by_id={@users_by_id}
  >
    <:steering>
      <%!-- Execution & Steering (task 01a008f6 stage 5). Execution log,
           steering composer (with its own `allow_upload` plumbing and the
           now-working @-mention autocomplete) and Outputs all live in the
           component; the shell keeps only the PubSub subscription, which
           belongs to the process that receives the messages. --%>
      <.live_component
        module={PlatformWeb.Tasks.SteeringComponent}
        id="tasks-steering"
        access_scope={@access_scope}
        detail_epoch={@detail_epoch}
        selected_task={@selected_task}
        current_user_id={@current_user_id}
        pending_reviews={@pending_reviews}
      />
    </:steering>

    <:panel_footer>
      <%!-- Merge / Open PR cluster (task 01a008f6 stage 5 finished the
           extraction started by 019ff182): the component owns
           `:merge_control` and `merge_task_branch`; the shell owns
           neither. Nothing renders unless the deploy is `pr_merge` with
           `auto_merge: false` on a non-stacked task with a live
           `pr_merged` gate. --%>
      <.live_component
        module={PlatformWeb.Tasks.MergeControlComponent}
        id="tasks-merge-control"
        access_scope={@access_scope}
        detail_epoch={@detail_epoch}
        selected_task={@selected_task}
        current_user_id={@current_user_id}
      />
    </:panel_footer>
  </.live_component>

  <%!-- Stacks concern (task 01a008f6 stage 3): stack detail panel, review
       rollup overlay, dep-graph fullscreen modal and stack-level assignee
       modal. Four regions that used to sit at 2691-3178, 3180-3446,
       3482-3585 and 3957-4095 now render inline in the component's ~H. --%>
  <.live_component
    module={PlatformWeb.Tasks.StacksComponent}
    id="tasks-stacks"
    access_scope={@access_scope}
    agents={@agents}
    stacks={@stacks}
    board_review_subscriptions={@review_request_subscriptions}
    current_user_id={@current_user_id}
  />

  <%!-- Return-to-planning modal (task 01a008f6 stage 6). Owns
       `:show_supersede_modal` + `:supersede_reason`; the trigger in
       TaskDetailComponent reaches it with phx-target="#tasks-supersede". --%>
  <.live_component
    module={PlatformWeb.Tasks.SupersedeComponent}
    id="tasks-supersede"
    access_scope={@access_scope}
    selected_task={@selected_task}
    current_user_id={@current_user_id}
  />

  <%!-- New-Task creation (task 01a008f6 stage 6): the mobile create FAB,
       the bottom-sheet form and the :task_attachments upload all live in
       PlatformWeb.Tasks.TaskCreateComponent. The header split-button above
       reaches it with phx-target="#tasks-create". --%>
  <.live_component
    module={PlatformWeb.Tasks.TaskCreateComponent}
    id="tasks-create"
    access_scope={@access_scope}
    selected_task={@selected_task}
    projects_by_org={@projects_by_org}
    mask_names?={@mask_names?}
    mask_labels={@mask_labels}
    epics={@epics}
    agents={@agents}
    users={@users}
    current_user={@current_user}
  />

  <%!-- Per-phase assignee modal (task 01a008f6 stage 5). --%>
  <.live_component
    module={PlatformWeb.Tasks.AssigneesComponent}
    id="tasks-assignees"
    access_scope={@access_scope}
    selected_task={@selected_task}
    agents={@agents}
  />

  <.settings_sheet access_scope={@access_scope} open?={@settings_menu_open} />

  <%!-- Schedule-deletion confirm dialog (task 019f4eaa stage 6). Archive is
       instant + reversible with no modal; only this destructive step confirms. --%>
  <.schedule_delete_modal
    resource={@delete_modal}
    retention_days={Tenancy.Lifecycle.retention_days()}
  />

  <%!-- Archive undo toast (task 019f4eaa). Archive stays instant + dialog-free
       by design; this says what it took and keeps the reversal one click away.
       Top-level sibling — pinned chrome must never nest in an :if region. --%>
  <.archive_undo_toast undo={@undo_archive} />
</div>
