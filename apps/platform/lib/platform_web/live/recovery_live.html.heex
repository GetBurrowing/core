<div class="relative flex h-full min-h-0 flex-col">
  <.breadcrumb segments={[
    %{label: "Admin", navigate: ~p"/admin"},
    %{label: "Recovery", navigate: nil}
  ]} />
  <%!-- Header (mirrors the Admin surface chrome) — title left, org filter right --%>
  <div class="flex items-center justify-between gap-3 border-b border-edge px-4 py-3">
    <h1 class="text-sm font-semibold uppercase tracking-widest text-base-content">
      Recovery · Archived &amp; scheduled
    </h1>
    <form :if={@org_options != []} phx-change="filter_org" class="shrink-0">
      <select
        name="org"
        class="select select-sm select-bordered focus-visible-ring text-sm"
        aria-label="Filter by org"
      >
        <option value="" selected={@org_filter == nil}>All orgs</option>
        <option :for={{name, id} <- @org_options} value={id} selected={@org_filter == id}>
          {name}
        </option>
      </select>
    </form>
  </div>

  <div class="min-h-0 flex-1 overflow-y-auto p-4 clears-tab-bar">
    <div class="mx-auto max-w-6xl">
      <%= cond do %>
        <% @rows == [] -> %>
          <.empty_state variant={:standard} icon_name="hero-archive-box">
            <:title>Nothing archived</:title>
            <:body>
              Retired orgs, projects, and channels show up here so you can bring them back.
            </:body>
          </.empty_state>
        <% @top_level == [] -> %>
          <.empty_state variant={:standard} icon_name="hero-funnel">
            <:title>Nothing in that org</:title>
            <:body>
              No archived containers match this filter. Clear it to see everything recoverable.
            </:body>
          </.empty_state>
        <% true -> %>
          <%!-- Unified recoverable inventory (task 019f7600 stage 4): a row per
               org / project / channel. Containers expand to reveal the cascade
               children they hid; leaf rows carry a checkbox for selective
               restore via the pinned bulk bar below. --%>
          <div class="overflow-x-auto rounded-box border border-edge bg-base-100">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="border-b border-edge text-left text-xs font-medium uppercase tracking-wide text-base-content">
                  <th class="w-10 px-4 py-2.5">
                    <span class="sr-only">Select</span>
                  </th>
                  <.sort_header sort={@sort} key={:org} label="Org" />
                  <.sort_header sort={@sort} key={:name} label="Name" />
                  <.sort_header sort={@sort} key={:type} label="Type" />
                  <.sort_header sort={@sort} key={:status} label="Status" />
                  <.sort_header sort={@sort} key={:archived_at} label="Archived on" />
                  <.sort_header sort={@sort} key={:deletes_on} label="Deletes on" />
                  <th class="px-4 py-2.5 text-right">Action</th>
                </tr>
              </thead>
              <tbody>
                <%= for row <- @top_level do %>
                  <.recovery_row
                    row={row}
                    retention_days={@retention_days}
                    selected={selected?(@selected, row)}
                    selectable={row.type != :org}
                    expandable={row.type == :org and children?(@children_by_org, row.id)}
                    expanded={MapSet.member?(@expanded, row.id)}
                    child_count={child_count(@children_by_org, row.id)}
                  />
                  <%= if row.type == :org and MapSet.member?(@expanded, row.id) do %>
                    <.recovery_row
                      :for={child <- Map.get(@children_by_org, row.id, [])}
                      row={child}
                      retention_days={@retention_days}
                      selected={selected?(@selected, child)}
                      selectable={true}
                      indent={true}
                    />
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
      <% end %>
    </div>
  </div>

  <%!-- Pinned chrome: selection bulk bar. A direct sibling of the scroll region
       (NOT nested in a conditional wrapper that morphdom re-patches) so it stays
       stable while rows toggle — it mounts on 0→1 selected and unmounts on
       1→0, and only its count patches in between. --%>
  <div
    :if={@selected != %{}}
    data-role="selection-bar"
    class="fixed bottom-[calc(env(safe-area-inset-bottom)+1.5rem+var(--bottom-nav-height,0px))] left-1/2 z-40 -translate-x-1/2"
  >
    <div class="flex items-center gap-3 rounded-full border border-edge bg-base-100 px-4 py-2 shadow-md">
      <span class="text-sm font-medium tabular-nums text-base-content">
        {map_size(@selected)} selected
      </span>
      <.button
        variant="primary"
        phx-click="restore_selected"
        data-role="restore-selected"
        class="btn btn-primary btn-sm focus-visible-ring"
      >
        <.icon name="hero-arrow-uturn-left" class="size-4" /> Restore selected
      </.button>
      <button
        type="button"
        phx-click="clear_selection"
        class="focus-visible-ring rounded px-1 text-sm font-medium text-base-content hover:text-base-content"
      >
        Clear
      </button>
    </div>
  </div>

  <%!-- Pinned chrome: act-then-confirm success toast. Server-driven show/hide
       (assign + auto-dismiss timer) — no JS hook and no inline styles, so
       morphdom has nothing to clear on patch. Sibling of the scroll region. --%>
  <div
    :if={@toast}
    data-role="recovery-toast"
    role="status"
    aria-live="polite"
    class="fixed bottom-[calc(env(safe-area-inset-bottom)+1.5rem+var(--bottom-nav-height,0px))] right-4 z-50 max-w-sm"
  >
    <div class="flex items-start gap-3 rounded-lg border border-success/25 bg-base-100 px-4 py-3 shadow-md">
      <.icon name="hero-check-circle-solid" class="size-5 shrink-0 text-success" />
      <div class="min-w-0 flex-1">
        <p class="text-sm text-base-content">{@toast.message}</p>
        <div class="mt-2 flex items-center gap-4">
          <.link
            :if={@toast.view_path}
            navigate={@toast.view_path}
            data-role="toast-view"
            class="focus-visible-ring rounded text-xs font-medium text-primary hover:underline"
          >
            View →
          </.link>
          <button
            type="button"
            phx-click="undo_restore"
            data-role="toast-undo"
            class="focus-visible-ring rounded text-xs font-medium text-base-content/70 hover:text-base-content"
          >
            Undo
          </button>
        </div>
      </div>
      <button
        type="button"
        phx-click="dismiss_toast"
        aria-label="Dismiss"
        class="focus-visible-ring shrink-0 rounded"
      >
        <.icon name="hero-x-mark" class="size-4 opacity-40 hover:opacity-70" />
      </button>
    </div>
  </div>

  <%!-- "Restore all" warning: fires when an org's cascade children are on a
       delete countdown. Default restores them all; the admin can keep specific
       ones scheduled (task 019f7600 stage 5). --%>
  <.restore_all_modal restore={@restore_modal} />
</div>
