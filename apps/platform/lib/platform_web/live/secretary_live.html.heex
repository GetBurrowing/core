<Layouts.app flash={@flash} embedded={true}>
  <div
    class="flex h-full min-h-0 flex-col bg-base-100 text-base-content"
    data-role="secretary-surface"
    data-mode={@mode}
  >
    <%!-- Header: canvas 01a1b744 node proto .top (phone) / .mhead (desktop).
         The interrupt-settings control is stage 5. --%>
    <header
      class="flex h-13 shrink-0 items-center gap-2.5 px-4 lg:border-b lg:border-base-300"
      data-role="secretary-header"
    >
      <.agent_portrait :if={@agent} agent={@agent} size={28} data-role="secretary-agent-avatar" />
      <div class="min-w-0 flex-1">
        <h1 class="truncate text-[17px] font-semibold leading-tight lg:inline lg:text-base">
          {@name}
        </h1>
        <p
          class="truncate text-[13px] text-base-content/70 lg:ml-2 lg:inline"
          data-role="secretary-sub"
        >
          {@agent_name} is reading for you
          <span
            :if={@mode == :ok}
            class="secretary-live ml-1 inline-flex items-center gap-1 text-[11px] text-info"
            title="Live"
            data-role="secretary-live"
          >
            <i class="secretary-live-dot" aria-hidden="true"></i>live
          </span>
          <span :if={@catching_up > 0} class="lg:hidden" data-role="secretary-catching-up">
            · catching up…
          </span>
        </p>
      </div>
      <span
        :if={@catching_up > 0}
        class="hidden whitespace-nowrap text-[13px] text-base-content/70 lg:inline"
        data-role="secretary-catching-up-desktop"
      >
        catching up on {@catching_up} new things…
      </span>
    </header>

    <div class="clears-tab-bar min-h-0 flex-1 overflow-y-auto" data-role="secretary-scroll">
      <div class="mx-auto max-w-3xl pb-6">
        <%!-- Declared extra, carried from /inbox: the notification-permission row. --%>
        <.notification_state_row
          push_permission={@push_permission}
          user_agent={@user_agent}
          auto_denied={@push_auto_denied}
          native_platform={@push_native_platform}
          registration_failed={@push_registration_failed}
        />

        <%= if @live_action == :everything do %>
          <div class="px-4">
            <p
              class="pt-3.5 pb-1 text-[11px] font-semibold uppercase tracking-[.08em] text-base-content/70"
              data-role="secretary-everything-title"
            >
              Everything I looked at, newest first
            </p>
            <p class="mb-2 text-[13px] leading-relaxed text-base-content/70">
              The raw items I read: asks, mentions, meetings and alerts. I sort them above; nothing here is hidden from you.
            </p>
          </div>
          <ul
            id="secretary-everything"
            role="list"
            phx-update="stream"
            data-role="secretary-everything"
          >
            <li
              :for={{dom_id, item} <- @streams.everything}
              id={dom_id}
              class="flex items-start gap-3 px-4 py-2.5 hover:bg-base-200"
            >
              <button
                type="button"
                class="flex min-w-0 flex-1 items-start gap-3 text-left"
                phx-click="open"
                phx-value-ref_type="inbox_item"
                phx-value-ref_id={item.id}
                data-role="secretary-everything-row"
                data-item-id={item.id}
              >
                <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-base-300 text-base-content">
                  <.icon name={item_icon(item)} class="size-5" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="flex items-baseline justify-between gap-2">
                    <span class="truncate text-[15px] font-semibold">{item.title}</span>
                    <time class="shrink-0 text-xs text-base-content/50">
                      {relative_time(item.inserted_at)}
                    </time>
                  </span>
                  <span class="block truncate text-[13px] text-base-content/70">{item.body}</span>
                  <span class="block text-[11px] uppercase tracking-wide text-base-content/50">
                    {kind_word(item)}
                  </span>
                </span>
              </button>
            </li>
          </ul>
          <div class="px-4 pt-3">
            <.link
              navigate={~p"/brief"}
              class="focus-visible-ring font-semibold text-primary"
              data-role="secretary-back"
            >
              Back to {@name}
            </.link>
          </div>
        <% else %>
          <%!-- No-AI fallback (row 10) and budget (row 11): dashed, no brief, no live dot. --%>
          <div
            :if={@mode in [:no_ai, :budget]}
            class="mx-4 mt-1 mb-2 flex items-start gap-2.5 rounded-lg border border-dashed border-base-300 px-3 py-2.5 text-[13px] text-base-content/70"
            data-role="secretary-fallback-note"
            data-fallback={@mode}
          >
            <.icon name="hero-power" class="mt-0.5 size-[18px] shrink-0" />
            <span :if={@mode == :no_ai} class="flex-1">{no_ai_copy(@agent_name)}</span>
            <span :if={@mode == :budget} class="flex-1">{budget_copy()}</span>
            <.link
              :if={@mode == :no_ai}
              navigate={~p"/setup/connect-ai"}
              class="shrink-0 whitespace-nowrap font-semibold text-primary"
              data-role="secretary-connect-ai"
            >
              Connect AI
            </.link>
          </div>

          <%!-- Right now (rows 4-9). --%>
          <section
            :if={@mode == :ok}
            class={[
              "mx-4 mt-0.5 mb-2.5 rounded-box border border-base-300 bg-base-200 px-3.5 pt-3",
              @all_clear? && "pb-3",
              !@all_clear? && "pb-1.5"
            ]}
            data-role="secretary-brief"
            aria-label="Right now"
          >
            <div class="mb-1 flex items-center justify-between gap-2">
              <b class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[.08em]">
                <.icon name="hero-sparkles" class="size-3.5 text-info" />Right now
              </b>
              <span :if={@catching_up > 0} class="text-[13px] text-base-content/70">
                catching up…
              </span>
            </div>
            <p :if={@all_clear?} class="mt-1 text-[16px]" data-role="secretary-all-clear">
              {fyis_below(@fyi_count)}
            </p>
            <ol
              :if={!@all_clear?}
              id="secretary-brief-lines"
              phx-update="stream"
              class="list-none"
            >
              <li
                :for={{dom_id, line} <- @streams.brief}
                id={dom_id}
                class={[
                  "flex flex-col gap-1.5 border-t border-base-300 py-2.5 first:border-t-0 sm:flex-row sm:items-start sm:gap-2.5",
                  line.new? && "secretary-arrived"
                ]}
                data-role="secretary-brief-line"
              >
                <p class="flex-1 text-[16px] leading-[1.42]">
                  <span
                    :if={line.tag_label}
                    class={[
                      "secretary-tag mr-1.5 inline-block rounded-full border px-1.5 align-[2px] text-[10px] font-bold leading-[1.6]",
                      brief_tag_class(line.tag)
                    ]}
                    data-role="secretary-brief-tag"
                  >
                    {line.tag_label}
                  </span>
                  <span
                    :if={line.new?}
                    class="secretary-tag mr-1.5 inline-block rounded-full border border-info px-1.5 align-[2px] text-[10px] font-bold leading-[1.5] text-info"
                    data-role="secretary-just-now"
                  >
                    just now
                  </span>
                  {line.line}
                </p>
                <button
                  type="button"
                  phx-click="open"
                  phx-value-ref_type={line.ref_type}
                  phx-value-ref_id={line.ref_id}
                  phx-value-url={line.url}
                  class={[
                    "focus-visible-ring shrink-0 self-start whitespace-nowrap",
                    line.id == first_brief_id(@view) &&
                      "inline-flex h-8 items-center rounded-full bg-primary px-3 text-[13px] font-semibold text-primary-content",
                    line.id != first_brief_id(@view) && "text-[13px] font-semibold text-primary"
                  ]}
                  data-role="secretary-brief-action"
                >
                  {line.action_label}<span :if={line.id != first_brief_id(@view)}> ›</span>
                </button>
              </li>
            </ol>
            <p
              :if={!@all_clear? and @held_fyis > 0}
              class="mt-1 border-t border-base-300 pt-2 pb-1 text-[13px] text-base-content/70"
              data-role="secretary-brief-footer"
            >
              {holding(@held_fyis)}
            </p>
          </section>

          <%!-- Add your own to-do (row 12): hidden in fallback and all clear. --%>
          <form
            :if={@mode == :ok and not @all_clear?}
            phx-submit="add_todo"
            class="mx-4 mb-1 flex h-11 items-center gap-2 rounded-lg border border-base-300 bg-base-200 px-3 focus-within:border-primary"
            data-role="secretary-add-row"
          >
            <.icon name="hero-plus" class="size-[18px] text-base-content/70" />
            <input
              id="secretary-add-input"
              name="title"
              type="text"
              autocomplete="off"
              placeholder="Add something to do"
              class="min-w-0 flex-1 bg-transparent text-[15px] outline-none placeholder:text-base-content/70"
            />
          </form>

          <%!-- Goal groups (rows 13-23), or the fallback groups by kind. --%>
          <div id="secretary-groups" phx-update="stream" data-role="secretary-groups">
            <section
              :for={{dom_id, group} <- @streams.groups}
              id={dom_id}
              class="mt-2"
              data-role="secretary-group"
              data-group-key={group.key}
              aria-label={group.label}
            >
              <div
                class="sticky top-0 z-[2] bg-base-100 px-4 pt-3 pb-1"
                data-role="secretary-group-header"
              >
                <div class="flex items-baseline gap-2">
                  <b class="text-[15px] font-bold">{group.label}</b>
                  <small :if={group.sub} class="text-[13px] text-base-content/70">
                    {group.sub}
                  </small>
                  <span
                    :if={@mode != :ok}
                    class="text-[13px] font-medium text-base-content/50"
                    data-role="secretary-group-count"
                  >
                    {group.count}
                  </span>
                  <span
                    :if={@mode == :ok and group.new_count > 0}
                    class="secretary-tag ml-auto rounded-full border border-info px-1.5 text-[10px] font-bold leading-[1.5] text-info"
                    data-role="secretary-group-new"
                  >
                    {group.new_count} new
                  </span>
                </div>
                <p
                  :if={group.status}
                  class={[
                    "mt-0.5 flex items-center gap-1.5 text-[13px]",
                    group.at_risk? && "text-warning",
                    !group.at_risk? && "text-base-content/70"
                  ]}
                >
                  <.icon :if={group.at_risk?} name="hero-exclamation-triangle" class="size-3.5" />
                  {group.status}
                </p>
              </div>

              <%= for row <- group.rows do %>
                <%!-- Not a to-do result (row 23) --%>
                <%= cond do %>
                  <% row.leaving? -> %>
                    <div
                      class="secretary-leaving mx-4 my-1 flex items-center gap-2.5 rounded-md border border-dashed border-base-300 px-3 py-2.5 text-[13px] text-base-content/50"
                      data-role="secretary-leaving"
                      id={row.id}
                    >
                      <.icon name="hero-check" class="size-4" />
                      <span><s>{row.title}</s> <br />{row.reason}</span>
                    </div>
                  <% row.kind == :suggested and row.todo.status == "dismissed" -> %>
                    <div
                      class="mx-4 my-1 flex items-center gap-2.5 rounded-md bg-success/8 px-3 py-2.5 text-[13px] text-base-content/70"
                      data-role="secretary-learned"
                      id={row.id}
                    >
                      <.icon name="hero-check" class="size-4 text-success" />
                      <span class="flex-1">
                        <s>{row.title}</s>
                        <br />
                        <b class="text-base-content">
                          Got it, I won’t add things like this.
                        </b>
                      </span>
                      <button
                        type="button"
                        phx-click="todo_not_undo"
                        phx-value-id={row.ref_id}
                        class="font-semibold text-primary"
                      >
                        Undo
                      </button>
                    </div>
                  <% row.kind == :suggested -> %>
                    <div
                      class="secretary-sugg mx-4 my-1 rounded-lg border border-base-300 border-l-[3px] bg-base-200 px-3 pt-3 pb-2.5"
                      data-role="secretary-suggested"
                      data-agent-slot={@agent && @agent.color}
                      id={row.id}
                    >
                      <div class="flex items-center gap-2 text-[13px] text-base-content/70">
                        <.agent_portrait :if={@agent} agent={@agent} size={22} />
                        <span>I’m hearing a to-do in {row.space_label || "a space"}</span>
                      </div>
                      <%= if @editing_todo == row.ref_id do %>
                        <form phx-submit="todo_save" phx-value-id={row.ref_id} class="mt-1.5">
                          <input
                            id={"secretary-edit-#{row.ref_id}"}
                            name="title"
                            type="text"
                            value={row.title}
                            class="w-full rounded border border-primary bg-base-100 px-2 py-1 text-[15px] font-semibold outline-none"
                            data-role="secretary-suggested-edit"
                          />
                          <div class="mt-2 flex flex-wrap gap-1.5">
                            <button
                              type="submit"
                              class="inline-flex h-8 items-center rounded-full border border-base-300 bg-base-200 px-3 text-[13px] hover:bg-base-300"
                            >
                              Save and keep
                            </button>
                            <button
                              type="button"
                              phx-click="todo_cancel_edit"
                              class="inline-flex h-8 items-center rounded-full border border-base-300 px-3 text-[13px] hover:bg-base-300"
                            >
                              Cancel
                            </button>
                          </div>
                        </form>
                      <% else %>
                        <div
                          class="mt-1.5 mb-1 text-[15px] font-semibold"
                          data-role="secretary-suggested-title"
                        >
                          {row.title}
                        </div>
                        <p
                          :if={row.quote}
                          class="mb-2.5 text-[13px] text-base-content/70"
                          data-role="secretary-suggested-quote"
                        >
                          <b :if={row.author_label} class="text-base-content">
                            {row.author_label}:
                          </b>
                          “{row.quote}”
                        </p>
                        <p :if={row.reason} class="mb-2.5 text-[13px] text-base-content/70">
                          {row.reason}
                        </p>
                        <div class="flex flex-wrap gap-1.5">
                          <button
                            type="button"
                            phx-click="todo_keep"
                            phx-value-id={row.ref_id}
                            class="inline-flex h-8 items-center gap-1.5 rounded-full border border-base-300 bg-base-200 px-3 text-[13px] hover:bg-base-300"
                            data-role="secretary-suggested-keep"
                          >
                            <.icon name="hero-check" class="size-3.5" />Keep
                          </button>
                          <button
                            type="button"
                            phx-click="todo_edit"
                            phx-value-id={row.ref_id}
                            class="inline-flex h-8 items-center gap-1.5 rounded-full border border-base-300 bg-base-200 px-3 text-[13px] hover:bg-base-300"
                          >
                            <.icon name="hero-pencil" class="size-3.5" />Edit
                          </button>
                          <button
                            type="button"
                            phx-click="todo_not"
                            phx-value-id={row.ref_id}
                            class="inline-flex h-8 items-center rounded-full border border-base-300 px-3 text-[13px] hover:bg-base-300"
                            data-role="secretary-suggested-not"
                          >
                            Not a to-do
                          </button>
                        </div>
                      <% end %>
                    </div>
                  <% row.kind == :todo -> %>
                    <div
                      class={[
                        "relative flex w-full items-start gap-3 px-4 py-2.5 hover:bg-base-200",
                        row.new? && "secretary-arrived"
                      ]}
                      data-role="secretary-todo"
                      data-done={to_string(row.todo.status == "done")}
                      id={row.id}
                    >
                      <button
                        type="button"
                        phx-click="todo_toggle"
                        phx-value-id={row.ref_id}
                        aria-label="Mark done"
                        aria-pressed={to_string(row.todo.status == "done")}
                        class={[
                          "mt-0.5 inline-flex size-[22px] shrink-0 items-center justify-center rounded-full border-[1.6px]",
                          row.todo.status == "done" &&
                            "border-success bg-success text-success-content",
                          row.todo.status != "done" &&
                            "border-base-content/50 hover:border-base-content"
                        ]}
                        data-role="secretary-todo-check"
                      >
                        <.icon
                          name="hero-check"
                          class={["size-3.5", row.todo.status != "done" && "opacity-0"]}
                        />
                      </button>
                      <div class="min-w-0 flex-1">
                        <div class={[
                          "text-[15px] font-medium leading-[1.35]",
                          row.todo.status == "done" && "text-base-content/70 line-through"
                        ]}>
                          {row.title}
                        </div>
                        <div class="mt-0.5 flex items-center gap-1.5 text-[13px] text-base-content/70">
                          <span
                            :if={row.todo.origin != "self"}
                            class={[
                              "secretary-tag inline-block rounded-full border px-1.5 text-[10px] font-bold leading-[1.6]",
                              tag_class("todo")
                            ]}
                            data-role="secretary-row-tag"
                          >
                            To-do
                          </span>
                          <span class="truncate" data-role="secretary-todo-source">
                            {todo_source(row, @agent_name)}
                          </span>
                        </div>
                        <div
                          :if={row.todo.status == "done"}
                          class="mt-1.5 flex items-center gap-2 rounded bg-success/12 px-2.5 py-1.5 text-[13px]"
                          data-role="secretary-todo-done"
                        >
                          <.icon name="hero-check" class="size-3.5 text-success" />
                          <span class="min-w-0 flex-1">{done_note(row.todo)}</span>
                          <button
                            type="button"
                            phx-click="todo_undo"
                            phx-value-id={row.ref_id}
                            class="shrink-0 font-semibold text-primary"
                          >
                            Undo
                          </button>
                        </div>
                      </div>
                      <span
                        :if={row.due_label && row.todo.status != "done"}
                        class={[
                          "shrink-0 pt-0.5 text-[13px]",
                          row.due_soon? && "font-semibold text-warning",
                          !row.due_soon? && "text-base-content/70"
                        ]}
                        data-role="secretary-todo-due"
                      >
                        {row.due_label}
                      </span>
                      <button
                        type="button"
                        phx-click="menu"
                        phx-value-id={row.id}
                        aria-label="More for this item"
                        class="hidden size-7 shrink-0 items-center justify-center rounded text-base-content/70 hover:bg-base-300 xl:inline-flex"
                      >
                        <.icon name="hero-ellipsis-horizontal" class="size-4" />
                      </button>
                    </div>
                  <% true -> %>
                    <div
                      class={[
                        "relative flex w-full items-start gap-3 py-2.5 pr-3 pl-4 hover:bg-base-200",
                        row.new? && "secretary-arrived"
                      ]}
                      data-role="secretary-row"
                      data-tag={row.tag}
                      data-ref-type={row.ref_type}
                      data-ref-id={row.ref_id}
                      id={row.id}
                    >
                      <%= if row.agent_author? and @agent do %>
                        <.agent_portrait agent={@agent} size={28} />
                      <% else %>
                        <span class={[
                          "mt-px flex size-7 shrink-0 items-center justify-center rounded-full",
                          row.kind == :not_in_space &&
                            "border border-dashed border-info/60 text-info",
                          row.kind != :not_in_space && "bg-base-300 text-base-content"
                        ]}>
                          <.icon name={row_icon(row)} class="size-4" />
                        </span>
                      <% end %>
                      <div class="min-w-0 flex-1">
                        <div
                          class="text-[15px] font-semibold leading-[1.35]"
                          data-role="secretary-row-title"
                        >
                          {row.title}
                          <span
                            :if={row.new?}
                            class="secretary-tag ml-1.5 inline-block rounded-full border border-info px-1.5 align-[2px] text-[10px] font-bold leading-[1.5] text-info"
                            data-role="secretary-new"
                          >
                            new
                          </span>
                        </div>
                        <button
                          type="button"
                          phx-click="why"
                          phx-value-id={row.id}
                          aria-expanded="false"
                          class="mt-0.5 flex max-w-full items-center gap-1.5 text-left text-[13px] text-base-content/70"
                          data-role="secretary-reason"
                        >
                          <span
                            :if={row.tag_label}
                            class={[
                              "secretary-tag inline-flex shrink-0 items-center gap-1 rounded-full border px-1.5 text-[10px] font-bold leading-[1.6]",
                              tag_class(row.tag)
                            ]}
                            data-role="secretary-row-tag"
                          >
                            <.icon :if={row.kind == :not_in_space} name="hero-eye" class="size-3" />
                            {row.tag_label}
                          </span>
                          <span class="truncate">{row.reason || row.source}</span>
                        </button>
                        <div
                          :if={row.moved?}
                          class="mt-0.5 flex items-center gap-1 text-[12px] text-info"
                          data-role="secretary-moved"
                        >
                          <.icon name="hero-sparkles" class="size-3" />I moved this up · was {row.previous_tag_label}
                        </div>
                        <div
                          :if={row.kind == :not_in_space and row.space_id}
                          class="mt-1.5 flex gap-1.5"
                        >
                          <button
                            type="button"
                            phx-click="join"
                            phx-value-space_id={row.space_id}
                            class="inline-flex h-8 items-center rounded-full border border-base-300 bg-base-200 px-3 text-[13px] hover:bg-base-300"
                            data-role="secretary-join"
                          >
                            Join {row.space_label}
                          </button>
                        </div>
                      </div>
                      <button
                        :if={row.tag in ["decide", "waiting"]}
                        type="button"
                        phx-click="open"
                        phx-value-ref_type={row.ref_type}
                        phx-value-ref_id={row.ref_id}
                        phx-value-url={row.url}
                        class="inline-flex h-8 shrink-0 items-center rounded-full border border-base-300 bg-base-200 px-3 text-[13px] hover:bg-base-300"
                        data-role="secretary-row-action"
                      >
                        Open
                      </button>
                      <button
                        type="button"
                        phx-click="menu"
                        phx-value-id={row.id}
                        aria-label="More for this item"
                        class="hidden size-7 shrink-0 items-center justify-center rounded text-base-content/70 hover:bg-base-300 xl:inline-flex"
                      >
                        <.icon name="hero-ellipsis-horizontal" class="size-4" />
                      </button>
                    </div>
                <% end %>
              <% end %>
            </section>
          </div>

          <%!-- Quietly handled (row 24): collapsed by default. --%>
          <section
            :if={@mode == :ok}
            class="mx-4 mt-3 rounded-lg border border-base-300 bg-base-200"
            data-role="secretary-quiet"
          >
            <button
              type="button"
              phx-click="toggle_quiet"
              aria-expanded={to_string(@quiet_open?)}
              class="flex w-full items-center gap-2 px-3 py-2.5 text-left text-[13px]"
              data-role="secretary-quiet-toggle"
            >
              <.icon
                name={if @quiet_open?, do: "hero-chevron-down", else: "hero-chevron-right"}
                class="size-4 text-base-content/70"
              />
              <b class="text-base-content">Quietly handled · {@quiet_count}</b>
              <span :if={@quiet_summary} class="truncate text-base-content/70">
                {@quiet_summary}
              </span>
            </button>
            <div
              id="secretary-quiet-rows"
              phx-update="stream"
              class={["px-3 pb-2", !@quiet_open? && "hidden"]}
              data-role="secretary-quiet-rows"
            >
              <div
                :for={{dom_id, row} <- @streams.quiet}
                id={dom_id}
                class="flex flex-col py-1.5 text-[13px] sm:flex-row sm:gap-3"
              >
                <span class="font-medium">{row.title}</span>
                <span class="text-base-content/70">{row.reason || row.source}</span>
              </div>
            </div>
          </section>

          <div class="px-4 pt-3">
            <.link
              navigate={~p"/brief/everything"}
              class="focus-visible-ring font-semibold text-primary"
              data-role="secretary-everything-link"
            >
              See everything I looked at
            </.link>
          </div>
        <% end %>
      </div>
    </div>

    <div
      :if={@toast}
      role="status"
      class="pointer-events-none fixed inset-x-0 bottom-20 z-40 flex justify-center px-4 lg:bottom-6"
      data-role="secretary-toast"
    >
      <span class="rounded-full bg-base-content px-4 py-2 text-[13px] text-base-100 shadow-lg">
        {@toast}
      </span>
    </div>
  </div>
</Layouts.app>
