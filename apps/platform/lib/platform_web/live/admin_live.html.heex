<%!-- Burrow redesign 24 stage 4: the masters' Settings › Admin panel anatomy
     (master-desktop.html, sec==='admin'): an h3 title, a text-subtle
     description, and an always-visible ghost "Open". Tokens only; hover only
     through lg:hover:. Every entry, href and :if gate is unchanged. Held by
     test/platform/design/admin_reskin_source_guard_test.exs. --%>
<div class="flex h-full min-h-0 flex-col">
  <div class="flex-1 min-h-0 overflow-y-auto p-4 lg:p-5 clears-tab-bar">
    <div class="mx-auto max-w-3xl">
      <h1 class="mb-3 text-xl font-bold text-base-content" data-role="admin-heading">Admin</h1>

      <div class="flex flex-col gap-2" data-role="admin-card-list">
        <.link
          :if={Platform.Access.module_access?(@access_scope, :admin)}
          navigate="/access"
          class="block rounded-box border border-edge bg-base-200 p-4 transition-colors lg:hover:bg-base-300 focus-visible-ring"
          data-role="admin-access-link"
          data-admin-card="access"
        >
          <h3 class="text-base font-semibold text-base-content">Access</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Inspect effective access and undo access changes.
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <span
              class="inline-flex h-[30px] items-center rounded-full border border-edge bg-base-200 px-3 text-sm text-base-content"
              data-role="admin-card-open"
            >
              Open
            </span>
          </div>
        </.link>

        <.link
          navigate="/control"
          class="block rounded-box border border-edge bg-base-200 p-4 transition-colors lg:hover:bg-base-300 focus-visible-ring"
          data-admin-card="agents"
        >
          <h3 class="text-base font-semibold text-base-content">Agents</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Connect, manage, and federate agents across Burrow runtimes.
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <span
              class="inline-flex h-[30px] items-center rounded-full border border-edge bg-base-200 px-3 text-sm text-base-content"
              data-role="admin-card-open"
            >
              Open
            </span>
          </div>
        </.link>

        <.link
          navigate="/admin/federation"
          class="block rounded-box border border-edge bg-base-200 p-4 transition-colors lg:hover:bg-base-300 focus-visible-ring"
          data-admin-card="federation"
        >
          <h3 class="text-base font-semibold text-base-content">Agent Federation</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Federation health dashboard — runtime connections, dead-letter buffer, manual ping.
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <span
              class="inline-flex h-[30px] items-center rounded-full border border-edge bg-base-200 px-3 text-sm text-base-content"
              data-role="admin-card-open"
            >
              Open
            </span>
          </div>
        </.link>

        <.link
          navigate="/control/usage"
          class="block rounded-box border border-edge bg-base-200 p-4 transition-colors lg:hover:bg-base-300 focus-visible-ring"
          data-admin-card="usage"
        >
          <h3 class="text-base font-semibold text-base-content">Usage / Cost Metering</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Per-task and per-agent usage events, latency, and cost rollups.
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <span
              class="inline-flex h-[30px] items-center rounded-full border border-edge bg-base-200 px-3 text-sm text-base-content"
              data-role="admin-card-open"
            >
              Open
            </span>
          </div>
        </.link>

        <.link
          navigate="/admin/users"
          class="block rounded-box border border-edge bg-base-200 p-4 transition-colors lg:hover:bg-base-300 focus-visible-ring"
          data-admin-card="users"
        >
          <h3 class="text-base font-semibold text-base-content">User Access</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Manage Burrow users — archive and unarchive root-org membership.
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <span
              class="inline-flex h-[30px] items-center rounded-full border border-edge bg-base-200 px-3 text-sm text-base-content"
              data-role="admin-card-open"
            >
              Open
            </span>
          </div>
        </.link>

        <.link
          :if={@sign_in_admin?}
          navigate="/admin/sign-in-users"
          class="block rounded-box border border-edge bg-base-200 p-4 transition-colors lg:hover:bg-base-300 focus-visible-ring"
          data-role="admin-sign-in-users-link"
          data-admin-card="sign-in-users"
        >
          <h3 class="text-base font-semibold text-base-content">Users</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Invite people, send sign-in links, and disable or remove sign-in.
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <span
              class="inline-flex h-[30px] items-center rounded-full border border-edge bg-base-200 px-3 text-sm text-base-content"
              data-role="admin-card-open"
            >
              Open
            </span>
          </div>
        </.link>

        <.link
          navigate="/admin/orgs"
          class="block rounded-box border border-edge bg-base-200 p-4 transition-colors lg:hover:bg-base-300 focus-visible-ring"
          data-role="admin-orgs-link"
          data-admin-card="orgs"
        >
          <h3 class="text-base font-semibold text-base-content">Orgs</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Onboard a tenant org without a migration. Scope colour and scope-rail visibility still need a follow-up code change.
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <span
              class="inline-flex h-[30px] items-center rounded-full border border-edge bg-base-200 px-3 text-sm text-base-content"
              data-role="admin-card-open"
            >
              Open
            </span>
          </div>
        </.link>

        <.link
          navigate="/admin/vault"
          class="block rounded-box border border-edge bg-base-200 p-4 transition-colors lg:hover:bg-base-300 focus-visible-ring"
          data-role="admin-vault-link"
          data-admin-card="vault"
        >
          <h3 class="text-base font-semibold text-base-content">Vault</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Paste a secret once and grant it to agents. They fetch it with vault_fetch; it never enters chat.
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <span
              class="inline-flex h-[30px] items-center rounded-full border border-edge bg-base-200 px-3 text-sm text-base-content"
              data-role="admin-card-open"
            >
              Open
            </span>
          </div>
        </.link>

        <.link
          navigate="/admin/branding"
          class="block rounded-box border border-edge bg-base-200 p-4 transition-colors lg:hover:bg-base-300 focus-visible-ring"
          data-role="admin-branding-link"
          data-admin-card="branding"
        >
          <h3 class="text-base font-semibold text-base-content">Branding</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            This install's app name, manifest colours, and home-screen icons — derived from one square upload.
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <span
              class="inline-flex h-[30px] items-center rounded-full border border-edge bg-base-200 px-3 text-sm text-base-content"
              data-role="admin-card-open"
            >
              Open
            </span>
          </div>
        </.link>

        <.link
          navigate="/admin/themes"
          class="block rounded-box border border-edge bg-base-200 p-4 transition-colors lg:hover:bg-base-300 focus-visible-ring max-lg:hidden"
          data-role="admin-themes-link"
          data-admin-card="themes"
        >
          <h3 class="text-base font-semibold text-base-content">Themes</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Edit colour tokens, shape, density, font and glass, then make a theme available in Appearance.
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <span
              class="inline-flex h-[30px] items-center rounded-full border border-edge bg-base-200 px-3 text-sm text-base-content"
              data-role="admin-card-open"
            >
              Open
            </span>
          </div>
        </.link>

        <.link
          navigate="/admin/prototypes"
          class="block rounded-box border border-edge bg-base-200 p-4 transition-colors lg:hover:bg-base-300 focus-visible-ring"
          data-role="admin-prototypes-link"
          data-admin-card="prototypes"
        >
          <h3 class="text-base font-semibold text-base-content">Prototypes</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Turn prototype publishing on or off, choose who may publish, and set size, file and retention limits.
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <span
              class="inline-flex h-[30px] items-center rounded-full border border-edge bg-base-200 px-3 text-sm text-base-content"
              data-role="admin-card-open"
            >
              Open
            </span>
          </div>
        </.link>

        <.link
          navigate="/admin/insights"
          class="block rounded-box border border-edge bg-base-200 p-4 transition-colors lg:hover:bg-base-300 focus-visible-ring"
          data-role="admin-insights-link"
          data-admin-card="insights"
        >
          <h3 class="text-base font-semibold text-base-content">Insights</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Choose whether dreaming insights are sent beyond the Org memory Insights tab, and which kinds.
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <span
              class="inline-flex h-[30px] items-center rounded-full border border-edge bg-base-200 px-3 text-sm text-base-content"
              data-role="admin-card-open"
            >
              Open
            </span>
          </div>
        </.link>

        <.link
          navigate="/admin/external-logins"
          class="block rounded-box border border-edge bg-base-200 p-4 transition-colors lg:hover:bg-base-300 focus-visible-ring"
          data-role="admin-external-logins-link"
          data-admin-card="external-logins"
        >
          <h3 class="text-base font-semibold text-base-content">External Logins</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Recover external users awaiting setup — one-click grant of org, channels, and DM allowlist.
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <span
              class="inline-flex h-[30px] items-center rounded-full border border-edge bg-base-200 px-3 text-sm text-base-content"
              data-role="admin-card-open"
            >
              Open
            </span>
          </div>
        </.link>

        <.link
          navigate="/admin/recovery"
          class="block rounded-box border border-edge bg-base-200 p-4 transition-colors lg:hover:bg-base-300 focus-visible-ring"
          data-admin-card="recovery"
        >
          <h3 class="text-base font-semibold text-base-content">Recovery</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Restore archived orgs and projects, or cancel a scheduled deletion before the retention window closes.
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <span
              class="inline-flex h-[30px] items-center rounded-full border border-edge bg-base-200 px-3 text-sm text-base-content"
              data-role="admin-card-open"
            >
              Open
            </span>
          </div>
        </.link>
      </div>
    </div>
  </div>
</div>
