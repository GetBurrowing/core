<div class="flex h-full min-h-0 flex-col">
  <.breadcrumb segments={[
    %{label: "Admin", navigate: ~p"/admin"},
    %{label: "Federation", navigate: nil}
  ]} />
  <%!-- Header --%>
  <div class="flex items-center justify-between border-b border-edge px-4 py-3">
    <div class="flex items-center gap-3">
      <h1 class="text-sm font-semibold uppercase tracking-widest text-base-content">
        Admin · Federation Health
      </h1>
      <span class="badge badge-ghost badge-sm">{length(@runtimes)} runtimes</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-xs text-subtle">Auto-refreshes every 5s</span>
      <button phx-click="refresh" class="btn btn-ghost btn-xs">
        <span class="hero-arrow-path size-4"></span> Refresh
      </button>
    </div>
  </div>

  <%!-- Tabs: Federation / Dead Letters --%>
  <div class="flex-1 min-h-0 overflow-y-auto p-4 space-y-6">
    <%!-- Runtime status table --%>
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-base-content mb-3">
        Runtime Connections
      </h2>

      <%= if Enum.empty?(@runtimes) do %>
        <div class="rounded-lg border border-edge p-8 text-center text-subtle text-sm">
          No active runtimes registered.
        </div>
      <% else %>
        <%!--
          Connection, build and proof are THREE cells that are allowed to
          disagree (task 01a06d01 stage 4, per the attached design canvas).
          `Connected` and `Build` are adjacent so a row can visibly say
          "connected 20s ago, running for six days"; `Last proven` reports
          events core observed, never settings.

          `overflow-x-auto` rather than `overflow-hidden` so the widened row
          scrolls at 375px instead of clipping the proof column off. `Runtime
          ID` moved from second place to just before `Actions` for the same
          reason and nothing else: it is the widest column on the row, and in
          second place it pushed all three of the canvas's facts past the
          right edge of a 375px viewport. Nothing is hidden — the whole row is
          still reachable by scrolling — but the columns that lead are now the
          ones the canvas says have to be read together.
        --%>
        <div class="rounded-lg border border-edge overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-base-200 text-xs uppercase tracking-wider text-base-content">
              <tr>
                <th class="px-4 py-2 text-left">Agent</th>
                <th class="px-4 py-2 text-left">Status</th>
                <th class="px-4 py-2 text-left">Connected</th>
                <th class="px-4 py-2 text-left">Build</th>
                <%!--
                  `Last proven`, never `Capabilities`: this cell is a log, not
                  a verdict.
                --%>
                <th class="px-4 py-2 text-left">Last proven</th>
                <th class="px-4 py-2 text-left">Last Seen</th>
                <th class="px-4 py-2 text-left">Last Connected (DB)</th>
                <th class="px-4 py-2 text-left">Runtime ID</th>
                <th class="px-4 py-2 text-left">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-base-200">
              <%= for runtime <- @runtimes do %>
                <tr id={"runtime-row-#{runtime.runtime_id}"} class="hover:bg-base-100">
                  <%!--
                    Public Sans 600 / 13px, and it never truncates: this is
                    the one string that says which process you are about to
                    restart.
                  --%>
                  <td class="px-4 py-3 align-top text-[13px] font-semibold whitespace-nowrap">
                    {runtime.agent_name || runtime.agent_slug || "(unlinked)"}
                  </td>
                  <%!--
                    `--color-success` marks that the socket is live and ONLY
                    that. It must never grow to mean "healthy" or "capable" —
                    that conflation is the whole ticket.
                  --%>
                  <td class="px-4 py-3 align-top">
                    <%= if runtime.online do %>
                      <span class="inline-flex items-center gap-1.5 text-success">
                        <span class="size-2 rounded-full bg-success inline-block"></span> Online
                      </span>
                    <% else %>
                      <span class="inline-flex items-center gap-1.5 text-error">
                        <span class="size-2 rounded-full bg-error inline-block"></span> Offline
                      </span>
                    <% end %>
                  </td>
                  <%!--
                    Connection age. The VALUE here is deliberately untouched —
                    task 01a06d03 (`e752bdce`) repairs what feeds it and asked
                    that this expression be left alone.
                  --%>
                  <td class="px-4 py-3 align-top text-xs text-subtle">
                    {format_dt(runtime.connected_at)}
                  </td>
                  <%!--
                    Build age, adjacent to connection age on purpose. Amber
                    fires ONLY on a capability this runtime is expected to
                    serve whose code cannot be in the running process — never
                    for merely being behind main. `--color-error` is
                    deliberately unused: a stale agent is answering, just with
                    old code, and red would push an operator toward a bounce
                    more expensive than the condition.
                  --%>
                  <td class="px-4 py-3 align-top">
                    <div class="flex items-baseline gap-1.5">
                      <span
                        data-build={build_sha(runtime)}
                        class="font-mono text-[11px] max-w-[10ch] truncate"
                      >
                        {build_sha(runtime)}
                      </span>
                      <span class="text-neutral text-[11px]">·</span>
                      <span data-build-age class="text-neutral text-[12px] whitespace-nowrap">
                        {build_age(runtime)}
                      </span>
                    </div>
                    <%= for stale <- predated_capabilities(runtime) do %>
                      <div
                        data-build-warning={stale.capability}
                        class="mt-1 flex items-start gap-1 text-warning text-[12px]"
                      >
                        <span class="hero-exclamation-triangle size-3.5 shrink-0"></span>
                        <span>predates {stale.capability} ({stale.landed_label})</span>
                      </div>
                    <% end %>
                  </td>
                  <%!--
                    The proof cell. It never truncates, and it never carries a
                    tooltip — a hover is unreachable in a terminal, on a phone
                    and in the screenshot someone pastes into the channel at
                    midnight, which is where this gets read.

                    The `border-edge` hairline below is the most
                    load-bearing pixel on the page: everything above it
                    HAPPENED, everything below it was ASSERTED by the process
                    whose competence is in question.

                    Emphasis inside the cell follows the canvas's budget:
                    "an event actually observed is the only cell on this row
                    that cannot lie, everything else stays quiet so this one
                    reads first". So the LABEL takes `--color-neutral` (the
                    canvas assigns that token to quiet supporting text) and
                    the VALUE keeps full `base-content` weight — `never` is
                    the word the whole ticket is about, and it has to survive
                    being read at midnight off a pasted screenshot.
                  --%>
                  <td class="px-4 py-3 align-top whitespace-nowrap">
                    <div data-proof-list class="w-fit min-w-[15ch] space-y-0.5">
                      <%= for proof <- proof_rows(runtime) do %>
                        <div
                          data-proof={proof.capability}
                          class="flex items-baseline justify-between gap-4"
                        >
                          <%!--
                            `w-fit` on the list, not the cell: the pair stays
                            as tight as its own widest row so the label and
                            its time are read together. Without it the cell is
                            sized by the declared chip below and
                            `justify-between` flings the time to the far edge,
                            which at 375px puts `never` past the fold — the
                            one word this column exists to deliver.
                          --%>
                          <span data-proof-label class="text-neutral text-[12px]">
                            {proof.label}
                          </span>
                          <span data-proof-value class="text-[12px]">
                            {proof.value}
                          </span>
                        </div>
                      <% end %>
                    </div>
                    <div data-proof-rule class="mt-2 border-t border-edge pt-2">
                      <%= if Enum.empty?(declared_chips(runtime)) do %>
                        <span data-declared class="text-info text-[12px]">declared: none</span>
                      <% else %>
                        <div
                          data-declared
                          class="flex flex-wrap items-baseline gap-1 text-info text-[12px]"
                        >
                          <span>declared:</span>
                          <%= for feature <- declared_chips(runtime) do %>
                            <span
                              data-declared-chip
                              class="rounded border border-info/40 px-1 max-w-[24ch] truncate"
                            >
                              {feature}
                            </span>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </td>
                  <td class="px-4 py-3 align-top text-xs text-subtle">
                    {format_dt(runtime.last_seen_at)}
                  </td>
                  <td class="px-4 py-3 align-top text-xs text-subtle">
                    {format_dt(runtime.last_connected_at)}
                  </td>
                  <td class="px-4 py-3 align-top font-mono text-xs text-subtle">
                    {runtime.runtime_id}
                  </td>
                  <td class="px-4 py-3 align-top">
                    <%= if runtime.online do %>
                      <button
                        phx-click="ping"
                        phx-value-runtime-id={runtime.runtime_id}
                        class="btn btn-xs btn-outline"
                        title="Send ping to runtime"
                      >
                        Ping
                      </button>
                      <%= case Map.get(@ping_results, runtime.runtime_id) do %>
                        <% :sent -> %>
                          <span class="text-xs text-info ml-1">Sent ✓</span>
                        <% {:error, _} -> %>
                          <span class="text-xs text-error ml-1">Failed</span>
                        <% _ -> %>
                          <span></span>
                      <% end %>
                    <% else %>
                      <span class="text-xs text-subtle">—</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>

    <%!-- Dead Letters --%>
    <div>
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-base-content">
          Dead Letters
          <span class="badge badge-ghost badge-xs ml-1">
            {length(@dead_letters)} in ledger
          </span>
        </h2>
        <%= if not Enum.empty?(@dead_letters) do %>
          <button
            id="prune-dead-letters"
            phx-click="prune_dead_letters"
            class="btn btn-xs btn-ghost text-error"
            title="Deletes settled rows only. Pending and replaying rows are the replay queue and cannot be pruned from here."
          >
            Prune settled
          </button>
        <% end %>
      </div>

      <%!-- Cumulative loss counters. Monotonic, never pruned — see the caption. --%>
      <div id="dead-letter-cumulative" class="rounded-lg border border-edge p-3 mb-3">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content">
            Cumulative loss
          </h3>
          <div class="flex items-center gap-2">
            <span class="text-xs text-subtle">
              replay rate {:erlang.float_to_binary(@loss_summary.replay_rate * 100, decimals: 1)}%
            </span>
            <span class={[
              "badge badge-xs",
              if(@loss_summary.balanced, do: "badge-success", else: "badge-error")
            ]}>
              {if @loss_summary.balanced, do: "books balance", else: "books do not balance"}
            </span>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2">
          <div class="rounded-md bg-base-200 px-3 py-2">
            <div class="text-[0.65rem] uppercase tracking-wider text-subtle">
              Recorded
            </div>
            <div
              id="dead-letter-count-recorded"
              class="text-lg font-semibold tabular-nums"
            >
              {@loss_summary.recorded}
            </div>
          </div>
          <div class="rounded-md bg-base-200 px-3 py-2">
            <div class="text-[0.65rem] uppercase tracking-wider text-subtle">
              Replayed
            </div>
            <div
              id="dead-letter-count-replayed"
              class="text-lg font-semibold tabular-nums text-success"
            >
              {@loss_summary.replayed}
            </div>
          </div>
          <div class="rounded-md bg-base-200 px-3 py-2">
            <div class="text-[0.65rem] uppercase tracking-wider text-subtle">
              Dropped · policy
            </div>
            <div
              id="dead-letter-count-dropped-policy"
              class="text-lg font-semibold tabular-nums"
            >
              {@loss_summary.dropped_policy}
            </div>
          </div>
          <div class="rounded-md bg-base-200 px-3 py-2">
            <div class="text-[0.65rem] uppercase tracking-wider text-subtle">
              Dropped · stale
            </div>
            <div
              id="dead-letter-count-dropped-stale"
              class="text-lg font-semibold tabular-nums"
            >
              {@loss_summary.dropped_stale}
            </div>
          </div>
          <div class="rounded-md bg-base-200 px-3 py-2">
            <div class="text-[0.65rem] uppercase tracking-wider text-subtle">
              Superseded
            </div>
            <div
              id="dead-letter-count-superseded-duplicate"
              class="text-lg font-semibold tabular-nums"
            >
              {@loss_summary.superseded_duplicate}
            </div>
          </div>
          <div class="rounded-md bg-base-200 px-3 py-2">
            <div class="text-[0.65rem] uppercase tracking-wider text-subtle">
              Abandoned
            </div>
            <div
              id="dead-letter-count-abandoned"
              class="text-lg font-semibold tabular-nums text-error"
            >
              {@loss_summary.abandoned}
            </div>
          </div>
          <div class="rounded-md bg-base-200 px-3 py-2">
            <div class="text-[0.65rem] uppercase tracking-wider text-subtle">
              Awaiting replay
            </div>
            <div
              id="dead-letter-count-pending"
              class="text-lg font-semibold tabular-nums text-warning"
            >
              {@loss_summary.pending}
            </div>
          </div>
        </div>

        <p id="dead-letter-cumulative-caption" class="mt-2 text-xs text-subtle">
          Totals since inception — every fire ever dead-lettered, not a snapshot of the
          rows below and not a 24h window. Pruning the ledger does not move these numbers.
          Subtract two readings to get a window. "Awaiting replay" is the only live term:
          it is counted off the ledger, which never prunes a queued row.
        </p>

        <%= if not Enum.empty?(@key_breakdown) do %>
          <div id="dead-letter-key-breakdown" class="mt-3 overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="text-[0.65rem] uppercase tracking-wider text-base-content">
                <tr>
                  <th class="px-2 py-1 text-left">Responsibility key</th>
                  <th class="px-2 py-1 text-right">Recorded</th>
                  <th class="px-2 py-1 text-right">Replayed</th>
                  <th class="px-2 py-1 text-right">Dropped</th>
                  <th class="px-2 py-1 text-right">Abandoned</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-base-200">
                <%= for entry <- @key_breakdown do %>
                  <tr id={entry.dom_id}>
                    <td class="px-2 py-1 font-mono text-xs">{entry.label}</td>
                    <td data-count="recorded" class="px-2 py-1 text-right tabular-nums">
                      {entry.recorded}
                    </td>
                    <td data-count="replayed" class="px-2 py-1 text-right tabular-nums">
                      {entry.replayed}
                    </td>
                    <td data-count="dropped" class="px-2 py-1 text-right tabular-nums">
                      {entry.dropped}
                    </td>
                    <td data-count="abandoned" class="px-2 py-1 text-right tabular-nums">
                      {entry.abandoned}
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>

      <%= if Enum.empty?(@dead_letters) do %>
        <div class="rounded-lg border border-edge p-6 text-center text-subtle text-sm">
          The ledger is empty. That means nothing is queued and nothing settled recently —
          it does not mean nothing was ever lost; read the cumulative totals above.
        </div>
      <% else %>
        <div class="rounded-lg border border-edge overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-base-200 text-xs uppercase tracking-wider text-base-content">
              <tr>
                <th class="px-3 py-2 text-left">Occurred</th>
                <th class="px-3 py-2 text-left">Disposition</th>
                <th class="px-3 py-2 text-left">Responsibility</th>
                <th class="px-3 py-2 text-left">Trigger</th>
                <th class="px-3 py-2 text-left">Agent</th>
                <th class="px-3 py-2 text-left">Subject</th>
                <th class="px-3 py-2 text-right">Attempts</th>
              </tr>
            </thead>
            <tbody id="dead-letter-rows" class="divide-y divide-base-200">
              <%= for letter <- @dead_letters do %>
                <tr id={"dead-letter-#{letter.id}"} class="hover:bg-base-100">
                  <td class="px-3 py-2 text-xs text-subtle whitespace-nowrap">
                    {format_dt(letter.occurred_at)}
                  </td>
                  <td class="px-3 py-2">
                    <span
                      data-disposition={letter.disposition}
                      class={["badge badge-sm", disposition_badge(letter.disposition)]}
                      title={letter.reason}
                    >
                      {letter.disposition}
                    </span>
                  </td>
                  <td class="px-3 py-2 font-mono text-xs">
                    {letter.responsibility_key || "—"}
                  </td>
                  <td class="px-3 py-2 text-xs text-subtle">
                    {letter.trigger_kind || "—"}
                  </td>
                  <td class="px-3 py-2 text-xs">
                    {letter.agent_slug || "—"}
                  </td>
                  <td class="px-3 py-2 font-mono text-xs text-subtle">
                    <%= cond do %>
                      <% is_nil(letter.subject_id) -> %>
                        <span class="text-subtle">—</span>
                      <% letter.subject_task_id -> %>
                        <.link
                          navigate={~p"/tasks/#{letter.subject_task_id}"}
                          class="link link-hover"
                        >
                          {letter.subject_type} {letter.subject_short}
                        </.link>
                      <% true -> %>
                        <span>{letter.subject_type} {letter.subject_short}</span>
                    <% end %>
                  </td>
                  <td class="px-3 py-2 text-right tabular-nums text-xs">
                    {letter.attempts}
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
</div>
