<div class="flex h-full min-h-0 flex-col">
  <.breadcrumb segments={[
    %{label: "Admin", navigate: ~p"/admin"},
    %{label: "Federation", navigate: nil}
  ]} />
  <%!-- Header --%>
  <div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
    <div class="flex items-center gap-3">
      <h1 class="text-sm font-semibold uppercase tracking-widest text-base-content/60">
        Admin · Federation Health
      </h1>
      <span class="badge badge-ghost badge-sm">{length(@runtimes)} runtimes</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-xs text-base-content/40">Auto-refreshes every 5s</span>
      <button phx-click="refresh" class="btn btn-ghost btn-xs">
        <span class="hero-arrow-path size-4"></span> Refresh
      </button>
    </div>
  </div>

  <%!-- Tabs: Federation / Dead Letters --%>
  <div class="flex-1 min-h-0 overflow-y-auto p-4 space-y-6">
    <%!-- Runtime status table --%>
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-base-content/50 mb-3">
        Runtime Connections
      </h2>

      <%= if Enum.empty?(@runtimes) do %>
        <div class="rounded-lg border border-base-300 p-8 text-center text-base-content/40 text-sm">
          No active runtimes registered.
        </div>
      <% else %>
        <div class="rounded-lg border border-base-300 overflow-hidden">
          <table class="w-full text-sm">
            <thead class="bg-base-200 text-xs uppercase tracking-wider text-base-content/50">
              <tr>
                <th class="px-4 py-2 text-left">Agent</th>
                <th class="px-4 py-2 text-left">Runtime ID</th>
                <th class="px-4 py-2 text-left">Status</th>
                <th class="px-4 py-2 text-left">Connected At</th>
                <th class="px-4 py-2 text-left">Last Seen</th>
                <th class="px-4 py-2 text-left">Last Connected (DB)</th>
                <th class="px-4 py-2 text-left">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-base-200">
              <%= for runtime <- @runtimes do %>
                <tr class="hover:bg-base-100">
                  <td class="px-4 py-3 font-medium">
                    {runtime.agent_name || runtime.agent_slug || "(unlinked)"}
                  </td>
                  <td class="px-4 py-3 font-mono text-xs text-base-content/60">
                    {runtime.runtime_id}
                  </td>
                  <td class="px-4 py-3">
                    <%= if runtime.online do %>
                      <span class="inline-flex items-center gap-1.5 text-success">
                        <span class="size-2 rounded-full bg-success inline-block"></span> Online
                      </span>
                    <% else %>
                      <span class="inline-flex items-center gap-1.5 text-error">
                        <span class="size-2 rounded-full bg-error inline-block"></span> Offline
                      </span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 text-xs text-base-content/60">
                    {format_dt(runtime.connected_at)}
                  </td>
                  <td class="px-4 py-3 text-xs text-base-content/60">
                    {format_dt(runtime.last_seen_at)}
                  </td>
                  <td class="px-4 py-3 text-xs text-base-content/60">
                    {format_dt(runtime.last_connected_at)}
                  </td>
                  <td class="px-4 py-3">
                    <%= if runtime.online do %>
                      <button
                        phx-click="ping"
                        phx-value-runtime-id={runtime.runtime_id}
                        class="btn btn-xs btn-outline"
                        title="Send ping to runtime"
                      >
                        Ping
                      </button>
                      <%= case Map.get(@ping_results, runtime.runtime_id) do %>
                        <% :sent -> %>
                          <span class="text-xs text-info ml-1">Sent ✓</span>
                        <% {:error, _} -> %>
                          <span class="text-xs text-error ml-1">Failed</span>
                        <% _ -> %>
                          <span></span>
                      <% end %>
                    <% else %>
                      <span class="text-xs text-base-content/30">—</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>

    <%!-- Dead Letters --%>
    <div>
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
          Dead Letters
          <span class="badge badge-ghost badge-xs ml-1">
            {length(@dead_letters)} in ledger
          </span>
        </h2>
        <%= if not Enum.empty?(@dead_letters) do %>
          <button
            id="prune-dead-letters"
            phx-click="prune_dead_letters"
            class="btn btn-xs btn-ghost text-error"
            title="Deletes settled rows only. Pending and replaying rows are the replay queue and cannot be pruned from here."
          >
            Prune settled
          </button>
        <% end %>
      </div>

      <%!-- Cumulative loss counters. Monotonic, never pruned — see the caption. --%>
      <div id="dead-letter-cumulative" class="rounded-lg border border-base-300 p-3 mb-3">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
            Cumulative loss
          </h3>
          <div class="flex items-center gap-2">
            <span class="text-xs text-base-content/40">
              replay rate {:erlang.float_to_binary(@loss_summary.replay_rate * 100, decimals: 1)}%
            </span>
            <span class={[
              "badge badge-xs",
              if(@loss_summary.balanced, do: "badge-success", else: "badge-error")
            ]}>
              {if @loss_summary.balanced, do: "books balance", else: "books do not balance"}
            </span>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2">
          <div class="rounded-md bg-base-200 px-3 py-2">
            <div class="text-[0.65rem] uppercase tracking-wider text-base-content/50">
              Recorded
            </div>
            <div
              id="dead-letter-count-recorded"
              class="text-lg font-semibold tabular-nums"
            >
              {@loss_summary.recorded}
            </div>
          </div>
          <div class="rounded-md bg-base-200 px-3 py-2">
            <div class="text-[0.65rem] uppercase tracking-wider text-base-content/50">
              Replayed
            </div>
            <div
              id="dead-letter-count-replayed"
              class="text-lg font-semibold tabular-nums text-success"
            >
              {@loss_summary.replayed}
            </div>
          </div>
          <div class="rounded-md bg-base-200 px-3 py-2">
            <div class="text-[0.65rem] uppercase tracking-wider text-base-content/50">
              Dropped · policy
            </div>
            <div
              id="dead-letter-count-dropped-policy"
              class="text-lg font-semibold tabular-nums"
            >
              {@loss_summary.dropped_policy}
            </div>
          </div>
          <div class="rounded-md bg-base-200 px-3 py-2">
            <div class="text-[0.65rem] uppercase tracking-wider text-base-content/50">
              Dropped · stale
            </div>
            <div
              id="dead-letter-count-dropped-stale"
              class="text-lg font-semibold tabular-nums"
            >
              {@loss_summary.dropped_stale}
            </div>
          </div>
          <div class="rounded-md bg-base-200 px-3 py-2">
            <div class="text-[0.65rem] uppercase tracking-wider text-base-content/50">
              Superseded
            </div>
            <div
              id="dead-letter-count-superseded-duplicate"
              class="text-lg font-semibold tabular-nums"
            >
              {@loss_summary.superseded_duplicate}
            </div>
          </div>
          <div class="rounded-md bg-base-200 px-3 py-2">
            <div class="text-[0.65rem] uppercase tracking-wider text-base-content/50">
              Abandoned
            </div>
            <div
              id="dead-letter-count-abandoned"
              class="text-lg font-semibold tabular-nums text-error"
            >
              {@loss_summary.abandoned}
            </div>
          </div>
          <div class="rounded-md bg-base-200 px-3 py-2">
            <div class="text-[0.65rem] uppercase tracking-wider text-base-content/50">
              Awaiting replay
            </div>
            <div
              id="dead-letter-count-pending"
              class="text-lg font-semibold tabular-nums text-warning"
            >
              {@loss_summary.pending}
            </div>
          </div>
        </div>

        <p id="dead-letter-cumulative-caption" class="mt-2 text-xs text-base-content/50">
          Totals since inception — every fire ever dead-lettered, not a snapshot of the
          rows below and not a 24h window. Pruning the ledger does not move these numbers.
          Subtract two readings to get a window. "Awaiting replay" is the only live term:
          it is counted off the ledger, which never prunes a queued row.
        </p>

        <%= if not Enum.empty?(@key_breakdown) do %>
          <div id="dead-letter-key-breakdown" class="mt-3 overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="text-[0.65rem] uppercase tracking-wider text-base-content/50">
                <tr>
                  <th class="px-2 py-1 text-left">Responsibility key</th>
                  <th class="px-2 py-1 text-right">Recorded</th>
                  <th class="px-2 py-1 text-right">Replayed</th>
                  <th class="px-2 py-1 text-right">Dropped</th>
                  <th class="px-2 py-1 text-right">Abandoned</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-base-200">
                <%= for entry <- @key_breakdown do %>
                  <tr id={entry.dom_id}>
                    <td class="px-2 py-1 font-mono text-xs">{entry.label}</td>
                    <td data-count="recorded" class="px-2 py-1 text-right tabular-nums">
                      {entry.recorded}
                    </td>
                    <td data-count="replayed" class="px-2 py-1 text-right tabular-nums">
                      {entry.replayed}
                    </td>
                    <td data-count="dropped" class="px-2 py-1 text-right tabular-nums">
                      {entry.dropped}
                    </td>
                    <td data-count="abandoned" class="px-2 py-1 text-right tabular-nums">
                      {entry.abandoned}
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>

      <%= if Enum.empty?(@dead_letters) do %>
        <div class="rounded-lg border border-base-300 p-6 text-center text-base-content/40 text-sm">
          The ledger is empty. That means nothing is queued and nothing settled recently —
          it does not mean nothing was ever lost; read the cumulative totals above.
        </div>
      <% else %>
        <div class="rounded-lg border border-base-300 overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-base-200 text-xs uppercase tracking-wider text-base-content/50">
              <tr>
                <th class="px-3 py-2 text-left">Occurred</th>
                <th class="px-3 py-2 text-left">Disposition</th>
                <th class="px-3 py-2 text-left">Responsibility</th>
                <th class="px-3 py-2 text-left">Trigger</th>
                <th class="px-3 py-2 text-left">Agent</th>
                <th class="px-3 py-2 text-left">Subject</th>
                <th class="px-3 py-2 text-right">Attempts</th>
              </tr>
            </thead>
            <tbody id="dead-letter-rows" class="divide-y divide-base-200">
              <%= for letter <- @dead_letters do %>
                <tr id={"dead-letter-#{letter.id}"} class="hover:bg-base-100">
                  <td class="px-3 py-2 text-xs text-base-content/60 whitespace-nowrap">
                    {format_dt(letter.occurred_at)}
                  </td>
                  <td class="px-3 py-2">
                    <span
                      data-disposition={letter.disposition}
                      class={["badge badge-sm", disposition_badge(letter.disposition)]}
                      title={letter.reason}
                    >
                      {letter.disposition}
                    </span>
                  </td>
                  <td class="px-3 py-2 font-mono text-xs">
                    {letter.responsibility_key || "—"}
                  </td>
                  <td class="px-3 py-2 text-xs text-base-content/60">
                    {letter.trigger_kind || "—"}
                  </td>
                  <td class="px-3 py-2 text-xs">
                    {letter.agent_slug || "—"}
                  </td>
                  <td class="px-3 py-2 font-mono text-xs text-base-content/60">
                    <%= cond do %>
                      <% is_nil(letter.subject_id) -> %>
                        <span class="text-base-content/30">—</span>
                      <% letter.subject_task_id -> %>
                        <.link
                          navigate={~p"/tasks/#{letter.subject_task_id}"}
                          class="link link-hover"
                        >
                          {letter.subject_type} {letter.subject_short}
                        </.link>
                      <% true -> %>
                        <span>{letter.subject_type} {letter.subject_short}</span>
                    <% end %>
                  </td>
                  <td class="px-3 py-2 text-right tabular-nums text-xs">
                    {letter.attempts}
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
</div>
