<div
  class="flex h-full min-h-0 bg-base-200 text-base-content"
  data-page="calendar"
  phx-window-keydown="escape"
  phx-key="Escape"
>
  <.list_pane
    mini_month={@mini_month}
    cursor={@cursor}
    today={@today}
    view={@view}
    section={if @live_action == :settings, do: :settings, else: :calendar}
    booking_link_count={@booking_link_count}
    calendars={@calendars}
    calendars_shown={@calendars_shown}
  />

  <section
    :if={@live_action == :settings}
    class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden bg-base-200"
    data-role="calendar-settings"
  >
    <div class="cal-mainhead">
      <h1>Calendar settings</h1>
    </div>
    <.section_tabs section={:settings} />
    <div class="clears-tab-bar min-h-0 flex-1 overflow-y-auto">
      <.settings_page
        feed_url={@feed_url}
        feed_old={@feed_old}
        feed_exists?={@feed_exists?}
        feed_modal={@feed_modal}
        subscriptions={@external_subscriptions}
        calendars_shown={@calendars_shown}
        ext_error={@ext_error}
        ext_url={@ext_url}
        ext_label={@ext_label}
        agent_rows={@agent_rows}
        agent_choices={@agent_choices}
        grant_form={@grant_form}
      />
    </div>
  </section>

  <section
    :if={@live_action != :settings}
    class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden bg-base-200"
    aria-live="polite"
  >
    <.cal_header view={@view} cursor={@cursor} sel_day={@sel_day} zone={@zone} />
    <.section_tabs section={:calendar} />
    <div
      id="calendar-body"
      phx-hook="CalendarScroll"
      data-view={@view}
      class="clears-tab-bar relative min-h-0 flex-1 overflow-y-auto"
    >
      <.legend meetings_on={@meetings_on} />
      <%= if @view == "month" do %>
        <.month_grid cursor={@cursor} today={@today} entries={@visible_entries} zone={@zone} />
        <.month_grid
          cursor={@cursor}
          today={@today}
          entries={@visible_entries}
          zone={@zone}
          phone
        />
      <% else %>
        <.week_grid
          days={week_days(@cursor)}
          entries={@visible_entries}
          zone={@zone}
          today={@today}
          selected_id={@selected && Map.get(@selected, :id)}
        />
        <div class="lg:hidden" data-role="calendar-phone-week">
          <.day_strip sel_day={@sel_day} today={@today} entries={@visible_entries} zone={@zone} />
          <.phone_day
            day={@sel_day}
            entries={@visible_entries}
            zone={@zone}
            today={@today}
            selected_id={@selected && Map.get(@selected, :id)}
          />
        </div>
      <% end %>
    </div>
  </section>

  <.details_panel :if={@selected && @live_action != :settings} detail={@selected} />

  <.event_editor
    :if={@editing}
    form={@form}
    editing={@editing}
    error={@editor_error}
    invalid={@editor_fields}
    where_options={where_options(@spaces, @projects)}
    meetings_on={@meetings_on}
  />
</div>
