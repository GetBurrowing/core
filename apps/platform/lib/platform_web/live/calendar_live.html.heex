<div class="flex h-full min-h-0 bg-base-200 text-base-content" data-page="calendar">
  <.list_pane
    mini_month={@mini_month}
    cursor={@cursor}
    today={@today}
    view={@view}
    section={if @live_action == :settings, do: :settings, else: :calendar}
    booking_link_count={@booking_link_count}
    calendars={@calendars}
    calendars_shown={@calendars_shown}
  />

  <section
    :if={@live_action == :settings}
    class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden bg-base-200"
    data-role="calendar-settings"
  >
    <%!-- Interim (stage 1): stage 3 rebuilds this page to v4's three
         panels. Until then it opens PR #51's feed/external and agent
         access sheets, so no setting loses its entry point. --%>
    <div class="flex min-h-[52px] shrink-0 items-center gap-2 border-b border-edge px-3 lg:px-4">
      <h1 class="m-0 text-[17px] font-[650] lg:text-[15px]">Calendar settings</h1>
    </div>
    <.section_tabs section={:settings} />
    <div class="clears-tab-bar min-h-0 flex-1 overflow-y-auto">
      <div class="flex max-w-[860px] flex-col gap-4 px-3 py-4 lg:p-5">
        <div class="rounded-[var(--radius-box)] border border-edge bg-base-100 p-4">
          <h3 class="m-0 mb-1 text-[15px] font-[650]">
            Private iCal feed and external calendars
          </h3>
          <button
            id="calendar-subscribe"
            type="button"
            phx-click="subscribe"
            class={PlatformWeb.CalendarLive.Components.ghost_btn()}
          >
            Open
          </button>
        </div>
        <div class="rounded-[var(--radius-box)] border border-edge bg-base-100 p-4">
          <h3 class="m-0 mb-1 text-[15px] font-[650]">Agents with calendar access</h3>
          <button
            id="calendar-agent-access"
            type="button"
            phx-click="agent_access"
            class={PlatformWeb.CalendarLive.Components.ghost_btn()}
          >
            Open
          </button>
        </div>
      </div>
    </div>
  </section>

  <section
    :if={@live_action != :settings}
    class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden bg-base-200"
    aria-live="polite"
  >
    <.cal_header view={@view} cursor={@cursor} sel_day={@sel_day} zone={@zone} />
    <.section_tabs section={:calendar} />
    <div
      id="calendar-body"
      phx-hook="CalendarScroll"
      data-view={@view}
      class="clears-tab-bar relative min-h-0 flex-1 overflow-y-auto"
    >
      <.legend meetings_on={@meetings_on} />
      <%= if @view == "month" do %>
        <.month_grid cursor={@cursor} today={@today} entries={@visible_entries} zone={@zone} />
        <.month_grid
          cursor={@cursor}
          today={@today}
          entries={@visible_entries}
          zone={@zone}
          phone
        />
      <% else %>
        <.week_grid
          days={week_days(@cursor)}
          entries={@visible_entries}
          zone={@zone}
          today={@today}
          selected_id={@selected && Map.get(@selected, :id)}
        />
        <div class="lg:hidden" data-role="calendar-phone-week">
          <.day_strip sel_day={@sel_day} today={@today} entries={@visible_entries} zone={@zone} />
          <.phone_day
            day={@sel_day}
            entries={@visible_entries}
            zone={@zone}
            today={@today}
            selected_id={@selected && Map.get(@selected, :id)}
          />
        </div>
      <% end %>
    </div>
  </section>

  <.sheet
    id="calendar-sheet"
    open={@sheet != nil}
    on_close="close_sheet"
    placement={:bottom}
    handle_close
    swipe_dismiss
  >
    <:title>Calendar</:title>
    <div class="space-y-4">
      <p :if={@error} role="alert" class="text-sm text-error">{@error}</p>
      <%= case @sheet do %>
        <% :agent_access -> %>
          <h2 class="text-lg font-semibold">Agent access</h2>
          <p class="mt-2 text-sm text-subtle">
            Choose what an agent may do. Changes wait for your approval in Inbox unless you preapprove them.
          </p>
          <.form
            for={@grant_form}
            id="calendar-agent-grant-form"
            phx-submit="grant_agent"
            class="mt-4 space-y-3 [&_label]:min-h-11"
          >
            <.input
              field={@grant_form[:agent_id]}
              type="select"
              label="Agent"
              options={Enum.map(@agent_choices, &{&1.name, &1.id})}
              phx-change="choose_grant_agent"
              required
            />
            <.input
              :for={
                {field, label} <- [
                  read: "Read shared events",
                  read_private: "Include private events",
                  create: "Create events",
                  move: "Move events",
                  preapprove: "Preapprove changes"
                ]
              }
              field={@grant_form[field]}
              type="checkbox"
              label={label}
            />
            <button class="btn btn-primary min-h-11" disabled={@agent_choices == []}>
              Save access
            </button>
          </.form>
          <div
            :for={grant <- @calendar_grants}
            class="mt-4 rounded-xl border border-edge p-3 text-sm"
          >
            <p>
              {Enum.find_value(@agent_choices, grant.agent_id, fn agent ->
                if agent.id == grant.agent_id, do: agent.name
              end)}
            </p>
            <p class="text-subtle">
              {if grant.revoked_at, do: "Revoked", else: "Active"} · {if grant.preapprove,
                do: "Preapproved",
                else: "Approval required"}
            </p>
            <button
              :if={is_nil(grant.revoked_at)}
              id={"calendar-revoke-agent-#{grant.agent_id}"}
              phx-click="revoke_agent"
              phx-value-id={grant.agent_id}
              class="btn btn-ghost min-h-11 text-error"
            >
              Revoke access
            </button>
          </div>
          <p :if={@error} role="alert" class="mt-3 text-sm text-error">{@error}</p>
        <% :edit -> %>
          <h2 class="text-lg font-semibold">
            {if @selected.id, do: "Edit event", else: "New event"}
          </h2>
          <.form
            for={@form}
            id="calendar-event-form"
            phx-submit="save"
            phx-change="event_change"
            class="space-y-3 [&_.label]:text-[15px]"
          >
            <.input field={@form[:title]} label="Title" required maxlength="300" />
            <.input field={@form[:all_day]} type="checkbox" label="All day" />
            <div
              :if={@form[:all_day].value not in [true, "true"]}
              class="grid grid-cols-1 gap-3 sm:grid-cols-2"
            >
              <.input field={@form[:starts_at]} type="datetime-local" label="Start" /><.input
                field={@form[:ends_at]}
                type="datetime-local"
                label="End"
              />
            </div>
            <div
              :if={@form[:all_day].value in [true, "true"]}
              class="grid grid-cols-1 gap-3 sm:grid-cols-2"
            >
              <.input field={@form[:start_date]} type="date" label="All-day start" /><.input
                field={@form[:end_date]}
                type="date"
                label="All-day end"
              />
            </div>
            <.input field={@form[:time_zone]} label="Time zone" required />
            <.input
              field={@form[:repeat]}
              type="select"
              label="Repeat"
              options={[
                {"Doesn't repeat", ""},
                {"Daily", "FREQ=DAILY"},
                {"Weekly", "FREQ=WEEKLY"},
                {"Monthly", "FREQ=MONTHLY"},
                {"Custom", "custom"}
              ]}
            />
            <div
              :if={@form[:repeat].value == "custom"}
              class="space-y-3 rounded-lg border border-edge p-3"
            >
              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <.input
                  field={@form[:custom_interval]}
                  type="number"
                  label="Every"
                  min="1"
                  max="365"
                /><.input
                  field={@form[:custom_frequency]}
                  type="select"
                  label="Period"
                  options={[{"Days", "DAILY"}, {"Weeks", "WEEKLY"}, {"Months", "MONTHLY"}]}
                />
              </div>
              <.input field={@form[:custom_until]} type="date" label="Last date (optional)" />
              <.input
                field={@form[:custom_count]}
                type="number"
                min="1"
                max="10000"
                label="Number of events (optional)"
              />
            </div>
            <.input
              field={@form[:where]}
              type="select"
              label="Where"
              options={where_options(@spaces, @projects)}
            />
            <p class="text-xs text-subtle">
              {visibility_label(@form[:where].value, @spaces, @projects)}
            </p>
            <.input
              field={@form[:visibility]}
              type="select"
              label="Shared visibility"
              options={[{"Event details", "details"}, {"Busy only", "busy"}]}
            />
            <.input field={@form[:description]} type="textarea" label="Description" />
            <button type="submit" class="btn btn-primary w-full min-h-11">Save event</button>
          </.form>
        <% :detail -> %>
          <h2 class="text-lg font-semibold">{@selected.title}</h2>
          <p :if={!@selected.all_day} class="font-mono text-sm">
            {time_label(@selected.starts_at, @zone)}–{time_label(@selected.ends_at, @zone)}
          </p>
          <p :if={@selected.all_day} class="text-sm">
            All day · {@selected.start_date}–{Date.add(@selected.end_date, -1)}
          </p>
          <p class="text-xs text-subtle">Created in {@selected.time_zone}</p>
          <p class="whitespace-pre-wrap text-sm">{@selected.description}</p>
          <p :if={@selected.tentative} class="text-sm text-subtle">
            Tentative · Review this change in Inbox.
          </p>
          <.link
            :if={@selected.tentative and @selected.owner_id == @current_user_record.id}
            navigate={~p"/inbox"}
            class="btn min-h-11"
          >
            Open Inbox
          </.link>
          <div
            :if={@selected.owner_id == @current_user_record.id and not @selected.tentative}
            class="flex gap-2"
          >
            <button phx-click="edit" class="btn min-h-11">Edit event</button><button
              phx-click="delete"
              data-confirm="Delete this event?"
              class="btn btn-ghost min-h-11 text-error"
            >Delete event</button>
          </div>
        <% :meeting -> %>
          <h2 class="text-lg font-semibold">{@selected.title}</h2>
          <p class="text-sm">Meetings edit where they live.</p>
          <.link
            navigate={~p"/meetings/#{@selected.meeting.slug}"}
            class="btn btn-primary min-h-11"
          >
            Open in Meetings
          </.link>
        <% :external -> %>
          <h2 class="text-lg font-semibold">{@selected.title}</h2>
          <p class="text-sm">{@selected.subscription} · Read-only external calendar</p>
          <p :if={@selected.stale} class="text-sm text-error">
            Refresh required; availability unknown.
          </p>
          <p class="text-sm">Edit this event in its source calendar.</p>
        <% :subscribe -> %>
          <section class="space-y-3 border-b border-edge pb-4">
            <h2 class="text-lg font-semibold">External calendars</h2>
            <p class="text-sm">
              Only you can see these calendars. Read-only; changes stay in the source calendar.
            </p>
            <.form
              for={%{}}
              as={:subscription}
              phx-submit="add_external"
              id="external-calendar-form"
              class="space-y-2"
            >
              <label class="block text-[15px]">
                Name<input
                  name="subscription[name]"
                  required
                  maxlength="100"
                  class="input w-full"
                />
              </label>
              <label class="block text-[15px]">
                Calendar URL<input
                  name="subscription[url]"
                  type="url"
                  required
                  autocomplete="off"
                  class="input w-full"
                  placeholder="https://…/calendar.ics"
                />
              </label>
              <button class="btn min-h-11" type="submit">Add external calendar</button>
            </.form>
            <div
              :for={subscription <- @external_subscriptions}
              id={"external-calendar-#{subscription.id}"}
              class="space-y-2 rounded-lg border border-edge p-3"
            >
              <h3 class="font-semibold">{subscription.name}</h3>
              <p class="text-sm">
                Read-only · {if Platform.Calendar.Subscriptions.fresh?(subscription),
                  do: "Up to date",
                  else: "Availability unknown"}
              </p>
              <p :if={subscription.refreshed_at} class="text-xs text-subtle">
                Last refreshed {Calendar.strftime(subscription.refreshed_at, "%b %-d, %H:%M UTC")}
              </p>
              <p :if={subscription.error} class="text-sm text-error">{subscription.error}</p>
              <div class="flex gap-2">
                <button
                  phx-click="refresh_external"
                  phx-value-id={subscription.id}
                  class="btn min-h-11"
                  phx-disable-with="Refreshing…"
                >
                  Refresh
                </button>
                <button
                  phx-click="remove_external"
                  phx-value-id={subscription.id}
                  data-confirm="Remove this external calendar?"
                  class="btn btn-ghost min-h-11 text-error"
                >
                  Remove
                </button>
              </div>
            </div>
          </section>
          <h2 class="text-lg font-semibold">Subscribe to your calendar</h2>
          <p class="text-sm">
            Shows your Burrow events and meetings. Anyone with this link can read them.
          </p>
          <p class="text-sm">External calendars stay private in Calendar.</p>
          <%= if @feed_url do %>
            <p class="font-mono text-sm">webcal://••••••••</p>
            <button
              id="calendar-copy-feed"
              phx-hook="CopyToClipboard"
              data-clipboard-text={@feed_url}
              class="btn min-h-11"
            >
              Copy link
            </button>
            <.link
              href={{:webcal, String.replace(@feed_url, ~r/^https?:/, "")}}
              class="btn min-h-11"
            >
              Add to Apple Calendar
            </.link>
            <p class="text-sm">
              Google and Outlook: paste the link under "Add calendar › From URL"
            </p>
          <% else %>
            <p class="text-sm">
              Create a new link to subscribe. Existing links stay active until you regenerate or revoke them.
            </p>
            <button phx-click="confirm_rotate" class="btn min-h-11">
              Create subscription link
            </button>
          <% end %>
          <button phx-click="confirm_rotate" class="btn btn-ghost min-h-11 text-error">
            Regenerate link
          </button>
          <button phx-click="revoke_feed" class="btn btn-ghost min-h-11 text-error">
            Revoke link
          </button>
          <div :if={@confirm_rotate} class="rounded-lg border border-edge p-3">
            <p class="mb-3 text-sm">
              The old link will stop working in every calendar app that uses it.
            </p>
            <button phx-click="rotate_feed" class="btn btn-primary min-h-11">
              Confirm regeneration
            </button>
          </div>
        <% _ -> %>
      <% end %>
    </div>
  </.sheet>
</div>
