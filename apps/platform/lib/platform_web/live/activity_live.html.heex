<%!--
  Outer scroll container — fixes BACKLOG #16-followup mobile clipping where
  the panel was hard-capped at viewport height because the shell's main
  content area is `flex-1 overflow-hidden`. Without `h-full overflow-y-auto`
  here, content past the viewport simply disappears (no scroll, no Load more
  button reachable). With it, the panel scrolls within the shell main area.
--%>
<div class="h-full overflow-y-auto">
  <div class="mx-auto max-w-3xl p-6">
    <header class="mb-6 flex items-end justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold">AI activity log</h1>
        <p class="text-sm text-base-content/70">
          Full record of AI actions in your spaces, including items later removed.
        </p>
      </div>
      <button
        type="button"
        phx-click="refresh"
        class="btn btn-sm btn-ghost gap-2"
        aria-label="Refresh activity"
      >
        <span class="hero-arrow-path size-4"></span>
        <span>Refresh</span>
      </button>
    </header>

    <div role="tablist" class="tabs tabs-boxed mb-3 inline-flex">
      <button
        :for={label <- @ranges}
        type="button"
        role="tab"
        phx-click="change_range"
        phx-value-range={label}
        class={["tab", @range == label && "tab-active"]}
        aria-selected={@range == label}
      >
        {range_label(label)}
      </button>
    </div>

    <p class="mb-6 text-xs text-base-content/50">
      <span class="font-medium text-base-content/70">{range_label(@range)}</span>
      &middot; Page <span class="font-medium text-base-content/70">{@page}</span>
      of <span class="font-medium text-base-content/70">{@total_pages}</span>
    </p>

    <%!-- Empty state per docs/design-system/03-voice.md §5.4 — Activity uses
         :minimal per Marlowe's 2026-05-09 pin (no conversational chrome). --%>
    <.empty_state :if={@actions == []} variant={:minimal}>
      <:body>
        When your agents start working, what they do appears here. Try a wider date range, or connect an agent to start.
      </:body>
    </.empty_state>

    <%!-- Day-grouped feed (audit 1B-USE-2): one section per UTC day in
         reverse chronological order. Headers use 'Today / Yesterday /
         weekday / explicit date' for scannability. Read-only — no per-row
         action buttons; soft-deleted items render with a Deleted pill and
         strikethrough. --%>
    <div :if={@actions != []} class="space-y-6">
      <section
        :for={{day, day_actions} <- group_actions_by_day(@actions)}
        aria-labelledby={"activity-day-#{Date.to_iso8601(day)}"}
      >
        <h2
          id={"activity-day-#{Date.to_iso8601(day)}"}
          class="mb-2 text-xs font-semibold uppercase tracking-widest text-base-content/50"
        >
          {day_header_label(day)}
        </h2>
        <ul class="space-y-3" role="list">
          <li
            :for={action <- day_actions}
            class={[
              "flex items-start gap-3 rounded-2xl border border-base-300 bg-base-100 p-4",
              action.state == :undone && "opacity-70"
            ]}
          >
            <%!-- The acting agent's face. This was a hand-rolled circle over a
                 local `avatar_initial/1` that took a bare name string — NOT
                 `PresenceHooks.avatar_initial/2` — and tinted itself by row
                 KIND (primary for a message, secondary for a canvas). Reviewer
                 ruling on 01a003b7-035f-7399-8523-06f8ca142fd8: keep the tint —
                 restored below via `agent_avatar`'s `fallback_class` seam so an
                 imageless row still reads its kind at a glance. It now also
                 shows the agent's uploaded image when there is one, in which
                 case `fallback_class` is inert and the row is unchanged. --%>
            <div class="flex-shrink-0 pt-1">
              <.agent_avatar
                name={action.agent_name}
                avatar_url={action.agent_avatar_url}
                size="md"
                fallback_class={[
                  action.kind == :message && "bg-primary/10 text-primary",
                  action.kind == :canvas && "bg-secondary/10 text-secondary"
                ]}
              />
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2 text-xs text-base-content/60">
                <span class="font-semibold text-base-content/80">{action.agent_name}</span>
                <span class="rounded-full bg-base-200 px-2 py-0.5 font-medium">
                  {kind_label(action.kind)}
                </span>
                <%!-- State pill renders ONLY on Deleted rows. Active is the
                      unmarked default — putting an "Active" pill on every row
                      would be visual noise (Active is the common case). --%>
                <span
                  :if={action.state == :undone}
                  class="rounded-full bg-warning/15 px-2 py-0.5 font-medium text-warning"
                >
                  Deleted
                </span>
                <span title={DateTime.to_string(action.inserted_at)}>
                  {time_ago(action.inserted_at)}
                </span>
              </div>
              <p class={[
                "mt-1 line-clamp-3 text-sm break-words",
                action.state == :active && "text-base-content/80",
                action.state == :undone && "text-base-content/60 line-through decoration-1"
              ]}>
                {action_preview(action)}
              </p>
            </div>
          </li>
        </ul>
      </section>
    </div>

    <nav
      :if={@total_pages > 1}
      class="mt-6 flex flex-wrap items-center justify-center gap-1"
      aria-label="Pagination"
    >
      <button
        type="button"
        phx-click="goto_page"
        phx-value-page="1"
        disabled={@page == 1}
        class="btn btn-sm btn-ghost"
        aria-label="First page"
      >
        «
      </button>
      <button
        type="button"
        phx-click="goto_page"
        phx-value-page={@page - 1}
        disabled={@page == 1}
        class="btn btn-sm btn-ghost"
        aria-label="Previous page"
      >
        ‹
      </button>

      <%= for entry <- visible_pages(@page, @total_pages) do %>
        <%= case entry do %>
          <% :ellipsis -> %>
            <span class="px-2 text-base-content/40" aria-hidden="true">…</span>
          <% n -> %>
            <button
              type="button"
              phx-click="goto_page"
              phx-value-page={n}
              class={[
                "btn btn-sm",
                n == @page && "btn-primary",
                n != @page && "btn-ghost"
              ]}
              aria-current={n == @page && "page"}
            >
              {n}
            </button>
        <% end %>
      <% end %>

      <button
        type="button"
        phx-click="goto_page"
        phx-value-page={@page + 1}
        disabled={@page == @total_pages}
        class="btn btn-sm btn-ghost"
        aria-label="Next page"
      >
        ›
      </button>
      <button
        type="button"
        phx-click="goto_page"
        phx-value-page={@total_pages}
        disabled={@page == @total_pages}
        class="btn btn-sm btn-ghost"
        aria-label="Last page"
      >
        »
      </button>
    </nav>
  </div>
</div>
