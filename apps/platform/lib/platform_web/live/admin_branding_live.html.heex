<%!-- Branding — install-wide PWA identity (task 01a0879a stage 4).

     Mobile-first: every column here is a single stack at 375px and only
     splits at `sm:`. Nothing carries a fixed pixel width wider than the
     smallest preview tile, so the page container has nothing to overflow
     horizontally. --%>
<div class="mx-auto w-full max-w-3xl px-4 py-6" data-role="admin-branding">
  <div class="mb-6">
    <.link navigate="/admin" class="text-sm text-base-content/60 hover:text-base-content">
      ← Admin
    </.link>
    <h1 class="mt-2 text-xl font-semibold text-base-content">Branding</h1>
    <p class="mt-1 text-sm text-base-content/60">
      This install's home-screen identity. It applies to everyone who installs this
      deployment — orgs are clients, not white-label units, so there is no per-org
      variant of these values.
    </p>
  </div>

  <%!-- ── Upload ──────────────────────────────────────────────── --%>
  <section class="mb-8 rounded-lg border border-edge bg-base-200 p-4">
    <h2 class="text-base font-semibold text-base-content">Source image</h2>
    <p class="mt-1 text-sm text-base-content/60">
      One square upload. Every icon this install serves is derived from it.
    </p>

    <form
      id="branding-upload-form"
      phx-change="validate_source"
      phx-submit="validate_source"
      class="mt-4"
    >
      <div
        class="rounded-lg border-2 border-dashed border-edge bg-base-100 p-6 text-center"
        phx-drop-target={@uploads.source.ref}
        data-role="branding-dropzone"
      >
        <span class="hero-cloud-arrow-up size-8 text-base-content/40"></span>
        <p class="mt-2 text-sm text-base-content/70">
          Drag an image here, or pick one from your device:
        </p>
        <%!-- Exactly ONE live_file_input on this page. FilesLive carries a
             standing note about two inputs sharing a ref; do not add a
             second here. --%>
        <.live_file_input
          upload={@uploads.source}
          class="file-input file-input-bordered file-input-sm mt-3 w-full max-w-full"
        />
        <p class="mt-3 text-xs text-base-content/50">
          Square PNG, at least {IconSet.min_source_px()}px on each side, opaque.
          Up to {max_file_size_label()} ({accept_label()}).
        </p>
        <p class="mt-2 text-xs text-base-content/50">
          The maskable Android variant is generated by shrinking your artwork to the
          inner 80% of the canvas and filling the edge with the background colour
          below — so a mark that already fills the frame edge to edge will come back
          smaller than you drew it. Leave it room.
        </p>
      </div>

      <div
        :for={entry <- @uploads.source.entries}
        class="mt-3 flex items-center justify-between gap-3 text-xs text-base-content/60"
      >
        <span class="truncate">{entry.client_name} — {entry.progress}%</span>
        <button
          type="button"
          phx-click="cancel_source"
          phx-value-ref={entry.ref}
          class="btn btn-ghost btn-xs"
          aria-label="Cancel upload"
        >
          <span class="hero-x-mark size-4"></span>
        </button>
      </div>

      <p
        :for={err <- Enum.flat_map(@uploads.source.entries, &upload_errors(@uploads.source, &1))}
        class="mt-3 text-sm text-error"
        data-role="branding-upload-error"
      >
        {error_message(err)}
      </p>

      <p
        :if={@upload_error}
        class="mt-3 text-sm text-error"
        data-role="branding-upload-error"
      >
        {@upload_error}
      </p>
    </form>
  </section>

  <%!-- ── Identity fields ─────────────────────────────────────── --%>
  <section class="mb-8 rounded-lg border border-edge bg-base-200 p-4">
    <.form
      for={@form}
      id="branding-identity-form"
      phx-change="validate_identity"
      phx-submit="save_identity"
    >
      <h2 class="text-base font-semibold text-base-content">Name and colours</h2>

      <div class="mt-4">
        <.input
          field={@form[:app_name]}
          type="text"
          label="App name"
          data-role="branding-app-name"
        />
        <p class="mt-1 text-xs text-base-content/50" data-role="branding-label-budget">
          Home screens show about {label_budget()} characters
          — currently {@app_name_length}. Put the distinguishing word FIRST:
          "Ellis Suite" is shown as "Ellis S…". Longer names are allowed and are
          used in full in the install prompt.
        </p>
      </div>

      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <.input
          field={@form[:background_color]}
          type="text"
          label="Surface / base-100 (background)"
          data-role="branding-background-color"
        />
        <.input
          field={@form[:theme_color]}
          type="text"
          label="Browser chrome (theme colour)"
          data-role="branding-theme-color"
        />
      </div>
      <p class="mt-1 text-xs text-base-content/50">
        Six-digit hex. The background is the splash surface AND the padding behind the
        maskable icon, so the two match by construction.
      </p>

      <div class="mt-4">
        <.button phx-disable-with="Saving…" data-role="branding-save">Save</.button>
      </div>
    </.form>
  </section>

  <%!-- ── Derived preview ─────────────────────────────────────── --%>
  <section class="rounded-lg border border-edge bg-base-200 p-4" data-role="branding-preview">
    <h2 class="text-base font-semibold text-base-content">What gets served</h2>
    <p class="mt-1 text-sm text-base-content/60">
      Rendered at the sizes the OS actually uses. The maskable tile is shown inside a
      circular mask because a circle is the crop most Android launchers apply — if the
      mark loses an edge here, it loses it on the home screen.
    </p>

    <div class="mt-4 flex flex-wrap items-end gap-6">
      <figure class="flex flex-col items-center gap-2">
        <img
          src={@icons.icon_192}
          alt="Home-screen icon at 192 pixels"
          width="192"
          height="192"
          class="h-24 w-24 rounded-lg border border-edge sm:h-48 sm:w-48"
          data-role="branding-preview-192"
        />
        <figcaption class="text-xs text-base-content/50">192 · any</figcaption>
      </figure>

      <figure class="flex flex-col items-center gap-2">
        <img
          src={@icons.icon_512_maskable}
          alt="Maskable icon shown inside the circular launcher crop"
          width="512"
          height="512"
          class="h-24 w-24 rounded-full border border-edge sm:h-48 sm:w-48"
          data-role="branding-preview-maskable"
        />
        <figcaption class="text-xs text-base-content/50">512 · maskable (circle crop)</figcaption>
      </figure>

      <figure class="flex flex-col items-center gap-2">
        <img
          src={@icons.favicon_32}
          alt="Favicon at 32 pixels"
          width="32"
          height="32"
          class="h-8 w-8 border border-edge"
          data-role="branding-preview-favicon"
        />
        <figcaption class="text-xs text-base-content/50">32 · favicon</figcaption>
      </figure>
    </div>

    <p :if={is_nil(@branding.version)} class="mt-4 text-xs text-base-content/50">
      No upload yet — these are the icons that ship with the app.
    </p>
  </section>
</div>
