<%!-- Branding — install-wide PWA identity (task 01a0879a stage 4).

     Mobile-first: every column here is a single stack at 375px and only
     splits at `sm:`. Nothing carries a fixed pixel width wider than the
     smallest preview tile, so the page container has nothing to overflow
     horizontally. --%>
<%!-- The app shell bounds the document at `h-[100dvh] overflow-hidden` and its
     `<main>` is `overflow-hidden` too, so a page that relies on the DOCUMENT
     scrolling is simply clipped at the fold with no way to reach the rest.
     Every other admin page owns its scroller; this one did not, which made the
     identity fields and the preview unreachable below ~100dvh. The outer column
     takes the bounded height, the inner div is the scroller. --%>
<div class="flex h-full min-h-0 flex-col" data-role="admin-branding">
  <div class="flex-1 min-h-0 overflow-y-auto px-4 py-6 clears-tab-bar">
    <div class="mx-auto w-full max-w-5xl">
      <div class="mb-6">
        <.link
          navigate="/admin"
          class="text-sm font-medium text-base-content hover:text-base-content"
        >
          ← Admin
        </.link>
        <h1 class="mt-2 text-xl font-semibold text-base-content">Branding</h1>
        <p class="mt-1 text-sm text-subtle">
          This install's home-screen identity. It applies to everyone who installs this
          deployment — orgs are clients, not white-label units, so there is no per-org
          variant of these values.
        </p>
      </div>

      <%!-- ── Upload ──────────────────────────────────────────────── --%>
      <section class="mb-8 rounded-lg border border-edge bg-base-200 p-4">
        <h2 class="text-base font-semibold text-base-content">Source image</h2>
        <p class="mt-1 text-sm text-subtle">
          One square upload. Every icon this install serves is derived from it.
        </p>

        <form
          id="branding-upload-form"
          phx-change="validate_source"
          phx-submit="validate_source"
          class="mt-4"
        >
          <div
            class="rounded-lg border-2 border-dashed border-edge bg-base-100 p-6 text-center"
            phx-drop-target={@uploads.source.ref}
            data-role="branding-dropzone"
          >
            <span class="hero-cloud-arrow-up size-8 text-subtle"></span>
            <p class="mt-2 text-sm text-base-content">
              Drag an image here, or pick one from your device:
            </p>
            <%!-- Exactly ONE live_file_input on this page. FilesLive carries a
             standing note about two inputs sharing a ref; do not add a
             second here. --%>
            <.live_file_input
              upload={@uploads.source}
              class="file-input file-input-bordered file-input-sm mt-3 w-full max-w-full"
            />
            <p class="mt-3 text-xs text-subtle">
              Square PNG, at least {IconSet.min_source_px()}px on each side, opaque.
              Up to {max_file_size_label()} ({accept_label()}).
            </p>
            <p class="mt-2 text-xs text-subtle">
              The maskable Android variant is generated by shrinking your artwork to the
              inner 80% of the canvas and filling the edge with the background colour
              below — so a mark that already fills the frame edge to edge will come back
              smaller than you drew it. Leave it room.
            </p>
          </div>

          <div
            :for={entry <- @uploads.source.entries}
            class="mt-3 flex items-center justify-between gap-3 text-xs text-subtle"
          >
            <span class="truncate">{entry.client_name} — {entry.progress}%</span>
            <button
              type="button"
              phx-click="cancel_source"
              phx-value-ref={entry.ref}
              class="btn btn-ghost btn-xs"
              aria-label="Cancel upload"
            >
              <span class="hero-x-mark size-4"></span>
            </button>
          </div>

          <p
            :for={
              err <- Enum.flat_map(@uploads.source.entries, &upload_errors(@uploads.source, &1))
            }
            class="mt-3 text-sm text-error"
            data-role="branding-upload-error"
          >
            {error_message(err)}
          </p>

          <p
            :if={@upload_error}
            class="mt-3 text-sm text-error"
            data-role="branding-upload-error"
          >
            {@upload_error}
          </p>
        </form>

        <%!-- Only while an upload is set: unset falls back to the Burrow icon
             set, all seven variants together (task 01a14b9e stage 6). --%>
        <div
          :if={@branding.source_storage_key}
          class="mt-4 flex flex-wrap items-center gap-3 border-t border-edge pt-4"
        >
          <button
            type="button"
            phx-click="reset_icon"
            data-confirm="Reset the icon to the Burrow default for everyone on this install?"
            class="btn btn-ghost btn-sm focus-visible-ring"
            data-role="branding-reset-icon"
          >
            <span class="hero-arrow-uturn-left size-4"></span> Reset icon to Burrow default
          </button>
          <p class="text-xs text-subtle">
            Removes the uploaded image and every icon derived from it.
          </p>
        </div>
      </section>

      <%!-- ── Identity fields ─────────────────────────────────────── --%>
      <section class="mb-8 rounded-lg border border-edge bg-base-200 p-4">
        <.form
          for={@form}
          id="branding-identity-form"
          phx-change="validate_identity"
          phx-submit="save_identity"
        >
          <h2 class="text-base font-semibold text-base-content">Name and colours</h2>

          <div class="mt-4">
            <.input
              field={@form[:app_name]}
              type="text"
              label="App name"
              data-role="branding-app-name"
            />
            <p class="mt-1 text-xs text-subtle" data-role="branding-label-budget">
              Home screens show about {label_budget()} characters
              — currently {@app_name_length}. Put the distinguishing word FIRST:
              "Acme Workspace" is shown as "Acme Works…". Longer names are allowed and are
              used in full in the install prompt.
            </p>
          </div>

          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <.input
              field={@form[:background_color]}
              type="text"
              label="Surface / base-100 (background)"
              data-role="branding-background-color"
            />
            <.input
              field={@form[:theme_color]}
              type="text"
              label="Browser chrome (theme colour)"
              data-role="branding-theme-color"
            />
          </div>
          <p class="mt-1 text-xs text-subtle">
            Six-digit hex. The background is the splash surface AND the padding behind the
            maskable icon, so the two match by construction.
          </p>
          <%!-- The browser bar is a different surface from the app, so these stay
               separate fields; this only COPIES the app's dark surface in (the app
               is dark-first and root.html.heex paints background_color as the
               first-paint colour). Nothing is saved until Save. --%>
          <button
            type="button"
            phx-click="match_app_colours"
            class="btn btn-ghost btn-xs mt-2"
            data-role="branding-match-app-colours"
          >
            <span class="hero-swatch size-4" aria-hidden="true"></span> Match app colours
          </button>

          <div class="mt-4">
            <.button phx-disable-with="Saving…" data-role="branding-save">Save</.button>
          </div>
        </.form>
      </section>

      <%!-- ── App colours (task 01a0dbee stage 4) ───────────────────
           Design direction canvas 01a0dbf8. Three colours per mode, the rest
           derived. The DRAFT reaches the preview only (inline style from
           ThemeCss.mode_declarations/2); the page chrome stays in the saved
           theme until Save. Phone: controls, then a Light/Dark toggle above
           ONE preview, then that mode's checks. lg: controls left, both
           previews and both check lists right. --%>
      <section
        class="mb-8 rounded-lg border border-edge bg-base-200 p-4"
        data-role="app-colours"
      >
        <h2 class="text-base font-semibold text-base-content">App colours</h2>
        <p class="mt-1 text-sm text-subtle">
          Colours used inside Burrow for everyone on this install. Pick an action colour and a
          surface for each mode; Burrow derives text, links, borders and the focus ring from
          them. Status colours (info, success, warning, error) are not editable.
        </p>

        <div class="mt-4 grid grid-cols-1 gap-6 lg:grid-cols-2">
          <%!-- ── Controls ── --%>
          <form
            id="app-colours-form"
            phx-change="validate_colors"
            phx-submit="save_colors"
            class="min-w-0"
          >
            <h3 class="text-sm font-medium text-base-content">Start from a theme</h3>
            <div
              class="mt-2 flex gap-3 overflow-x-auto pb-2"
              role="list"
              data-role="color-presets"
            >
              <button
                :for={preset <- Presets.all()}
                type="button"
                role="listitem"
                phx-click="apply_preset"
                phx-value-preset={preset.key}
                class={[
                  "focus-visible-ring flex shrink-0 flex-col items-center gap-1 rounded-lg p-1",
                  @colors_preset == preset.key && "bg-base-300"
                ]}
                aria-pressed={to_string(@colors_preset == preset.key)}
                data-role="color-preset"
                data-preset={preset.key}
              >
                <span
                  class="relative block h-12 w-16 overflow-hidden rounded-md border border-edge"
                  style={preset_style(preset)}
                  aria-hidden="true"
                >
                  <span
                    class="absolute left-1.5 top-1.5 size-3 rounded-full"
                    style="background:var(--swatch-light)"
                  >
                  </span>
                  <span
                    class="absolute bottom-1.5 right-1.5 size-3 rounded-full"
                    style="background:var(--swatch-dark)"
                  >
                  </span>
                </span>
                <span class="text-xs text-base-content">{preset.name}</span>
              </button>
            </div>
            <p class="text-xs text-subtle" data-role="color-preset-label">
              current: {Presets.label(@colors_preset, @colors_draft)}
            </p>

            <div class="mt-4 grid grid-cols-[auto_minmax(0,1fr)_minmax(0,1fr)] items-start gap-x-3 gap-y-3">
              <span></span>
              <span :for={mode <- modes()} class="text-xs font-medium text-subtle">
                {mode_label(mode)}
              </span>

              <%= for slot <- slots() do %>
                <span class="pt-1.5 text-sm text-base-content">{slot_label(slot)}</span>
                <div
                  :for={mode <- modes()}
                  class="min-w-0"
                  data-role={"color-#{mode}-#{slot}"}
                >
                  <div class="flex items-center gap-1.5">
                    <input
                      type="color"
                      id={"colors-#{field(mode, slot)}-swatch"}
                      name={"colors[#{field(mode, slot)}_swatch]"}
                      value={resolved(@colors_draft, mode, slot)}
                      phx-debounce="150"
                      class="focus-visible-ring h-8 w-8 shrink-0 cursor-pointer rounded border border-edge bg-transparent p-0.5"
                      aria-label={"#{mode_label(mode)} #{String.downcase(slot_label(slot))} colour picker"}
                    />
                    <input
                      type="text"
                      id={"colors-#{field(mode, slot)}"}
                      name={"colors[#{field(mode, slot)}]"}
                      value={@colors_inputs[field(mode, slot)]}
                      data-normalized={@colors_inputs[field(mode, slot)]}
                      phx-hook="HexField"
                      placeholder={placeholder(mode, slot)}
                      phx-debounce="150"
                      autocomplete="off"
                      spellcheck="false"
                      maxlength="7"
                      class={[
                        "input input-sm w-full min-w-0 font-mono text-xs",
                        @colors_errors[field(mode, slot)] && "input-error"
                      ]}
                      aria-label={"#{mode_label(mode)} #{String.downcase(slot_label(slot))} hex"}
                      aria-invalid={to_string(Map.has_key?(@colors_errors, field(mode, slot)))}
                    />
                  </div>
                  <p
                    :if={@colors_errors[field(mode, slot)]}
                    role="alert"
                    class="mt-1 text-xs text-error"
                    data-role="color-input-error"
                  >
                    {@colors_errors[field(mode, slot)]}
                  </p>
                </div>
              <% end %>
            </div>

            <div class="mt-6 flex flex-col gap-3">
              <p
                :for={reason <- @colors_blocks}
                class="text-sm text-error"
                data-role="color-block-reason"
              >
                {reason}
              </p>
              <p
                :for={msg <- @colors_save_errors}
                role="alert"
                class="text-sm text-error"
                data-role="color-save-error"
              >
                {msg}
              </p>
              <div class="flex flex-wrap items-center gap-2">
                <.button
                  variant="primary"
                  disabled={@colors_blocks != []}
                  data-confirm={save_scope()}
                  data-role="color-save"
                >
                  Save colours
                </.button>
                <%!-- type="button" so neither submits the form; `.button` has no
                     `type` attr, hence the plain element with its classes. --%>
                <button
                  type="button"
                  phx-click="cancel_colors"
                  class="btn btn-ghost focus-visible-ring"
                  data-role="color-cancel"
                >
                  Cancel
                </button>
                <button
                  type="button"
                  phx-click="reset_colors"
                  data-confirm={save_scope()}
                  class="btn btn-ghost focus-visible-ring"
                  data-role="color-reset"
                >
                  Reset to Burrow default
                </button>
              </div>
            </div>
          </form>

          <%!-- ── Preview + checks ── --%>
          <div class="min-w-0">
            <div
              class="mb-3 inline-flex rounded-lg border border-edge p-0.5 lg:hidden"
              role="group"
              aria-label="Preview mode"
              data-role="color-preview-toggle"
            >
              <button
                :for={mode <- modes()}
                type="button"
                phx-click="preview_mode"
                phx-value-mode={mode}
                aria-pressed={to_string(@colors_preview_mode == mode)}
                class={[
                  "focus-visible-ring rounded-md px-3 py-1 text-sm",
                  @colors_preview_mode == mode && "bg-base-300 font-medium"
                ]}
              >
                {mode_label(mode)}
              </button>
            </div>

            <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
              <div
                :for={mode <- modes()}
                class={[@colors_preview_mode != mode && "hidden lg:block", "min-w-0"]}
              >
                <p class="mb-1 hidden text-xs font-medium text-subtle lg:block">
                  {mode_label(mode)}
                </p>
                <%!-- data-theme gives daisy's theme for this mode;
                     data-theme-preview keeps the SAVED #install-theme block out
                     (see ThemeCss moduledoc); the inline style is the draft. --%>
                <div
                  data-theme={mode}
                  data-theme-preview
                  style={preview_style(@colors_draft, mode)}
                  class="flex overflow-hidden rounded-lg border border-edge bg-base-100 text-base-content"
                  data-role={"color-preview-#{mode}"}
                  aria-label={"#{mode_label(mode)} mode preview"}
                >
                  <div class="flex w-16 shrink-0 flex-col gap-1 border-r border-edge bg-base-200 p-1.5 text-[10px] sm:w-20">
                    <span class="truncate font-semibold">{@branding.app_name}</span>
                    <span class="truncate rounded bg-primary px-1 py-0.5 text-primary-content">
                      # general
                    </span>
                    <span class="truncate px-1 text-base-content"># design</span>
                    <span class="flex items-center gap-1 px-1 text-base-content">
                      <span class="size-1.5 shrink-0 rounded-full bg-success"></span>
                      <span class="truncate">Ana</span>
                    </span>
                  </div>
                  <div class="flex min-w-0 flex-1 flex-col gap-2 p-2">
                    <div class="flex items-start gap-1.5">
                      <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-accent text-[9px] font-bold text-accent-content">
                        A
                      </span>
                      <div class="min-w-0 text-[11px] leading-snug">
                        <span class="font-semibold">Ana</span>
                        <p>
                          Draft is up, <span class="text-interactive underline">see the doc</span>.
                        </p>
                      </div>
                    </div>
                    <input
                      type="text"
                      readonly
                      tabindex="-1"
                      value="Reply in #general"
                      aria-label={"#{mode_label(mode)} preview message field"}
                      class="input input-xs w-full min-w-0 ring-2 ring-focus-ring"
                    />
                    <div>
                      <.button variant="primary" class="btn btn-primary btn-xs" tabindex="-1">
                        Send
                      </.button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2" data-role="color-checks">
              <div
                :for={mode <- modes()}
                class={[@colors_preview_mode != mode && "hidden lg:block", "min-w-0"]}
                data-role={"color-checks-#{mode}"}
              >
                <h3 class="text-xs font-medium text-base-content">
                  {mode_label(mode)} checks
                </h3>
                <ul class="mt-1 flex flex-col gap-1.5">
                  <li
                    :for={check <- @colors_checks[mode]}
                    class="text-sm"
                    data-role="color-check"
                    data-level={check.level}
                    data-check={check.id}
                  >
                    <div class="flex items-center gap-2">
                      <span class="min-w-0 flex-1">{check_label(check.id)}</span>
                      <span class="font-mono text-xs text-subtle">
                        {format_ratio(check.ratio)}
                      </span>
                      <.chip tone={level_tone(check.level)}>{level_word(check.level)}</.chip>
                    </div>
                    <p :if={check.level != :pass} class="text-xs text-subtle">
                      {check.message}
                    </p>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <%!-- ── Derived preview ─────────────────────────────────────── --%>
      <section class="rounded-lg border border-edge bg-base-200 p-4" data-role="branding-preview">
        <h2 class="text-base font-semibold text-base-content">What gets served</h2>
        <p class="mt-1 text-sm text-subtle">
          Rendered at the sizes the OS actually uses. The maskable tile is shown inside a
          circular mask because a circle is the crop most Android launchers apply — if the
          mark loses an edge here, it loses it on the home screen.
        </p>

        <div class="mt-4 flex flex-wrap items-end gap-6">
          <figure class="flex flex-col items-center gap-2">
            <img
              src={@icons.icon_192}
              alt="Home-screen icon at 192 pixels"
              width="192"
              height="192"
              class="h-24 w-24 rounded-lg border border-edge sm:h-48 sm:w-48"
              data-role="branding-preview-192"
            />
            <figcaption class="text-xs text-subtle">192 · any</figcaption>
          </figure>

          <figure class="flex flex-col items-center gap-2">
            <img
              src={@icons.icon_512_maskable}
              alt="Maskable icon shown inside the circular launcher crop"
              width="512"
              height="512"
              class="h-24 w-24 rounded-full border border-edge sm:h-48 sm:w-48"
              data-role="branding-preview-maskable"
            />
            <figcaption class="text-xs text-subtle">
              512 · maskable (circle crop)
            </figcaption>
          </figure>

          <figure class="flex flex-col items-center gap-2">
            <img
              src={@icons.favicon_32}
              alt="Favicon at 32 pixels"
              width="32"
              height="32"
              class="h-8 w-8 border border-edge"
              data-role="branding-preview-favicon"
            />
            <figcaption class="text-xs text-subtle">32 · favicon</figcaption>
          </figure>
        </div>

        <p :if={is_nil(@branding.version)} class="mt-4 text-xs text-subtle">
          No upload yet — these are the icons that ship with the app.
        </p>
      </section>
    </div>
  </div>
</div>
