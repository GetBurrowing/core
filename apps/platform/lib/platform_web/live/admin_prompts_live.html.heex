<div class="flex h-full min-h-0 flex-col">
  <.breadcrumb segments={
    cond do
      @missing_key ->
        [
          %{label: "Admin", navigate: ~p"/admin"},
          %{label: "Prompts", navigate: ~p"/admin/prompts"},
          %{label: @missing_key.slug, navigate: nil}
        ]

      @selected_template ->
        [
          %{label: "Admin", navigate: ~p"/admin"},
          %{label: "Prompts", navigate: ~p"/admin/prompts"},
          %{label: @selected_template.slug, navigate: nil}
        ]

      true ->
        [
          %{label: "Admin", navigate: ~p"/admin"},
          %{label: "Prompts", navigate: nil}
        ]
    end
  } />
  <%!-- Header --%>
  <div class="flex items-center justify-between border-b border-edge px-4 py-3">
    <div class="flex items-center gap-3">
      <%= if @selected_template || @missing_key do %>
        <button
          phx-click="back_to_index"
          class="btn btn-ghost btn-xs btn-square"
          title="Back to all prompts"
        >
          <span class="hero-arrow-left size-4"></span>
        </button>
        <h1 class="text-sm font-semibold uppercase tracking-widest text-base-content">
          Admin · Prompts · {(@selected_template && @selected_template.slug) || @missing_key.slug}
        </h1>
      <% else %>
        <h1 class="text-sm font-semibold uppercase tracking-widest text-base-content">
          Admin · Prompts
        </h1>
        <span class="badge badge-ghost badge-sm">{length(@templates)}</span>
      <% end %>
    </div>
    <div class="flex items-center gap-2">
      <span :if={@save_status == :saved} class="text-xs text-success">Saved ✓</span>
    </div>
  </div>

  <%!-- INDEX VIEW --%>
  <%= if is_nil(@selected_template) && is_nil(@missing_key) do %>
    <div class="flex-1 overflow-y-auto p-4 clears-tab-bar">
      <div
        :if={@rows == []}
        class="flex items-center justify-center h-full text-subtle"
      >
        No prompt templates found. Run migrations to seed defaults.
      </div>

      <div :if={@rows != []} class="overflow-x-auto">
        <table class="table table-sm w-full">
          <thead>
            <tr>
              <th class="text-xs uppercase tracking-wider text-base-content">Slug</th>
              <th class="text-xs uppercase tracking-wider text-base-content">Name</th>
              <th class="text-xs uppercase tracking-wider text-base-content hidden md:table-cell">
                Description
              </th>
              <th class="text-xs uppercase tracking-wider text-base-content hidden sm:table-cell">
                Updated
              </th>
              <th class="text-xs uppercase tracking-wider text-base-content hidden sm:table-cell">
                By
              </th>
            </tr>
          </thead>
          <tbody>
            <%!-- The union: templates that exist and responsibility slugs that
                  are declared, sorted TOGETHER on slug. The marked row is not
                  hoisted and there is no banner or badge above this table —
                  see the moduledoc. A banner can be read past; a row is the
                  list. --%>
            <%= for row <- @rows do %>
              <tr
                :if={row.kind == :template}
                phx-click="select_template"
                phx-value-slug={row.slug}
                class="cursor-pointer hover:bg-base-200 transition-colors"
              >
                <td class="font-mono text-xs text-primary">{row.template.slug}</td>
                <td class="text-sm font-medium">{row.template.name}</td>
                <td class="text-xs text-subtle hidden md:table-cell max-w-xs">
                  <span class="line-clamp-1">{row.template.description || "—"}</span>
                </td>
                <td class="text-xs text-subtle hidden sm:table-cell whitespace-nowrap">
                  {relative_time(row.template.updated_at)}
                </td>
                <td class="text-xs text-subtle hidden sm:table-cell">
                  {row.template.updated_by || "—"}
                </td>
              </tr>

              <%!-- A declared key with no template. Ground is base-200 so it
                    reads as a member of this list rather than an alert
                    dropped into it; the name is at the SAME size and weight a
                    real template's name gets, because visual weight tracks
                    consequence, not existence. The slug is mono like every
                    other slug but NOT text-primary: primary is the action
                    colour here and this row is a statement. --%>
              <tr
                :if={row.kind == :missing}
                data-role="declared-missing-row"
                data-slug={row.slug}
                phx-click="select_template"
                phx-value-slug={row.slug}
                class="cursor-pointer bg-base-200 hover:bg-base-300 transition-colors"
              >
                <td class="font-mono text-xs text-base-content">{row.slug}</td>
                <td class="text-sm font-medium">
                  <div class="flex items-center gap-2">
                    <span>{row.slug}</span>
                    <span
                      data-role="declared-missing-marker"
                      class="badge badge-sm bg-warning text-warning-content border-0 font-mono"
                      title="Declared by a responsibility, with no prompt template"
                    >
                      !
                    </span>
                  </div>
                  <div
                    data-role="declared-missing-utility"
                    class="mt-0.5 text-xs text-base-content/70"
                  >
                    declared by {row.entry.trigger_kind || "responsibility"} {row.entry.key} · no template · dispatches render empty
                  </div>
                </td>
                <td class="text-xs text-base-content/70 hidden md:table-cell max-w-xs">
                  <span class="line-clamp-1">No template carries this slug.</span>
                </td>
                <td class="text-xs text-subtle hidden sm:table-cell whitespace-nowrap">
                  —
                </td>
                <td class="text-xs text-subtle hidden sm:table-cell">—</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <%!-- EDIT VIEW --%>
  <%= if @selected_template && @edit_form do %>
    <div class="flex flex-1 min-h-0 overflow-hidden">
      <%!-- Editor area --%>
      <div class="flex flex-1 min-w-0 flex-col overflow-y-auto p-4 gap-6 clears-tab-bar">
        <%!-- THE NOTICE (task 019fe6ba, ADR-0048). Rendered in the info slot,
              matching the running-experiment lifecycle colour so the badge on
              the experiments page and this banner read as the same fact in two
              places.

              There is no dismiss control, deliberately: the state in which
              someone dismisses this is exactly the state in which believing
              an edit reached the experiment does damage. It names the
              experiment rather than merely asserting one exists, because
              "this template has a running experiment" is a fact and
              "planner-terser-briefs is running on this template" is
              something the reader can act on. --%>
        <div
          :if={@running_experiment}
          data-role="experiment-snapshot-notice"
          class="alert alert-info text-sm items-start shrink-0"
        >
          <div class="space-y-1">
            <p class="font-semibold">
              Editing this template does not affect
              <.link
                navigate={~p"/control/experiments/#{@running_experiment.slug}"}
                class="link"
                data-role="experiment-snapshot-notice-link"
              >
                {@running_experiment.name}
              </.link>
              , which is running on it.
            </p>
            <p>
              That experiment compares against a copy of this prompt taken when it was
              activated, not against this row. Saving here changes what future dispatches
              render; it changes nothing the experiment has measured or will measure.
            </p>
          </div>
        </div>

        <%!-- Variant selector + diff. Shown only while an experiment is
              running, because outside one there is no snapshot to diff
              against and a selector over a single option is furniture. --%>
        <div
          :if={@running_experiment && @experiment_variants != []}
          data-role="variant-editor"
          class="space-y-3 shrink-0"
        >
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-medium uppercase tracking-wider text-base-content">
              Variant
            </span>
            <button
              :for={variant <- @experiment_variants}
              type="button"
              phx-click="select_variant"
              phx-value-variant={variant.slug}
              data-role="variant-option"
              data-variant={variant.slug}
              data-selected={to_string(@selected_variant == variant.slug)}
              class={[
                "btn btn-xs",
                if(@selected_variant == variant.slug, do: "btn-primary", else: "btn-outline")
              ]}
            >
              {variant.slug}
            </button>
          </div>

          <div class="rounded-lg border border-edge bg-base-200 p-3 space-y-2">
            <p class="text-xs text-subtle">
              Diff against the control snapshot taken at activation — not against the row
              being edited above.
            </p>

            <%!-- The empty diff says so in words. A blank panel cannot be told
                  apart from a diff that failed to render, and this is the
                  state an author sees first. --%>
            <p
              :if={@variant_diff == []}
              data-role="variant-diff-empty"
              class="text-xs text-base-content"
            >
              Identical to the control snapshot — no differences.
            </p>

            <pre
              :if={@variant_diff not in [nil, []]}
              data-role="variant-diff"
              class="text-xs font-mono whitespace-pre-wrap max-h-64 overflow-y-auto"
            ><span
                :for={{kind, line} <- @variant_diff}
                data-role={"variant-diff-#{kind}"}
                class={if kind == :del, do: "text-subtle", else: "text-base-content font-semibold"}
              >{if kind == :del, do: "- ", else: "+ "}{line}
</span></pre>
          </div>
        </div>

        <.form
          for={@edit_form}
          phx-change="validate_template"
          phx-submit="save_template"
          class="space-y-4"
        >
          <%!-- Name --%>
          <div>
            <label class="label label-text text-xs font-medium">Name</label>
            <input
              type="text"
              name="template[name]"
              value={@edit_form[:name].value}
              class="input input-bordered input-sm w-full"
              placeholder="Human-readable name"
            />
            <div :if={@edit_form[:name].errors != []} class="text-xs text-error mt-1">
              {hd(@edit_form[:name].errors) |> elem(0)}
            </div>
          </div>

          <%!-- Description --%>
          <div>
            <label class="label label-text text-xs font-medium">Description</label>
            <textarea
              name="template[description]"
              rows="2"
              class="textarea textarea-bordered textarea-sm w-full text-sm"
              placeholder="What this template is used for…"
            >{@edit_form[:description].value}</textarea>
          </div>

          <%!-- Content --%>
          <div>
            <label class="label label-text text-xs font-medium">
              Content
              <span class="text-subtle font-normal ml-1">
                — use {"{{variable}}"} for interpolation
              </span>
            </label>
            <textarea
              name="template[content]"
              rows="20"
              class="textarea textarea-bordered w-full font-mono text-xs leading-relaxed"
              placeholder="Prompt content with {{variable}} placeholders…"
              style="resize: vertical;"
            >{@edit_form[:content].value}</textarea>
            <div :if={@edit_form[:content].errors != []} class="text-xs text-error mt-1">
              {hd(@edit_form[:content].errors) |> elem(0)}
            </div>
          </div>

          <%!-- Actions --%>
          <div class="flex items-center gap-3 pt-2">
            <button type="submit" class="btn btn-primary btn-sm">
              Save
            </button>
            <button
              type="button"
              phx-click="reset_template"
              class="btn btn-ghost btn-sm"
              data-confirm="Reset to hardcoded default? This will overwrite your changes."
            >
              Reset to Default
            </button>
          </div>
        </.form>

        <%!-- Preview section --%>
        <div :if={@preview_content} class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-base-content">
              Preview
            </span>
            <span class="text-[10px] text-subtle">(with sample data)</span>
          </div>
          <div class="rounded-lg border border-edge bg-base-200 p-4">
            <pre class="whitespace-pre-wrap font-mono text-xs text-base-content/80 leading-relaxed">{@preview_content}</pre>
          </div>
        </div>
      </div>

      <%!-- Variables reference sidebar --%>
      <aside class="hidden lg:flex w-64 shrink-0 flex-col border-l border-edge bg-base-100 overflow-y-auto p-4 gap-3">
        <div class="text-xs font-semibold uppercase tracking-wider text-base-content">
          Available Variables
        </div>
        <div class="space-y-2">
          <div
            :for={var <- @selected_template.variables}
            class="rounded border border-edge bg-base-200 p-2"
          >
            <div class="font-mono text-xs text-primary">{"{{#{var}}}"}</div>
            <div class="mt-0.5 text-[11px] text-subtle">
              {Map.get(variable_descriptions(), var, "Variable")}
            </div>
          </div>
        </div>
        <div class="mt-2 text-[10px] text-subtle leading-relaxed">
          Use {"{{variable_name}}"} syntax in the content. Unknown variables are left as-is.
        </div>
      </aside>
    </div>
  <% end %>

  <%!-- DECLARED-BUT-UNBACKED PANE (task 01a0a74d stage 4).
        Deliberately NOT an editor. There is nothing to edit, and an empty
        editor is the shape that invites someone to type a body into it
        without deciding whether this key should have one — which is the open
        question this task exists to answer. --%>
  <div
    :if={@missing_key}
    data-role="declared-missing-pane"
    class="flex-1 overflow-y-auto p-4 clears-tab-bar"
  >
    <div class="max-w-xl space-y-4 rounded-lg bg-base-200 p-4">
      <div class="flex items-center gap-2">
        <span class="font-mono text-sm text-base-content">{@missing_key.slug}</span>
        <span
          class="badge badge-sm bg-warning text-warning-content border-0 font-mono"
          title="Declared by a responsibility, with no prompt template"
        >
          !
        </span>
      </div>

      <p data-role="declared-missing-explanation" class="text-sm text-base-content">
        No template carries this slug. A cron fires this responsibility, so the dispatch
        renders with an empty body and nothing errors.
      </p>

      <p class="text-xs text-base-content/70">
        Declared by {@missing_key.trigger_kind || "responsibility"} {@missing_key.key}.
      </p>

      <button
        type="button"
        phx-click="create_template_for_key"
        data-role="declared-missing-create"
        class="btn btn-sm"
      >
        Create a template for this key
      </button>
    </div>
  </div>
</div>
