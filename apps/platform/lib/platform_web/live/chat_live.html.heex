<%!-- Hidden JS-hook anchors. When embedded inside a parent surface
     (e.g. MeetingLive), the parent already mounts these hooks; mounting
     them a second time would create duplicate elements with the same id
     (LiveKit Room would double-subscribe). Suppress them in embedded
     mode and let the parent own the singletons. --%>

<%!-- `#push-subscribe` used to be the first anchor here. It moved to
     `shell.html.heex` in task 019ffb7b stage 3, where it is a singleton
     covering every surface rather than only `/chat`, so the
     `:if={!@embedded}` guard it carried is gone too — a shell-level
     element cannot collide with itself. `@push_permission` is seeded and
     maintained by `PlatformWeb.ShellLive` and still drives
     `<.notification_banner>` below. --%>

<%!-- data-camera-enabled / data-mic-enabled carry the server's committed
     media intent. On a LiveKit reconnect (task 019e4b3e stage 3) the JS
     hook reads these off the dataset to re-engage the camera/mic WITHOUT
     waiting for a fresh LV push — reconnect-safe (the operator's exact error was
     "unable to push hook event. LiveView not connected").
     data-transcriber-markers (task 01a0d4fe stage 3): the server's
     transcriber identity markers, so MeetingClient skips the worker's tile
     without a hard-coded copy of the list in JS.
     It reads @transcriber_markers_json, which
     TranscriberMarkersHook recomputes on every event and message (stage
     5): an assign-free expression is static and never re-sent. --%>
<div
  :if={!@embedded}
  id="meeting-client"
  phx-hook="MeetingClient"
  class="hidden"
  data-camera-enabled={to_string(@camera_enabled)}
  data-mic-enabled={to_string(@mic_enabled)}
  data-transcriber-markers={@transcriber_markers_json}
  data-participant-names={
    PlatformWeb.MeetingLive.participant_names_json(assigns[:meeting_participants] || [])
  }
>
</div>
<%!-- data-participant-names (task 01a1117f stage 5): see
     `MeetingLive.participant_names_json/1`. --%>
<div
  :if={!@embedded}
  id="meeting-room"
  phx-hook="MeetingRoom"
  class="hidden"
  data-participant-names={
    PlatformWeb.MeetingLive.participant_names_json(assigns[:meeting_participants] || [])
  }
>
</div>
<div :if={!@embedded} id="meeting-soundboard" phx-hook="MeetingSoundboard" class="hidden"></div>
<%!-- Canvas rooms (task 01a1316b-84fa stage 2): this LiveView answers the
     canvas_room_* events (CanvasHooks). A CanvasRoomBridge hook only talks
     to its LiveView when that LiveView renders this marker, so a frame on a
     surface without the handlers (task pages, the standalone canvas page,
     a meeting's canvas tile) runs disconnected instead of crashing it. --%>
<span hidden data-canvas-rooms></span>

<%!-- An always-rendered, box-less slot (rung 10 stage 5): whatever comes
     and goes inside it is never a new sibling ahead of a composer field's
     ancestors. LiveView's DOM patch re-appends every sibling AFTER an
     inserted node, and a moved contenteditable loses focus (it is not a
     textual input, so LiveView does not restore it). See
     `Partials.Composer.typing_indicator/1`. --%>
<div id="chat-notification-banner-slot" class="contents">
  <.notification_banner
    :if={!@embedded}
    push_permission={@push_permission}
    dismissed={@notification_banner_dismissed}
  />
</div>

<%!-- Chat root must claim the full height of <main> AND set min-h-0 so its
     descendant flex columns (chat-drop-zone, #message-list) can correctly
     shrink-to-fit. Without min-h-0, the default `min-height: auto` on flex
     items lets long message lists push past the viewport — on iOS Safari /
     PWA standalone, this manifests as the bottom-tab nav being pushed
     below the visible area while messages scroll the document itself.
     PR #333 rooted the shell chrome but the chat surface was still
     blowing the layout from the inside. --%>
<div class="flex h-full min-h-0 overflow-hidden">
  <%!-- Desktop sidebar — sectioned channel rail (chat plan v2 Stage 2).

       The `hidden lg:flex` responsive gate keeps this whole rail invisible
       on mobile; the phone's surface is the Chat list (`chat_list/1`, task
       01a1557a-8562), which replaced the drawer overlay. Same pattern as the
       icon-rail / bottom-rail split in shell.html.heex.

       Section order:
         1. Pinned   (renders only when non-empty; locked at top)
         2. DMs      (always shown; renders empty-state when no DMs)
         3. Sub-orgs (one per org, the root org included, ALWAYS
                      rendered as section headers — empty buckets get an
                      empty-state hint instead of being suppressed)

       Stage 3 will wire drag-and-drop on the `.channel-section-drag-handle`
       affordance; today it's a static `☰` glyph that fades in on hover. --%>
  <%!-- rbac-external-users M5: the chrome-less external space rail — markup
       lives in `ChatLive.Partials.ExternalRail.external_rail/1` (task 01a0312e
       stage 2). Rendered INSTEAD of the internal `#chat-sidebar` below; the
       `:if={@external?}` gate moved inside the component with it. --%>
  <.external_rail
    external?={@external?}
    external_user={@external_user}
    channels={@channels}
    dm_conversations={@dm_conversations}
    active_space={@active_space}
    unread_counts={@unread_counts}
    user_id={@user_id}
    sidebar_sections={@sidebar_sections}
    mask_names?={@mask_names?}
    revealed_section_ids={@revealed_section_ids}
  />

  <%!-- The internal desktop channel rail — markup lives in
       `ChatLive.Partials.Rail.rail/1` (task 01a0312e stage 3). The
       `:if={!@embedded and !@external?}` gate moved inside the component with
       it, so this call states no render condition of its own. --%>
  <.rail
    restricted_channel_ids={@restricted_channel_ids}
    embedded={@embedded}
    external?={@external?}
    sidebar_edit={@sidebar_edit}
    sidebar_admin_edit={@sidebar_admin_edit}
    sidebar_menu_open={@sidebar_menu_open}
    root_admin?={@root_admin?}
    mask_names?={@mask_names?}
    revealed_section_ids={@revealed_section_ids}
    sidebar_sections={@sidebar_sections}
    channel_sections={@channel_sections}
    pinned_task_spaces={@pinned_task_spaces}
    agents_block={@agents_block}
    channels={@channels}
    dm_conversations={@dm_conversations}
    archived_channels={@archived_channels}
    archived_open={@archived_open}
    active_space={@active_space}
    unread_counts={@unread_counts}
    user_id={@user_id}
    scope_filter={@scope_filter}
    tenant_org_ids={@tenant_org_ids}
    lifecycle_menu_key={@lifecycle_menu_key}
    hidden_drawer_open={@hidden_drawer_open}
    undo_toast={@undo_toast}
    move_toast={@move_toast}
  />

  <%!-- External mobile channel switcher (task 019f9257-a83e) — markup lives in
       `ChatLive.Partials.ExternalRail.external_mobile_switcher/1` (task
       01a0312e stage 2). The `@external? and !@embedded and ...` gate moved
       INSIDE the component with it. --%>
  <.external_mobile_switcher
    external?={@external?}
    embedded={@embedded}
    external_user={@external_user}
    channels={@channels}
    dm_conversations={@dm_conversations}
    active_space={@active_space}
    unread_counts={@unread_counts}
    user_id={@user_id}
    drawer_query={@drawer_query}
    sidebar_sections={@sidebar_sections}
    mask_names?={@mask_names?}
    revealed_section_ids={@revealed_section_ids}
  />

  <%!-- The phone Chat tab: the conversation list at /chat (task 01a1557a-8562
       stage 2). Markup and its gate (`:index`, not embedded, not external)
       live in `ChatLive.Partials.ChatList.chat_list/1`; it is `lg:hidden`. --%>
  <%!-- `:if` short-circuits attribute evaluation, which is what keeps the
       embedded surfaces alive: `ChatLive.Embedded` has no `@push_permission`
       (ShellLive's on_mount seeds it on routed mounts only). --%>
  <.chat_list
    :if={!@embedded}
    live_action={@live_action}
    embedded={@embedded}
    external?={@external?}
    mask_names?={@mask_names?}
    revealed_section_ids={@revealed_section_ids}
    sidebar_sections={@sidebar_sections}
    channel_sections={@channel_sections}
    pinned_task_spaces={@pinned_task_spaces}
    agents_block={@agents_block}
    channels={@channels}
    dm_conversations={@dm_conversations}
    archived_channels={@archived_channels}
    archived_open={@archived_open}
    restricted_channel_ids={@restricted_channel_ids}
    unread_counts={@unread_counts}
    list_excerpts={@list_excerpts}
    list_identities={@list_identities}
    list_collapsed={@list_collapsed}
    list_order_hold={@list_order_hold}
    push_permission={@push_permission}
    notification_banner_dismissed={@notification_banner_dismissed}
    list_sheet={@list_sheet}
    list_search_query={@list_search_query}
    list_search_results={@list_search_results}
  />

  <%!-- Desktop still lands in a channel from /chat: this reports which side
       of `lg` the viewport is on, and `handle_event("chat_viewport", ...)`
       patches into the first channel when it is not below it. --%>
  <div
    :if={!@embedded and @live_action == :index}
    id="chat-viewport-breakpoint"
    phx-hook="ViewportBreakpoint"
    data-breakpoint="1024"
    data-event="chat_viewport"
    class="hidden"
  >
  </div>

  <%!-- At /chat a phone sees only the list: the conversation column is
       `max-lg:hidden` there (the stage text's `hidden lg:flex`, written as
       one variant so the column's own `flex` keeps its literal class string
       on every other route; chat_live_test.exs pins that string). Desktop is
       unchanged. --%>
  <div class={
    if(!@embedded and !@external? and @live_action == :index,
      do: "flex flex-1 overflow-hidden min-w-0 min-h-0 max-lg:hidden",
      else: "flex flex-1 overflow-hidden min-w-0 min-h-0"
    )
  }>
    <div
      id="chat-drop-zone"
      phx-hook="DragDropUpload"
      class="flex flex-1 flex-col overflow-hidden min-w-0 min-h-0"
    >
      <.space_header
        active_space={@active_space}
        embedded={@embedded}
        external?={@external?}
        space_participants={@space_participants}
        user_id={@user_id}
        space_sheet={@space_sheet}
        agent_status={@agent_status}
        mask_names?={@mask_names?}
        revealed_section_ids={@revealed_section_ids}
        sidebar_sections={@sidebar_sections}
        active_space_scope={@active_space_scope}
        active_space_org={@active_space_org}
        scope_filter={@scope_filter}
        meetings_enabled={@meetings_enabled}
        in_meeting={@in_meeting}
        search_form={@search_form}
        search_query={@search_query}
        canvases={@canvases}
        show_canvases={@show_canvases}
        pins={@pins}
        show_pins={@show_pins}
        agent_presence={@agent_presence}
        has_agent_participant={@has_agent_participant}
        active_agent_participant_id={@active_agent_participant_id}
        active_agent_armable_id={@active_agent_armable_id}
        active_agent_name={@active_agent_name}
        active_agent_armable_name={@active_agent_armable_name}
        goal_panel={@goal_panel}
        goal_edit={@goal_edit}
        can_edit_goal?={@can_edit_goal?}
        goal_invite?={@goal_invite?}
        goal_scope_options={@goal_scope_options}
        goal_scope_error={@goal_scope_error}
        goal_cadence_form={@goal_cadence_form}
        goal_time_zone={@goal_time_zone}
      />

      <%!-- The three drawers open and close (and the pins drawer appears
           when someone pins while it is shown) inside one always-rendered,
           box-less slot, so they are never new siblings ahead of #chat-dock
           (rung 10 stage 5; see the slot note at the top of this file). --%>
      <div id="chat-drawers-slot" class="contents">
        <.search_drawer
          search_query={@search_query}
          search_results={@search_results}
          participants_map={@participants_map}
        />

        <.pins_drawer active_space={@active_space} pins={@pins} show_pins={@show_pins} />

        <.canvases_drawer
          active_canvas={@active_canvas}
          current_participant={@current_participant}
          new_canvas_form={@new_canvas_form}
          show_canvases={@show_canvases}
          canvas_sort={@canvas_sort}
          canvas_search_query={@canvas_search_query}
          canvas_unindexed_count={@canvas_unindexed_count}
          canvas_groups={@canvas_groups}
          canvas_pinned_groups={@canvas_pinned_groups}
          canvas_parent_titles={@canvas_parent_titles}
          canvas_expanded_keys={@canvas_expanded_keys}
          canvas_explorer_collapsed={@canvas_explorer_collapsed}
          canvas_archive_count={@canvas_archive_count}
          canvas_search_focus={@canvas_search_focus}
          prototype_upload={@uploads[PrototypeUpload.upload_name()]}
          can_publish_prototype?={@can_publish_prototype?}
        />
      </div>

      <%!-- The phone space sheet (task 01a1557a-8a6d, rung 7), opened by the
           header's title button. `lg:hidden`; `SpaceSheetHooks` owns it. --%>
      <.space_sheet
        :if={@active_space && !@embedded}
        space_sheet={@space_sheet}
        active_space={@active_space}
        space_participants={@space_participants}
        user_id={@user_id}
        mask_names?={@mask_names?}
        revealed_section_ids={@revealed_section_ids}
        sidebar_sections={@sidebar_sections}
        external?={@external?}
        canvases={@canvases}
        show_canvases={@show_canvases}
        meetings_enabled={@meetings_enabled}
        in_meeting={@in_meeting}
        agent_presence={@agent_presence}
        has_agent_participant={@has_agent_participant}
        active_agent_participant_id={@active_agent_participant_id}
        active_agent_armable_id={@active_agent_armable_id}
        active_agent_name={@active_agent_name}
        search_query={@search_query}
        search_results={@search_results}
        participants_map={@participants_map}
        pins={@pins}
        space_sheet_pins={@space_sheet_pins}
        space_sheet_threads={@space_sheet_threads}
        goal_panel={@goal_panel}
        goal_edit={@goal_edit}
        can_edit_goal?={@can_edit_goal?}
        goal_invite?={@goal_invite?}
        goal_scope_options={@goal_scope_options}
        goal_scope_error={@goal_scope_error}
        goal_cadence_form={@goal_cadence_form}
        goal_time_zone={@goal_time_zone}
        active_space_scope={@active_space_scope}
        active_space_org={@active_space_org}
        scope_filter={@scope_filter}
        space_sheet_files={@space_sheet_files}
        space_sheet_links={@space_sheet_links}
      />

      <div id="inline-focus-listener" phx-hook="InlineFocus" class="hidden"></div>
      <.archived_banner
        active_space={@active_space}
        can_unarchive?={@can_unarchive?}
        can_cancel_deletion?={@can_cancel_deletion?}
      />

      <.message_scroller
        streams={@streams}
        has_more_older={@has_more_older}
        loading_older={@loading_older}
        newest_evicted?={@newest_evicted?}
        loading_newer={@loading_newer}
        anchor_message_id={@anchor_message_id}
        active_space={@active_space}
        current_participant={@current_participant}
        agent_participant_ids={@agent_participant_ids}
        agent_slots_map={@agent_slots_map}
        participants_map={@participants_map}
        quick_emojis={@quick_emojis}
        pinned_message_ids={@pinned_message_ids}
        highlighted_message_id={@highlighted_message_id}
        canvases_by_id={@canvases_by_id}
        attachments_map={@attachments_map}
        thread_previews={@thread_previews}
        expanded_threads={@expanded_threads}
        inline_thread_messages={@inline_thread_messages}
        mention_suggestions={@mention_suggestions}
        mention_source={@mention_source}
        mention_query={@mention_query}
        editing_message_id={@editing_message_id}
        rendered_message_ids={@rendered_message_ids}
        refused_summons={@refused_summons}
        mounted_inline_canvas_ids={@mounted_inline_canvas_ids}
        load_older_failed?={@load_older_failed?}
        embedded={@embedded}
        viewer_user_id={@user_id}
      />

      <%!-- THE DOCK (task 01a15f2e stage 3; Saru's canvas 01a15f2f, node lay:
           "the conversation fills the whole screen"). One wrapper around the
           four contiguous siblings below the scroller: streaming replies, the
           jump-to-latest anchor, the typing indicator and the composer.
           `.chat-dock` is `display: contents` at EVERY width, so on desktop and
           in embedded chat these four stay flex items of #chat-drop-zone
           exactly as before (the jump anchor's sibling relationship above
           included). Only `.chat-dock--glass` below lg becomes a box: an
           absolute overlay at the bottom of #chat-drop-zone, so the timeline
           runs under the glass composer and bar instead of being cropped
           above them. The ChatDock hook writes its height to
           `--chat-dock-h` on <html> for the timeline's end padding. --%>
      <div
        id="chat-dock"
        phx-hook="ChatDock"
        class={["chat-dock", !@embedded && "chat-dock--glass"]}
      >
        <.streaming_replies
          streaming_replies={@streaming_replies}
          agent_slots_map={@agent_slots_map}
          participants_map={@participants_map}
        />

        <%!-- Jump-to-latest control (task 01a03c76 stage 3; made a mobile
             overlay by task 01a0419a stage 2; made an overlay at EVERY WIDTH
             by task 01a0419a v3 stage 1, per design canvas revision 37).

             This is a floating overlay at all viewport widths. The two
             wrappers below are unconditional boxes — there is no breakpoint
             and no `display: contents` state any more, and there is no
             in-flow chip at any width. `.chat-jump-anchor` is a
             zero-height positioned box and `.chat-jump-anchor-row` is an
             absolutely-positioned full-width centring row sitting 8px above
             the composer (above the typing indicator when one is showing,
             because the anchor sits ahead of it in the flow). Zero height
             means ZERO LAYOUT SHIFT: the composer does not move when the
             control appears, and the message pane keeps its full height,
             which is worth one extra visible message.

             There is no bar, strip or full-width background behind it. The
             centring row is transparent and `pointer-events: none`, so the
             only thing that takes a tap is the control itself; the message
             text either side of it stays clickable.

             DESKTOP now gets the same overlay. The `self-start ml-5 mb-1`
             gutter classes that positioned the old in-flow chip are GONE from
             the button: the promoted `margin: 0` overrides them at every
             width, so leaving them would describe a layout this file no
             longer has. Centring is PANE-RELATIVE, not viewport-relative —
             `.chat-jump-anchor` is an in-flow block inside the chat column,
             so it is the row's containing block and `left: 0; right: 0` track
             the message pane in both sidebar states.

             Because it now floats, REACHABILITY IS EMPIRICAL, NOT STRUCTURAL.
             The old in-flow row made "nothing clipped or unreachable at 390px"
             true by construction; an overlay gives that guarantee up as the
             accepted cost of zero layout shift. Nothing in this template
             proves it any more — it is asserted by the stage-5 measurements,
             which hit-test the composer input, the send control and every
             bottom-nav tab with the control present, at 390px and at 1440x900.

             It stays in `chat_live.html.heex` rather than moving into
             `Partials.Composer` (task 01a0312e's extraction): the desktop
             path still depends on being a SIBLING of the scroller and the
             composer, so pushing it inside either one is the one move that
             could silently break it.

             The `:if` is the whole visibility story: when the reader does not
             need a way back, this node LEAVES THE DOM. Not transparent, not
             zero-width, no aria-hidden shell and no exit animation — an exit
             animation needs the node to outlive its own removal, which is the
             unreachable-but-present state the acceptance criteria forbid.

             WHAT THE `:if` NOW ASKS (task 01a0419a stage 4). It is no longer
             the distance predicate alone. `MessagesHooks.jump_chip_visible?/3`
             composes the reader's position with the unread count into five
             bands, and the rule lives THERE, in one testable function, not
             spelled out in this attribute — a boolean expression inline here
             is a rule nothing can call and nothing can mutate.

             The band that matters: scrolled up a little with NOTHING new, the
             control is absent. Scrolling up to re-read three messages used to
             raise a pill nobody asked for. Deep in history it appears
             unprompted, because there the way back is worth offering.

             The count badge sits to the RIGHT of the label so its arrival
             grows the chip into empty space and the label never shifts. It is
             aria-hidden because the accessible name below already says the
             number in a sentence.

             Both strings come from `MessagesHooks` (stage 4). The cap lives
             there as a single module attribute, so the unresolved 99+ / 9+
             question resolves in one integer rather than in this template. --%>
        <%!-- The anchor still LEAVES THE DOM when hidden (above), but
             inside `#chat-jump-slot`, an always-rendered, box-less
             (`contents`) slot: so it is never a new sibling ahead of the
             typing indicator and the composer area, which the DOM patch
             would then re-append after it, blurring the focused field
             (gate case 7007, rung 10 stage 5). Layout is unchanged: a
             `contents` box generates nothing, so the anchor is still an
             in-flow item of the chat column. --%>
        <div id="chat-jump-slot" class="contents">
          <div
            :if={
              MessagesHooks.jump_chip_visible?(
                @jump_deep_in_history,
                @jump_away_from_bottom,
                @jump_new_message_count
              )
            }
            class="chat-jump-anchor"
          >
            <div class="chat-jump-anchor-row">
              <button
                type="button"
                phx-click="jump_to_latest"
                aria-label={MessagesHooks.jump_aria_label(@jump_new_message_count)}
                class="chat-jump-chip focus-visible-ring flex-shrink-0"
              >
                <%!-- The button is the 44px HIT AREA and paints nothing; this span
                   is the 28px painted pill. They are two elements on purpose, so
                   both boxes have a bounding rect and the e2e measurement can
                   assert 28-painted-inside-44-tappable without reading a
                   pseudo-element. Collapsing them back into one is the defect
                   this split exists to prevent: it looks finished either way,
                   and the only symptom is people missing the button. --%>
                <span class="chat-jump-chip-pill">
                  <span class="min-w-0 truncate">Jump to latest</span>
                  <span
                    :if={@jump_new_message_count > 0}
                    aria-hidden="true"
                    class="chat-jump-chip-count shrink-0 whitespace-nowrap"
                  >
                    {MessagesHooks.jump_count_label(@jump_new_message_count)}
                  </span>
                </span>
              </button>
            </div>
          </div>
        </div>

        <.typing_indicator
          agent_typing_pids={@agent_typing_pids}
          streaming_replies={@streaming_replies}
          participants_map={@participants_map}
        />

        <.composer
          active_space={@active_space}
          compose_form={@compose_form}
          current_participant={@current_participant}
          uploads={@uploads}
          mention_suggestions={@mention_suggestions}
          mention_source={@mention_source}
          mention_query={@mention_query}
          mask_names?={@mask_names?}
          revealed_section_ids={@revealed_section_ids}
          sidebar_sections={@sidebar_sections}
          limits={@large_upload_limits}
          large_staged={@large_upload_staged}
          attach_menu_open={@attach_menu_open}
          canvases={@canvases}
          attach_canvas={@attach_canvas_id && Map.get(@canvases_by_id, @attach_canvas_id)}
          attach_failed={@attach_failed}
        />
      </div>

      <%!-- The phone ＋ sheet (rung 11). Outside the glass dock so the fixed
           sheet stacks above the tab bar. Not when embedded: the meeting
           rail is itself a sheet, and a second sheet nested in it doubles
           its backdrop and handle. --%>
      <PlatformWeb.ChatLive.Partials.Attach.attach_sheet
        :if={!@embedded && @active_space && is_nil(@active_space.archived_at)}
        open={@attach_menu_open}
        canvases={@canvases}
      />
      <%!-- The desktop drop target (rung 11), shown by the DragDropUpload
           hook on this element. --%>
      <PlatformWeb.ChatLive.Partials.Attach.drop_target :if={
        @active_space && is_nil(@active_space.archived_at)
      } />
    </div>

    <.canvas_overlay
      canvas={@active_canvas}
      show_versions_panel={@show_versions_panel}
      canvas_versions={@canvas_versions}
      restore_confirm_revision={@restore_confirm_revision}
      viewer={{:user, @user_id}}
    />

    <%!-- Embedded surfaces (e.g. inside MeetingLive) leave the meeting
         mini-bar to the parent — the parent already owns the live
         meeting state. Skip the panel here to avoid a double mini-bar. --%>
    <.meeting_panel
      :if={!@embedded}
      in_meeting={@in_meeting}
      active_space={@active_space}
      mic_enabled={@mic_enabled}
      camera_enabled={@camera_enabled}
      screen_share_enabled={@screen_share_enabled}
      native_call={@native_call}
      mic_pending={@mic_pending}
      media_error={@media_error}
      meeting_participants={@meeting_participants}
      invite_rows={@invite_rows}
      active_meeting_tab={@active_meeting_tab}
      rail_open={@quickmeet_rail_open}
      meeting={@quickmeet_meeting}
      agents_by_id={@agents_by_id}
      agent_activity={@agent_activity}
      agent_activity_now={@agent_activity_now}
      candidates={@meeting_candidates}
      candidates_closed={@meeting_candidates_closed}
      candidate_events={@meeting_candidate_events}
      candidate_error={@candidate_error}
      candidate_order={@candidate_order}
      captions_available={@meetings_enabled}
    />
  </div>
</div>

<%!-- Standalone-only modals: settings, new-channel, new-conversation.
     The embedded surface (e.g. meeting chat panel) scopes to one space
     and has no affordances to open these, so the components are skipped
     to keep the embed lean. --%>
<.live_component
  :if={!@embedded}
  module={SettingsComponent}
  id="chat-settings"
  open={@show_settings}
  space={@active_space}
  current_user_id={@user_id}
/>

<%!-- Channel members panel (task 01a0fd62 stage 3). Opened by the header
     "members" button (channels only) and the refused-summon notice. --%>
<.live_component
  :if={!@embedded}
  module={MembersComponent}
  id="chat-members"
  open={@show_members}
  space={@active_space}
  current_user_id={@user_id}
/>

<%!-- New-channel creation is internal-only chrome — external users never see a
     new-channel affordance, so the modal is also gated off their surface. --%>
<.live_component
  :if={!@embedded and !@external?}
  module={NewChannelComponent}
  id="chat-new-channel"
  open={@show_new_channel_modal}
  org_options={@new_channel_org_options}
  active_org_id={@active_org_id}
  current_user_id={@user_id}
/>

<%!-- rbac-external-users M5 stage 3: the DM picker IS available to external
     users, but filtered to allowlisted-org humans (no agents). Thread the
     render-branch flag + acting user so the component can apply
     `Chat.external_dm_permitted?/3` at picker-build time. --%>
<.live_component
  :if={!@embedded}
  module={NewConversationComponent}
  id="chat-new-conversation"
  open={@show_new_conversation_modal}
  user_id={@user_id}
  external?={@external?}
/>

<%!-- The row sheet (task 019fe998; the phone Chat list's since task
     01a1557a-8562). Rendered HERE, at the template root: `.sheet` is
     `position: fixed`, and a CSS `transform` on any ancestor becomes the
     containing block for fixed descendants, which would centre the panel on
     that ancestor instead of the viewport. Same reason the guest-invite sheet
     sits at its LiveView's root. Always rendered (not `:if`-gated on the
     target) so the panel can transition in; `row_actions_target/5` returns
     nil while closed, which keeps the header empty. --%>
<%!-- The phone row sheet. A Chat list row's long-press opens it through
     `@list_sheet == {:row, id}` (task 01a1557a-8562 stage 4). The desktop
     rail's `@row_actions_space_id` drives `row_actions_dialog/1` only. The
     name is masked like the row it came from. --%>
<.row_actions_sheet
  :if={!@embedded and !@external?}
  target={
    ChatListHooks.row_sheet_space_id(@list_sheet)
    |> row_actions_target(@channels, @dm_conversations, @pinned_space_ids, @user_id)
    |> mask_row_target(assigns)
  }
/>

<%!-- Desktop rail row-actions menu (task 019ff8ba stage 1). Same assign, same
     open/close events and same resolver as the sheet above; only the chrome
     and the breakpoint differ. Rendered HERE, at the template root, for the
     reason `move_to_org_dialog/1` is: `#chat-section-list` is
     `overflow-y-auto`, so `overflow-x` computes to `auto` and clips anything
     anchored to a row on both axes.

     The resolver is called a second time rather than bound to a variable
     shared with the sheet: `:if` short-circuits attribute evaluation, and
     these assigns are absent on the embedded and external surfaces. The
     duplicate costs one `list_participants/1` per render, and only while a
     DM's menu is open.

     A DIFFERENT resolver from the sheet's, and deliberately so. The rail's
     Pinned block carries task rows and they now carry a trigger too (the designer,
     2026-08-13), so this one also looks in `@pinned_task_spaces`. The sheet
     keeps the conversation-only resolver: the phone drawer's task rows unpin
     on the row itself and never open it, and the sheet's two actions
     (`toggle_pinned`, `hide_channel`) are the wrong verbs for a task pin. --%>
<.row_actions_dialog
  :if={!@embedded and !@external?}
  root_admin?={@root_admin?}
  target={
    rail_row_actions_target(
      @row_actions_space_id,
      @channels,
      @dm_conversations,
      @pinned_task_spaces,
      @pinned_space_ids,
      @user_id
    )
  }
/>

<.reaction_picker reaction_picker_for={@reaction_picker_for} />

<PlatformWeb.Components.ChatViewer.chat_viewer viewer={@viewer} />

<%!-- Listener for scroll-to-message events from the correction header
     (task 019e0f29 Stage 6, contract Section D.4). Hidden div; the
     ChatScrollToMessage hook drives smooth scroll + brief pulse. --%>
<div id="chat-scroll-to-message-listener" phx-hook="ChatScrollToMessage" class="hidden"></div>

<%!-- Version history (task 019e0f29 Stage 6; redesign rung 9 stage 4):
     a phone sheet and a desktop popover from the one @version_history
     assign, set by clicking the `(edited)` affix on a message. --%>
<PlatformWeb.Components.ChatVersionHistory.chat_version_history version_history={@version_history} />

<.message_actions_sheet
  open_message_actions_id={@open_message_actions_id}
  open_message_actions_msg={@open_message_actions_msg}
  open_message_actions_mine={@open_message_actions_mine}
  current_participant={@current_participant}
  quick_emojis={@quick_emojis}
  agent_participant_ids={@agent_participant_ids}
  pinned_message_ids={@pinned_message_ids}
  active_space={@active_space}
/>

<.reactors_sheet open_reactors={@open_reactors} current_participant={@current_participant} />

<%!-- The 'Answering' context panel (task 01a0d8de stage 3): popover on
     desktop, bottom sheet on mobile; state in MessageContextHooks. --%>
<.message_context_overlay
  message_context={@message_context}
  mobile?={@message_context_mobile?}
/>

<%!-- Schedule-deletion confirm dialog (task 019f4eaa stage 6). Archive is
     instant + reversible with no modal; only this destructive step confirms. --%>
<.schedule_delete_modal
  resource={@delete_modal}
  retention_days={Platform.Tenancy.Lifecycle.retention_days()}
/>

<%!-- "Move to organisation…" confirmation (task 019fd76a stage 1). Rendered
     ONCE for the surface, as a top-level sibling: a dialog nested inside the
     rail's scrolling `<nav>` would be clipped by its `overflow-y-auto`. The
     confirm handler reads its ids from `@reassign_confirm` on the server, so
     this markup carries no channel or destination id of its own. --%>
<.move_to_org_picker picker={@reassign_picker} />
<.move_to_org_dialog confirm={@reassign_confirm} />

<%!-- Archive undo toast (task 019f4eaa). Archive is instant + dialog-free by
     design; this says what it took and keeps the reversal one click away.
     Top-level sibling — pinned chrome must never nest in an :if region. --%>
<.archive_undo_toast undo={@undo_archive} />

<.junk_batch_modal
  show_junk_batch_modal={@show_junk_batch_modal}
  junk_batch_target={@junk_batch_target}
/>
