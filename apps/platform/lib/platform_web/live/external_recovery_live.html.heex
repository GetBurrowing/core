<div class="flex h-full min-h-0 flex-col">
  <%!-- Header --%>
  <div class="flex items-center justify-between border-b border-edge px-4 py-3">
    <div class="flex items-center gap-3">
      <h1 class="text-sm font-semibold uppercase tracking-widest text-base-content">
        Admin · External Logins
      </h1>
      <span class="badge badge-ghost badge-sm" data-role="queue-count">{length(@queue)}</span>
      <span
        :if={@new_count > 0}
        class="badge badge-primary badge-sm gap-1"
        data-role="new-login-badge"
      >
        <span class="hero-bell-alert size-3"></span>
        {@new_count} new
      </span>
    </div>
  </div>

  <%!-- Queue --%>
  <div class="flex-1 min-h-0 overflow-y-auto p-4 clears-tab-bar">
    <div
      :if={@queue == [] and @provisioned == []}
      class="flex h-full flex-col items-center justify-center gap-2 text-subtle"
      data-role="empty-queue"
    >
      <span class="hero-check-circle size-8"></span>
      <p class="text-sm">No external logins are awaiting setup.</p>
    </div>

    <div :if={@queue != []} class="mx-auto max-w-4xl space-y-3">
      <div
        :for={row <- @queue}
        data-role="queue-row"
        data-user-id={row.user_id}
        class="rounded-lg border border-edge bg-base-200 p-4"
      >
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="hero-user-circle size-5 text-subtle"></span>
              <span class="text-sm font-medium text-base-content truncate">
                {display_name(row.user)}
              </span>
              <span :if={row.reason} class="badge badge-ghost badge-xs">{row.reason}</span>
            </div>
            <div class="mt-1 text-xs text-subtle truncate">{row.email}</div>
            <div class="mt-0.5 text-xs text-subtle">
              Signed in {relative_time(row.last_seen_at)}
            </div>
          </div>
        </div>

        <%!-- Unmapped affordance (task 019ff7ff stage 5): this login's group
             claim named no org, so show the values it actually carried —
             an admin maps a real string instead of guessing one. A login
             recorded before group capture shows a "not recorded" note, NOT
             an empty list, which would read as "carried no groups". --%>
        <div
          :if={row.group_match == :none}
          class="mt-2 flex flex-col gap-1"
          data-role="unmapped-groups"
        >
          <span class="text-xs font-medium text-subtle">
            No mapped group matched this login
          </span>
          <div
            :if={is_list(row.group_values) and row.group_values != []}
            class="flex flex-wrap gap-1"
          >
            <span
              :for={value <- row.group_values}
              class="badge badge-ghost badge-xs font-mono"
              data-role="unmapped-group-value"
            >
              {value}
            </span>
          </div>
          <span
            :if={row.group_values == []}
            class="text-xs text-subtle"
            data-role="unmapped-groups-empty"
          >
            This login carried no group values at all.
          </span>
          <span
            :if={is_nil(row.group_values)}
            class="text-xs text-subtle"
            data-role="unmapped-groups-unknown"
          >
            Group values weren't recorded for this login, so there is nothing to map from here.
          </span>
        </div>

        <%!-- Grant form: target org + a multi-select checkbox list of
             channels (0..N) + per-org DM allowlist. Mobile-first — stacks
             vertically so it stays usable at 375px. Submits to recover/3. --%>
        <form
          phx-submit="grant"
          data-role="grant-form"
          class="mt-3 flex flex-col gap-3 border-t border-edge pt-3"
        >
          <input type="hidden" name="user_id" value={row.user_id} />

          <%!-- Target org. The group claim only ever SUGGESTS (task 019ff7ff
               stage 4): a `:one` match pre-selects its org and says so; a
               `:none` or `:ambiguous` row leaves the placeholder selected, so
               the browser cannot silently default to the first <option> — that
               default IS the wrong-tenant grant the incidents were made of.
               `required` keeps an empty submit from posting. --%>
          <label class="flex flex-col gap-1">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-medium text-subtle">Target org</span>
              <span
                :if={row.group_match == :one and row.suggested_org_id}
                class="badge badge-ghost badge-xs gap-1"
                data-role="org-suggestion"
              >
                <span class="hero-sparkles size-3"></span> suggested from group claim
              </span>
            </div>
            <select
              name="target_org_id"
              required
              data-role="grant-org"
              class="select select-sm select-bordered bg-base-100"
            >
              <option value="" disabled selected={is_nil(row.suggested_org_id)}>
                Choose an org…
              </option>
              <option :for={org <- @orgs} value={org.id} selected={org.id == row.suggested_org_id}>
                {org.name}
              </option>
            </select>
            <span
              :if={row.group_match == :ambiguous}
              class="text-xs text-warning"
              data-role="org-ambiguous"
            >
              This login matched more than one mapped group, so no org was pre-selected. Choose one.
            </span>
          </label>

          <div class="flex flex-col gap-1">
            <span class="text-xs font-medium text-subtle">
              Channels <span class="font-normal text-subtle">· select any number</span>
            </span>
            <.channel_checkboxes id={"grant-#{row.user_id}"} spaces={@grant_spaces} />
          </div>

          <label class="flex items-center gap-2">
            <input
              type="checkbox"
              name="allow_dm"
              value="true"
              class="checkbox checkbox-sm checkbox-primary"
              data-role="grant-allow-dm"
            />
            <span class="text-xs font-medium text-subtle">Allow DMs in this org</span>
          </label>

          <button
            type="submit"
            class="btn btn-sm btn-primary gap-2 self-start"
            data-role="grant-button"
          >
            <span class="hero-check size-4"></span> Grant access
          </button>
        </form>
      </div>
    </div>

    <%!-- Add-channels surface for ALREADY-provisioned external users. They
         drop off the queue above, so they get their own section; channels
         they already belong to render checked + locked. --%>
    <div
      :if={@provisioned != []}
      class="mx-auto mt-6 max-w-4xl"
      data-role="provisioned-section"
    >
      <h2 class="mb-2 text-xs font-semibold uppercase tracking-widest text-base-content">
        Provisioned external users · add channels
      </h2>
      <div class="space-y-3">
        <div
          :for={row <- @provisioned}
          data-role="provisioned-row"
          data-user-id={row.user_id}
          class="rounded-lg border border-edge bg-base-200 p-4"
        >
          <div class="flex items-center gap-2">
            <span class="hero-user-circle size-5 text-subtle"></span>
            <span class="text-sm font-medium text-base-content truncate">
              {display_name(row.user)}
            </span>
            <span class="badge badge-ghost badge-xs">external</span>
          </div>

          <form
            phx-submit="grant"
            data-role="add-channels-form"
            class="mt-3 flex flex-col gap-3 border-t border-edge pt-3"
          >
            <input type="hidden" name="user_id" value={row.user_id} />

            <div class="flex flex-col gap-1">
              <span class="text-xs font-medium text-subtle">
                Add channels
                <span class="font-normal text-subtle">· already-joined are locked</span>
              </span>
              <.channel_checkboxes
                id={"add-#{row.user_id}"}
                spaces={@grant_spaces}
                checked_ids={row.member_space_ids}
                disabled_ids={row.member_space_ids}
              />
            </div>

            <button
              type="submit"
              class="btn btn-sm btn-primary gap-2 self-start"
              data-role="add-channels-button"
            >
              <span class="hero-plus size-4"></span> Add channels
            </button>
          </form>
        </div>
      </div>
    </div>

    <%!-- Group-claim mapping editor (task 019ff7ff stage 5). Maps an IdP
         group value to an org so a FUTURE holding login pre-selects it.
         Nothing here grants anything — no membership is written, and
         existing holding users are unaffected until an admin grants them.
         Mobile-first: the form stacks vertically and stays usable at
         375px, matching the grant forms above. --%>
    <div class="mx-auto mt-6 max-w-4xl" data-role="group-mapping-section">
      <h2 class="mb-2 text-xs font-semibold uppercase tracking-widest text-base-content">
        Group claim → org mapping
      </h2>
      <p class="mb-3 text-xs text-subtle">
        A mapping only pre-selects an org for logins that arrive after it is added. It grants nothing.
      </p>

      <div class="rounded-lg border border-edge bg-base-200 p-4">
        <p
          :if={@group_claims == []}
          class="text-xs text-subtle"
          data-role="group-mapping-empty"
        >
          No group values are mapped yet.
        </p>

        <div :if={@group_claims != []} class="flex flex-col gap-2">
          <div
            :for={claim <- @group_claims}
            data-role="group-mapping-row"
            data-claim-id={claim.id}
            class="flex flex-wrap items-center gap-2 rounded-md border border-edge bg-base-100 px-3 py-2"
          >
            <span class="font-mono text-xs text-base-content" data-role="group-mapping-value">
              {claim.claim_value}
            </span>
            <span class="hero-arrow-right size-3 text-subtle"></span>
            <span class="text-sm text-base-content" data-role="group-mapping-org">
              {claim.org && claim.org.name}
            </span>
            <button
              type="button"
              phx-click="delete_group_mapping"
              phx-value-id={claim.id}
              data-role="group-mapping-delete"
              aria-label={"Remove the mapping for #{claim.claim_value}"}
              class="btn btn-ghost btn-xs ml-auto gap-1"
            >
              <span class="hero-trash size-4"></span> Remove
            </button>
          </div>
        </div>

        <form
          phx-submit="add_group_mapping"
          data-role="group-mapping-form"
          class="mt-3 flex flex-col gap-3 border-t border-edge pt-3"
        >
          <label class="flex flex-col gap-1">
            <span class="text-xs font-medium text-subtle">Group claim value</span>
            <input
              type="text"
              name="claim_value"
              autocomplete="off"
              placeholder="e.g. clients-northwind"
              data-role="group-mapping-input"
              class="input input-sm input-bordered bg-base-100"
            />
          </label>

          <label class="flex flex-col gap-1">
            <span class="text-xs font-medium text-subtle">Org</span>
            <select
              name="org_id"
              data-role="group-mapping-org-select"
              class="select select-sm select-bordered bg-base-100"
            >
              <option value="" disabled selected>Choose an org…</option>
              <option :for={org <- @orgs} value={org.id}>{org.name}</option>
            </select>
          </label>

          <button
            type="submit"
            class="btn btn-sm btn-primary gap-2 self-start"
            data-role="group-mapping-submit"
          >
            <span class="hero-plus size-4"></span> Add mapping
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
