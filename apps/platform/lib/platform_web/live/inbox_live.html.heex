<div class="relative flex h-full min-h-0">
  <%!-- Two panes at lg and up (task 01a15ee1 stage 4): the list as a 380px
       column, the detail beside it. Below lg one pane at a time: /inbox is
       the list, /inbox/briefing/:date the detail with a back link. The pinned
       chrome below is position: fixed, so this flex row does not lay it out. --%>
  <div
    class={[
      "h-full min-w-0 flex-1 overflow-y-auto lg:w-95 lg:flex-none lg:border-r lg:border-edge lg:bg-base-100",
      @live_action == :briefing && "max-lg:hidden"
    ]}
    data-role="inbox-surface"
  >
    <div class="mx-auto max-w-3xl p-6">
      <header class="mb-6 flex items-start justify-between gap-4">
        <div class="min-w-0">
          <h1 class="text-2xl font-bold text-base-content">Inbox</h1>
          <p class="mt-1 text-sm text-base-content/60">
            Everything waiting on you across Burrow. Tick rows and clear them in one go, or open an item to jump to it.
          </p>
        </div>
        <%!-- The pile-up escape hatch. Act-then-confirm, so there is NO pre-action
             modal: the count is named on the button itself and the undo lives in
             the toast that follows. `--color-error` is spent here and only here —
             this is the destructive action; the toast reports a success and stays
             on plain surface + border. Hidden entirely at zero, so an empty inbox
             offers nothing to clear. --%>
        <button
          :if={
            clearable_count(@review_count, @mention_count, @meeting_count, @briefing_count) > 0
          }
          type="button"
          phx-click="clear_all"
          data-role="clear-all"
          class="btn btn-ghost btn-sm focus-visible-ring shrink-0 text-error hover:bg-error/10"
        >
          Clear all ({clearable_count(
            @review_count,
            @mention_count,
            @meeting_count,
            @briefing_count
          )})
        </button>
      </header>

      <%!-- Filter chips (task 01a15ee1 stage 4). The filter is in the URL as
           ?f=, so a reload or a shared link keeps it. --%>
      <nav aria-label="Filter the Inbox" class="-mt-2 mb-6">
        <ul class="flex flex-wrap gap-1.5" data-role="inbox-filter-chips">
          <li :for={{value, label} <- @filters}>
            <.link
              patch={"/inbox" <> filter_query(value)}
              data-role="inbox-filter-chip"
              data-filter={value}
              aria-current={if(@filter == value, do: "true")}
              class={[
                "focus-visible-ring inline-flex min-h-8 items-center rounded-full border px-3 text-sm",
                if(@filter == value,
                  do: "border-transparent bg-base-300 text-base-content",
                  else: "border-edge text-subtle lg:hover:text-base-content"
                )
              ]}
            >
              {label}
            </.link>
          </li>
        </ul>
      </nav>

      <%!-- Notification-permission state (task 019ffb7b stage 4). The rail bell
         this replaces was rejected on review: it collided with the Inbox tile,
         which is where the actual notifications live. The state belongs on the
         page those notifications land on. `@push_permission` arrives via
         ShellLive's on_mount, which this LiveView already runs; it renders
         nothing for unknown / unsupported / granted.

         `@user_agent` and `@push_auto_denied` arrive the same way and decide
         the blocked row's wording: which browser's steps to give, and whether
         to give steps at all (the browser can refuse without ever asking, and
         then site settings are not the problem).

         `@push_registration_failed` (task 019ffe52) is the third such fact:
         permission granted and the device still not stored. It is what makes
         `granted` render anything at all, and it carries WHY rather than a
         yes/no, because "nobody can fix this for you yet" and "reload and it
         may work" are different instructions. --%>
      <.notification_state_row
        push_permission={@push_permission}
        user_agent={@user_agent}
        auto_denied={@push_auto_denied}
        native_platform={@push_native_platform}
        registration_failed={@push_registration_failed}
      />

      <%!-- Empty inbox: no section headers, no rows — just the calm minimal
         state. Sections below are each gated on their own count, so when
         every count is zero only this renders. --%>
      <.empty_state
        :if={
          @review_count == 0 and @mention_count == 0 and @meeting_count == 0 and
            @briefing_count == 0
        }
        variant={:minimal}
      >
        <:body>
          <%!-- Two lines in the body slot: `:minimal` renders no title slot and
             wraps the body in a `<p>`, so the lines are block spans, not `<p>`. --%>
          <span class="block font-semibold" data-role="inbox-empty-title">
            Nothing waiting on you.
          </span>
          <span class="mt-1 block" data-role="inbox-empty-body">
            Plans to review, mentions and meetings about to start will show up here.
          </span>
        </:body>
      </.empty_state>

      <%!-- A filter with nothing to show, in an inbox that is not empty. --%>
      <p
        :if={
          @filter != "all" and
            clearable_count(@review_count, @mention_count, @meeting_count, @briefing_count) > 0 and
            filtered_count(@filter, %{
              briefing: @briefing_count,
              review: @review_count,
              mentions: @mention_count,
              meetings: @meeting_count
            }) == 0
        }
        class="py-10 text-center text-sm text-subtle"
        data-role="inbox-filter-empty"
      >
        Nothing here.
      </p>

      <div class="space-y-8">
        <%!-- The daily briefing (task 01a15ee1 stage 4): above the sections,
             newest first, one row per day. --%>
        <ul
          :if={@briefing_count > 0 and shows?(@filter, :briefing)}
          id="inbox-briefing-list"
          role="list"
          class="space-y-2"
          data-role="inbox-briefings"
        >
          <.briefing_row
            :for={row <- @briefing_rows}
            row={row}
            patch={(row.url || "/inbox") <> filter_query(@filter)}
          />
        </ul>

        <%!-- Awaiting your review --%>
        <section
          :if={@review_count > 0 and shows?(@filter, :review)}
          aria-labelledby="inbox-section-review"
          data-role="inbox-section"
          data-section="review"
        >
          <h2
            id="inbox-section-review"
            class="mb-2 text-xs font-semibold uppercase tracking-widest text-base-content/50"
          >
            Awaiting your review
          </h2>
          <ul
            id="inbox-review-list"
            role="list"
            class="space-y-2"
            phx-update="stream"
          >
            <.inbox_item
              :for={{dom_id, item} <- @streams.review_items}
              id={dom_id}
              item={item}
              selectable={true}
              selected={Map.has_key?(@selected, item.id)}
            />
          </ul>
        </section>

        <%!-- Mentions (grouped by space via per-row label + adjacency) --%>
        <section
          :if={@mention_count > 0 and shows?(@filter, :mentions)}
          aria-labelledby="inbox-section-mentions"
          data-role="inbox-section"
          data-section="mentions"
        >
          <h2
            id="inbox-section-mentions"
            class="mb-2 text-xs font-semibold uppercase tracking-widest text-base-content/50"
          >
            Mentions
          </h2>
          <ul
            id="inbox-mention-list"
            role="list"
            class="space-y-2"
            phx-update="stream"
          >
            <.inbox_item
              :for={{dom_id, item} <- @streams.mention_items}
              id={dom_id}
              item={item}
              space_label={mention_space_label(item, @mention_space_labels)}
              selectable={true}
              selected={Map.has_key?(@selected, item.id)}
            />
          </ul>
        </section>

        <%!-- Meetings --%>
        <section
          :if={@meeting_count > 0 and shows?(@filter, :meetings)}
          aria-labelledby="inbox-section-meetings"
          data-role="inbox-section"
          data-section="meetings"
        >
          <h2
            id="inbox-section-meetings"
            class="mb-2 text-xs font-semibold uppercase tracking-widest text-base-content/50"
          >
            Meetings
          </h2>
          <ul
            id="inbox-meeting-list"
            role="list"
            class="space-y-2"
            phx-update="stream"
          >
            <.inbox_item
              :for={{dom_id, item} <- @streams.meeting_items}
              id={dom_id}
              item={item}
              selectable={true}
              selected={Map.has_key?(@selected, item.id)}
            />
          </ul>
        </section>
      </div>
    </div>
  </div>

  <%!-- The detail pane. At lg and up it is always there; below lg only on
       /inbox/briefing/:date, where it is the whole screen. Stage 5 mounts the
       briefing's own component in place of the header placeholder below. --%>
  <section
    class={[
      "min-w-0 flex-1 overflow-auto bg-base-200",
      @live_action != :briefing && "max-lg:hidden"
    ]}
    data-role="inbox-detail-pane"
    aria-label="Inbox item"
  >
    <p
      :if={is_nil(@briefing_detail)}
      class="flex h-full items-center justify-center p-6 text-sm text-subtle"
      data-role="inbox-detail-empty"
    >
      Select an item
    </p>

    <div :if={@briefing_detail} class="mx-auto max-w-3xl p-6">
      <.link
        patch={"/inbox" <> filter_query(@filter)}
        class="focus-visible-ring -ml-2 mb-3 inline-flex min-h-11 items-center rounded px-2 font-semibold text-interactive lg:hidden"
        data-role="inbox-detail-back"
      >
        ‹ Inbox
      </.link>

      <div
        :if={@briefing_detail == :not_found}
        class="py-10 text-center text-sm text-subtle"
        data-role="inbox-briefing-not-found"
      >
        There's no briefing for this day.
      </div>

      <div
        :if={is_map(@briefing_detail)}
        id={"inbox-briefing-detail-#{@briefing_detail.date}"}
        data-role="inbox-briefing-detail"
        data-date={Date.to_iso8601(@briefing_detail.date)}
      >
        <%!-- Stage 5: the briefing itself. Every button goes through
             Briefings.handle/5 / undo/3 inside the component; its toast is
             the one below. --%>
        <.live_component
          module={PlatformWeb.InboxLive.BriefingComponent}
          id={"briefing-#{@briefing_detail.briefing_id}"}
          briefing_id={@briefing_detail.briefing_id}
          user_id={@current_user_id}
          today={@briefing_today}
          refresh={@briefing_refresh}
        />
      </div>
    </div>
  </section>

  <%!-- Pinned chrome: the bulk-selection bar. A direct sibling of the scroll
       region (NOT nested inside it, and NOT inside a conditional wrapper that
       morphdom re-patches) so it stays stable while rows toggle — it mounts on
       0→1 selected and unmounts on 1→0, and only its count patches in between.
       Lifted from RecoveryLive, where this placement was paid for with a real
       flicker/detach bug. --%>
  <div
    :if={@selected != %{}}
    data-role="selection-bar"
    class="fixed bottom-[calc(1.5rem+var(--bottom-nav-height))] left-1/2 z-40 -translate-x-1/2"
  >
    <div class="flex items-center gap-3 rounded-full border border-edge bg-base-100 px-4 py-2 shadow-md">
      <span
        class="text-sm font-medium tabular-nums text-base-content"
        data-role="selection-count"
      >
        {map_size(@selected)} selected
      </span>
      <.button
        variant="primary"
        phx-click="dismiss_selected"
        data-role="clear-selected"
        class="btn btn-primary btn-sm focus-visible-ring"
      >
        <.icon name="hero-check" class="size-4" /> Clear selected
      </.button>
      <%!-- "Cancel", not Recovery's "Clear": the primary action beside it is
           already called "Clear selected", and two controls a thumb apart both
           reading "Clear" is a coin flip on whether the rows survive. --%>
      <button
        type="button"
        phx-click="clear_selection"
        data-role="cancel-selection"
        class="focus-visible-ring rounded px-1 text-sm text-base-content/60 hover:text-base-content"
      >
        Cancel
      </button>
    </div>
  </div>

  <%!-- Pinned chrome: the act-then-confirm success toast, lifted from
       RecoveryLive. Server-driven show/hide (assign + nonce-guarded auto-dismiss
       timer) — no JS hook and no inline styles, so morphdom has nothing to clear
       on patch. A sibling of the scroll region for the same reason as the bar
       above it.

       Bottom-RIGHT while the selection bar is bottom-centre, so the two never
       overlap even though a sweep can raise the toast as the bar unmounts.

       Surface + border only. This reports a success, so it must NOT wear the
       destructive slot the button that raised it wears. --%>
  <%!-- The open-undo variant (task 01a11703 stage 3): one line, title first and
       truncated, a no-wrap text Undo with a 44px tap target, no X — it times
       out. Full-width inset below sm so a long title still leaves Undo room at
       375px; the bulk-clear toast's right-4 max-w-sm from sm up. Same surface,
       same live region, no error tint: opening a row is not a failure. --%>
  <%!-- The briefing detail's toast (task 01a15ee1 stage 5) is this same
       one-line toast, `variant: :briefing`: 5 s instead of 8 s, paused while
       hovered or focused (the ToastPause hook pushes toast_pause /
       toast_resume), and its Undo is `Briefings.undo/3`. A Revert or Delete
       toast has no Undo: those have no inverse. It clears the tab bar AND
       the home indicator on the phone. --%>
  <div
    :if={@toast && @toast[:variant] in [:single, :briefing]}
    id="inbox-toast"
    phx-hook="ToastPause"
    data-role="inbox-toast"
    data-variant={@toast[:variant]}
    data-paused={to_string(@toast[:paused] == true)}
    role="status"
    aria-live="polite"
    class="fixed bottom-[calc(1.5rem+var(--bottom-nav-height)+env(safe-area-inset-bottom))] left-4 right-4 z-50 sm:left-auto sm:max-w-sm"
  >
    <div class="flex min-h-11 items-center gap-3 rounded-lg border border-edge bg-base-100 pl-4 pr-2 shadow-md">
      <p class="min-w-0 flex-1 truncate text-sm text-base-content" data-role="toast-message">
        {@toast.message}
      </p>
      <button
        :if={@toast[:undo?] != false}
        type="button"
        phx-click={if(@toast[:variant] == :briefing, do: "undo_briefing", else: "undo_clear")}
        data-role="toast-undo"
        class="focus-visible-ring min-h-11 shrink-0 whitespace-nowrap rounded px-2 text-sm font-medium text-base-content/70 hover:text-base-content"
      >
        Undo
      </button>
    </div>
  </div>

  <div
    :if={@toast && @toast[:variant] not in [:single, :briefing]}
    data-role="inbox-toast"
    role="status"
    aria-live="polite"
    class="fixed bottom-[calc(1.5rem+var(--bottom-nav-height))] right-4 z-50 max-w-sm"
  >
    <div class="flex items-start gap-3 rounded-lg border border-edge bg-base-100 px-4 py-3 shadow-md">
      <div class="min-w-0 flex-1">
        <p class="text-sm text-base-content" data-role="toast-message">{@toast.message}</p>
        <div class="mt-2">
          <button
            type="button"
            phx-click="undo_clear"
            data-role="toast-undo"
            class="focus-visible-ring rounded text-xs font-medium text-base-content/70 hover:text-base-content"
          >
            Undo
          </button>
        </div>
      </div>
      <button
        type="button"
        phx-click="dismiss_toast"
        aria-label="Dismiss"
        class="focus-visible-ring shrink-0 rounded"
      >
        <.icon name="hero-x-mark" class="size-4 opacity-40 hover:opacity-70" />
      </button>
    </div>
  </div>
</div>
