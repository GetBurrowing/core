<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{@game["title"]} · Burrow</title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
  </head>
  <body class="min-h-screen bg-base-300 text-base-content">
    <header class="navbar mx-auto max-w-5xl px-6 py-5">
      <a href={"/games/#{@game["slug"]}"} class="text-2xl font-bold tracking-tight">burrow <span class="text-primary">play</span></a>
      <div class="ml-auto text-sm opacity-70">{if @user, do: "Signed in as #{@user.name || @user.email}", else: "Come play."}</div>
    </header>
    <main class="mx-auto max-w-5xl px-6 pb-16">
      <div class="overflow-hidden rounded-3xl border border-base-content/10 bg-base-200">
        <img :if={@game["image_path"]} src={@game["image_path"]} alt={@game["image_alt"] || @game["title"]} class="max-h-96 w-full object-cover" />
        <section class="p-6 sm:p-10">
          <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">Made to be played together</p>
          <h1 class="text-5xl font-black tracking-tight">{@game["title"]}</h1>
          <p class="mt-4 max-w-2xl text-lg opacity-80">{@game["summary"]}</p>
          <p class="mt-5 text-sm opacity-70">Windows · Free · {Float.round(@release["byte_size"] / 1_048_576, 1)} MiB</p>
          <div class="mt-7">
            <a :if={!@user} id="game-sign-in" class="btn btn-primary btn-lg" href={"/games/#{@game["slug"]}/sign-in"}>Sign in to download</a>
            <a :if={@user} id="game-download" class="btn btn-primary btn-lg" href={"/games/#{@game["slug"]}/releases/#{@release["version"]}/download"}>Download for Windows</a>
          </div>
          <p class="mt-4 text-sm opacity-70">On your phone? Browse here, then open this page on your Windows PC to play.</p>
        </section>
      </div>
      <nav class="tabs tabs-border my-7" aria-label="Game page">
        <a id="game-tab" class={["tab", !@community? && "tab-active"]} aria-current={if !@community?, do: "page"} href={"/games/#{@game["slug"]}"}>Game</a>
        <a id="community-tab" class={["tab", @community? && "tab-active"]} aria-current={if @community?, do: "page"} href={"/games/#{@game["slug"]}?tab=community"}>Community</a>
      </nav>
      <section :if={!@community?} id="game-instructions" class="card bg-base-200 p-6 sm:p-8">
        <h2 class="text-2xl font-bold">From download to giant robot.</h2>
        <ol class="mt-5 list-inside list-decimal space-y-3 opacity-80"><li>Download on your Windows PC.</li><li>Extract the ZIP into a folder.</li><li>Open <strong>Play Multiplayer.bat</strong>.</li></ol>
        <p class="mt-5 opacity-80">{@game["multiplayer_note"]}</p>
        <details class="mt-7 text-sm opacity-70"><summary class="cursor-pointer">Release details</summary><p class="mt-3">Version {@release["version"]}</p><p class="mt-2 break-all">SHA-256: {@release["sha256"]}</p></details>
      </section>
      <section :if={@community?} id="game-community" class="card bg-base-200 p-6 sm:p-8">
        <h2 class="text-2xl font-bold">Meet the other pilots.</h2>
        <p class="mt-4 opacity-80">A shared place for this game’s players. Joining gives you access to this community, not the creators’ development channels.</p>
        <p :if={!@game["community_space_id"]} class="mt-5 opacity-70">The community is not open yet. You can still sign in and download the game.</p>
        <a :if={@game["community_space_id"] && !@user} id="community-sign-in" class="btn btn-primary mt-6 self-start" href={"/games/#{@game["slug"]}/sign-in"}>Sign in to join</a>
        <form :if={@game["community_space_id"] && @user} method="post" action={"/games/#{@game["slug"]}/community"} class="mt-6">
          <input type="hidden" name="_csrf_token" value={@csrf_token} />
          <button id="community-join" type="submit" class="btn btn-primary">Join the community</button>
        </form>
      </section>
      <footer class="mt-8 text-sm opacity-60">Hosted with Burrow · Game downloads currently support Windows.</footer>
    </main>
  </body>
</html>
