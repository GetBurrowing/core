<main
  id="switcher-consent-invalid"
  class="min-h-screen bg-base-200 text-base-content flex items-center justify-center px-4 py-12"
>
  <div class="w-full max-w-md rounded-2xl border border-edge bg-base-100 p-6 shadow-sm">
    <h1 class="text-lg font-semibold">This link doesn't work</h1>
    <p class="mt-3 text-sm text-subtle">
      The install that sent you here gave an address this install can't connect to. Go back and try adding it again.
    </p>
    <a
      href="/"
      class="mt-6 inline-flex items-center rounded-lg border border-edge px-4 py-2 text-sm font-medium"
    >
      Go to {Platform.Branding.app_name()}
    </a>
  </div>
</main>
