<main
  id="switcher-consent"
  class="min-h-screen bg-base-200 text-base-content flex items-center justify-center px-4 py-12"
>
  <div class="w-full max-w-md rounded-2xl border border-edge bg-base-100 p-6 shadow-sm">
    <h1 data-role="switcher-consent-title" class="text-lg font-semibold leading-snug">
      Show your unread from {@install_name} in {@origin_host}'s switcher on this browser?
    </h1>
    <p class="mt-3 text-sm text-subtle">
      {@origin_host} will get a count of your unread here, and nothing else:
    </p>
    <ul data-role="switcher-consent-points" class="mt-3 space-y-2 text-sm">
      <li class="flex gap-2">
        <span class="hero-check size-4 mt-0.5 shrink-0 text-primary" aria-hidden="true"></span>
        No messages, names or spaces
      </li>
      <li class="flex gap-2">
        <span class="hero-check size-4 mt-0.5 shrink-0 text-primary" aria-hidden="true"></span>
        It can't sign in as you or act for you
      </li>
      <li class="flex gap-2">
        <span class="hero-check size-4 mt-0.5 shrink-0 text-primary" aria-hidden="true"></span>
        Only on this browser. Turn it off any time in Manage installs
      </li>
    </ul>
    <p data-role="switcher-consent-signed-in" class="mt-4 text-xs text-subtle">
      Signed in to {@install_name} as {@user_label}
    </p>
    <form
      id="switcher-consent-form"
      action={~p"/switcher/connect"}
      method="post"
      class="mt-6 flex justify-end gap-2"
    >
      <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
      <input type="hidden" name="origin" value={@origin} />
      <a
        href={@cancel_url}
        data-role="switcher-consent-cancel"
        class="inline-flex items-center rounded-lg border border-edge px-4 py-2 text-sm font-medium text-base-content hover:bg-base-200"
      >
        Cancel
      </a>
      <button
        type="submit"
        data-role="switcher-consent-allow"
        class="inline-flex items-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-content"
      >
        Allow
      </button>
    </form>
  </div>
</main>
