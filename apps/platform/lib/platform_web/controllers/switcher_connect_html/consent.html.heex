<main
  id="switcher-consent"
  class="min-h-screen bg-base-200 text-base-content flex items-center justify-center px-4 py-12"
>
  <div class="w-full max-w-md rounded-2xl border border-edge bg-base-100 p-7 shadow-sm">
    <%!-- Stage 4: the install header the stage-1 consent frame shows (this
         install's logo tile, name and host). --%>
    <div data-role="switcher-consent-install" class="mb-5 flex items-center gap-2.5">
      <span class="relative inline-flex size-10 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-edge bg-base-300 text-sm font-extrabold">
        <img
          src="/branding/current/apple_touch"
          alt=""
          class="absolute inset-0 size-full object-cover"
        />
      </span>
      <span class="flex min-w-0 flex-col">
        <span class="truncate text-sm font-semibold">{@install_name}</span>
        <span class="truncate text-xs text-subtle">{@install_host}</span>
      </span>
    </div>
    <h1 data-role="switcher-consent-title" class="text-xl font-bold leading-snug">
      Show your unread from {@install_name} in {@origin_host}'s switcher on this browser?
    </h1>
    <p class="mt-3 text-sm text-subtle">
      {@origin_host} will get a count of your unread here, and nothing else:
    </p>
    <ul data-role="switcher-consent-points" class="mt-3 list-disc space-y-1 pl-5 text-sm">
      <li>No messages, names or spaces</li>
      <li>It can't sign in as you or act for you</li>
      <li>Only on this browser. Turn it off any time in Manage installs</li>
    </ul>
    <p
      data-role="switcher-consent-signed-in"
      class="mt-4 border-t border-edge pt-4 text-xs text-subtle"
    >
      Signed in to {@install_name} as {@user_label}
    </p>
    <form
      id="switcher-consent-form"
      action={~p"/switcher/connect"}
      method="post"
      class="mt-6 flex justify-end gap-2"
    >
      <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
      <input type="hidden" name="origin" value={@origin} />
      <a
        href={@cancel_url}
        data-role="switcher-consent-cancel"
        class="inline-flex items-center rounded-full border border-edge px-4 py-2 text-sm font-semibold text-base-content hover:bg-base-content/8"
      >
        Cancel
      </a>
      <button
        type="submit"
        data-role="switcher-consent-allow"
        class="inline-flex items-center rounded-full bg-primary px-4 py-2 text-sm font-semibold text-primary-content"
      >
        Allow
      </button>
    </form>
  </div>
</main>
