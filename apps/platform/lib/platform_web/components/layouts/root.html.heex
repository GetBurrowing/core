<%!-- The inline background is the FIRST-PAINT colour (task 01a0879a stage 8).
     An installed iOS web app cold-launches into a white web view and paints
     nothing until app.css arrives and applies; the manifest's
     background_color is not used as a launch shade. Painting the branding
     background on the root element makes the first frame dark as soon as
     the HTML is parsed, before the stylesheet. It is NOT the themed
     background: app.css overrides it with `!important` once loaded so a
     light-theme user still gets base-100. No hex literal here — the value
     is the branding row's. --%>
<% branding = Platform.Branding.get() %> <!DOCTYPE html>
<%!-- `data-theme` / `data-preset` are the signed-in person's stored theme
     (task 01a1557a stage 3), so a device with an empty cache paints the
     chosen preset in its first frame. Absent for a signed-out page, for
     "system" mode (data-theme) and for the base Burrow preset
     (data-preset); the theme-boot script below fills them in. --%>
<% theme_boot = PlatformWeb.Layouts.theme_boot(assigns) %>
<html
  lang="en"
  style={"background-color: #{branding.background_color}"}
  data-theme={theme_boot.html_theme}
  data-preset={theme_boot.html_preset}
>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <%!-- A denial page has no interactive controls. Exclude the per-response
         token so known and missing resource URLs have identical 403 bodies. --%>
    <meta :if={!assigns[:access_denied]} name="csrf-token" content={get_csrf_token()} />
    <%!-- Install identity (task 01a0879a stage 7). ONE row read per render,
         deliberately uncached: "upload, refresh, Add to Home Screen" is the
         requirement, and Safari reads `apple-touch-icon` and
         `apple-mobile-web-app-title` from THIS head at add-time — the
         manifest is Android's half, these tags are iOS's. Every identity
         value here routes through Platform.Branding; no literal name, hex
         or icon path may be reintroduced. The same rule covers the in-app
         theme colours below: they come from the row through
         Platform.Branding.ThemeCss, never a literal here. --%>
    <.live_title default={branding.app_name}>
      {assigns[:page_title]}
    </.live_title>
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={branding.app_name} />
    <link
      rel="icon"
      type="image/x-icon"
      href={Platform.Branding.icon_url(branding, :favicon_ico)}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={Platform.Branding.icon_url(branding, :favicon_32)}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={Platform.Branding.icon_url(branding, :favicon_16)}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={Platform.Branding.icon_url(branding, :apple_touch)}
    />
    <meta name="theme-color" content={branding.theme_color} />
    <meta name="vapid-public-key" content={Platform.Push.vapid_public_key()} />
    <meta
      name="webmcp-enabled"
      content={to_string(Application.get_env(:platform, :webmcp_enabled, false))}
    />
    <%!-- Reconnect escalation thresholds (task 01a12b10). Read once at boot by
         app.js; the root layout is outside the LiveView, so a changed value
         reaches the client on the next full page load. --%>
    <meta
      name="reconnect-escalation"
      data-attempts={PlatformWeb.ReconnectEscalation.config().attempts}
      data-seconds={PlatformWeb.ReconnectEscalation.config().seconds}
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!-- Install theme colours (task 01a0dbee-f598-7001-b450-7890103f44c4
         stage 2). MUST come after the app.css link: it overrides the daisyUI
         theme tokens at equal specificity, so source order is what makes it
         win. Renders nothing at all when the row stores no colours, so a
         fresh install's CSS is exactly app.css. The css is safe to raw/1
         because ThemeCss re-validates every value as #rrggbb and drops the
         rest. Read from the same uncached row as everything above: a save
         shows on the next FULL page load in every tab. LiveView live
         navigation does not re-render this root layout, so an already-open
         tab keeps its old colours until its next full load. --%>
    <% install_theme_css = Platform.Branding.ThemeCss.render(branding) %>
    <style :if={install_theme_css} id="install-theme" data-role="install-theme">
      <%= Phoenix.HTML.raw(install_theme_css) %>
    </style>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- Theme boot (task 01a1557a stage 3). Applies the person's preset and
         mode to <html> before first paint. It sits after the app.css link on
         purpose: a parser-inserted script waits for the stylesheets above it,
         so the computed `--color-base-200` it copies into theme-color is
         already the painted one.

         Resolution order: the server's stored preference (signed-in only,
         authoritative, written through to the cache), then the
         `burrow-theme-v1` localStorage cache (first-paint cache only), then
         the registry default. Every id, mode and default reaches the script
         as a data attribute rendered from Platform.Accounts.ThemePreference:
         no EEx inside the body and no hex anywhere. The server-rendered
         `branding.theme_color` meta above stays as the no-JS fallback. --%>
    <script
      data-role="theme-boot"
      data-presets={theme_boot.presets}
      data-modes={theme_boot.modes}
      data-base-preset={theme_boot.base_preset}
      data-default-preset={theme_boot.default_preset}
      data-default-mode={theme_boot.default_mode}
      data-server-preset={theme_boot.server_preset}
      data-server-mode={theme_boot.server_mode}
    >
      (() => {
        const KEY = "burrow-theme-v1";
        const root = document.documentElement;
        const config = (document.currentScript && document.currentScript.dataset) || {};
        const words = (value) => (value || "").split(" ").filter(Boolean);
        const PRESETS = words(config.presets);
        const MODES = words(config.modes);
        const BASE = config.basePreset;
        const DEFAULT = {preset: config.defaultPreset, mode: config.defaultMode};

        const normalize = (value) => {
          const pref = value && typeof value === "object" ? value : {};
          return {
            preset: PRESETS.includes(pref.preset) ? pref.preset : DEFAULT.preset,
            mode: MODES.includes(pref.mode) ? pref.mode : DEFAULT.mode
          };
        };

        const parse = (raw) => {
          try {
            return raw ? JSON.parse(raw) : null;
          } catch (_error) {
            return null;
          }
        };

        const readCache = () => {
          try {
            return parse(localStorage.getItem(KEY));
          } catch (_error) {
            return null;
          }
        };

        const writeCache = (pref) => {
          try {
            localStorage.setItem(KEY, JSON.stringify(pref));
          } catch (_error) {
            // Private mode or a full quota: the server render still paints.
          }
        };

        const scheme =
          typeof window.matchMedia === "function"
            ? window.matchMedia("(prefers-color-scheme: dark)")
            : null;

        let current = normalize(null);

        const resolvedMode = () =>
          current.mode === "system" ? (scheme && scheme.matches ? "dark" : "light") : current.mode;

        const snapshot = () => ({
          preset: current.preset,
          mode: current.mode,
          resolved: resolvedMode()
        });

        const syncThemeColor = () => {
          const meta = document.querySelector('meta[name="theme-color"]');
          const ground = getComputedStyle(root).getPropertyValue("--color-base-200").trim();
          if (!meta || !ground) return false;
          meta.setAttribute("content", ground);
          return true;
        };

        const paint = () => {
          root.setAttribute("data-theme", resolvedMode());

          if (current.preset === BASE) {
            root.removeAttribute("data-preset");
          } else {
            root.setAttribute("data-preset", current.preset);
          }

          if (!syncThemeColor()) {
            document.addEventListener("DOMContentLoaded", syncThemeColor, {once: true});
          }

          window.dispatchEvent(new CustomEvent("burrow:theme", {detail: snapshot()}));
        };

        window.burrowTheme = {
          get: snapshot,
          apply: (pref) => {
            const next = pref || {};
            current = {
              preset: PRESETS.includes(next.preset) ? next.preset : current.preset,
              mode: MODES.includes(next.mode) ? next.mode : current.mode
            };
            writeCache(current);
            paint();
            return snapshot();
          }
        };

        if (config.serverPreset || config.serverMode) {
          current = normalize({preset: config.serverPreset, mode: config.serverMode});
          writeCache(current);
        } else {
          current = normalize(readCache());
        }

        paint();

        if (scheme) {
          const onScheme = () => current.mode === "system" && paint();
          if (typeof scheme.addEventListener === "function") {
            scheme.addEventListener("change", onScheme);
          } else if (typeof scheme.addListener === "function") {
            scheme.addListener(onScheme);
          }
        }

        window.addEventListener("storage", (event) => {
          if (event.key !== KEY) return;
          current = normalize(parse(event.newValue));
          paint();
        });
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
