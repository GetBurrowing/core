<%!-- PWA app-shell scroll lock: the shell occupies exactly the visual
     viewport (100dvh — collapses correctly when the iOS URL bar shows /
     hides) and `overflow-hidden` prevents the document itself from
     scrolling. Combined with the html/body lock in app.css, the bottom-
     tab nav (rendered later in the inner flex column) is functionally
     rooted: only the inner content scroller (per-LiveView, `overflow-y-
     auto`) can scroll, so the chrome stays put on mobile. PR #331's
     pb-clearance on inner panels remains as defense-in-depth. --%>
<div
  class="flex h-[100dvh] overflow-hidden bg-base-100 safe-area-top pb-[var(--meeting-bar-height,0px)]"
  style={"--meeting-bar-height: " <> (if @meeting_active, do: "3rem", else: "0px")}
>
  <%!-- Sidebar collapse persistence hook (localStorage) --%>
  <div
    id="sidebar-collapse-hook"
    phx-hook="SidebarCollapse"
    data-collapsed={if @sidebar_collapsed, do: "true", else: "false"}
    class="hidden"
  >
  </div>
  <%!-- Desktop-only sidebar (lg+ width). Mobile users get the bottom-nav
       added in #13; the original mobile drawer is gone (task 019e0d4b
       Stage 2 cleanup — orphaned post-#13). The desktop collapse-to-icons
       mode is preserved via `:sidebar_collapsed`. --%>
  <nav
    id="shell-sidebar"
    class={[
      "hidden lg:flex flex-col gap-2 border-r border-base-300 bg-base-200 py-4 px-2 transition-all duration-200 ease-in-out",
      if(@sidebar_collapsed, do: "lg:w-14", else: "w-56")
    ]}
  >
    <%!-- Sidebar header --%>
    <div class="mb-4 flex items-center px-2">
      <span :if={!@sidebar_collapsed} class="text-lg font-bold">⚡</span>
    </div>

    <%!-- Module navigation links --%>
    <.link
      id="shell-chat-link"
      navigate="/chat"
      phx-hook="LastChatLink"
      data-default-chat-path="/chat"
      class={nav_item_class(@current_path, "/chat")}
      title="Chat"
    >
      <span class="hero-chat-bubble-left-right size-5 flex-shrink-0"></span>
      <span :if={!@sidebar_collapsed} class="text-sm font-medium">Chat</span>
    </.link>
    <.link
      navigate="/activity"
      class={nav_item_class(@current_path, "/activity")}
      title="Activity"
    >
      <span class="hero-sparkles size-5 flex-shrink-0"></span>
      <span :if={!@sidebar_collapsed} class="text-sm font-medium">Activity</span>
    </.link>
    <.link
      navigate="/tasks"
      class={nav_item_class(@current_path, "/tasks")}
      title="Tasks"
    >
      <span class="hero-rectangle-stack size-5 flex-shrink-0"></span>
      <span :if={!@sidebar_collapsed} class="text-sm font-medium">Tasks</span>
    </.link>
    <.link
      navigate="/skills"
      class={nav_item_class(@current_path, "/skills")}
      title="Skills"
    >
      <span class="hero-book-open size-5 flex-shrink-0"></span>
      <span :if={!@sidebar_collapsed} class="text-sm font-medium">Skills</span>
    </.link>
    <.link
      navigate="/changelog"
      class={nav_item_class(@current_path, "/changelog")}
      title="Changelog"
    >
      <span class="hero-newspaper size-5 flex-shrink-0"></span>
      <span :if={!@sidebar_collapsed} class="text-sm font-medium">Changelog</span>
    </.link>
    <.link
      navigate="/control"
      class={nav_item_class(@current_path, "/control")}
      title="Agent Resources"
    >
      <span class="hero-cog-6-tooth size-5 flex-shrink-0"></span>
      <span :if={!@sidebar_collapsed} class="text-sm font-medium">Agent Resources</span>
    </.link>
    <.link
      navigate="/org-context"
      class={nav_item_class(@current_path, "/org-context")}
      title="Org Context"
    >
      <span class="hero-building-library size-5 flex-shrink-0"></span>
      <span :if={!@sidebar_collapsed} class="text-sm font-medium">Org Context</span>
    </.link>
    <.link
      navigate="/control/usage"
      class={nav_item_class(@current_path, "/control/usage")}
      title="Usage"
    >
      <span class="hero-chart-bar-square size-5 flex-shrink-0"></span>
      <span :if={!@sidebar_collapsed} class="text-sm font-medium">Usage</span>
    </.link>
    <.link
      navigate="/admin/prompts"
      class={nav_item_class(@current_path, "/admin/prompts")}
      title="Admin · Prompts"
    >
      <span class="hero-wrench-screwdriver size-5 flex-shrink-0"></span>
      <span :if={!@sidebar_collapsed} class="text-sm font-medium">Admin · Prompts</span>
    </.link>
    <.link
      navigate="/admin/federation"
      class={nav_item_class(@current_path, "/admin/federation")}
      title="Admin · Federation"
    >
      <span class="hero-signal size-5 flex-shrink-0"></span>
      <span :if={!@sidebar_collapsed} class="text-sm font-medium">Admin · Federation</span>
    </.link>

    <div class="flex-1"></div>

    <%!-- Collapse toggle (desktop only) --%>
    <button
      class="hidden lg:flex items-center justify-center rounded-lg p-1 text-base-content/40 hover:bg-base-300 hover:text-base-content transition-colors"
      phx-click="toggle_sidebar"
      title={if @sidebar_collapsed, do: "Expand sidebar", else: "Collapse sidebar"}
    >
      <span class={[
        "size-5",
        if(@sidebar_collapsed, do: "hero-chevron-right", else: "hero-chevron-left")
      ]}>
      </span>
    </button>
  </nav>

  <%!-- Main content area. min-w-0 + min-h-0: this column is flex-1 inside
       a flex row (the shell root) AND a flex-col itself, so its children
       (header, main, bottom-nav) need a bounded parent. Without min-h-0
       the column inherits min-height: auto and grows to its intrinsic
       content height, which on long chat threads pushes the bottom-tab
       nav out of the visible viewport on iOS. --%>
  <div class="flex flex-1 flex-col overflow-hidden min-w-0 min-h-0">
    <%!-- Top bar --%>
    <header
      id="utility-bar"
      class="flex h-10 items-center justify-between border-b border-base-300 bg-base-200/60 px-4"
    >
      <div class="flex items-center gap-2">
        <%!-- Mobile primary nav is the bottom-nav from #13; the original
             hamburger + drawer pattern was deleted in task 019e0d4b Stage 2. --%>
        <%!-- Active module name (mobile only) --%>
        <span class="text-sm font-semibold lg:hidden">
          {@active_module}
        </span>
        <%!-- Suite name (desktop only) --%>
        <span class="hidden text-xs font-semibold uppercase tracking-widest text-base-content/50 lg:inline">
          Startup Suite
        </span>
      </div>
      <div class="flex items-center gap-2">
        <%!-- Roster presence indicator. Wrapped in <.async_result> so the
             initial assign_async load shows a spinner without blocking page
             paint. After PubSub-driven refreshes (refresh_roster/2) the
             assigns remain in %AsyncResult{ok?: true} shape, so this
             component continues to render the resolved branch. --%>
        <.async_result :let={principal_name} assign={@principal_name}>
          <:loading>
            <span
              class="loading loading-spinner loading-xs text-base-content/40"
              data-test-id="shell-roster-loading"
              title="Loading roster"
            >
            </span>
          </:loading>
          <:failed>
            <%!-- Neutral fallback so a transient DB blip doesn't blank the bar --%>
            <span
              class="inline-block size-2 rounded-full bg-base-content/20"
              data-test-id="shell-roster-failed"
              title="Roster unavailable"
            >
            </span>
          </:failed>
          <%= if principal_name do %>
            <div class="relative">
              <button
                phx-click="toggle_roster"
                class="flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium text-base-content/70 hover:bg-base-300 transition-colors"
                title="Agent roster"
                data-test-id="shell-roster-button"
              >
                <.async_result :let={composite} assign={@composite_status}>
                  <:loading>
                    <span class="loading loading-spinner loading-xs"></span>
                  </:loading>
                  <:failed>
                    <span class="inline-block size-2 rounded-full bg-base-content/20" />
                  </:failed>
                  <span class={[
                    "inline-block size-2 rounded-full",
                    Platform.Chat.SpaceAgentPresence.dot_color(composite)
                  ]} />
                </.async_result>
                <span>Agents</span>
              </button>

              <%!-- Roster dropdown panel --%>
              <div
                :if={assigns[:roster_open] && @roster_open}
                class="absolute right-0 top-full mt-1 z-50 w-64 max-w-[calc(100vw-1rem)] rounded-lg border border-base-300 bg-base-200 shadow-lg"
              >
                <div class="p-3 space-y-1">
                  <.async_result :let={roster_items} assign={@roster_items}>
                    <:loading>
                      <div class="flex items-center justify-center py-4">
                        <span class="loading loading-spinner loading-sm"></span>
                      </div>
                    </:loading>
                    <:failed>
                      <div class="text-xs text-base-content/40 px-2 py-2">
                        Roster unavailable
                      </div>
                    </:failed>
                    <%= for {sa, status} <- roster_items do %>
                      <div class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-base-300 group">
                        <div class="flex items-center gap-2">
                          <span class={[
                            "inline-block size-2 rounded-full",
                            Platform.Chat.SpaceAgentPresence.dot_color(status)
                          ]} />
                          <span class="text-sm font-medium">
                            {if sa.role == "principal",
                              do: sa.agent.name,
                              else: "@#{sa.agent.name}"}
                          </span>
                          <span
                            :if={sa.role == "principal"}
                            class="text-[10px] text-base-content/40 uppercase"
                          >
                            principal
                          </span>
                        </div>
                        <div class="flex items-center gap-2">
                          <span class="text-xs text-base-content/50">{status}</span>
                          <button
                            :if={sa.role != "principal"}
                            phx-click="dismiss_agent"
                            phx-value-agent-id={sa.agent_id}
                            phx-value-space-id={sa.space_id}
                            class="hidden group-hover:inline text-xs text-base-content/40 hover:text-error transition-colors"
                            title="Remove agent"
                          >
                            Remove
                          </button>
                        </div>
                      </div>
                    <% end %>
                  </.async_result>
                </div>
              </div>
            </div>
          <% else %>
            <%!-- Legacy status dot (no space / no principal configured) --%>
            <span
              :if={assigns[:agent_status]}
              class={"inline-block size-2 rounded-full #{agent_status_color(@agent_status)}"}
            >
            </span>
            <span :if={assigns[:agent_status]} class="text-xs text-base-content/50">
              {agent_status_label(@agent_status)}
            </span>
          <% end %>
        </.async_result>

        <%!-- Human presence indicator --%>
        <.async_result :let={presence_list} assign={@presence_list}>
          <:loading>
            <span
              class="loading loading-spinner loading-xs text-base-content/40"
              data-test-id="shell-presence-loading"
              title="Loading participants"
            >
            </span>
          </:loading>
          <:failed>
            <%!-- Quietly hide on failure rather than show a broken count --%>
          </:failed>
          <div class="relative">
            <button
              phx-click="toggle_presence_panel"
              class="flex items-center gap-1 text-xs text-base-content/50 hover:text-base-content transition-colors"
              title="Online participants"
            >
              <span class="hero-user-group size-4"></span>
              <span>{Enum.count(presence_list, & &1.online)}</span>
            </button>

            <div
              :if={assigns[:show_presence_panel] && @show_presence_panel}
              class="absolute right-0 top-full mt-1 z-50 w-56 max-w-[calc(100vw-1rem)] rounded-lg border border-base-300 bg-base-100 shadow-lg p-2"
            >
              <div class="text-[10px] uppercase tracking-widest text-base-content/40 px-2 mb-1">
                Participants
              </div>
              <%= for user <- presence_list do %>
                <div class="flex items-center gap-2 py-1.5 px-2 rounded">
                  <span class={"inline-block size-2 rounded-full #{if user.online, do: "bg-green-500", else: "bg-zinc-400"}"} />
                  <span class="text-sm text-base-content/70">{user.name}</span>
                </div>
              <% end %>
            </div>
          </div>
        </.async_result>

        <%!-- Caption toggle (visible when in a meeting) --%>
        <button
          :if={@captions_enabled != nil}
          phx-click="toggle_captions"
          class={[
            "rounded-lg p-1 transition-colors",
            if(@captions_enabled,
              do: "text-primary hover:bg-base-300",
              else: "text-base-content/60 hover:bg-base-300 hover:text-base-content"
            )
          ]}
          aria-label={if @captions_enabled, do: "Hide captions", else: "Show captions"}
          title={if @captions_enabled, do: "Hide captions", else: "Show captions"}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-4"
          >
            <path d="M2 5a2 2 0 012-2h16a2 2 0 012 2v10a2 2 0 01-2 2H6l-4 4V5zm5 3a1 1 0 00-1 1v1a1 1 0 001 1h2a1 1 0 001-1V9a1 1 0 00-1-1H7zm7 0a1 1 0 00-1 1v1a1 1 0 001 1h2a1 1 0 001-1V9a1 1 0 00-1-1h-2z" />
          </svg>
        </button>

        <%!-- Dark/light mode toggle --%>
        <button
          id="theme-toggle"
          phx-hook="ThemeToggle"
          class="rounded-lg p-1 text-base-content/60 hover:bg-base-300 hover:text-base-content transition-colors"
          aria-label="Toggle dark/light mode"
          title="Toggle dark/light mode"
        >
          <span data-icon="sun" class="hero-sun size-4 hidden"></span>
          <span data-icon="moon" class="hero-moon size-4"></span>
        </button>

        <span class="text-xs text-base-content/50">{@current_user}</span>
        <.link
          href="/auth/logout"
          class="text-xs text-base-content/40 hover:text-base-content/70 transition-colors"
          title="Log out"
        >
          <span class="hero-arrow-right-on-rectangle size-4"></span>
        </.link>
      </div>
    </header>
    <%!-- Flash messages --%>
    <.flash_group flash={@flash} />
    <%!-- Meeting captions overlay --%>
    <div
      :if={@captions_enabled}
      id="meeting-captions"
      phx-hook="MeetingCaptions"
      class="fixed bottom-[calc(1rem+var(--bottom-nav-height,0px))] left-1/2 -translate-x-1/2 z-30 w-full max-w-2xl px-4 py-3 rounded-xl bg-black/75 backdrop-blur-sm text-sm text-white shadow-lg transition-opacity duration-300"
      aria-live="polite"
      aria-label="Meeting captions"
    >
    </div>
    <%!-- Surface. `flex-1` claims the remaining vertical space inside
         the inner column; `overflow-hidden` keeps the surface itself
         from scrolling (per-LiveView panels supply their own
         `overflow-y-auto` scrollers). `overscroll-contain` stops iOS
         rubber-band from propagating up and revealing/displacing the
         chrome (top app bar, bottom-tab nav).

         `min-h-0` is the load-bearing addition (post-#333): inside the
         shell's flex-col inner content column, flex items default to
         `min-height: auto` which means <main> refuses to shrink below
         its intrinsic content height. With a long chat thread that
         intrinsic height blows past the viewport — pushing the
         bottom-tab nav (the next flex sibling) off-screen on iOS Safari
         / PWA standalone even though the shell root is correctly
         100dvh-bounded. min-h-0 lets <main> actually receive the
         bounded `flex-1` height so its internal scrollers
         (#message-list etc.) can scroll on their own. --%>
    <main class="flex-1 min-h-0 overflow-hidden overscroll-contain">
      {@inner_content}
    </main>

    <%!-- Mobile bottom-nav (task 019e1322) — replaces the shell hamburger as
         the primary cross-surface navigation on phones. lg:hidden inside the
         component itself so desktop continues to use the existing left rail
         (lines 1-150 above). Tasks badge ships at 0 in Stage 1; Stage 3
         wires the live count via shell_live.ex `@tasks_count` assign. --%>
    <.bottom_nav active_module={@active_module} tasks_count={@tasks_count} />

    <%!-- Mobile More sheet (task 019e1322 Stage 2) — bottom sheet that surfaces
         the long-tail destinations (Skills, Changelog, Agent Resources, Org
         Context, Usage, Admin·Prompts, Admin·Federation) plus the profile +
         sign-out row. Triggered by `phx-click="open_more_sheet"` on the More
         tab in <.bottom_nav>. lg:hidden inside the component itself. --%>
    <.more_sheet open={@more_sheet_open} current_user={@current_user} />

    <%!-- Persistent meeting bar (survives navigation) --%>
    <.live_component
      module={PlatformWeb.MeetingBarLive}
      id="meeting-bar"
      meeting_active={@meeting_active}
      meeting_space_id={@meeting_space_id}
      meeting_space_name={@meeting_space_name}
      meeting_space_slug={@meeting_space_slug}
      meeting_started_at={@meeting_started_at}
      on_meeting_page={@on_meeting_page}
      sidebar_collapsed={@sidebar_collapsed}
    />
  </div>
</div>
