# Build from the full measured LOCAL image ID, preserving its CLI and runtime.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG EXPECTED_DRIVER_SHA256
ARG EXPECTED_HELPER_SHA256
COPY clip_runner.py source-receipt.json rebind_image_driver.py /tmp/clip-readiness/
RUN python3 /tmp/clip-readiness/rebind_image_driver.py \
      --driver /opt/clip-runner/driver/driver.py \
      --helper /opt/clip-runner/bin/clip_runner.py \
      --source-helper /opt/clip-runner/src/clip_runner.py \
      --replacement /tmp/clip-readiness/clip_runner.py \
      --receipt /tmp/clip-readiness/source-receipt.json \
      --expected-driver "$EXPECTED_DRIVER_SHA256" \
      --expected-helper "$EXPECTED_HELPER_SHA256" \
    && cmp /opt/clip-runner/bin/clip_runner.py /opt/clip-runner/src/clip_runner.py \
    && python3 /opt/clip-runner/bin/clip_runner.py version \
    && rm -rf /tmp/clip-readiness
COPY tests/ /opt/clip-runner/src/tests/
COPY install_helper.py rebind_image_driver.py source-receipt.json /opt/clip-runner/src/
LABEL org.getburrow.clip-helper.version="0.9.2" \
      org.getburrow.clip-helper.sha256="0a5c4e0bb84c208c492682fda5b6ccb6d79d9bf306602d411362502a15e175c4"
