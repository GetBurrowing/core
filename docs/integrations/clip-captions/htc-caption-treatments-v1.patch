--- /dev/null
+++ b/clip-agent/tests/test_dynamic_captions.py
@@ -0,0 +1,193 @@
+"""Temporal, transcript and geometry contracts, independent of config acceptance."""
+
+import json
+from pathlib import Path
+
+import pytest
+from click.testing import CliRunner
+from clip_agent import dynamic_captions as dc
+from clip_agent.captions import render_caption_pngs
+from clip_agent.cli import cli
+from clip_agent.config import FONTS_DIR, CaptionConfig, Config
+from clip_agent.models import CaptionStyle as S
+from clip_agent.models import Word
+from PIL import Image, ImageChops
+
+
+def words():
+    return [
+        Word(text=t, start=s, end=e)
+        for t, s, e in [
+            ("Most", 10.0, 10.2),
+            ("people", 10.3, 10.55),
+            ("skip", 10.6, 10.8),
+            ("backups.", 10.9, 11.2),
+            ("Wait", 13.0, 13.2),
+            ("please.", 13.3, 13.6),
+        ]
+    ]
+
+
+def test_capability_and_style_validation():
+    r = CliRunner().invoke(cli, ["version", "--json"])
+    assert r.exit_code == 0
+    c = json.loads(r.output)
+    assert c["caption_treatments"] == 1
+    assert c["headline_review"] == 1
+    assert c["caption_styles"] == ["none", "plain", "phrase-pop", "karaoke", "type-on", "focus-word", "editorial-punch"]
+    for style in ["type-on", "focus-word", "editorial-punch"]:
+        assert CaptionConfig(style=style).style == style
+    with pytest.raises(ValueError):
+        CaptionConfig(style="palette-only")
+
+
+def test_actual_intermediate_animation_state():
+    phrase = dc.phrases(words(), 10, 4)[0]
+    f = dc.state(S.TYPE_ON, phrase, 10, 0.34)
+    assert f["alpha"] == pytest.approx((1, 0.5, 0, 0))
+    assert f["underline"] == pytest.approx(1 - 0.04 / 0.3)
+    f = dc.state(S.FOCUS_WORD, phrase, 10, 0.36)
+    assert f["previous"] == 0 and f["active"] == 1
+    assert f["mix"] == pytest.approx(0.875)
+    p = dc.layout([w.text for w in phrase.words], 1080, 1920, Path(FONTS_DIR))
+    box = dc.pill_box(p, f)
+    assert box[0] == pytest.approx(p.boxes[0][0] + 0.875 * (p.boxes[1][0] - p.boxes[0][0]))
+    assert box[2] - box[0] == pytest.approx(
+        (p.boxes[0][2] - p.boxes[0][0]) * 0.125 + (p.boxes[1][2] - p.boxes[1][0]) * 0.875
+    )
+    f = dc.state(S.EDITORIAL_PUNCH, phrase, 10, 0.09)
+    assert f["opacity"] == pytest.approx(0.5)
+    assert f["rise"] == pytest.approx(1.5)
+    assert dc.state(S.EDITORIAL_PUNCH, phrase, 10, 0.2)["rise"] == 0
+
+
+@pytest.mark.parametrize("style", list(dc.STYLES))
+def test_rendered_pixels_change_without_reflow(tmp_path, style):
+    phrase = dc.phrases(words(), 10, 4)[0]
+    plan = dc.layout([w.text for w in phrase.words], 360, 640, Path(FONTS_DIR))
+    frozen = plan.boxes
+    images = []
+    for i, t in enumerate([0.0, 0.04, 0.09, 0.18, 0.34, 0.6, 1.1]):
+        path = tmp_path / f"{i}.png"
+        dc.render(plan, style, dc.state(style, phrase, 10, t), path)
+        images.append(Image.open(path).copy())
+        assert plan.boxes == frozen
+        bbox = images[-1].getbbox()
+        if bbox:
+            assert bbox[0] > 0 and bbox[2] < 360
+            assert bbox[1] >= int(640 * 0.62) and bbox[3] <= int(640 * 0.78)
+    assert (
+        ImageChops.difference(images[0], images[4] if style == S.FOCUS_WORD else images[2]).convert("RGB").getbbox()
+        is not None
+    )
+    assert plan.tokens == ("Most", "people", "skip", "backups.")
+    # No invented yellow fill (allow off-white antialiasing).
+    assert not any(r > 180 and g > 150 and b < 100 and a > 200 for im in images for r, g, b, a in im.getdata())
+
+
+def test_gap_camera_cut_last_word_and_rapid_speech(tmp_path):
+    p = dc.phrases(words(), 10, 4, breaks=(10.65,))
+    assert [x.text for x in p] == ["Most people skip", "backups.", "Wait please."]
+    assert p[0].end == pytest.approx(0.65)
+    assert p[1].end == pytest.approx(1.5)
+    assert p[-1].words[-1].text == "please."
+    assert p[-1].end == pytest.approx(3.9)
+    fast = dc.phrases([Word(text="One.", start=0, end=0.08), Word(text="Two.", start=0.1, end=0.16)], 0, 1)
+    assert dc.state(S.EDITORIAL_PUNCH, fast[0], 0, 0.02) == {"rise": 0, "opacity": 1}
+    for style in dc.STYLES:
+        rendered = render_caption_pngs(
+            words(),
+            tmp_path / style.value,
+            width=360,
+            height=640,
+            style=style,
+            config=Config(),
+            fonts_dir=FONTS_DIR,
+            clip_start=10,
+            clip_dur=4,
+            breaks=(10.65,),
+        )
+        assert all(not (a < 0.65 - 1e-6 and b > 0.65 + 1e-6) for _, a, b in rendered)
+        assert all(not (a < 2.5 and b > 1.5) for _, a, b in rendered)
+        assert len(rendered) < 150
+
+
+def test_long_words_and_bounded_sampling():
+    tokens = ["extraordinarilylongwordthatcannotfitnormally", "still", "spoken."]
+    p = dc.layout(tokens, 360, 640, Path(FONTS_DIR))
+    assert p.tokens == tuple(tokens)
+    assert all(0 < b[0] < b[2] < 360 for b in p.boxes)
+    assert len({x[1] for x in p.origins}) <= 2
+    slow = dc.phrases([Word(text="Hold.", start=0, end=600)], 0, 600)[0]
+    assert len(dc.sample_times(S.TYPE_ON, slow, 0)) <= 13
+    assert len(dc.sample_times(S.FOCUS_WORD, slow, 0)) <= 7
+    assert len(dc.sample_times(S.EDITORIAL_PUNCH, slow, 0)) <= 9
+
+
+def test_interrupted_pill_is_continuous_and_last_word_visible():
+    phrase = dc.phrases([Word("A", 0, 0.02), Word("longer", 0.03, 0.05), Word("end", 0.06, 0.08)], 0, 0.1)[0]
+    plan = dc.layout([w.text for w in phrase.words], 360, 640, Path(FONTS_DIR))
+    before = dc.pill_box(plan, dc.state(S.FOCUS_WORD, phrase, 0, 0.06 - 1e-8))
+    after = dc.pill_box(plan, dc.state(S.FOCUS_WORD, phrase, 0, 0.06))
+    assert before == pytest.approx(after, abs=0.0001)
+    assert dc.state(S.TYPE_ON, phrase, 0, 0.08)["alpha"][-1] > 0
+    tiny = dc.phrases([Word("Last.", 0, 0.01)], 0, 0.02)[0]
+    assert dc.state(S.TYPE_ON, tiny, 0, 0)["alpha"] == (1.0,)
+
+
+def test_legacy_png_snapshots_are_unchanged(tmp_path):
+    # SHA256s captured from unmodified upstream 82ef513 using Pillow 13.0.0.
+    # Pin decoded RGBA rather than encoder byte details in the long term.
+    import hashlib
+
+    expected = {
+        "plain": ["6bd79ef722764780d12487b55290f6fe51d047c96ac33c438bb2b492bb55c328"],
+        "phrase-pop": [
+            "5c3d5f78a1f6339bfc86c15cbcccede5e51134a9273bddcde988fb9411a03a22",
+            "1447035563743498193706e55c68800d752accd12bc03442a83662a30df2caeb",
+        ],
+        "karaoke": [
+            "4529f80db2184e4fc6187f41a6ff467193993d8e9a41b4e66d649dfa9615bc16",
+            "873dee0e3e3670cc74b4af766b61ce5584dfa80b685605c6e30760943b532f2a",
+            "eb392854f972acfd06b4cdd0db5367fac575b8cf5ebe28a77b1aef0a14d6ad28",
+            "6e361f8b564791f4c1e7f8b23819b010adfd32e335ec8108edd95b2326bba7bb",
+        ],
+    }
+    source = [Word("Most", 0, 0.3), Word("people", 0.4, 0.7), Word("skip", 0.8, 1.1), Word("backups.", 1.2, 1.6)]
+    for style, hashes in expected.items():
+        rows = render_caption_pngs(
+            source,
+            tmp_path / style,
+            width=360,
+            height=640,
+            style=style,
+            config=Config(),
+            fonts_dir=FONTS_DIR,
+            clip_start=0,
+            clip_dur=2,
+        )
+        assert [hashlib.sha256(p.read_bytes()).hexdigest() for p, _, _ in rows] == hashes
+
+
+def test_intermediate_png_opacity_and_pill_geometry(tmp_path):
+    phrase = dc.phrases(words(), 10, 4)[0]
+    plan = dc.layout([w.text for w in phrase.words], 1080, 1920, Path(FONTS_DIR))
+    path = tmp_path / "frame.png"
+    dc.render(plan, S.EDITORIAL_PUNCH, dc.state(S.EDITORIAL_PUNCH, phrase, 10, 0.09), path, scrim=False)
+    assert max(Image.open(path).getchannel("A").getdata()) == 128
+    dc.render(plan, S.EDITORIAL_PUNCH, dc.state(S.EDITORIAL_PUNCH, phrase, 10, 0.2), path, scrim=False)
+    assert max(Image.open(path).getchannel("A").getdata()) == 255
+    frame = dc.state(S.FOCUS_WORD, phrase, 10, 0.36)
+    expected = dc.pill_box(plan, frame)
+    dc.render(plan, S.FOCUS_WORD, frame, path, scrim=False)
+    im = Image.open(path)
+    colored = [(x, y) for y in range(im.height) for x in range(im.width) if im.getpixel((x, y)) == dc.VIOLET]
+    assert min(x for x, y in colored) == pytest.approx(expected[0], abs=1)
+    assert max(x for x, y in colored) == pytest.approx(expected[2], abs=1)
+    assert min(y for x, y in colored) == pytest.approx(expected[1], abs=1)
+    assert max(y for x, y in colored) == pytest.approx(expected[3], abs=1)
+
+
+def test_unrepresentable_token_fails_instead_of_clipping():
+    with pytest.raises(ValueError, match="without clipping"):
+        dc.layout(["W" * 10000], 360, 640, Path(FONTS_DIR))
