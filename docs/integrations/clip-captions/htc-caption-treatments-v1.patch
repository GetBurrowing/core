index 0000000..52c2552
--- /dev/null
+++ b/clip-agent/src/clip_agent/dynamic_captions.py
@@ -0,0 +1,238 @@
+"""Restrained temporal captions on the existing PNG/concat boundary.
+
+Layout is computed once per phrase. Only transition windows are sampled at
+30 Hz; holds reuse one PNG. No new video renderer or transcription path.
+"""
+
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFilter, ImageFont
+
+from .models import SENTENCE_ENDERS, CaptionStyle, Phrase, Word
+
+STYLES = frozenset({CaptionStyle.TYPE_ON, CaptionStyle.FOCUS_WORD, CaptionStyle.EDITORIAL_PUNCH})
+TEXT = (244, 244, 240, 255)
+TEAL = (46, 196, 182)
+VIOLET = (109, 74, 255, 255)
+FPS = 30
+
+
+@dataclass(frozen=True)
+class Layout:
+    tokens: tuple[str, ...]
+    # Drawing origins and padded word rectangles never change over a phrase.
+    origins: tuple[tuple[float, float], ...]
+    boxes: tuple[tuple[float, float, float, float], ...]
+    font: ImageFont.FreeTypeFont
+    emphasis_font: ImageFont.FreeTypeFont
+    emphasis: int
+    size: tuple[int, int]
+    scrims: tuple[tuple[float, float, float, float], ...]
+
+
+def phrases(words: list[Word], start: float, duration: float, breaks=()) -> list[Phrase]:
+    """No phrase crosses a camera/EDL cut, speaker change or >1.5 second gap.
+
+    Seven words / ~52 characters bound work and keep two short lines. Long
+    individual words stay intact and shrink to fit rather than being clipped.
+    """
+    selected = [w for w in words if start <= w.start < start + duration]
+    chunks: list[list[Word]] = []
+    chunk: list[Word] = []
+    for word in selected:
+        if chunk and (
+            len(chunk) >= 7
+            or len(" ".join(w.text for w in [*chunk, word])) > 52
+            or word.start - chunk[-1].end > 1.5
+            or any(chunk[0].start < b <= word.start for b in breaks)
+            or (word.speaker and chunk[-1].speaker and word.speaker != chunk[-1].speaker)
+        ):
+            chunks.append(chunk)
+            chunk = []
+        chunk.append(word)
+        if word.text and word.text[-1] in SENTENCE_ENDERS:
+            chunks.append(chunk)
+            chunk = []
+    if chunk:
+        chunks.append(chunk)
+    result = []
+    for i, chunk in enumerate(chunks):
+        end = chunks[i + 1][0].start if i + 1 < len(chunks) else chunk[-1].end + 0.3
+        if end - chunk[-1].end > 1.5:
+            end = chunk[-1].end + 0.3
+        end = min(end, *(b for b in breaks if b > chunk[0].start), start + duration)
+        result.append(
+            Phrase(
+                text=" ".join(w.text for w in chunk),
+                words=chunk,
+                start=max(0, chunk[0].start - start),
+                end=max(0, end - start),
+            )
+        )
+    return result
+
+
+def layout(tokens: list[str], width: int, height: int, fonts_dir: Path) -> Layout:
+    """One shared sentence-case grotesque layout in the 62–78% band.
+
+    Measure the heavier word too, so editorial emphasis cannot push its
+    neighbour. Shrinking is shared by all treatments, including long words.
+    """
+    base = fonts_dir / "Inter-SemiBold.ttf"
+    bold = fonts_dir / "weights" / "Inter-ExtraBold.ttf"
+    emphasis = max(range(len(tokens)), key=lambda i: len(tokens[i].strip(".,!?;:")))
+    size = max(8, round(height * 0.0375))
+    left, right = width * 0.09, width * 0.84
+    top, bottom = height * 0.62, height * 0.78
+    # Reserve room for 12px entry rise, shadows, pill and underline.
+    rise = 12 * height / 1920
+    while True:
+        font, heavy = ImageFont.truetype(str(base), size), ImageFont.truetype(str(bold), size)
+        widths = [max(font.getlength(t), heavy.getlength(t)) for t in tokens]
+        space = font.getlength(" ")
+        available = right - left - size * 0.5 - 16
+        split = (
+            min(
+                range(1, len(tokens)),
+                key=lambda k: max(sum(widths[:k]) + space * (k - 1), sum(widths[k:]) + space * (len(tokens) - k - 1)),
+            )
+            if len(tokens) > 1
+            else 1
+        )
+        lines = [list(range(len(tokens)))]
+        if sum(widths) + space * (len(tokens) - 1) > available or sum(map(len, tokens)) + len(tokens) - 1 > 26:
+            lines = [list(range(split)), list(range(split, len(tokens)))] if split < len(tokens) else lines
+        widest = max(sum(widths[i] for i in ids) + space * (len(ids) - 1) for ids in lines)
+        if (widest <= available and size * 1.3 * len(lines) + rise + 16 < bottom - top) or size == 1:
+            break
+        size -= 1
+    if widest > available:
+        raise ValueError("caption token cannot fit the safe band without clipping")
+    line_h = size * 1.3
+    y = (top + bottom - line_h * len(lines) - rise) / 2
+    origins, boxes, scrims = [None] * len(tokens), [None] * len(tokens), []
+    pad = size * 0.15
+    ref = font.getbbox("Hg")
+    for line, ids in enumerate(lines):
+        w = sum(widths[i] for i in ids) + space * (len(ids) - 1)
+        x = (left + right - w) / 2
+        line_y = y + line * line_h
+        scrims.append((x - pad, line_y + ref[1] - pad, x + w + pad, line_y + ref[3] + pad))
+        for i in ids:
+            origins[i] = (x, line_y)
+            boxes[i] = (x - pad, line_y + ref[1] - pad, x + widths[i] + pad, line_y + ref[3] + pad)
+            x += widths[i] + space
+    return Layout(tuple(tokens), tuple(origins), tuple(boxes), font, heavy, emphasis, (width, height), tuple(scrims))
+
+
+def state(style: CaptionStyle, phrase: Phrase, clip_start: float, t: float) -> dict:
+    starts = [w.start - clip_start for w in phrase.words]
+    active = max((i for i, s in enumerate(starts) if s <= t), default=0)
+    age = max(0, t - starts[active])
+    if style == CaptionStyle.TYPE_ON:
+        return {
+            "alpha": tuple(
+                1.0 if phrase.end - s <= 1 / FPS else max(0.0, min(1.0, (t - s) / min(0.08, phrase.end - s - 1 / FPS)))
+                for s in starts
+            ),
+            "active": active,
+            "underline": max(0.0, 1 - age / 0.3),
+            "rise": 0.0,
+            "opacity": 1.0,
+        }
+    if style == CaptionStyle.FOCUS_WORD:
+        weights = [1.0] + [0.0] * (len(starts) - 1)
+        for i in range(1, active + 1):
+            until = starts[i + 1] if i < active else t
+            mix = 1 - (1 - min(1.0, max(0.0, until - starts[i]) / 0.12)) ** 3
+            weights = [w * (1 - mix) for w in weights]
+            weights[i] += mix
+        return {
+            "weights": tuple(weights),
+            "active": active,
+            "previous": max(0, active - 1),
+            "mix": 1 - (1 - min(1.0, age / 0.12)) ** 3,
+            "rise": 0.0,
+            "opacity": 1.0,
+        }
+    progress = 1.0 if phrase.end - phrase.start < 0.25 else min(1.0, max(0.0, (t - phrase.start) / 0.18))
+    return {"rise": 12 * (1 - (1 - (1 - progress) ** 3)), "opacity": progress}
+
+
+def pill_box(plan: Layout, frame: dict) -> tuple[float, float, float, float]:
+    return tuple(sum(box[k] * weight for box, weight in zip(plan.boxes, frame["weights"])) for k in range(4))
+
+
+def render(plan: Layout, style: CaptionStyle, frame: dict, path: Path, *, scrim: bool = True) -> None:
+    image = Image.new("RGBA", plan.size)
+    if scrim:
+        d = ImageDraw.Draw(image)
+        for box in plan.scrims:
+            d.rounded_rectangle(box, radius=plan.font.size * 0.18, fill=(0, 0, 0, 153))
+    if style == CaptionStyle.FOCUS_WORD:
+        ImageDraw.Draw(image).rounded_rectangle(pill_box(plan, frame), radius=plan.font.size * 0.18, fill=VIOLET)
+    text = Image.new("RGBA", plan.size)
+    d = ImageDraw.Draw(text)
+    for i, (token, origin) in enumerate(zip(plan.tokens, plan.origins)):
+        alpha = frame.get("alpha", (1.0,) * len(plan.tokens))[i]
+        font = plan.emphasis_font if style == CaptionStyle.EDITORIAL_PUNCH and i == plan.emphasis else plan.font
+        d.text(origin, token, font=font, fill=(*TEXT[:3], round(255 * alpha)))
+    shadow = Image.new("RGBA", plan.size, (0, 0, 0, 0))
+    shadow.putalpha(text.getchannel("A").point(lambda p: round(p * 0.55)))
+    shadow = shadow.filter(ImageFilter.GaussianBlur(4 * plan.size[1] / 1920))
+    image.alpha_composite(shadow, (0, round(2 * plan.size[1] / 1920)))
+    image.alpha_composite(text)
+    if style == CaptionStyle.TYPE_ON:
+        box = plan.boxes[frame["active"]]
+        ImageDraw.Draw(image).line(
+            (box[0], box[3], box[2], box[3]),
+            fill=(*TEAL, round(255 * frame["underline"])),
+            width=max(1, round(3 * plan.size[1] / 1920)),
+        )
+    if frame["opacity"] < 1:
+        image.putalpha(image.getchannel("A").point(lambda p: round(p * frame["opacity"])))
+    if frame["rise"]:
+        moved = Image.new("RGBA", plan.size)
+        moved.alpha_composite(image, (0, round(frame["rise"] * plan.size[1] / 1920)))
+        image = moved
+    image.save(path)
+
+
+def sample_times(style: CaptionStyle, phrase: Phrase, clip_start: float) -> list[float]:
+    """Bounded 30Hz transitions plus event endpoints; static holds are one PNG."""
+    times = {phrase.start, phrase.end}
+    windows = []
+    if style in (CaptionStyle.TYPE_ON, CaptionStyle.FOCUS_WORD):
+        windows = [(w.start - clip_start, 0.3 if style == CaptionStyle.TYPE_ON else 0.12) for w in phrase.words]
+    elif phrase.end - phrase.start >= 0.25:
+        windows = [(phrase.start, 0.18)]
+    for start, duration in windows:
+        times.update(
+            min(phrase.end, start + i / FPS)
+            for i in range(math.ceil(duration * FPS) + 1)
+            if phrase.start <= start + i / FPS <= phrase.end
+        )
+        times.add(min(phrase.end, start + duration))
+        if style == CaptionStyle.TYPE_ON:
+            times.add(min(phrase.end, start + 0.08))
+    return sorted(times)
+
+
+def render_segments(words, out_dir, *, width, height, style, fonts_dir, clip_start, clip_dur, breaks=()):
+    out_dir = Path(out_dir)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    result = []
+    for phrase in phrases(words, clip_start, clip_dur, breaks):
+        plan = layout([w.text for w in phrase.words], width, height, Path(fonts_dir))
+        times = sample_times(style, phrase, clip_start)
+        for start, end in zip(times, times[1:]):
+            if end - start < 1e-6:
+                continue
+            path = out_dir / f"cap{len(result):05d}.png"
+            render(plan, style, state(style, phrase, clip_start, start), path)
+            result.append((path, start, end))
+    return result
