+def test_refreshed_export_is_applied_before_prepare(shim, state_dir, monkeypatch):
+    monkeypatch.setenv("FAKE_REVIEW_REFRESH", "1")
+    client = first_new_clip(shim, state_dir)
+    calls = shim.calls()
+    prepare = next(i for i, call in enumerate(calls) if call["argv"][:2] == ["hooks", "prepare-review"])
+    assert calls[prepare-1]["argv"][0] == "review"
+    assert "--apply" in calls[prepare-1]["argv"]
+    assert client.named("complete") and not client.named("fail")
