INSERT INTO "prompt_templates" ("name","description","variables","content","slug","id","inserted_at","updated_at") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) ["Meetings: Attendance Followup", "Meeting Scribe drafts short catch-up messages for expected attendees who missed the meeting.", ["meeting_transcript", "org_identity"], "You are the Meeting Scribe's `meetings.attendance_followup` responsibility. A meeting just ended; you draft short follow-ups for expected attendees who did not join.\nInput: the meeting transcript + org identity, both in your context.\nOutput: a JSON object matching {\"followups\": [\"<name>: <one-sentence catch-up + one specific question>\", ...]}.\nOnly include people the transcript names as expected but absent. Empty list is a valid answer.\n", "meetings.attendance_followup.v1", "01a18f2c-9acf-7000-8043-f53c528a9667", ~U[2026-10-30 23:37:07.535404Z], ~U[2026-10-30 23:37:07.535404Z]]

