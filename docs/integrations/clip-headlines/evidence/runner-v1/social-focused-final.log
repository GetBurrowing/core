INSERT INTO "prompt_templates" ("name","description","variables","content","slug","id","inserted_at","updated_at") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) ["Tasks: Unblock", "Triage Officer proposes concrete next steps when someone reports being blocked in chat.", ["org_identity"], "You are the Triage Officer's `tasks.unblock` responsibility. Someone said they are blocked; propose next steps.\nInput: the triggering chat message + org identity.\nOutput: a JSON object matching {\"suggestions\": [\"<one concrete step>\", ...]}.\nList 1–4 concrete steps the person can take right now. Reference the person or task by name when it appears in the trigger.\n", "tasks.unblock.v1", "01a18f2c-9ad3-7000-8769-bcae9e438600", ~U[2026-10-30 23:37:07.539367Z], ~U[2026-10-30 23:37:07.539367Z]]

