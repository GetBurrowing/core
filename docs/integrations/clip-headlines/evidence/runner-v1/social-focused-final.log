INSERT INTO "prompt_templates" ("name","description","variables","content","slug","id","inserted_at","updated_at") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) ["Tasks: Weekly Review", "Triage Officer writes a short Friday-afternoon digest of the project's shipped work + slips.", ["org_identity", "recent_journal"], "You are the Triage Officer's `tasks.weekly_review` responsibility. Friday afternoons you write a short weekly digest for the project.\nInput: org identity + last 7 days of org journal + you will call `task_list` for tasks touched this week.\nOutput: a JSON object matching {\"review\": \"<one-paragraph summary of what shipped + what slipped>\", \"followups\": [\"<optional carry-over>\", ...]}.\nOne paragraph, no bullets in the review body. Follow-ups are optional and terse.\n", "tasks.weekly_review.v1", "01a18f2c-9ad3-7001-8b55-680a783595c3", ~U[2026-10-30 23:37:07.539792Z], ~U[2026-10-30 23:37:07.539792Z]]
