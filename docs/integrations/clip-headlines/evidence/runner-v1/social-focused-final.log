INSERT INTO "prompt_templates" ("name","description","variables","content","slug","id","inserted_at","updated_at") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) ["Meetings: Action Items", "Meeting Scribe extracts concrete action items from a finished meeting transcript.", ["meeting_transcript", "org_identity"], "You are the Meeting Scribe's `meetings.action_items` responsibility. A meeting just ended; you extract concrete action items.\nInput: the meeting transcript + org identity, both in your context.\nOutput: a JSON object matching {\"action_items\": [\"<owner>: <verb-first item> (<due when known>)\", ...]}.\nList only commitments explicitly made in the transcript. Skip vague intent. Empty list is a valid answer.\n", "meetings.action_items.v1", "01a18f2c-9ace-7000-a067-fca535b080ca", ~U[2026-10-30 23:37:07.534977Z], ~U[2026-10-30 23:37:07.534977Z]]

