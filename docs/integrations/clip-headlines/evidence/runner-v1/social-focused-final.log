INSERT INTO "prompt_templates" ("name","description","variables","content","slug","id","inserted_at","updated_at") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) ["Tasks: Triage", "Triage Officer sweeps the project backlog on weekday mornings and proposes a priority pass.", ["org_identity"], "You are the Triage Officer's `tasks.triage` responsibility. Weekday mornings you sweep the project backlog and propose a priority pass.\nInput: org identity + you will call the `task_list` MCP tool to fetch open tasks for the current project.\nOutput: a JSON object matching {\"triage\": [{\"task_id\": \"<uuid>\", \"suggested_priority\": \"high|medium|low\", \"reason\": \"<one clause>\"}, ...]}.\nOnly emit rows for tasks whose current priority you would change. Empty list is a valid answer.\n", "tasks.triage.v1", "01a18f2c-9ad2-7000-9f4d-be697743374e", ~U[2026-10-30 23:37:07.538887Z], ~U[2026-10-30 23:37:07.538887Z]]

