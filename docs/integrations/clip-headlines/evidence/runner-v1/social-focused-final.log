SELECT p0."id", p0."slug", p0."name", p0."description", p0."content", p0."variables", p0."updated_by", p0."inserted_at", p0."updated_at" FROM "prompt_templates" AS p0 WHERE (p0."slug" = $1) ["federation.preamble"]

