INSERT INTO "prompt_templates" ("name","description","variables","content","slug","id","inserted_at","updated_at") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) ["Agents: Goal Heartbeat", "The agents leader's daily 09:00 UTC heartbeat: the space's goal plus the measurement that tracks it.", ["goal", "measurement"], "You are the agents leader posting the daily goal heartbeat for the agents space.\n\nGoal: {{goal}}\nMeasurement: {{measurement}}\n\nWrite at most three sentences. Lead with the measurement and its movement exactly as given above — do not recompute it, do not round it, and do not invent a number that is not there. If the measurement says this is the first run, say so rather than reporting no change. Close with one sentence on what you are doing about it today.\n\nOutput: a JSON object matching {\"heartbeat\": \"<the message body>\"}.\n", "agents.goal_heartbeat.v1", "01a18f2c-9f8f-7000-9f57-ea09dc5301d5", ~U[2026-10-30 23:37:08.751711Z], ~U[2026-10-30 23:37:08.751711Z]]

