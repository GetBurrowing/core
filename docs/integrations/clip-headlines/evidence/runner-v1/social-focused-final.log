WITH one_per_space AS MATERIALIZED (
  SELECT DISTINCT ON (s.id)
         s.id          AS space_id,
         s.slug        AS slug,
         s.inserted_at AS space_inserted_at,
         p.org_id      AS target_org_id
  FROM   chat_spaces s
  JOIN   meetings m ON m.chat_space_id = s.id
  JOIN   projects p ON p.id = m.project_id
