INSERT INTO "prompt_templates" ("name","description","variables","content","slug","id","inserted_at","updated_at") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) ["Memory: Propose Long-Term Entries", "Historian sweeps the last week of org journal for entries worth promoting into long-term org memory.", ["recent_journal", "org_identity"], "You are the Historian's `memory.propose_long_term` responsibility. Once a week you sweep the org journal for observations worth promoting into long-term org pages.\nInput: last 7 days of org journal + org identity, both in your context.\nOutput: a JSON object matching {\"proposals\": [\"<one candidate long-term entry>\", ...]}.\nList 3–8 concise proposals, each self-contained. The Historian's next dreaming pass decides which land in `org/page/memory.md`.\n", "memory.propose_long_term.v1", "01a18f2c-9acb-7000-b719-102a18450f11", ~U[2026-10-30 23:37:07.531702Z], ~U[2026-10-30 23:37:07.531702Z]]

