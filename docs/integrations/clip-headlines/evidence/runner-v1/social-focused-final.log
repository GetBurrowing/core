INSERT INTO "prompt_templates" ("name","description","variables","content","slug","id","inserted_at","updated_at") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) ["Nudge Prompt (short-form, safety-net / no-ack)", "Short-form nudge sent on safety-net / no-ack events only (task 019f640d stage 4). Replaces the polling-era full-context re-fire. No skills_reference, no evidence_workflow_reference, no task description, no org preamble — target output <500 tokens (~<2000 chars). Callers: `TaskRouter.fire_no_ack_alert/2` and `TaskRouter.fire_safety_net_alert/2` via `HeartbeatScheduler.nudge_prompt/2`.", ["task_id", "stage_id", "elapsed_minutes", "pending_validation_ids", "feedback_guidance"], "Task {{task_id}} stage {{stage_id}} — no ack in {{elapsed_minutes}}m. Please ack, push validation, or report_blocker.\n\n## Completion Reminder\nCurrent task_id: `{{task_id}}`\nCurrent stage_id: `{{stage_id}}`\n- Pending validation IDs: {{pending_validation_ids}} — ack, push validation_pass, or report_blocker with task_id={{task_id}} stage_id={{stage_id}}\n- If you are blocked on local infra (test rig, containers, ports, test hosts, credentials, missing tools), you should already have pinged Dalton (with an @-mention) in the execution space; if not, do it now instead of filing a blocker.{{feedback_guidance}}", "nudge", "01a18f2c-95e5-7000-aec9-c7a38252858f", ~U[2026-10-30 23:37:06.277098Z], ~U[2026-10-30 23:37:06.277098Z]]

