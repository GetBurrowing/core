    def test_tuning_documents_every_config_key():
        """docs/TUNING.md has a `### `[section]`` heading per config section and names every key in it."""
        from clip_agent.config import SECTIONS, Config
    
        text = (CLIP_AGENT / "docs" / "TUNING.md").read_text()
        missing = []
        for section in SECTIONS:
            m = re.search(rf"^### `\[{section}\]`.*?$(.*?)(?=^### |^---|\Z)", text, re.M | re.S)
            if not m:
                missing.append(f"[{section}] (no section heading)")
                continue
            body = m.group(1)
            model = Config.model_fields[section].annotation
            for key in model.model_fields:  # type: ignore[union-attr]
                if not re.search(rf"`{re.escape(key)}`", body):
                    missing.append(f"{section}.{key}")
