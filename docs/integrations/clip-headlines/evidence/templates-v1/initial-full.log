case = 'edited'

    @pytest.mark.parametrize("case", ["steady", "ducked", "outro", "edited", "unnormalised", "wider"])
    def test_a_loud_bed_is_capped_under_the_speech(speech_src, loud_low_bed, loud_outro, tmp_path, case):
        """A bed louder than the speech (a mastered track at level_db = 0). Normalising the
        finished mix then turned the speech down by about the difference: measured 7 dB
        (ducked: 3.5 dB), the bed 6.6 LU OVER the speech. The bed is now capped at
        music.speech_margin_lu (default 11) under the dialogue first, so:
    
        * the file still meets audio.target_lufs (normalised cases);
        * the speech sits no lower than in the same render without a bed, within 0.5 dB
          (a bed at 11 LU under adds at most about 0.33 LU to the mix, which the
          normalisation takes back off everything);
        * the bed plays at least the margin under the speech while the clip runs, within
          0.2 LU (the band filters' loss and the AAC encode; measured 10.95 to 11.03).
    
        ``outro``: a loud kept card sound after the speech is not part of the dialogue the
        cap is measured on (it would loosen the cap under the speech). ``unnormalised``: the
        cap holds without audio.normalize too. ``wider``: speech_margin_lu = 15 is used."""
        normalize = case != "unnormalised"
        margin = 15.0 if case == "wider" else 11.0
        card = {"outro": {"path": str(loud_outro), "audio": "keep"}} if case == "outro" else {}
        bed = {"music": {"enabled": True, "path": str(loud_low_bed), "level_db": 0,
                         "duck_db": 8 if case == "ducked" else 0,
                         **({"speech_margin_lu": margin} if case == "wider" else {})}}
    
        def cfg_(**sections):
            return build_config([("t", {"reframe": {"mode": "fit"}, "audio": {"normalize": normalize, "fade_ms": 0},
                                        **card, **sections})])
    
        go = _render_edited if case == "edited" else _render_long
        c = cfg_(**bed)
        out = go(speech_src, tmp_path / "bed.mp4", c)
        ref = go(speech_src, tmp_path / "ref.mp4", cfg_())
        speech, under = _lufs(out, _BODY_S, _SPEECH_BAND), _lufs(out, _BODY_S, _BED_BAND)
        alone = _lufs(ref, _BODY_S, _SPEECH_BAND)
        if normalize:
            whole = _lufs(out, 8.0)
            assert abs(whole - c.audio.target_lufs) <= 0.5, whole
        assert speech >= alone - 0.5, (speech, alone)                   # the speech is not turned down
>       assert speech - under >= margin - 0.2, (speech, under)          # the bed stays under it
