 @cli.group(cls=_HooksGroup)
 def hooks() -> None:
     """Quote-backed hook-title variants (clip hooks PROJECT) and posting records (clip hooks mark-posted)."""
+
+
+@hooks.command("prepare-review")
+@click.option("--check-applied", is_flag=True, help="Verify the applied review headline; never generate or edit.")
+@click.argument("project")
+@click.option("--request", "request_path", required=True, type=click.Path(exists=True, dir_okay=False))
+@_PROFILE_OPT
+@_CONFIG_OPT
+@_CONTENT_FREE_OPT
+@_friendly_errors
+def hooks_prepare_review(project, request_path, profile, config_path, check_applied) -> None:
+    """Prepare an exact quote-backed headline in review.toml (contract v1).
+
+    Request/voice/text remain local. Emits only a content-free receipt, even in
+    cloud mode. Does not apply review, finalize, approve a Burrow post or publish.
+    Run review --apply and finalize --regenerate afterwards.
+    """
+    from . import headline, pipeline, privacy
+    from . import hooks as hooks_mod
+    from .manifest import load_manifest
+    from .runlog import RunLog
+
+    try:
+        current = _load(config_path, profile)
+        project_dir = pipeline.find_project_dir(current, project)
+        manifest = load_manifest(project_dir)
+        config = current if profile else hooks_mod.project_config(manifest, current)
+        req = headline.HeadlineRequest.parse(json.loads(Path(request_path).read_text()),
+                                            privacy=config.effective_privacy_mode,
+                                            capabilities={"headline_review": 1})
+        if not check_applied and req.requested_headline is None and config.effective_privacy_mode == "local":
+            _preflight_local_model(config)
+        sweep_expired_logs(config, project_dirs=[project_dir])
+        with privacy.network_guard(config):
+            if check_applied:
+                receipt = headline.verify_applied(project_dir, manifest, config, req)
+            else:
+                receipt = headline.prepare_review(project_dir, manifest, config, req,
+                                                   runlog=RunLog(project_dir, config))
+        click.echo(json.dumps(receipt, sort_keys=True))
+    except headline.HeadlineError as exc:
+        raise AppError(exc.code) from None
+    except Exception:
+        # No transcript-derived provider errors, paths or request text cross the boundary.
+        raise AppError("HEADLINE_PREPARE_FAILED") from None


