+"""Versioned local headline boundary for automated picks and review regeneration.
+
+Generation belongs to hooks.generate_variants; this module never calls a model
+or changes approval state. Requests/receipts are local files, never MCP payloads.
+"""
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from pathlib import Path
+
+CONTRACT_VERSION = 1
+
+
+class HeadlineError(ValueError):
+    """Only a stable code crosses the local runner boundary."""
+
+    def __init__(self, code: str):
+        self.code = code
+        super().__init__(code)
+
+
+@dataclass(frozen=True)
+class HeadlineRequest:
+    consumer: str
+    candidate_id: str
+    source_id: str
+    start: float
+    end: float
+    voice_revision: str
+    voice_direction: str
+    base_render_id: str | None
+    requested_headline: str | None
+
+    @classmethod
+    def parse(cls, data: dict, *, privacy: str, capabilities: dict) -> HeadlineRequest:
+        if capabilities.get("headline_review") != CONTRACT_VERSION:
+            raise HeadlineError("HEADLINE_CLI_UNSUPPORTED")
+        if not isinstance(data, dict) or data.get("version") != CONTRACT_VERSION:
+            raise HeadlineError("HEADLINE_REQUEST_UNSUPPORTED")
+        if privacy != "cloud" and data.get("export_text", False):
+            raise HeadlineError("HEADLINE_PRIVACY_EXPORT_REFUSED")
+        consumer = data.get("consumer")
+        if consumer not in ("episode", "regenerate", "edit"):
+            raise HeadlineError("HEADLINE_CONSUMER_UNSUPPORTED")
+        voice = data.get("voice")
+        if not isinstance(voice, dict) or not all(
+            isinstance(voice.get(k), str) and voice[k].strip()
+            for k in ("revision", "direction")
+        ):
+            raise HeadlineError("HEADLINE_VOICE_MISSING")
+        source = data.get("source")
+        if not isinstance(source, dict) or not all(
+            isinstance(data.get(k), str) and data[k].strip() for k in ("candidate_id",)
+        ) or not isinstance(source.get("id"), str) or not source["id"].strip():
+            raise HeadlineError("HEADLINE_SOURCE_MISSING")
+        start, end = source.get("start"), source.get("end")
+        if not all(type(n) in (int, float) and math.isfinite(n) for n in (start, end)):
+            raise HeadlineError("HEADLINE_SPAN_INVALID")
+        if not 0 <= start < end:
+            raise HeadlineError("HEADLINE_SPAN_INVALID")
+        base = data.get("base_render_id")
+        if consumer != "episode" and (not isinstance(base, str) or not base.strip()):
+            raise HeadlineError("HEADLINE_BASE_MISSING")
+        title = data.get("requested_headline")
+        if consumer == "edit":
+            if not isinstance(title, str) or not title.strip():
+                raise HeadlineError("HEADLINE_EMPTY")
+            title = " ".join(title.split())
+        elif title is not None:
+            raise HeadlineError("HEADLINE_REQUEST_UNSUPPORTED")
+        return cls(consumer, data["candidate_id"], source["id"], float(start), float(end),
+                   voice["revision"], voice["direction"], base, title)
+
+    def receipt(self, *, headline: str, backed: bool, applied: bool, privacy: str,
+                export_text: bool = False) -> dict:
+        if not isinstance(headline, str) or not headline.strip():
+            raise HeadlineError("HEADLINE_EMPTY")
+        if not backed:
+            raise HeadlineError("HEADLINE_UNBACKED")
+        if self.requested_headline is not None and headline != self.requested_headline:
+            raise HeadlineError("HEADLINE_APPLIED_MISMATCH")
+        if privacy != "cloud" and export_text:
+            raise HeadlineError("HEADLINE_PRIVACY_EXPORT_REFUSED")
+        result = {
+            "version": CONTRACT_VERSION, "candidate_id": self.candidate_id,
+            "source_id": self.source_id, "start": self.start, "end": self.end,
+            "voice_revision": self.voice_revision, "base_render_id": self.base_render_id,
+            "status": "applied" if applied else "prepared", "backed": True,
+        }
+        if privacy == "cloud" and export_text:
+            result["requested_headline"] = self.requested_headline
+            result["applied_headline"] = headline if applied else None
+        return result
+
+
+def prepare_review(project_dir: Path, manifest, config, request: HeadlineRequest, *, runlog=None) -> dict:
+    """Prepare one supported review entry; caller must apply, then finalize.
+
+    Uses the existing hook policy, evidence checks and rotation. No internal
+    state is written; only review.toml is prepared. Prior unapplied edits fail
+    closed through write_review_file instead of being overwritten.
+    """
+    import re
+
+    from . import hooks, review
+    from .learn import db
+    from .manifest import atomic_write_text
+
+    c = next((c for c in manifest.candidates if c.id == request.candidate_id), None)
+    if c is None:
+        raise HeadlineError("HEADLINE_CANDIDATE_MISSING")
+    if (abs(c.effective_start - request.start) > 0.001
+            or abs(c.effective_end - request.end) > 0.001):
+        raise HeadlineError("HEADLINE_SPAN_STALE")
+    if not config.captions.hook_title:
+        raise HeadlineError("HEADLINE_OVERLAY_DISABLED")
+    if not hooks.is_approved(c, manifest):
+        raise HeadlineError("HEADLINE_RENDER_APPROVAL_REQUIRED")
+    words = hooks.saved_words(project_dir, manifest)
+    text = hooks.clip_text(project_dir, manifest, c, words=words)
+    names = hooks.episode_names(project_dir, manifest, words=words)
+    original = hooks.clip_original(c, words)
+    headline = request.requested_headline
+    if headline is None:
+        cfg = config.model_copy(deep=True)
+        cfg.selection.title_hint += "\nShow voice direction (provisional where incomplete): " + request.voice_direction
+        conn = db.connect(config.show.name)
+        try:
+            mix = db.recent_hook_types(conn)
+        finally:
+            conn.close()
+        # Existing selection variants may fill n without an AI call. A regenerate
+        # request needs a fresh draft through the SAME policy, not that shortcut.
+        candidate = c.model_copy(deep=True)
+        candidate.titles = []
+        result = hooks.generate_variants(cfg, candidate, text, n=1, mix=mix,
+                                        runlog=runlog, names=names, original=original)
+        if not result.variants:
+            raise HeadlineError("HEADLINE_OUTPUT_UNSUPPORTED")
+        headline = result.variants[0].title
+    if not isinstance(headline, str) or not headline.strip():
+        raise HeadlineError("HEADLINE_EMPTY")
+    headline = " ".join(headline.split())
+    if hooks.check_variant(headline, "", "selection", text, names=names, original=original).problem:
+        raise HeadlineError("HEADLINE_UNBACKED")
+    path = review.write_review_file(project_dir, manifest, words=words, config=config)
+    content = path.read_text()
+    chunks = re.split(r"(?m)(?=^\[\[clip\]\]\s*$)", content)
+    for i, chunk in enumerate(chunks):
+        import tomllib
+        rows = tomllib.loads(chunk).get("clip", [])
+        if rows and rows[0].get("id") == c.id:
+            chunks[i] = chunk.replace("[[clip]]\n", "[[clip]]\nheadline = " + review._toml_str(headline) + "\n", 1)
+            break
+    else:
+        raise HeadlineError("HEADLINE_OUTPUT_UNSUPPORTED")
+    atomic_write_text(path, "".join(chunks), mode=0o600)
+    return request.receipt(headline=headline, backed=True, applied=False,
+                           privacy=config.effective_privacy_mode)
+
+
+def verify_applied(project_dir: Path, manifest, config, request: HeadlineRequest) -> dict:
+    """Content-free verification against persisted tool state after review --apply.
+
+    This verifies application, not render completion or permission to publish.
+    """
+    import tomllib
+
+    from . import hooks, review
+
+    c = next((c for c in manifest.candidates if c.id == request.candidate_id), None)
+    if c is None:
+        raise HeadlineError("HEADLINE_CANDIDATE_MISSING")
+    if not review._fully_applied(project_dir / review.REVIEW_NAME, manifest):
+        raise HeadlineError("HEADLINE_REVIEW_NOT_APPLIED")
+    entries = tomllib.loads((project_dir / review.REVIEW_NAME).read_text()).get("clip", [])
+    entry = next((e for e in entries if e.get("id") == c.id), {})
+    expected = entry.get("headline")
+    if not isinstance(expected, str) or not expected.strip():
+        raise HeadlineError("HEADLINE_OUTPUT_UNSUPPORTED")
+    words = hooks.saved_words(project_dir, manifest)
+    actual = review.hook_title_for(c, config, words=words)
+    if actual != expected or not c.approval or c.status not in ("approved", "rendered"):
+        raise HeadlineError("HEADLINE_APPLIED_MISMATCH")
+    if (abs(c.effective_start - request.start) > 0.001
+            or abs(c.effective_end - request.end) > 0.001):
+        raise HeadlineError("HEADLINE_SPAN_STALE")
+    return request.receipt(headline=actual, backed=True, applied=True, privacy=config.effective_privacy_mode)
