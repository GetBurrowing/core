+import json
+import tomllib
+
+import pytest
+
+from clip_agent import headline, hooks, review
+from clip_agent.config import Config
+from clip_agent.manifest import Candidate, ProjectManifest, SourceInfo
+from clip_agent.models import Word
+
+
+def payload(consumer="episode"):
+    return {"version": 1, "consumer": consumer, "candidate_id": "abc123",
+            "source": {"id": "source-fixture", "start": 0, "end": 20},
+            "voice": {"revision": "fixture-rev-8", "direction": "Entertainment, comedy, positivity; incomplete."},
+            "base_render_id": None if consumer == "episode" else "render-fixture-1"}
+
+
+def parse(data):
+    return headline.HeadlineRequest.parse(data, privacy="local", capabilities={"headline_review": 1})
+
+
+@pytest.mark.parametrize("consumer", ["episode", "regenerate"])
+def test_consumers_share_local_receipt_without_text(consumer):
+    req = parse(payload(consumer))
+    receipt = req.receipt(headline="We shipped the app", backed=True, applied=True, privacy="local")
+    assert receipt == {"version": 1, "candidate_id": "abc123", "source_id": "source-fixture",
+                       "start": 0, "end": 20, "voice_revision": "fixture-rev-8",
+                       "base_render_id": None if consumer == "episode" else "render-fixture-1",
+                       "status": "applied", "backed": True}
+    assert "shipped" not in json.dumps(receipt)
+
+
+@pytest.mark.parametrize("change,code", [
+    ({"voice": None}, "HEADLINE_VOICE_MISSING"),
+    ({"source": {"id": "s", "start": 0, "end": float("nan")}}, "HEADLINE_SPAN_INVALID"),
+    ({"version": 2}, "HEADLINE_REQUEST_UNSUPPORTED"),
+    ({"export_text": True}, "HEADLINE_PRIVACY_EXPORT_REFUSED"),
+    ({"consumer": "regenerate", "base_render_id": None}, "HEADLINE_BASE_MISSING"),
+])
+def test_failures_are_content_free(change, code):
+    with pytest.raises(headline.HeadlineError, match=code):
+        parse(payload() | change)
+
+
+def test_unsupported_cli_fails_before_generation():
+    with pytest.raises(headline.HeadlineError, match="HEADLINE_CLI_UNSUPPORTED"):
+        headline.HeadlineRequest.parse(payload(), privacy="local", capabilities={})
+
+
+@pytest.mark.parametrize("title,backed,code", [("", True, "HEADLINE_EMPTY"),
+                                               ("unbacked", False, "HEADLINE_UNBACKED")])
+def test_unsupported_output_is_failure(title, backed, code):
+    with pytest.raises(headline.HeadlineError, match=code):
+        parse(payload()).receipt(headline=title, backed=backed, applied=True, privacy="local")
+
+
+@pytest.fixture
+def project(tmp_path, monkeypatch):
+    cfg = Config()
+    cfg.captions.hook_title = True
+    words = [Word(t, i, i + 0.9) for i, t in enumerate(
+        "We shipped the app and the team celebrated We shipped the app and the team celebrated".split())]
+    c = Candidate(id="abc123", rank=1, start=0, end=20, title="Old packaging",
+                  titles=["We shipped the app"], status="approved", render_fingerprint="old-render")
+    m = ProjectManifest(name="fixture", source=SourceInfo(path="/fixture.mp4", probe={"duration": 20}),
+                        config_resolved=cfg.model_dump(mode="json"), candidates=[c])
+    monkeypatch.setattr(hooks, "saved_words", lambda *a: words)
+    return tmp_path, m, cfg, words
+
+
+def test_explicit_headline_replaces_variant_and_approval_uses_new_packaging(project):
+    path, m, cfg, words = project
+    data = payload("edit") | {"requested_headline": "The team celebrated"}
+    prepared = headline.prepare_review(path, m, cfg, parse(data))
+    assert prepared["status"] == "prepared"
+    entry = tomllib.loads((path / "review.toml").read_text())["clip"][0]
+    assert entry["headline"] == "The team celebrated"
+    assert m.candidates[0].titles == ["We shipped the app"]  # no internal mutation
+    updated, invalidated, _ = review.apply_review(path, m, words, config=cfg)
+    c = updated.candidates[0]
+    assert c.title == "The team celebrated"
+    assert review.hook_title_for(c, cfg, words=words) == "The team celebrated"
+    assert invalidated == ["abc123"] and c.render_fingerprint is None
+    assert c.status == "approved"
+    assert c.approval["packaging"] == review.revision_record(c, source_fp=m.source.fingerprint, words=words, config=cfg)["packaging"]
+    assert headline.verify_applied(path, updated, cfg, parse(data))["status"] == "applied"
+
+
+def test_prepared_is_not_applied(project):
+    path, m, cfg, words = project
+    req = parse(payload("edit") | {"requested_headline": "The team celebrated"})
+    headline.prepare_review(path, m, cfg, req)
+    with pytest.raises(headline.HeadlineError, match="HEADLINE_REVIEW_NOT_APPLIED"):
+        headline.verify_applied(path, m, cfg, req)
+
+
+def test_dropping_headline_never_verifies_applied(project):
+    path, m, cfg, words = project
+    req = parse(payload("edit") | {"requested_headline": "The team celebrated"})
+    headline.prepare_review(path, m, cfg, req)
+    f = path / "review.toml"
+    f.write_text(f.read_text().replace('headline = "The team celebrated"\n', ""))
+    updated, _, _ = review.apply_review(path, m, words, config=cfg)
+    with pytest.raises(headline.HeadlineError, match="HEADLINE_OUTPUT_UNSUPPORTED"):
+        headline.verify_applied(path, updated, cfg, req)
+
+
+def test_unbacked_edit_does_not_write_or_apply(project):
+    path, m, cfg, words = project
+    data = payload("edit") | {"requested_headline": "Bananas cost 999 dollars"}
+    with pytest.raises(headline.HeadlineError, match="HEADLINE_UNBACKED"):
+        headline.prepare_review(path, m, cfg, parse(data))
+    assert not (path / "review.toml").exists()
+    assert m.candidates[0].render_fingerprint == "old-render"
+
+
+def test_generate_reuses_hook_policy_and_voice_and_never_reports_applied(project, monkeypatch):
+    path, m, cfg, words = project
+    calls = []
+    from clip_agent.learn import db
+    monkeypatch.setattr(db, "connect", lambda *a: type("Conn", (), {"close": lambda self: None})())
+    monkeypatch.setattr(db, "recent_hook_types", lambda c: {})
+    def generate(config, candidate, text, **kwargs):
+        calls.append((config, candidate, text))
+        return hooks.HookResult(candidate.id, [hooks.Variant("The team celebrated", "other", "The team celebrated", "brain")])
+    monkeypatch.setattr(hooks, "generate_variants", generate)
+    receipt = headline.prepare_review(path, m, cfg, parse(payload("regenerate")))
+    assert receipt["status"] == "prepared"
+    assert len(calls) == 1 and calls[0][1].titles == []
+    assert "Entertainment, comedy, positivity; incomplete." in calls[0][0].selection.title_hint
+    assert "Entertainment" not in cfg.selection.title_hint
+    assert tomllib.loads((path / "review.toml").read_text())["clip"][0]["headline"] == "The team celebrated"
+
+
+def test_missing_voice_precedes_provider_call(project, monkeypatch):
+    monkeypatch.setattr(hooks, "generate_variants", lambda *a, **k: pytest.fail("provider called"))
+    with pytest.raises(headline.HeadlineError, match="HEADLINE_VOICE_MISSING"):
+        parse(payload() | {"voice": {}})
+
+
+def test_review_rejects_injected_unbacked_headline_without_mutating_manifest(project):
+    path, m, cfg, words = project
+    review.write_review_file(path, m, words=words, config=cfg)
+    f = path / "review.toml"
+    f.write_text(f.read_text().replace("[[clip]]\n", '[[clip]]\nheadline = "999 bananas"\n', 1))
+    with pytest.raises(headline.HeadlineError, match="HEADLINE_UNBACKED"):
+        review.apply_review(path, m, words, config=cfg)
+    assert m.candidates[0].titles == ["We shipped the app"]
+    assert m.candidates[0].render_fingerprint == "old-render"
+
+
+def test_prior_unapplied_review_edits_are_preserved(project):
+    path, m, cfg, words = project
+    review.write_review_file(path, m, words=words, config=cfg)
+    f = path / "review.toml"
+    before = f.read_bytes()
+    with pytest.raises(RuntimeError, match="hasn't been applied"):
+        headline.prepare_review(path, m, cfg, parse(payload("edit") | {"requested_headline": "The team celebrated"}))
+    assert f.read_bytes() == before
+
+
+def test_exact_manual_request_cannot_claim_different_applied_title():
+    req = parse(payload("edit") | {"requested_headline": "The team celebrated"})
+    with pytest.raises(headline.HeadlineError, match="HEADLINE_APPLIED_MISMATCH"):
+        req.receipt(headline="We shipped the app", backed=True, applied=True, privacy="local")
+
+
+def test_cli_reports_capability_and_content_free_errors(tmp_path, monkeypatch):
+    from click.testing import CliRunner
+
+    from clip_agent import cli
+    monkeypatch.setenv("CLIP_NO_CONTENT", "1")
+    runner = CliRunner()
+    result = runner.invoke(cli.cli, ["version", "--json"])
+    assert result.exit_code == 0
+    assert json.loads(result.output)["headline_review"] == 1
+    request = tmp_path / "private-request.json"
