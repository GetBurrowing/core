+### `tests/test_subtle.py`
+
+````python
+"""Subtle style must forward, qualify exact modules and fail before upload."""
+import copy
+import os
+from pathlib import Path
+
+import pytest
+
+import clip_runner as c
+from conftest import FakeJobClient
+from test_dynamic_styles import CAPABILITY, caption_job
+from test_stage2 import first_new_clip, run
+
+
+def capability():
+    root = Path(os.environ["CLIP_TEMPLATE_TEST_MODULES"])
+    info = copy.deepcopy(CAPABILITY)
+    info["caption_styles"].append("subtle")
+    info["caption_renderer"].update(path=str(root / "captions.py"), sha256=c.SUBTLE_CAPTION_SOURCE_SHA256)
+    info["packaging_dependencies"] = {
+        name: {"path": str(root / (name + ".py")), "sha256": digest}
+        for name, digest in [("packaging_assets", c.PACKAGING_ASSETS_SHA256), ("subtle_captions", c.SUBTLE_RENDERER_SHA256)]
+    }
+    return info
+
+
+def test_subtle_independent_profile_and_finalize(shim, state_dir):
+    first_new_clip(shim, state_dir)
+    shim.script(version={"stdout": capability()})
+    start = len(shim.calls())
+    client = FakeJobClient(jobs=[caption_job("subtle")])
+    assert run(client, state_dir)["status"] == "done"
+    calls = shim.calls()[start:]
+    argv = next(call["argv"] for call in calls if call["argv"][0] == "finalize")
+    assert argv[argv.index("--captions") + 1] == "subtle"
+    assert any('style = "subtle"' in call.get("imported", "") for call in calls)
+    assert not any(call["argv"][0] == "process" for call in calls)
+    assert not list((shim.home / "profiles").glob("*-job-*"))
+
+
+@pytest.mark.parametrize("bad", ["old-style", "wrong-caption", "missing-dependency", "wrong-dependency"])
+def test_subtle_unsupported_never_finalize_upload_complete(shim, state_dir, bad):
+    first_new_clip(shim, state_dir)
+    info = capability()
+    if bad == "old-style":
+        info["caption_styles"].remove("subtle")
+    elif bad == "wrong-caption":
+        info["caption_renderer"]["sha256"] = "0" * 64
+    elif bad == "missing-dependency":
+        del info["packaging_dependencies"]
+    else:
+        info["packaging_dependencies"]["packaging_assets"]["sha256"] = "0" * 64
+    shim.script(version={"stdout": info})
+    start = len(shim.calls())
+    client = FakeJobClient(jobs=[caption_job("subtle")])
+    result = run(client, state_dir)
+    assert result["code"] in ("CAPTION_CLI_UNSUPPORTED", "HEADLINE_TEMPLATE_CLI_UNSUPPORTED")
+    assert not any(call["argv"][0] == "finalize" for call in shim.calls()[start:])
+    assert not client.named("complete")
+    assert not any(call[0] == "request" and call[1] == "file_add" for call in client.calls)
