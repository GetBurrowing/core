diff --git a/clip-agent/tests/test_subtle_captions.py b/clip-agent/tests/test_subtle_captions.py
new file mode 100644
index 0000000..045c2b0
--- /dev/null
+++ b/clip-agent/tests/test_subtle_captions.py
@@ -0,0 +1,67 @@
+from unittest.mock import patch
+
+import pytest
+from PIL import Image
+
+from clip_agent import captions
+from clip_agent import packaging_assets as assets
+from clip_agent.config import FONTS_DIR, Config
+from clip_agent.models import Word
+
+
+def render(words, tmp_path, style="subtle"):
+    cfg = Config()
+    cfg.captions.safe_top = 0.04
+    cfg.captions.safe_bottom = 0.645
+    return captions.render_caption_pngs(
+        words, tmp_path, width=540, height=960, style=style, config=cfg, fonts_dir=FONTS_DIR, clip_start=0, clip_dur=5
+    )
+
+
+def test_subtle_single_line_24px_regular_white_no_outline_or_highlight(tmp_path):
+    assets.clear()
+    words = [
+        Word(w, i * 0.3, i * 0.3 + 0.2)
+        for i, w in enumerate("Who gets access? This is a longer phrase that breaks safely.".split())
+    ]
+    result = render(words, tmp_path)
+    assert len(result) >= 3
+    assert len(result) < len(words)
+    for path, start, end in result:
+        image = Image.open(path)
+        bounds = image.getbbox()
+        assert bounds[3] - bounds[1] < 35  # exactly one 24px line plus soft shadow
+        assert 60 <= bounds[0] < bounds[2] <= 450
+        assert 39 <= bounds[1] < bounds[3] <= 619
+        opaque = [pixel for pixel in image.get_flattened_data() if pixel[3] == 255]
+        assert opaque and all(p[:3] == (255, 255, 255) for p in opaque)
+        assert 0 <= start < end <= 5
+
+
+def test_subtle_preserves_wording_and_uses_regular_font(tmp_path):
+    words = [Word(w, i * 0.2, i * 0.2 + 0.1) for i, w in enumerate("Google gives AI access.".split())]
+    with patch.object(ImageDraw := captions.ImageDraw.ImageDraw, "text", autospec=True, wraps=ImageDraw.text) as draw:
+        render(words, tmp_path)
+    assert draw.call_count > 0
+    assert " ".join(call.args[2] for call in draw.call_args_list) == "Google gives AI access."
+    assert all(call.kwargs["stroke_width"] == 0 for call in draw.call_args_list)
+    assert all(call.kwargs["font"].size == 24 for call in draw.call_args_list)
+    assert all(call.kwargs["font"].getname()[1] == "Regular" for call in draw.call_args_list)
+
+
+@pytest.mark.parametrize(
+    "word,code", [("unbroken" * 80, "CAPTION_LAYOUT_SHORTEN_TEXT"), ("Hello🐱", "CAPTION_GLYPH_UNSUPPORTED")]
+)
+def test_subtle_fails_without_silent_omission(tmp_path, word, code):
+    with pytest.raises(ValueError, match=code):
+        render([Word(word, 0, 1)], tmp_path)
+
+
+def test_subtle_font_pin_is_checked_after_cache_hit(tmp_path, monkeypatch):
+    words = [Word("Readably", 0, 1)]
+    render(words, tmp_path / "one")
+    from clip_agent import subtle_captions
+
+    monkeypatch.setattr(subtle_captions, "FONT_SHA256", "0" * 64)
+    with pytest.raises(ValueError, match="HEADLINE_ASSET_MISMATCH"):
+        render(words, tmp_path / "two")
