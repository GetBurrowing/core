index 0000000..78fe6e0
--- /dev/null
+++ b/clip-agent/src/clip_agent/subtle_captions.py
@@ -0,0 +1,93 @@
+"""Independent subtle caption style in the existing caption-track boundary."""
+
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFilter
+
+from . import packaging_assets as assets
+
+FONT_SHA256 = "40d692fce188e4471e2b3cba937be967878f631ad3ebbbdcd587687c7ebe0c82"
+REVISION = 1
+
+
+def render_segments(
+    words, out_dir, *, width, height, config, fonts_dir, clip_start, clip_dur, vpos_track=None, breaks=()
+):
+    from .captions import build_phrases, caption_safe_box
+
+    digest, raw = assets.verified(Path(fonts_dir) / "Inter-Regular.ttf", FONT_SHA256)
+    # 24 px at 960px high: 25% smaller than the approved sample's 32px baseline.
+    size = max(12, round(height * 0.025))
+    font = assets.font(raw, digest, size)
+    cmap = assets.cmap(raw, digest)
+    look = config.captions
+    safe = caption_safe_box(config, width, height, look)
+    if safe is None:
+        safe = (round(width * 0.08), round(height * 0.08), round(width * 0.88), round(height * 0.9))
+    radius = max(1, round(height * 0.001))
+    offset = max(1, round(height * 0.001))
+    pad = 3 * radius + offset + 2
+    max_width = safe[2] - safe[0] - 2 * pad
+    phases = build_phrases(words, clip_start, clip_dur, max_words=6, breaks=breaks)
+    split = []
+    for phase in phases:
+        group = []
+        for word in phase.words:
+            if any(not c.isspace() and ord(c) not in cmap for c in word.text):
+                raise ValueError("CAPTION_GLYPH_UNSUPPORTED")
+            bb = font.getbbox(word.text)
+            if bb[2] - bb[0] > max_width:
+                raise ValueError("CAPTION_LAYOUT_SHORTEN_TEXT")
+            proposed = " ".join(w.text for w in group + [word])
+            bb = font.getbbox(proposed)
+            if group and (bb[2] - bb[0] > max_width or group[-1].text.endswith((".", "?", "!", ",", ";", ":"))):
+                split.append((group, phase.end))
+                group = []
+            group.append(word)
+        if group:
+            split.append((group, phase.end))
+    result = []
+    out_dir = Path(out_dir)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    for i, (group, phase_end) in enumerate(split):
+        start = max(0.0, group[0].start - clip_start)
+        end = min(clip_dur, split[i + 1][0][0].start - clip_start if i + 1 < len(split) else phase_end)
+        if end <= start:
+            continue
+        text = " ".join(w.text for w in group)
+        mid = (start + end) / 2
+        vpos = next((v for a, b, v in (vpos_track or []) if a <= mid < b), look.vpos)
+        key = ("subtle", REVISION, text, digest, width, height, size, tuple(safe), vpos, radius, offset)
+
+        def paint(text=text, vpos=vpos):
+            ink = Image.new("RGBA", (width, height))
+            draw = ImageDraw.Draw(ink)
+            bbox = font.getbbox(text)
+            tw, th = bbox[2] - bbox[0], bbox[3] - bbox[1]
+            if th + 2 * pad > safe[3] - safe[1]:
+                raise ValueError("CAPTION_LAYOUT_SHORTEN_TEXT")
+            x = (safe[0] + safe[2] - tw) / 2 - bbox[0]
+            y = max(safe[1] + pad, min(round(height * vpos) - th // 2, safe[3] - pad - th)) - bbox[1]
+            draw.text((x, y), text, font=font, fill="white", stroke_width=0)
+            shadow = Image.new("RGBA", ink.size, (0, 0, 0, 0))
+            alpha = (
+                ink.getchannel("A")
+                .filter(ImageFilter.GaussianBlur(radius))
+                .point([round(alpha * 0.35) for alpha in range(256)])
+            )
+            shadow.putalpha(alpha)
+            shifted = Image.new("RGBA", ink.size)
+            shifted.alpha_composite(shadow, (offset, offset))
+            image = Image.alpha_composite(shifted, ink)
+            bounds = image.getbbox()
+            if bounds and not (
+                safe[0] <= bounds[0] < bounds[2] <= safe[2] and safe[1] <= bounds[1] < bounds[3] <= safe[3]
+            ):
+                raise ValueError("CAPTION_LAYOUT_UNSAFE")
+            return image
+
+        image = assets.cached(key, paint, weight=lambda x: x.width * x.height * 4).copy()
+        path = out_dir / f"cap{i:04d}.png"
+        image.save(path)
+        result.append((path, start, end))
+    return result
