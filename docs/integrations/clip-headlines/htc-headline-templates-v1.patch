diff --git a/clip-agent/src/clip_agent/packaging_assets.py b/clip-agent/src/clip_agent/packaging_assets.py
new file mode 100644
index 0000000..cd7d0c5
--- /dev/null
+++ b/clip-agent/src/clip_agent/packaging_assets.py
@@ -0,0 +1,111 @@
+"""Process-local bounded render caches. No cache persists across CLI processes.
+
+File identities include inode/device, size, mtime AND ctime nanoseconds. Every
+lookup stats the path, so replacement or in-place edits invalidate the cached
+bytes. A pinned hash is checked on EVERY call, including warm image/layout hits.
+Decoded assets/fonts use content hashes, never paths. Cached images are private:
+callers receive copies. All stores share a 64 MiB / 256 entry LRU budget.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import io
+import sys
+from collections import OrderedDict
+from threading import RLock
+
+from PIL import Image, ImageFont
+
+MAX_BYTES = 64 * 1024 * 1024
+MAX_ENTRIES = 256
+MAX_ASSET_BYTES = 16 * 1024 * 1024
+_entries = OrderedDict()
+_bytes = 0
+_lock = RLock()
+
+
+def cached(key, load, *, weight):
+    global _bytes
+    with _lock:
+        if key in _entries:
+            value, cost = _entries.pop(key)
+            _entries[key] = value, cost
+            return value
+        value = load()
+        cost = weight(value) if callable(weight) else weight
+        cost += sum(sys.getsizeof(part) for part in key) + sys.getsizeof(key)
+        if cost <= MAX_BYTES:
+            while _entries and (_bytes + cost > MAX_BYTES or len(_entries) >= MAX_ENTRIES):
+                _, (_, removed) = _entries.popitem(last=False)
+                _bytes -= removed
+            _entries[key] = value, cost
+            _bytes += cost
+        return value
+
+
+def clear():
+    global _bytes
+    with _lock:
+        _entries.clear()
+        _bytes = 0
+
+
+def info():
+    with _lock:
+        return {"entries": len(_entries), "bytes": _bytes, "max_bytes": MAX_BYTES, "max_entries": MAX_ENTRIES}
+
+
+def verified(path, expected=None):
+    from pathlib import Path
+
+    path = Path(path).resolve()
+    try:
+        stat = path.stat()
+        if stat.st_size > MAX_ASSET_BYTES:
+            raise ValueError("HEADLINE_ASSET_TOO_LARGE")
+        identity = (stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns, stat.st_ctime_ns)
+
+        def load():
+            with path.open("rb") as file:
+                raw = file.read(MAX_ASSET_BYTES + 1)
+                after = file.fileno()
+                import os
+
+                current = os.fstat(after)
+            observed = (current.st_dev, current.st_ino, current.st_size, current.st_mtime_ns, current.st_ctime_ns)
+            if identity != observed or len(raw) > MAX_ASSET_BYTES:
+                raise ValueError("HEADLINE_ASSET_CHANGED")
+            return hashlib.sha256(raw).hexdigest(), raw
+
+        digest, raw = cached(("bytes", str(path), identity), load, weight=lambda x: len(x[1]))
+    except OSError:
+        raise ValueError("HEADLINE_ASSET_MISMATCH") from None
+    if expected is not None and digest != expected:
+        raise ValueError("HEADLINE_ASSET_MISMATCH")
+    return digest, raw
+
+
+def font(raw, digest, size):
+    # FreeType objects retain a backing bytes stream; budget its full font size.
+    return cached(("font", digest, size), lambda: ImageFont.truetype(io.BytesIO(raw), size), weight=len(raw) + 16384)
+
+
+def cmap(raw, digest):
+    def load():
+        from fontTools.ttLib import TTFont
+
+        with TTFont(io.BytesIO(raw)) as face:
+            return frozenset(face.getBestCmap())
+
+    return cached(("cmap", digest), load, weight=lambda x: len(x) * 48)
+
+
+def logo(raw, digest, box):
+    def load():
+        with Image.open(io.BytesIO(raw)) as source:
+            image = source.convert("RGBA")
+        image.thumbnail(box)
+        return image
+
+    return cached(("logo", digest, tuple(box)), load, weight=lambda x: x.width * x.height * 4).copy()
