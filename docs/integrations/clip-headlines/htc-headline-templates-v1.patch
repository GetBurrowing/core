diff --git a/clip-agent/src/clip_agent/headline_templates.py b/clip-agent/src/clip_agent/headline_templates.py
new file mode 100644
index 0000000..7c400fd
--- /dev/null
+++ b/clip-agent/src/clip_agent/headline_templates.py
@@ -0,0 +1,258 @@
+"""Deterministic branded opening packaging; never generates text or edits video pixels."""
+
+from __future__ import annotations
+
+import copy
+import json
+import math
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFilter
+
+from . import packaging_assets as assets
+
+TEMPLATES = ("chrome-hook", "neon-broadcast", "arcade-punch")
+VERSION = 1
+PACKAGING_ASSETS_SHA256 = "47cb88ddee9a8c1d25884cca3e6362b3cbc61e78d9a914728de6c22028524122"
+SUBTLE_RENDERER_SHA256 = "f0ad451b76f12b79b1b4aaa644b98f0bedbafd8e2281c4c914d9b0cd67bd1b51"
+
+
+def _fail(code):
+    raise ValueError(code)
+
+
+def layout(text, *, width, height, look, font_path):
+    digest, raw = assets.verified(font_path)
+    cmap = assets.cmap(raw, digest)
+    if any(not c.isspace() and ord(c) not in cmap for c in text):
+        _fail("HEADLINE_GLYPH_UNSUPPORTED")
+    words = text.split()
+    if not words or len(text) > 500:
+        _fail("HEADLINE_LAYOUT_SHORTEN_TEXT")
+    spans = look.hook_title_emphasis
+    if any(i < 0 or i >= len(words) for i in spans) or len(set(spans)) != len(spans):
+        _fail("HEADLINE_EMPHASIS_STALE")
+    if spans and look.hook_title_emphasis_text != text:
+        _fail("HEADLINE_EMPHASIS_STALE")
+    if not look.hook_title_face_boxes:
+        _fail("HEADLINE_FACE_GEOMETRY_MISSING")
+    left = math.ceil(max(0.08, look.safe_side) * width)
+    right = math.floor((1 - max(0.12, look.safe_right)) * width)
+    top = math.ceil(max(0.08, look.safe_top) * height)
+    bottom = math.floor(0.29 * height)
+    # Include every decorative pixel and entrance displacement in the reserved region.
+    for box in look.hook_title_face_boxes:
+        if len(box) != 4 or not (0 <= box[0] < box[2] <= 1 and 0 <= box[1] < box[3] <= 1):
+            _fail("HEADLINE_FACE_GEOMETRY_INVALID")
+        if left < box[2] * width and right > box[0] * width and top < box[3] * height and bottom > box[1] * height:
+            _fail("HEADLINE_FACE_REGION_UNSAFE")
+    logo_h = round(height * 0.065)
+    # Reserve worst-case shear, stroke, offset and resampling before fitting text.
+    effect_pad = math.ceil((bottom - top - logo_h) * 0.06) + math.ceil(height * 0.055 * 0.045) + 5
+    pad = max(8, round(width * 0.025), effect_pad)
+    text_top = top + logo_h + pad
+    for size in range(round(height * 0.055), max(12, round(height * 0.024)) - 1, -1):
+        font = assets.font(raw, digest, size)
+        lines, current = [], []
+        for i, word in enumerate(words):
+            proposed = current + [(i, word)]
+            if font.getlength(" ".join(w for _, w in proposed)) <= right - left - 2 * pad:
+                current = proposed
+            else:
+                if not current:
+                    break
+                lines.append(current)
+                current = [(i, word)]
+        else:
+            if current:
+                lines.append(current)
+            if len(lines) <= 3 and len(lines) * round(size * 1.22) + 2 * pad <= bottom - text_top:
+                if all(font.getlength(" ".join(w for _, w in line)) <= right - left - 2 * pad for line in lines):
+                    return dict(
+                        words=words,
+                        lines=lines,
+                        size=size,
+                        region=(left, top, right, bottom),
+                        text_top=text_top,
+                        pad=pad,
+                        logo_h=logo_h,
+                    )
+    _fail("HEADLINE_LAYOUT_SHORTEN_TEXT")
+
+
+def render(text, path, *, width, height, look, fonts_dir):
+    assets.verified(Path(__file__).with_name("packaging_assets.py"), PACKAGING_ASSETS_SHA256)
+    assets.verified(Path(__file__).with_name("subtle_captions.py"), SUBTLE_RENDERER_SHA256)
+    # Verify bytes before even looking up a completed text/effect raster.
+    logo_digest, logo_raw = assets.verified(look.hook_title_logo_path, look.hook_title_logo_sha256)
+    font_path = Path(fonts_dir) / "Anton-Regular.ttf"
+    font_digest, font_raw = assets.verified(
+        font_path, "a4ba3a92350ebb031da0cb47630ac49eb265082ca1bc0450442f4a83ab947cab"
+    )
+    config = json.dumps(look.model_dump(mode="json"), sort_keys=True, separators=(",", ":"))
+    key = ("headline", VERSION, text, width, height, config, logo_digest, font_digest)
+
+    def paint():
+        return _render(
+            text,
+            width=width,
+            height=height,
+            look=look,
+            fonts_dir=fonts_dir,
+            logo_digest=logo_digest,
+            logo_raw=logo_raw,
+            font_digest=font_digest,
+            font_raw=font_raw,
+        )
+
+    image = assets.cached(key, paint, weight=lambda x: x.width * x.height * 4).copy()
+    image.save(path)
+    return Path(path)
+
+
+def _render(text, *, width, height, look, fonts_dir, logo_digest, logo_raw, font_digest, font_raw):
+    if look.hook_title_template not in TEMPLATES:
+        _fail("HEADLINE_TEMPLATE_UNSUPPORTED")
+    font_path = Path(fonts_dir) / "Anton-Regular.ttf"
+    key = (
+        "layout",
+        VERSION,
+        text,
+        width,
+        height,
+        font_digest,
+        json.dumps(look.model_dump(mode="json"), sort_keys=True),
+    )
+    spec = copy.deepcopy(
+        assets.cached(
+            key, lambda: layout(text, width=width, height=height, look=look, font_path=font_path), weight=8192
+        )
+    )
+    font = assets.font(font_raw, font_digest, spec["size"])
+    left, top, right, bottom = spec["region"]
+    img = Image.new("RGBA", (width, height))
+    draw = ImageDraw.Draw(img)
+    pad = spec["pad"]
+    a = assets.logo(logo_raw, logo_digest, (right - left - 2 * pad, spec["logo_h"]))
+    img.alpha_composite(a, ((left + right - a.width) // 2, top))
+    panel = (left + pad // 2, spec["text_top"] - pad // 2, right - pad // 2, bottom - pad // 2)
+    style = look.hook_title_template
+    if style == "neon-broadcast":
+        x0, y0, x1, y1 = panel
+        points = [(x0 + pad, y0), (x1, y0), (x1 - pad, y1), (x0, y1), (x0 + pad, y0)]
+        draw.polygon(points, fill=(4, 5, 20, 230))
+        draw.line(points, fill="#00E5FF", width=max(2, width // 180))
+        draw.line([(x0, y1), (x1 - pad, y1), (x1, y0)], fill="#FF22DD", width=max(2, width // 180))
+    if style == "arcade-punch":
+        for y in range(spec["text_top"], bottom - pad, max(4, width // 60)):
+            for x in range(left + pad, right - pad, max(4, width // 60)):
+                draw.ellipse((x, y, x + 1, y + 1), fill=(0, 210, 255, 100))
+    ink = Image.new("RGBA", img.size)
+    d = ImageDraw.Draw(ink)
+    for row, line in enumerate(spec["lines"]):
+        whole = " ".join(w for _, w in line)
+        x = (left + right - font.getlength(whole)) / 2
+        y = spec["text_top"] + pad // 2 + row * round(spec["size"] * 1.22)
+        for index, word in line:
+            fill = "#FFE600" if index in look.hook_title_emphasis else "#FFFFFF"
+            stroke = max(1, round(spec["size"] * 0.045))
+            if style == "arcade-punch":
+                d.text(
+                    (x + 3, y + 3),
+                    word,
+                    font=font,
+                    fill="#FF22DD",
+                    stroke_width=stroke + 1,
+                    stroke_fill="#FF22DD",
+                    anchor="lt",
+                )
+            d.text(
+                (x, y),
+                word,
+                font=font,
+                fill=fill,
+                stroke_width=stroke,
+                stroke_fill="#FF22DD" if style == "chrome-hook" else "#090518",
+                anchor="lt",
+            )
+            if style == "chrome-hook" and index not in look.hook_title_emphasis:
+                mask = Image.new("L", img.size)
+                ImageDraw.Draw(mask).text((x, y), word, font=font, fill=255, anchor="lt")
+                metal = Image.new("RGBA", img.size)
+                md = ImageDraw.Draw(metal)
+                for stripe in range(spec["size"] + 2):
+                    ratio = stripe / spec["size"]
+                    color = "#FFFFFF" if ratio < 0.36 or 0.51 < ratio < 0.73 else "#86BCD7"
+                    if 0.43 < ratio < 0.5:
+                        color = "#293A65"
+                    md.line((left, round(y) + stripe, right, round(y) + stripe), fill=color)
+                metal.putalpha(mask)
+                ink = Image.alpha_composite(ink, metal)
+                d = ImageDraw.Draw(ink)
+            x += font.getlength(word + " ")
+    if style == "chrome-hook":
+        alpha = ink.getchannel("A")
+        glow = Image.new("RGBA", img.size, "#00E5FF")
+        glow.putalpha(alpha.filter(ImageFilter.GaussianBlur(max(1, width / 220))))
+        img = Image.alpha_composite(img, glow)
+        # Chrome light is a deterministic highlight within the existing glyph mask.
+        shine = Image.new("RGBA", img.size)
+        sd = ImageDraw.Draw(shine)
+        for y in range(spec["text_top"], bottom):
+            if y % max(3, spec["size"]) < max(1, spec["size"] // 3):
+                sd.line((left, y, right, y), fill=(255, 255, 255, 90))
+        shine.putalpha(Image.composite(shine.getchannel("A"), Image.new("L", img.size), alpha))
+        ink = Image.alpha_composite(ink, shine)
+    ink_bounds = ink.getbbox()
+    if ink_bounds and not (
+        left <= ink_bounds[0] < ink_bounds[2] <= right and top <= ink_bounds[1] < ink_bounds[3] <= bottom
+    ):
+        _fail("HEADLINE_DECORATION_OUT_OF_BOUNDS")
+    if style == "arcade-punch":
+        # Bounded shear inside the reserved region, with full padding retained.
+        band = ink.crop((left, spec["text_top"], right, bottom))
+        band = band.transform(
+            band.size,
+            Image.Transform.AFFINE,
+            (1, 0.12, -(bottom - spec["text_top"]) * 0.06, 0, 1, 0),
+            resample=Image.Resampling.BICUBIC,
+        )
+        ink = Image.new("RGBA", img.size)
+        ink.alpha_composite(band, (left, spec["text_top"]))
+    img = Image.alpha_composite(img, ink)
+    bbox = img.getbbox()
+    if bbox and not (left <= bbox[0] < bbox[2] <= right and top <= bbox[1] < bbox[3] <= bottom):
+        _fail("HEADLINE_DECORATION_OUT_OF_BOUNDS")
+    return img
+
+
+def animate(timeline, title_path, *, until, directory, duration, fps=30):
+    """Sample only the opening at 30 Hz; captions continue untouched after exit."""
+    title = Image.open(title_path).convert("RGBA")
+    output = []
+    cursor = 0.0
+    frame_index = 0
+    for png, seconds in timeline:
+        end = cursor + seconds
+        while cursor < min(end, until) - 1e-8:
+            next_time = min(end, until, (frame_index + 1) / fps)
+            if next_time <= cursor + 1e-8:
+                frame_index += 1
+                continue
+            t = cursor
+            opacity = min(1.0, t / 0.2, max(0.0, (until - t) / 0.25))
+            opacity = max(0.0, opacity)
+            opacity = opacity * opacity * (3 - 2 * opacity)
+            overlay = title.copy()
+            overlay.putalpha(title.getchannel("A").point(lambda a, opacity=opacity: round(a * opacity)))
+            base = Image.open(png).convert("RGBA")
+            base = Image.alpha_composite(base, overlay)
+            dest = Path(directory) / f"_headline_{len(output):06}.png"
+            base.save(dest)
+            output.append((dest, next_time - cursor))
+            cursor = next_time
+            frame_index = int(cursor * fps + 1e-7)
+        if end > cursor + 1e-8:
+            output.append((png, end - cursor))
+            cursor = end
+    return output
