new file mode 100644
index 0000000..b391e00
--- /dev/null
+++ b/clip-agent/tests/test_packaging_assets.py
@@ -0,0 +1,118 @@
+import hashlib
+import os
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+from PIL import Image
+
+from clip_agent import headline_templates
+from clip_agent import packaging_assets as assets
+from clip_agent.config import FONTS_DIR, CaptionConfig
+from clip_agent.headline_templates import render
+
+
+@pytest.fixture(autouse=True)
+def empty_cache():
+    assets.clear()
+    yield
+    assets.clear()
+
+
+def setup(tmp_path):
+    logo = tmp_path / "logo.png"
+    Image.new("RGBA", (100, 40), "cyan").save(logo)
+    return CaptionConfig(
+        hook_title_template="chrome-hook",
+        safe_top=0.04,
+        hook_title_logo_path=str(logo),
+        hook_title_logo_sha256=hashlib.sha256(logo.read_bytes()).hexdigest(),
+        hook_title_face_boxes=[[0.2, 0.34, 0.7, 0.6]],
+    )
+
+
+def test_identical_key_loads_font_logo_effects_once(tmp_path):
+    look = setup(tmp_path)
+    with (
+        patch.object(assets.Image, "open", wraps=assets.Image.open) as opened,
+        patch.object(assets.ImageFont, "truetype", wraps=assets.ImageFont.truetype) as fonts,
+        patch.object(Path, "open", autospec=True, side_effect=Path.open) as files,
+        patch.object(headline_templates, "_render", wraps=headline_templates._render) as effects,
+    ):
+        render("Come back.", tmp_path / "first.png", width=540, height=960, look=look, fonts_dir=FONTS_DIR)
+        counts = (opened.call_count, fonts.call_count, files.call_count)
+        assert opened.call_count == 1 and fonts.call_count > 0 and files.call_count >= 2
+        render("Come back.", tmp_path / "next.png", width=540, height=960, look=look, fonts_dir=FONTS_DIR)
+        # Neither source asset is read again; Pillow saves through its own output stream.
+        assert (opened.call_count, fonts.call_count) == counts[:2]
+        assert files.call_count == counts[2]
+        assert effects.call_count == 1
+    assert (tmp_path / "first.png").read_bytes() == (tmp_path / "next.png").read_bytes()
+
+
+def test_warm_hit_still_refuses_wrong_pinned_digest(tmp_path):
+    look = setup(tmp_path)
+    render("Come back.", tmp_path / "first.png", width=540, height=960, look=look, fonts_dir=FONTS_DIR)
+    look.hook_title_logo_sha256 = "0" * 64
+    with pytest.raises(ValueError, match="HEADLINE_ASSET_MISMATCH"):
+        render("Come back.", tmp_path / "wrong.png", width=540, height=960, look=look, fonts_dir=FONTS_DIR)
+    assert not (tmp_path / "wrong.png").exists()
+
+
+@pytest.mark.parametrize("replace", [False, True])
+def test_same_path_replacement_invalidates_even_restored_mtime(tmp_path, replace):
+    look = setup(tmp_path)
+    path = Path(look.hook_title_logo_path)
+    render("Come back.", tmp_path / "first.png", width=540, height=960, look=look, fonts_dir=FONTS_DIR)
+    before = path.stat()
+    if replace:
+        other = tmp_path / "other.png"
+        Image.new("RGBA", (100, 40), "red").save(other)
+        os.replace(other, path)
+    else:
+        Image.new("RGBA", (100, 40), "red").save(path)
+    os.utime(path, ns=(before.st_atime_ns, before.st_mtime_ns))
+    with pytest.raises(ValueError, match="HEADLINE_ASSET_MISMATCH"):
+        render("Come back.", tmp_path / "wrong.png", width=540, height=960, look=look, fonts_dir=FONTS_DIR)
+    look.hook_title_logo_sha256 = hashlib.sha256(path.read_bytes()).hexdigest()
+    render("Come back.", tmp_path / "fresh.png", width=540, height=960, look=look, fonts_dir=FONTS_DIR)
+    assert (tmp_path / "fresh.png").read_bytes() != (tmp_path / "first.png").read_bytes()
+
+
+def test_wording_emphasis_size_and_config_change_pixels(tmp_path):
+    look = setup(tmp_path)
+    render("Come back.", tmp_path / "original.png", width=540, height=960, look=look, fonts_dir=FONTS_DIR)
+    for i, (text, change) in enumerate(
+        [
+            ("Next week.", {}),
+            ("Come back.", {"hook_title_emphasis": [0], "hook_title_emphasis_text": "Come back."}),
+            ("Come back.", {"hook_title_template": "arcade-punch"}),
+            ("Come back.", {"safe_side": 0.16}),
+        ]
+    ):
+        cfg = look.model_copy(update=change)
+        render(text, tmp_path / f"{i}.png", width=540, height=960, look=cfg, fonts_dir=FONTS_DIR)
+        assert (tmp_path / f"{i}.png").read_bytes() != (tmp_path / "original.png").read_bytes()
+    render("Come back.", tmp_path / "small.png", width=360, height=640, look=look, fonts_dir=FONTS_DIR)
+    assert Image.open(tmp_path / "small.png").size == (360, 640)
+
+
+def test_logo_callers_cannot_corrupt_shared_image(tmp_path):
+    look = setup(tmp_path)
+    digest, raw = assets.verified(look.hook_title_logo_path)
+    one = assets.logo(raw, digest, (100, 40))
+    expected = one.tobytes()
+    one.paste("black", (0, 0, 100, 40))
+    assert assets.logo(raw, digest, (100, 40)).tobytes() == expected
+
+
+def test_lru_entry_and_memory_budget(monkeypatch):
+    monkeypatch.setattr(assets, "MAX_BYTES", 1000)
+    monkeypatch.setattr(assets, "MAX_ENTRIES", 3)
+    for i in range(20):
+        assets.cached(("probe", i), lambda: b"x" * 40, weight=len)
+    assert assets.info()["bytes"] <= 1000
+    assert assets.info()["entries"] <= 3
+    assert assets.info()["entries"] > 0
+    assets.cached(("oversize",), lambda: b"x" * 1001, weight=len)
+    assert assets.info()["bytes"] <= 1000
