+def _headline_shot_crop(seg, shot, *, aspect, src_w, src_h):
+    """Reserve actual headroom using the union of measured faces, for the WHOLE shot.
+
+    No padding, blur, speaker choice or manufactured geometry. Refuse a crop if
+    the complete detected face cannot fit below the title at the existing zoom cap.
+    """
+    if seg.layout != "crop" or seg.face_box is None:
+        return seg  # The existing headline geometry guard rejects split/unknown.
+    samples = [fs for fs in shot.samples if fs]
+    if not samples or any(len(fs) != 1 for fs in samples):
+        raise ValueError("HEADLINE_FACE_REGION_UNSAFE")
+    fs = [faces[0] for faces in samples]
+    left = min(f.x for f in fs) * src_w
+    top = max(0.0, min(f.y for f in fs) - 0.02) * src_h
+    right = max(f.x + f.w for f in fs) * src_w
+    bottom = min(1.0, max(f.y + f.h for f in fs) + 0.02) * src_h
+    # Safety padding on both edges also absorbs even-integer rounding.
+    y0, y1 = 0.32, 0.86
+    minimum = max(src_h / _MAX_SHOT_ZOOM, (bottom - top) / (y1 - y0),
+                  (right - left) * _FACE_FIT / aspect)
+    maximum = min(float(src_h), src_w / aspect, top / y0,
+                  (src_h - bottom) / (1 - y1))
+    ch = _even_floor(maximum)
+    cw = _even_floor(ch * aspect)
+    if ch < minimum or cw <= 0:
+        raise ValueError("HEADLINE_FACE_REGION_UNSAFE")
+    low = max(0.0, bottom - y1 * ch)
+    high = min(src_h - ch, top - y0 * ch)
+    cy = _even_floor((low + high) / 2)
+    cx = _even_floor(max(0.0, min(src_w - cw, (left + right - cw) / 2)))
+    box = CropBox(cx, cy, cw, ch)
+    face_box = ((left - cx) / cw, (top - cy) / ch,
+                (right - cx) / cw, (bottom - cy) / ch)
+    if not (0 <= face_box[0] < face_box[2] <= 1 and 0.30 <= face_box[1] < face_box[3] <= 0.88):
+        raise ValueError("HEADLINE_FACE_REGION_UNSAFE")
+    return PlanSegment(seg.start, seg.end, "crop", [box], seg.speaker, face_box)
+
