+"""Independent safety/installation contracts for the Linux prerequisite."""
+
+import pytest
+
+from clip_agent import opencv_faces, reframe
+from clip_agent.config import Config
+from clip_agent.shots import Face, ShotFaces
+
+
+def test_missing_or_wrong_model_is_not_a_detector(monkeypatch, tmp_path):
+    model = tmp_path / "model.onnx"
+    monkeypatch.setenv("CLIP_FACE_MODEL", str(model))
+    assert opencv_faces.available() is False
+    model.write_bytes(b"not the qualified model")
+    assert opencv_faces.available() is False
+    with pytest.raises(RuntimeError, match="FACE_MODEL_MISSING_OR_MISMATCH"):
+        opencv_faces.detect(tmp_path / "image.png")
+
+
+def test_face_model_pin_is_literal():
+    assert opencv_faces.MODEL_SHA256 == "8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4"
+
+
+def test_union_crop_reserves_headroom_for_whole_shot_and_keeps_full_face():
+    cfg = Config()
+    cfg.reframe.width, cfg.reframe.height = 540, 960
+    cfg.captions.hook_title = True
+    cfg.captions.hook_title_template = "chrome-hook"
+    faces = [Face(0.48, 0.26, 0.14, 0.32), Face(0.49, 0.27, 0.14, 0.32)]
+    sh = ShotFaces(0, 4, [[face] for face in faces])
+    plan = reframe.plan_shots([sh], 4, 1920, 1080, cfg)
+    assert len(plan.segments) == 1  # Never change crop at title exit.
+    seg = plan.segments[0]
+    assert (seg.start, seg.end, seg.layout) == (0, 4, "crop")
+    x0, y0, x1, y1 = seg.face_box
+    assert 0 <= x0 < x1 <= 1
+    assert 0.30 <= y0 < y1 <= 0.88
+    box = seg.boxes[0]
+    for face in faces:
+        assert box.x <= face.x * 1920 < (face.x + face.w) * 1920 <= box.x + box.w
+        assert box.y <= face.y * 1080 < (face.y + face.h) * 1080 <= box.y + box.h
+
+
+def test_impossible_headroom_fails_instead_of_fit_or_clipping():
+    sh = ShotFaces(0, 4, [[Face(0.4, 0.01, 0.2, 0.8)]])
+    seg = reframe.PlanSegment(0, 4, "crop", [reframe.CropBox(0, 0, 606, 1080)], face_box=(0.1, 0.01, 0.8, 0.9))
+    with pytest.raises(ValueError, match="HEADLINE_FACE_REGION_UNSAFE"):
+        reframe._headline_shot_crop(seg, sh, aspect=9 / 16, src_w=1920, src_h=1080)
+
+
+def test_legacy_shot_crop_stays_unchanged():
+    cfg = Config()
+    cfg.captions.hook_title = True
+    cfg.captions.hook_title_template = "legacy"
+    sh = ShotFaces(0, 4, [[Face(0.48, 0.26, 0.14, 0.32)]])
+    plan = reframe.plan_shots([sh], 4, 1920, 1080, cfg)
+    assert plan.segments[0].boxes[0].h == 1080
+
+
+@pytest.mark.parametrize("code", ["HEADLINE_LAYOUT_SHORTEN_TEXT", "HEADLINE_FACE_REGION_UNSAFE"])
+def test_cli_content_free_layout_codes_survive_without_stderr_capture(monkeypatch, code):
+    import json
+
+    import click
+    from click.testing import CliRunner
+
+    from clip_agent import cli
+
+    monkeypatch.setenv("CLIP_NO_CONTENT", "1")
+
+    @click.command()
+    @cli._friendly_errors
+    def fail():
+        raise ValueError(code)
+
+    result = CliRunner().invoke(fail)
+    assert result.exit_code == 1
+    assert json.loads(result.stdout) == {"ok": False, "error": {"code": code}}
