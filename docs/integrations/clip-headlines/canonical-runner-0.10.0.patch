+    if (not isinstance(digest, str) or not re.fullmatch(r"[a-f0-9]{64}", digest)
+            or base != {"sha256": digest, "artifact": "sha256:" + digest}):
+        raise ClipError("HEADLINE_CONTENT_MISSING", "headline")
+    path = _headline_artifact_dir(runner) / (digest + ".json")
+    if path.is_symlink() or not path.is_file():
+        raise ClipError("HEADLINE_CONTENT_MISSING", "headline")
+    raw = path.read_bytes()
+    if hashlib.sha256(raw).hexdigest() != digest:
+        raise ClipError("HEADLINE_CONTENT_MISMATCH", "headline")
+    try:
+        document = json.loads(raw)
+        text = document["wording"]
+        if not isinstance(text, str) or not text.strip():
+            raise ValueError()
