+    shim.script(version={'stdout': info})
+    client = FakeJobClient(jobs=[make_job('job-01', 'new_clip', headline_template=contract())])
+    uploads = []
+    result = run(client, state_dir, uploader=lambda *args: uploads.append(1))
+    assert result['code'] == 'HEADLINE_TEMPLATE_CLI_UNSUPPORTED'
+    assert not uploads and not client.named('complete')
